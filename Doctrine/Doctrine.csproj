<Project Sdk="Microsoft.NET.Sdk">
  <!-- Doctrine: the game library. NuGet only, never a MonoRepo ProjectReference. Browser-wasm friendly: no threads, no
       filesystem, no reflection serialisation. Sections live in Army/, Battle/ and General/ (see SECTIONS.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Doctrine</RootNamespace>
    <LangVersion>latest</LangVersion>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="EvaluatedApplications.AlgFormer" Version="3.3.0" />
    <PackageReference Include="EvaluatedApplications.EvalApp" Version="4.4.2" />
    <PackageReference Include="EvaluatedApplications.Phasor" Version="2.19.1" />
    <PackageReference Include="EvaluatedApplications.Tracer" Version="2.0.4" />
  </ItemGroup>
</Project>