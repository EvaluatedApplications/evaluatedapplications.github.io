<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles and runs the exact code shown on the Tracer page (web/data/snippets/tracer-quickstart.cs)
       against the published NuGet package. The captured output is web/data/snippets/tracer-quickstart.out.txt. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\data\snippets\tracer-quickstart.cs" />
    <PackageReference Include="EvaluatedApplications.Tracer" Version="2.0.2" />
  </ItemGroup>

</Project>
