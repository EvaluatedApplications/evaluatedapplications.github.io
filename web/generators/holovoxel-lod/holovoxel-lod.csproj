<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the PUBLISHED EvaluatedApplications.HoloVoxel package and records a strip of terrain chunks decoded at three
       levels of detail, plus how accuracy, stored size and decode cost fall with the component budget.
       Run: dotnet run -c Release with the output path as the argument. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EvaluatedApplications.HoloVoxel" Version="1.5.2" />
  </ItemGroup>

</Project>