<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the PUBLISHED EvaluatedApplications.Phasor package and writes the data behind the Pleroma
       superposition replay and the capacity demo. Run: dotnet run -c Release with two output paths. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EvaluatedApplications.Phasor" Version="2.19.1" />
  </ItemGroup>

</Project>
