<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the PUBLISHED EvaluatedApplications.EvalApp package and records what the resource gate and the adaptive
       tuner really did on a queued batch of simulated downloads.
       Run: dotnet run -c Release with the output path as the argument. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EvaluatedApplications.EvalApp" Version="4.4.1" />
  </ItemGroup>

</Project>
