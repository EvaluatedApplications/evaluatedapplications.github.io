<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the PUBLISHED EvaluatedApplications.HoloGenome package on the 50-base example window and records the cumulative helix phase
       under the measured Olson twist and under the constant 34.3 degree control, the mean twist, and the cosine between a window
       and its reverse complement. It writes those into the "helix" block of web/data/diagrams/hologenome-scores.json and stamps the package version.
       Run: dotnet run -c Release with the path of that file as the argument. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EvaluatedApplications.HoloGenome" Version="0.1.1" />
  </ItemGroup>

</Project>