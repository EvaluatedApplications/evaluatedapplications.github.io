<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the PUBLISHED EvaluatedApplications.Prose package on a folder of plain-text books: parses sentences, mines the
       grammar into its tables, recombines new sentences and checks every one with the package's own validity gate.
       The corpus is three public-domain novels from Project Gutenberg (ebooks 11, 1661 and 1342), passed as a folder of
       .txt files; the Gutenberg licence header and footer are stripped before mining.
       Run: dotnet run -c Release with the output path and the corpus folder as arguments. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EvaluatedApplications.Prose" Version="1.4.0" />
  </ItemGroup>

</Project>