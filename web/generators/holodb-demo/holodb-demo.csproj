<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the PUBLISHED EvaluatedApplications.HoloDb package and writes the data behind the "one store, three ways"
       diagram: real rows, real NEAREST scores, real aggregate results, real usage-meter readings and real EXPLAIN output.
       Run: dotnet run -c Release with the output path as the argument. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EvaluatedApplications.HoloDb" Version="5.3.0" />
  </ItemGroup>

</Project>
