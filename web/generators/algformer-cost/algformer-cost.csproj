<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the PUBLISHED EvaluatedApplications.AlgFormer package and measures what the two attention cores cost:
       reading a prompt, producing each further token, and the memory the serve cache holds, at growing context
       lengths; plus the capacity numbers HoloShape derives for several widths.
       Run: dotnet run -c Release with the output path as the argument. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TieredPGO>false</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EvaluatedApplications.AlgFormer" Version="3.3.0" />
  </ItemGroup>

</Project>