<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generates web/data/diagrams/tracer-field.json by running the PUBLISHED
       EvaluatedApplications.Tracer package. Run: dotnet run -c Release with the output path as the argument.
       The generator stamps the resolved package version into the JSON. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EvaluatedApplications.Tracer" Version="2.0.2" />
  </ItemGroup>

</Project>
