S CREATE TABLE PageContent (Slug TEXT PRIMARY KEY, Title TEXT, Body TEXT)
COMMIT
S INSERT INTO PageContent (Slug, Title, Body) VALUES ('phasor', 'Phasor', 'Phasor encodes numbers and symbols as phasor faces and composes them with one algebra -- bind, unbind, bundle, correlate. Arithmetic is encoding, not calculation.')
COMMIT
S INSERT INTO PageContent (Slug, Title, Body) VALUES ('holodb', 'HoloDb', 'HoloDb stores data as holograms in one associative store, queried three ways over one copy: exact SQL by key, similarity search by content (NEAREST), and constant-time analytics.')
COMMIT
S INSERT INTO PageContent (Slug, Title, Body) VALUES ('algformer', 'AlgFormer', 'AlgFormer defines, trains, and runs transformer-style language models in pure managed .NET -- no GPU, no Python, no native runtime required.')
COMMIT
S INSERT INTO PageContent (Slug, Title, Body) VALUES ('tracer', 'Tracer', 'Tracer is a pathfinding and game-AI SDK for .NET: navmesh baking, multi-agent pathfinding with goal-sharing, dynamic obstacles, line-of-sight, fog-of-war, influence maps, combat.')
COMMIT
S INSERT INTO PageContent (Slug, Title, Body) VALUES ('evalapp', 'EvalApp', 'EvalApp is a resource-gated, self-tuning async pipeline runtime for .NET: describe a process as data and steps, and stop hand-writing concurrency coordination.')
COMMIT
