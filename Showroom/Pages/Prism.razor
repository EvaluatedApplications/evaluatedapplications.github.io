@page "/prism"
@inject HttpClient Http
@inject HoloKernel.SessionHost Sessions
@using System.Text
@using System.Threading.Channels
@using PrismFormer
@using HoloKernel

<PageTitle>Prism — autocomplete with a live holographic-transformer checkpoint</PageTitle>

<div class="room">
    <header class="room-head">
        <nav class="crumb"><a href="/">Evaluated Applications</a> <span>/</span> Prism</nav>
        <h1>Prism</h1>
        <p class="lede">This page downloads a real, trained <strong>HoloFormer</strong> checkpoint straight to your
            device and runs it right here, in this browser tab — no server call, no upload, nothing you type ever
            leaves this page. Type the start of a sentence and watch it continue, character by character, computed
            on your own CPU. This is <strong>autocomplete, not a chatbot</strong>: the model has never seen a
            dialogue turn in its life, so every submission is a fresh, independent continuation — it does not
            remember anything you typed before.</p>
        <div class="badges">
            <span>Runs on your device, not our servers</span><span>Real trained checkpoint</span><span>Holographic-transformer brain</span>
        </div>
    </header>

    @if (_loadError is not null)
    {
        <p class="err">@_loadError</p>
        <p class="hint">This tool runs off a snapshot of an ongoing training run, taken at one point in time —
            if the checkpoint files aren't available right now, please check back later.</p>
    }
    else if (!_loaded)
    {
        <div class="boot-crt ck-boot">
            <div class="boot-head"><span class="boot-dot" aria-hidden="true"></span>fetching the trained checkpoint</div>
            <div class="boot-sub">real files, downloading once to THIS device — cached by your browser after the first visit.</div>
            <div class="boot-log">
                @foreach (var s in _loadSteps)
                {
                    <span class="l @s.Cls"><span class="p">&gt;</span> @s.Label <span class="boot-status">@s.Status</span></span>
                }
            </div>
            <p class="boot-note">This download is the whole trick. Once it finishes, the model lives in this tab's
                own memory — there is no server behind Prism from here on, no API to call. Every character it
                generates below is computed by your device, not ours.</p>
        </div>
    }
    else
    {
        <div class="cr-stats">
            <div class="stat"><div class="n">@_stats!.ParamCount.ToString("N0")</div><div class="l">real stored parameters</div></div>
            <div class="stat"><div class="n">@_stats.EquivCompute.ToString("N0")</div><div class="l">dense-transformer-equivalent compute / token</div></div>
            <div class="stat"><div class="n">@(_stats.ComputePerStoredParam.ToString("F0"))×</div><div class="l">compute bought per stored parameter</div></div>
            <div class="stat"><div class="n">@_stats.Context</div><div class="l">tokens of context</div></div>
        </div>
        <div class="badges or-shape">
            <span>d=@_stats.Dim</span><span>@_stats.Layers layer(s)</span><span>K=@_k pass(es)</span>
            <span>shifts=@_stats.Shifts@(_stats.Golden ? " golden" : "")</span>
            <span>vocab=@_stats.Vocab subwords</span>@if (_rounds is not null) { <span>@_rounds.Value.ToString("N0") rounds trained</span> }
        </div>

        <div class="or-runs">
            <div class="or-run-list">
                @if (_history.Count == 0)
                {
                    <p class="hint">Type the start of a sentence — a word or two — and hit Continue. Each run starts
                        fresh from only what's in the box; the context window above is small on purpose, and this
                        checkpoint is early in training. No chat memory: nothing you typed in a previous run carries
                        into the next one. Don't take our word for it that this is local: open your browser's dev
                        tools, switch to the Network tab, then hit Continue — no new request fires. The checkpoint
                        you already downloaded above is doing all the work, on your own CPU.</p>
                }
                @foreach (var run in _history)
                {
                    <div class="or-run">
                        <span class="or-prompt">@run.Prompt</span><span class="or-cont">@run.Continuation</span>
                        @if (run.TrailedOff) { <span class="or-note">⋯ settled into a repeat loop (a known behaviour this early in training, not a bug)</span> }
                    </div>
                }
                @if (_generating) { <div class="or-run pending"><span class="or-prompt">@_pendingPrompt</span><span class="or-cont">@_pendingContinuation<span class="car" aria-hidden="true"></span></span></div> }
            </div>
            <div class="or-input-row">
                <input class="or-input" @bind="_prompt" @bind:event="oninput" @onkeydown="OnKeyDown" disabled="@_generating"
                       placeholder="start typing a sentence…" maxlength="60" />
                <button class="go" @onclick="Ask" disabled="@(_generating || string.IsNullOrWhiteSpace(_prompt))">
                    @(_generating ? "continuing…" : "Continue")
                </button>
            </div>
        </div>

        @if (_error is not null) { <p class="err">@_error</p> }

        <div class="outro">
            <p><strong>What's actually happening when you hit Continue.</strong> Every prompt becomes a handful of subword
                tokens, each bound into the model's holographic memory as a phase-and-magnitude pattern — a chord, not a
                row in a lookup table. None of this touches a server: tokenizing, binding and reading the resonance
                back out all run as plain C# in this browser tab, on your own CPU. Reading a prediction back out is an act of <em>resonance</em>: which stored
                pattern rings loudest against the current context. A conventional transformer buys depth by stacking
                many physically distinct, separately-trained layers. This model buys depth differently: it re-runs
                the <em>same small transformation</em> over its own output, weight-tied, K times in a row. Each pass
                doesn't add new information so much as let the pattern interfere with itself again — building up
                harmonics, sharpening whichever resonance was already strongest, the way plucking a string
                at the right moment reinforces its own overtones instead of damping them. It's a real nonlinear
                dynamical system iterating on its own state, not a deeper stack of unique weights — which is exactly
                why the parameter count above is worth reading twice: <code>@_stats!.ParamCount.ToString("N0")</code>
                real numbers, reused <code>@_k</code>× per layer, computing LIKE a real dense transformer would
                need <code>@_stats.EquivCompute.ToString("N0")</code> parameters to match — a <strong>compute-equivalence</strong>
                figure (12·d²·L·K, the standard way to compare a weight-tied model's iterated compute against an
                equivalent dense transformer), not a claim that this checkpoint secretly has that many real
                parameters stored anywhere.</p>

            <p><strong>Where this checkpoint stands, and where it's headed.</strong> Right now: @_stats.ParamCount.ToString("N0")
                real stored parameters, a @_stats.Vocab-token subword vocabulary, and an @_stats.Context-token context
                window — an honest, early snapshot of an ongoing training run, not a finished product.
                <strong>Next rung:</strong> GPT-2 small (OpenAI, 2019) — 124,000,000 real dense parameters, the smallest
                of the original public GPT-2 releases and the field's most commonly-cited "smallest real language
                model" reference point. That's the next milestone on the dense-equivalent-compute axis: grow context,
                vocabulary and resonance depth until this checkpoint's own compute budget clears that line, while its
                real stored-parameter count stays a small fraction of it. <strong>Further out:</strong> GPT-2 medium
                (355M) and large (774M) sit beyond that as the next horizons. None of this is a promise the model will
                write like GPT-2 once the compute number clears a line — compute budget and capability are not the
                same thing — it's just an honest way to watch a real number move over time.</p>

            <p><strong>Being honest about it.</strong> This is <strong>raw text continuation, not dialogue</strong> —
                this checkpoint was trained on plain text, never on turns, roles or "who's speaking," so it has no
                mechanism for understanding a conversation, and this REPL doesn't fake one: each run is one prompt in,
                one continuation out, with nothing from an earlier run fed back in. This checkpoint's vocabulary and
                context window are both still small — expect short, rough, sometimes broken continuations, and don't
                be surprised if one trails into a repeated character: the confidence gate above can read GREEDY even
                once the model has settled into a loop, a known, real behaviour this early in training (a run like
                that is labelled <em>settled into a repeat loop</em> above, rather than hiding it). It's a frozen copy from one point in
                an ongoing training run, not a live link to it — the real model keeps training after
                this snapshot was taken. It always runs at <strong>K=@_k weight-tied pass(es)</strong> — the model's
                one real trained depth (α=@(_trainedAlpha.ToString("0.00")), @KFactDetail). That's not a knob you can
                move here: K isn't a parameter to explore, it's a structural fact about this checkpoint.</p>

            <p>The brain is <code>AlgFormer</code>'s holographic transformer — the same substrate behind
                <a href="/creature">The Creature</a> and <a href="/forecaster">The Forecaster</a>, and the one that lets
                <a href="/analyst">The Analyst</a>'s database hold a running total as a single vector. Pure managed
                .NET, running entirely client-side. <code>dotnet add package EvaluatedApplications.AlgFormer</code></p>
        </div>
    }
</div>

@code {
    // ---- decode policy — ported onto HoloKernel's DecodePolicy 2026-08-28 (was 4 local consts + a hand-rolled
    // GateInfo/PickToken pair; DecodePolicy.Default carries the exact same thresholds, ported verbatim from
    // PrismStudio's HoloEngine originally, so these numbers are unchanged, just centralised now).
    static readonly DecodePolicy Policy = DecodePolicy.Default;   // ConfidentThreshold=0.60, Temperature=0.80, FloorK=3.0, DegenRepeat=4
    const int MaxReplyChars = 40;   // a runaway guard — this checkpoint's context is tiny, long continuations aren't meaningful yet

    HoloSession? _session;
    ModelStats? _stats;
    SubwordVocab? _vocab;   // published PrismFormer.SubwordVocab — replaces this file's own hand-rolled greedy-
                             // longest-match tokenizer (2026-08-28, verified safe against MonoRepo\AlgFormer\
                             // SubwordVocab.cs before swapping, not assumed): CharN=>CharVocab.N=96 already treats
                             // id 95 (CharVocab.End) as "\n" internally (Symbol(95)=="\n"), matching this file's
                             // OWN "id 95 is both newline and the stop marker" quirk exactly — the ctor takes ONLY
                             // the merges list (2-4 char strings), NOT the base chars (those are handled inside
                             // the class), and Encode() folds non-printable input to space internally too, same
                             // as this file's old Normalize() did by hand. Confirmed byte-for-byte equivalent
                             // greedy-longest-match semantics, not just "close enough."
    bool _loaded; string? _loadError; string? _error;
    long? _rounds;   // optional: only shown if data/oracle-rounds.txt was published alongside the checkpoint

    // ---- real per-file boot log for the checkpoint fetch (2026-08-28) — reuses the SAME .boot-crt/.boot-log/.l/.p
    // classes as the app-shell's own boot screen (wwwroot/css/boot.css, linked globally in index.html, so a
    // Razor component can use those classes directly without duplicating any CSS). Every line/status below is a
    // REAL fetch of a REAL file that already had to happen — this narrates it, it doesn't add a single extra
    // request or delay anything (Finish() only ever runs after the awaited fetch it's reporting on completes).
    sealed class LoadStep { public string Label = ""; public string Status = "fetching…"; public string Cls = ""; }
    readonly List<LoadStep> _loadSteps = new();
    LoadStep Begin(string label) { var s = new LoadStep { Label = label }; _loadSteps.Add(s); StateHasChanged(); return s; }
    void Finish(LoadStep s, string status, string cls = "core") { s.Status = status; s.Cls = cls; StateHasChanged(); }

    // ---- REAL trained depth — K is NOT a visitor-adjustable knob (fixed 2026-08-28, twice: first to default to
    // the real value, then the user caught that a slider shouldn't exist at all — "k is not a parameter, its
    // fixed to the model count"). The .bin file itself doesn't persist Iters/IterAlphaServe (verified by round-
    // tripping Serialize()/Deserialize() against the real checkpoint), so its own on-disk value reads back a
    // meaningless K=1 — `_k` is set ONCE at load from the real trained depth and never changes after. Sourced
    // live from `oracle-stackk.txt`/`oracle-iterwarm.txt` (same hand-off pattern as `oracle-rounds.txt`) carrying
    // PrismStudio's live `OneShotStackK`/`OneShotIterWarm` AT THE MOMENT this checkpoint snapshot was taken —
    // never hardcoded here, since both are the user's own live-hand-edited training knobs and change between
    // snapshots (verified live 2026-08-28: StackK=8, IterWarm=20000 — re-check `HoloEngine.cs` again before ever
    // hand-editing these files).
    int? _trainedStackK;
    int? _trainedIterWarm;
    double _trainedAlpha = 1.0;   // reconstructed below via HoloKernel's AlphaRamp.Reconstruct (the SAME formula
    // HoloEngine.AlphaFor uses) — a mid-ramp snapshot deserves a mid-ramp alpha, not a flat 1.0 guess (that would
    // ALSO misrepresent it, just in the opposite direction). Only valid for a single-layer checkpoint (layer 0's
    // real add-round is 0 by construction — it's present from round 0); falls back to 1.0 (fully composed) if the
    // checkpoint ever ships with >1 layer, or if either metadata file is missing. ALWAYS served (no "what if"
    // branch — K is fixed, so there's only ever the one real alpha to serve at); passed to HoloSession.
    // FromCheckpoint as a MANDATORY argument (the kernel enforces this by construction — see field comment above).

    int _k = 1;   // the model's one real trained depth — set once at load, never mutated (no slider, see field comments above)
    bool _generating;
    string _prompt = "";
    string _pendingPrompt = "";   // shown in the "in progress" run while _generating — the prompt is cleared from the input immediately
    string _pendingContinuation = "";   // streamed live, re-decoded after every emitted token while _generating —
    // this is what makes generation render as a typewriter: the markup binds to THIS field, so the per-character
    // StateHasChanged() call in the loop below actually has new text to paint (before this field existed, the
    // pending run showed a static "…" placeholder the whole time, so those per-character renders painted nothing new).
    // one entry per submission. Each run is INDEPENDENT — no prior run's prompt/continuation is ever fed back into the
    // next one's context, so there is no accumulated "chat history"; this is autocomplete, not dialogue memory.
    sealed record RunEntry(string Prompt, string Continuation, bool TrailedOff);
    readonly List<RunEntry> _history = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var s = Begin("data/oracle-vocab.txt");
            var vocabBytes = await Http.GetByteArrayAsync("data/oracle-vocab.txt");
            var merges = Encoding.UTF8.GetString(vocabBytes).Replace("\r\n", "\n").Split('\n').Where(l => l.Length > 0).ToList();
            _vocab = new SubwordVocab(merges);   // throws (caught below, degrades to _loadError) on a malformed merge line
            Finish(s, $"{vocabBytes.Length:N0} B → {_vocab.Size:N0}-symbol vocab");

            // Metadata sidecars fetched BEFORE the checkpoint bytes now (was after) — they're tiny and are
            // needed to compute K/alpha, which the SessionHost factory below needs up front (it only ever
            // runs once per model key, so it can't come back later to ask for them).
            s = Begin("data/oracle-rounds.txt");
            try { _rounds = long.Parse((await Http.GetStringAsync("data/oracle-rounds.txt")).Trim()); Finish(s, $"{_rounds:N0} rounds trained"); }
            catch { Finish(s, "not shipped (optional)", "fail"); _rounds = null; }

            s = Begin("data/oracle-stackk.txt");
            try { _trainedStackK = int.Parse((await Http.GetStringAsync("data/oracle-stackk.txt")).Trim()); Finish(s, $"K={_trainedStackK}"); }
            catch { Finish(s, "not shipped (optional)", "fail"); _trainedStackK = null; }

            s = Begin("data/oracle-iterwarm.txt");
            try { _trainedIterWarm = int.Parse((await Http.GetStringAsync("data/oracle-iterwarm.txt")).Trim()); Finish(s, $"{_trainedIterWarm:N0}-round ramp"); }
            catch { Finish(s, "not shipped (optional)", "fail"); _trainedIterWarm = null; }

            // fixed to the REAL trained depth (falls back to the file's bare K=1 only if the metadata sidecar is
            // missing) — never adjusted after this; see the field comments above for why.
            _k = _trainedStackK ?? 1;

            // SessionHost dedupes by MODEL key ("prism"): the FIRST visit to this page in a page load fetches
            // + deserializes the ~2.9 MB checkpoint exactly as before. A LATER visit reuses that same in-memory
            // HoloSession instead of re-downloading/re-parsing it — the factory below (and its boot-log step)
            // simply never runs a second time.
            bool reused = Sessions.IsLoaded("prism");
            _session = await Sessions.GetOrCreateAsync("prism", async () =>
            {
                var sb = Begin("data/oracle-brain.bin");
                var bytes = await Http.GetByteArrayAsync("data/oracle-brain.bin");
                var peek = HoloFormer.Deserialize(bytes);   // one-time peek at Layers/ParamCount for the boot log +
                // the alpha-reconstruction guard below — HoloSession.FromCheckpoint needs K/alpha as ctor args
                // (see field comment above), which in turn need Layers, so this has to happen before the session
                // can be built.
                Finish(sb, $"{bytes.Length:N0} B → {peek.ParamCount:N0} params deserialized");
                var alpha = (peek.Layers == 1 && _rounds is not null && _trainedIterWarm is > 0)
                    ? AlphaRamp.Reconstruct(_rounds.Value, addRound: 0, _trainedIterWarm.Value)
                    : 1.0;
                // HoloSession.FromCheckpoint requires K/alpha as explicit ctor args — the kernel enforces the
                // "checkpoint doesn't carry them" gotcha by construction rather than a footnote (see field comment).
                return HoloSession.FromCheckpoint(bytes, _k, alpha);
            });
            if (reused) Finish(Begin("data/oracle-brain.bin"), "reused from earlier this visit (no re-download)");
            _stats = _session.Stats();
            // Recomputed from the session actually in hand (not the factory's local "peek"/"alpha", which don't
            // exist on the reused-cache path) — same formula, so identical on a first-ever visit either way.
            _trainedAlpha = (_stats.Layers == 1 && _rounds is not null && _trainedIterWarm is > 0)
                ? AlphaRamp.Reconstruct(_rounds.Value, addRound: 0, _trainedIterWarm.Value)
                : 1.0;

            // Throwaway COMPUTE warm-up pass (2026-08-28) — pays WASM's cold-start cost (interpreter/
            // type-loading overhead on the FIRST call through a given hot path — Blazor WASM has no
            // AOT here, so the very first LogitsFor call is measurably slower than every call after
            // it) while the boot screen is still up, not during the visitor's first real Continue
            // click. Purely internal: never touches _history/_pendingContinuation/_prompt, discards
            // its result, and must not be able to fail page load — a warm-up miss just means the
            // FIRST real generation pays the cold-start cost again, exactly like before this fix
            // existed, not a broken page. Deliberately synchronous/on the UI thread: the boot screen
            // is already narrating real work, so a few extra ms before it flips to the REPL is
            // honest, not hidden — and it's the only way to guarantee the cost lands before the
            // visitor can click Continue (a fire-and-forget background warm-up could still lose the
            // race against a fast typist).
            //
            // SHARPENED 2026-08-28 (user's own sharper repro): the FIRST click's PROMPT ECHO
            // (`_pendingPrompt` — pure markup, no inference at all) also failed to render on its own,
            // appearing together with the whole continuation instead of first. A compute-only warm-up
            // can't explain or fix that — it never touches the render path. Real culprit is very
            // likely the RENDER side: `.or-run.pending`'s markup (the `_generating==true` branch of
            // this component's generated `BuildRenderTree`) is nested inside the `!_loaded` check's
            // `else` branch, so it is NEVER exercised by anything during the boot screen — the boot
            // log's own `Begin`/`Finish` StateHasChanged() calls only ever interpret the `!_loaded`
            // branch. The very FIRST time that particular conditional branch's IL runs, on an
            // interpreted (no-AOT) WASM runtime, is therefore a visitor's first real Continue click —
            // exactly the kind of one-time cost the compute warm-up above exists to avoid, just on
            // the render side instead. So: warm BOTH. The render warm-up below must run AFTER
            // `_loaded = true` (that conditional is what selects the branch containing `.or-run.pending`
            // at all) and flips `_generating` true then immediately back to false with no `await`
            // between the two StateHasChanged() calls, so nothing actually paints in between — no
            // visible flicker, purely paying the interpreter's first-execution cost during boot.
            try
            {
                var warmCtx = _vocab.Encode("the");
                if (warmCtx.Length == 0) warmCtx = new[] { 0 };
                _ = _session.Logits(warmCtx);
            }
            catch { /* warm-up only — never user-visible, never blocks page load either way */ }

            _loaded = true;

            try
            {
                _generating = true; _pendingPrompt = "warm"; _pendingContinuation = "up";
                StateHasChanged();
                // StateHasChanged() only SCHEDULES a render — without actually yielding back to the
                // browser, Blazor batches it with whatever runs next and only paints the LATEST state.
                // The original version of this warm-up reverted _generating in the very next line with
                // no yield in between, so the scheduled render was still pending when it got overwritten
                // — Blazor never built/diffed the .or-run.pending branch at all, and the warm-up was a
                // silent no-op (confirmed live: the user still saw the cold-start stutter after it
                // shipped). A real yield here (Task.Delay, not Task.Yield — WASM's message pump needs an
                // actual round trip through the browser event loop to flush a pending render) forces
                // that render to really happen during boot.
                await Task.Delay(1);
            }
            catch { /* warm-up only — never user-visible, never blocks page load either way */ }
            finally { _generating = false; _pendingPrompt = ""; _pendingContinuation = ""; }
        }
        catch (Exception ex) { _loadError = "Couldn't load the checkpoint: " + ex.Message; }
    }

    // K has no UI control anymore — this is purely the explanatory ramp detail for the outro copy's fact
    // statement (no "exploring"/"what if" branch needed, since there's nothing to explore away from).
    string KFactDetail
    {
        get
        {
            if (_trainedStackK is null) return "depth metadata wasn't shipped with this build, so K falls back to the bare checkpoint file's own K=1";
            var ramp = _stats is not null && _stats.Layers == 1 && _trainedIterWarm is > 0 && _rounds is not null
                ? (_rounds.Value >= _trainedIterWarm.Value
                    ? $"ramp fully complete (finished {_trainedIterWarm:N0} rounds in)"
                    : $"reconstructed from {_rounds:N0} of {_trainedIterWarm:N0} ramp rounds trained — still ramping in")
                : "fully composed";
            return ramp;
        }
    }

    async Task OnKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await Ask(); }

    // Producer/consumer split (2026-08-28, direct instruction) — replaces the old single loop that
    // had `await Task.Delay(60)` sitting INSIDE the generation loop, artificially throttling REAL
    // compute to typing speed. Now: the producer runs the actual LogitsFor/Gate.Pick generation loop
    // as fast as it actually computes, no delay anywhere in it; the consumer reveals exactly one
    // token per ~60ms tick, completely decoupled from how fast the producer produced them. WASM is
    // single-threaded, so these two loops don't literally run in parallel — but that's fine and not
    // the point: the point is that generation is no longer SERIALIZED behind the reveal cadence. If
    // compute finishes 40 tokens in 5ms, they queue up in the channel and the consumer still reveals
    // them one at a time, steadily, over the next ~2.4s; if compute is ever slower than the cadence
    // (shouldn't happen locally, but the channel makes it safe either way), the consumer's
    // `ReadAllAsync` just waits for the next token instead of showing nothing.
    async Task Ask()
    {
        if (_session is null || _vocab is null || string.IsNullOrWhiteSpace(_prompt) || _generating) return;
        var promptText = _prompt.Trim();
        _prompt = "";
        _pendingPrompt = promptText;
        _pendingContinuation = "";
        _generating = true; _error = null;
        StateHasChanged();

        try
        {
            var outIds = new List<int>();
            var trailedOff = false;
            Exception? producerError = null;
            // unbounded, single writer (the producer below)/single reader (the consumer below) — the
            // simplest correct primitive for "one loop feeds another, same tab, no real parallelism".
            var channel = Channel.CreateUnbounded<int>(new UnboundedChannelOptions { SingleReader = true, SingleWriter = true });

            // ---- producer: fresh context every run (seeded ONLY from this submission's own tokens —
            // nothing from a prior run's prompt/continuation ever gets folded in, so there's no
            // cross-run "memory" to leak — autocomplete, not chat). Runs the real LogitsFor/Gate.Pick
            // loop with NO artificial delay; pushes each produced token onto the channel the instant
            // it's computed. DegenGuard/trailedOff/MaxReplyChars cap logic all unchanged from before.
            async Task ProduceAsync()
            {
                try
                {
                    var seq = new List<int>(_vocab.Encode(promptText));
                    var vocabLimit = _vocab.Size;
                    var guard = new DegenGuard(Policy);   // HoloKernel port of HoloEngine's ProbeDegenRepeat=4 —
                    // a known behaviour this early in training (the confidence gate still reads GREEDY on a
                    // collapsed distribution), surfaced honestly rather than silently padded with spaces

                    for (var step = 0; step < MaxReplyChars; step++)
                    {
                        var take = Math.Min(seq.Count, _stats!.Context);
                        var ctx = take > 0 ? seq.Skip(seq.Count - take).ToArray() : new[] { 0 };

                        // lean serving path — a single LogitsFor pass, honouring Iters/K exactly like the
                        // full-recompute Inspector path did (removed 2026-08-28, see Showroom\CLAUDE.md).
                        var logits = _session.Logits(ctx);
                        var t = Gate.Pick(logits, vocabLimit, Policy, Random.Shared);

                        if (t == CharVocab.End) break;   // stop marker — see tokenizer field comment for why this id doubles as "\n"
                        outIds.Add(t); seq.Add(t);
                        await channel.Writer.WriteAsync(t);   // instant on an unbounded channel — not a throttle
                        if (guard.Observe(t)) { trailedOff = true; break; }
                    }
                }
                catch (Exception ex) { producerError = ex; }
                finally { channel.Writer.Complete(); }
            }
            var producerTask = ProduceAsync();

            // ---- consumer: steady ~60ms/token reveal cadence, decoupled from actual compute speed.
            // Paced to read as roughly human TYPING speed, not a network-latency simulation and not an
            // instant dump — the point is watching a locally-computed feed land character by
            // character, so it should feel like someone typing it, not a fast machine reveal.
            var revealed = new List<int>();
            await foreach (var t in channel.Reader.ReadAllAsync())
            {
                revealed.Add(t);
                // NOT trimmed — trimming mid-stream would make trailing spaces flicker in and out as
                // later characters land; the final decode below trims once.
                _pendingContinuation = _vocab.Decode(revealed);
                StateHasChanged();
                await Task.Delay(60);
            }

            await producerTask;
            if (producerError is not null) throw producerError;

            var shown = _vocab.Decode(outIds).TrimEnd();
            var continuationText = shown.Length > 0 ? shown : "(blank — this checkpoint is still very early in training)";
            _history.Add(new RunEntry(promptText, continuationText, trailedOff));
        }
        catch (Exception ex) { _error = "Prism stumbled: " + ex.Message; }
        finally { _generating = false; _pendingContinuation = ""; StateHasChanged(); }
    }
}
