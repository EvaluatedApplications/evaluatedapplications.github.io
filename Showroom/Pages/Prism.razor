@page "/prism"
@inject HttpClient Http
@inject HoloKernel.SessionHost Sessions
@using System.Text
@using PrismFormer
@using HoloKernel

<PageTitle>Prism — autocomplete with a live holographic-transformer checkpoint</PageTitle>

<div class="room" data-cat="algformer">
    <header class="room-head">
        <nav class="crumb"><a href="/">Evaluated Applications</a> <span>/</span> Prism</nav>
        <h1>Prism</h1>
        <p class="lede">A real, trained <strong>HoloFormer</strong> checkpoint, downloaded once and run entirely in
            this browser tab — nothing you type ever leaves this page. This is a <strong>technical demo, not a
            finished product</strong>: what's deployed here is just the last checkpoint we bothered to push, to see
            how training is going, not a curated "best" result — its behaviour will shift as the real model keeps
            changing underneath it.</p>
        <div class="badges">
            <span>Runs on your device, not our servers</span><span>Real trained checkpoint</span><span>Holographic-transformer brain</span>
        </div>
    </header>

    @if (_loadError is not null)
    {
        <p class="err">@_loadError</p>
        <p class="hint">This tool runs off a snapshot of an ongoing training run, taken at one point in time —
            if the checkpoint files aren't available right now, please check back later.</p>
    }
    else if (!_loaded)
    {
        <div class="boot-crt ck-boot">
            <div class="boot-head"><span class="boot-dot" aria-hidden="true"></span>fetching the trained checkpoint</div>
            <div class="boot-sub">real files, downloading once to THIS device — cached by your browser after the first visit.</div>
            <div class="boot-log">
                @foreach (var s in _loadSteps)
                {
                    <span class="l @s.Cls"><span class="p">&gt;</span> @s.Label <span class="boot-status">@s.Status</span></span>
                }
            </div>
            <p class="boot-note">This download is the whole trick. Once it finishes, the model lives in this tab's
                own memory — there is no server behind Prism from here on, no API to call. Every character it
                generates below is computed by your device, not ours.</p>
        </div>
    }
    else
    {
        <div class="cr-stats">
            <div class="stat"><div class="n">@_stats!.ParamCount.ToString("N0")</div><div class="l">real stored parameters</div></div>
            <div class="stat"><div class="n">@_stats.EquivCompute.ToString("N0")</div><div class="l">dense-transformer-equivalent compute / token</div></div>
            <div class="stat"><div class="n">@(_stats.ComputePerStoredParam.ToString("F0"))×</div><div class="l">compute bought per stored parameter</div></div>
            <div class="stat"><div class="n">@_stats.Context</div><div class="l">tokens of context</div></div>
        </div>
        <div class="badges or-shape">
            <span>d=@_stats.Dim</span><span>@_stats.Layers layer(s)</span><span>K=@_k pass(es)</span>
            <span>shifts=@_stats.Shifts@(_stats.Golden ? " golden" : "")</span>
            <span>vocab=@_stats.Vocab subwords</span>@if (_rounds is not null) { <span>@_rounds.Value.ToString("N0") rounds trained</span> }
        </div>

        <div class="or-runs">
            <div class="or-run-list">
                @if (_history.Count == 0)
                {
                    <p class="hint">Type the start of a sentence — a word or two — and hit Continue. Each run starts
                        fresh from only what's in the box; the context window above is small on purpose, and this
                        checkpoint is early in training. No chat memory: nothing you typed in a previous run carries
                        into the next one. Don't take our word for it that this is local: open your browser's dev
                        tools, switch to the Network tab, then hit Continue — no new request fires. The checkpoint
                        you already downloaded above is doing all the work, on your own CPU.</p>
                }
                @foreach (var run in _history)
                {
                    <div class="or-run">
                        <span class="or-prompt">@run.Prompt</span><span class="or-cont">@run.Continuation</span>
                        @if (run.TrailedOff) { <span class="or-note">⋯ settled into a repeat loop (a known behaviour this early in training, not a bug)</span> }
                    </div>
                }
                @if (_generating) { <div class="or-run pending"><span class="or-prompt">@_pendingPrompt</span><span class="or-cont">@_pendingContinuation<span class="car" aria-hidden="true"></span></span></div> }
            </div>
            <div class="or-input-row">
                <input class="or-input" @bind="_prompt" @bind:event="oninput" @onkeydown="OnKeyDown" disabled="@_generating"
                       placeholder="Hello!" maxlength="60" />
                <button class="go" @onclick="Ask" disabled="@(_generating || string.IsNullOrWhiteSpace(_prompt))">
                    @(_generating ? "continuing…" : "Continue")
                </button>
            </div>
        </div>

        @if (_error is not null) { <p class="err">@_error</p> }

        <div class="outro">
            <p><strong>What's happening when you hit Continue.</strong> Each prompt is bound into the model's
                holographic memory as phase-and-magnitude patterns, then read back out by <em>resonance</em> — which
                stored pattern rings loudest against the current context. Depth here isn't stacked layers: it's the
                same small transformation re-run <strong>K=@_k</strong> times over its own output, weight-tied,
                letting the pattern reinforce itself before a token is picked. All of it — tokenizing, binding,
                resonance — runs as plain C# in this tab, on your own CPU.</p>

            <p><strong>Where it stands, plainly.</strong> This is <strong>raw text continuation, not a chatbot</strong>:
                trained on plain text with no notion of turns or "who's speaking," so every run starts fresh with
                nothing carried over from an earlier one. Right now: @_stats!.ParamCount.ToString("N0") real stored
                parameters, a @_stats.Vocab-token vocabulary, @_stats.Context tokens of context — early in an
                ongoing training run, not a finished result. Expect short, rough continuations: real words and
                near-grammatical fragments next to invented non-words, occasionally trailing into a repeated
                character (flagged above as <em>settled into a repeat loop</em>, not hidden).</p>

            <p>The brain is <code>AlgFormer</code>'s holographic transformer — the same substrate behind
                <a href="/creature">The Creature</a> and <a href="/forecaster">The Forecaster</a>. Pure managed
                .NET, running entirely client-side. <code>dotnet add package EvaluatedApplications.AlgFormer</code></p>
        </div>
    }
</div>

@code {
    // ---- decode policy — ported onto HoloKernel's DecodePolicy 2026-08-28 (was 4 local consts + a hand-rolled
    // GateInfo/PickToken pair; DecodePolicy.Default carries the exact same thresholds, ported verbatim from
    // PrismStudio's HoloEngine originally, so these numbers are unchanged, just centralised now).
    static readonly DecodePolicy Policy = DecodePolicy.Default;   // ConfidentThreshold=0.60, Temperature=0.80, FloorK=3.0, DegenRepeat=4
    // The real stop condition is CharVocab.End (the model's own stop token) or DegenGuard catching a
    // collapsed repeat run — those are unchanged and still fire first when they fire at all.
    //
    // SUPERSEDES the 2026-08-30 instruction below (kept for the record, no longer the live policy):
    // "let it run until it actually stops, don't truncate mid-thought." That was a flat 600-char cap
    // totally decoupled from the model's real context window (`_stats.Context` — 32 tokens on the
    // live checkpoint as of this change). `BuildContext(seq, _stats.Context)` already trims the
    // model's INPUT to only its last `Context` tokens every step — nothing capped how many NEW
    // tokens got generated, so a run could wander up to ~18x past the one window the model can
    // actually see at once, with everything before that window structurally invisible to it. Direct
    // instruction (2026-09-04): "clip the prism output to its context length. So it doesn't ramble
    // on" — ties directly to a separately-verified finding the same day that raw autoregressive
    // generation gets visibly more garbled the further it runs past its trained context.
    // Cap is now read LIVE off the loaded checkpoint's own context window, not hardcoded. Widened
    // 2026-09-04 (direct instruction) from a 1x multiple to a 2x multiple of the model's real context
    // window: at 1x, generation stopped the instant the ENTIRE window BuildContext feeds back into the
    // model was something it wrote itself — a real anchor point, but tighter than needed. 2x still ties
    // the cap to the model's own real context window rather than an arbitrary constant (the old flat 600
    // let a run wander ~18x past the one window the model can actually see, which is the problem this
    // whole live-read mechanism exists to avoid) — it just allows one extra full window's worth of
    // unanchored drift past that point before the outer backstop cuts in, instead of zero.
    int MaxReplyChars => (_stats?.Context ?? 32) * 2;

    HoloSession? _session;
    ModelStats? _stats;
    SubwordVocab? _vocab;   // published PrismFormer.SubwordVocab — replaces this file's own hand-rolled greedy-
                             // longest-match tokenizer (2026-08-28, verified safe against MonoRepo\AlgFormer\
                             // SubwordVocab.cs before swapping, not assumed): CharN=>CharVocab.N=96 already treats
                             // id 95 (CharVocab.End) as "\n" internally (Symbol(95)=="\n"), matching this file's
                             // OWN "id 95 is both newline and the stop marker" quirk exactly — the ctor takes ONLY
                             // the merges list (2-4 char strings), NOT the base chars (those are handled inside
                             // the class), and Encode() folds non-printable input to space internally too, same
                             // as this file's old Normalize() did by hand. Confirmed byte-for-byte equivalent
                             // greedy-longest-match semantics, not just "close enough."
    bool _loaded; string? _loadError; string? _error;
    long? _rounds;   // optional: only shown if data/oracle-rounds.txt was published alongside the checkpoint

    // ---- real per-file boot log for the checkpoint fetch (2026-08-28) — reuses the SAME .boot-crt/.boot-log/.l/.p
    // classes as the app-shell's own boot screen (wwwroot/css/boot.css, linked globally in index.html, so a
    // Razor component can use those classes directly without duplicating any CSS). Every line/status below is a
    // REAL fetch of a REAL file that already had to happen — this narrates it, it doesn't add a single extra
    // request or delay anything (Finish() only ever runs after the awaited fetch it's reporting on completes).
    sealed class LoadStep { public string Label = ""; public string Status = "fetching…"; public string Cls = ""; }
    readonly List<LoadStep> _loadSteps = new();
    LoadStep Begin(string label) { var s = new LoadStep { Label = label }; _loadSteps.Add(s); StateHasChanged(); return s; }
    void Finish(LoadStep s, string status, string cls = "core") { s.Status = status; s.Cls = cls; StateHasChanged(); }

    // ---- REAL trained depth — K is NOT a visitor-adjustable knob (fixed 2026-08-28, twice: first to default to
    // the real value, then the user caught that a slider shouldn't exist at all — "k is not a parameter, its
    // fixed to the model count"). The .bin file itself doesn't persist Iters/IterAlphaServe (verified by round-
    // tripping Serialize()/Deserialize() against the real checkpoint), so its own on-disk value reads back a
    // meaningless K=1 — `_k` is set ONCE at load from the real trained depth and never changes after. Sourced
    // live from `oracle-stackk.txt`/`oracle-iterwarm.txt` (same hand-off pattern as `oracle-rounds.txt`) carrying
    // PrismStudio's live `OneShotStackK`/`OneShotIterWarm` AT THE MOMENT this checkpoint snapshot was taken —
    // never hardcoded here, since both are the user's own live-hand-edited training knobs and change between
    // snapshots (verified live 2026-08-28: StackK=8, IterWarm=20000 — re-check `HoloEngine.cs` again before ever
    // hand-editing these files).
    int? _trainedStackK;
    int? _trainedIterWarm;
    double _trainedAlpha = 1.0;   // reconstructed below via HoloKernel's AlphaRamp.Reconstruct (the SAME formula
    // HoloEngine.AlphaFor uses) — a mid-ramp snapshot deserves a mid-ramp alpha, not a flat 1.0 guess (that would
    // ALSO misrepresent it, just in the opposite direction). Only valid for a single-layer checkpoint (layer 0's
    // real add-round is 0 by construction — it's present from round 0); falls back to 1.0 (fully composed) if the
    // checkpoint ever ships with >1 layer, or if either metadata file is missing. ALWAYS served (no "what if"
    // branch — K is fixed, so there's only ever the one real alpha to serve at); passed to HoloSession.
    // FromCheckpoint as a MANDATORY argument (the kernel enforces this by construction — see field comment above).

    int _k = 1;   // the model's one real trained depth — set once at load, never mutated (no slider, see field comments above)
    bool _generating;
    string _prompt = "";
    string _pendingPrompt = "";   // shown in the "in progress" run while _generating — the prompt is cleared from the input immediately
    string _pendingContinuation = "";   // streamed live, re-decoded after every emitted token while _generating —
    // this is what makes generation render as a typewriter: the markup binds to THIS field, so the per-character
    // StateHasChanged() call in the loop below actually has new text to paint (before this field existed, the
    // pending run showed a static "…" placeholder the whole time, so those per-character renders painted nothing new).
    // one entry per submission. Each run is INDEPENDENT — no prior run's prompt/continuation is ever fed back into the
    // next one's context, so there is no accumulated "chat history"; this is autocomplete, not dialogue memory.
    sealed record RunEntry(string Prompt, string Continuation, bool TrailedOff);
    // Capped 2026-08-30 (real Arg_OutOfMemoryException report, "after some period of use" — i.e. many
    // submissions in one session, not one giant submission). This list previously grew without bound for
    // the life of the page: every submission appended one more entry forever. Blazor rebuilds + diffs this
    // component's ENTIRE render tree on every StateHasChanged() call (there is no @key/virtualization here),
    // so an unbounded _history means the per-render diff cost itself grows across a session — combined with
    // the render-frequency fix in Ask() below (up to MaxReplyChars renders per submission — was a flat 600
    // at the time this comment was written, now the live checkpoint's own context length, see MaxReplyChars'
    // own field comment), this compounds: total render-diff work across a session was effectively unbounded
    // on both axes at once. Fixed with the same "drop oldest" spirit Creature's `_log`/`_curve` and
    // Forecaster's `_log`/`_accCurve` already use (see Showroom/CLAUDE.md) — HistoryCap is lower than those
    // (40 vs 200-250) because each entry here can hold up to MaxReplyChars chars of real text plus its own
    // DOM subtree, not a single short log line.
    const int HistoryCap = 40;
    readonly List<RunEntry> _history = new();
    void AddHistory(RunEntry entry) { _history.Add(entry); if (_history.Count > HistoryCap) _history.RemoveAt(0); }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var s = Begin("data/oracle-vocab.txt");
            var vocabBytes = await Http.GetByteArrayAsync("data/oracle-vocab.txt");
            var merges = Encoding.UTF8.GetString(vocabBytes).Replace("\r\n", "\n").Split('\n').Where(l => l.Length > 0).ToList();
            _vocab = new SubwordVocab(merges);   // throws (caught below, degrades to _loadError) on a malformed merge line
            Finish(s, $"{vocabBytes.Length:N0} B → {_vocab.Size:N0}-symbol vocab");

            // Metadata sidecars fetched BEFORE the checkpoint bytes now (was after) — they're tiny and are
            // needed to compute K/alpha, which the SessionHost factory below needs up front (it only ever
            // runs once per model key, so it can't come back later to ask for them).
            s = Begin("data/oracle-rounds.txt");
            try { _rounds = long.Parse((await Http.GetStringAsync("data/oracle-rounds.txt")).Trim()); Finish(s, $"{_rounds:N0} rounds trained"); }
            catch { Finish(s, "not shipped (optional)", "fail"); _rounds = null; }

            s = Begin("data/oracle-stackk.txt");
            try { _trainedStackK = int.Parse((await Http.GetStringAsync("data/oracle-stackk.txt")).Trim()); Finish(s, $"K={_trainedStackK}"); }
            catch { Finish(s, "not shipped (optional)", "fail"); _trainedStackK = null; }

            s = Begin("data/oracle-iterwarm.txt");
            try { _trainedIterWarm = int.Parse((await Http.GetStringAsync("data/oracle-iterwarm.txt")).Trim()); Finish(s, $"{_trainedIterWarm:N0}-round ramp"); }
            catch { Finish(s, "not shipped (optional)", "fail"); _trainedIterWarm = null; }

            // fixed to the REAL trained depth (falls back to the file's bare K=1 only if the metadata sidecar is
            // missing) — never adjusted after this; see the field comments above for why.
            _k = _trainedStackK ?? 1;

            // SessionHost dedupes by MODEL key ("prism"): the FIRST visit to this page in a page load fetches
            // + deserializes the ~2.9 MB checkpoint exactly as before. A LATER visit reuses that same in-memory
            // HoloSession instead of re-downloading/re-parsing it — the factory below (and its boot-log step)
            // simply never runs a second time.
            bool reused = Sessions.IsLoaded("prism");
            _session = await Sessions.GetOrCreateAsync("prism", async () =>
            {
                var sb = Begin("data/oracle-brain.bin.gz");
                // gzip-precompressed at rest (2026-08-31 — was a raw uncompressed fetch; the checkpoint keeps
                // growing every training round and a visitor reported it "stuck downloading"). GitHub Pages
                // serves this byte-for-byte with no Content-Encoding/on-the-fly compression, so shipping a
                // pre-gzipped sidecar + decompressing it here (HoloKernel.CheckpointFetch, see its own doc
                // comment) is the only way to actually shrink the transfer — decompression happens entirely
                // client-side, nothing about the fetched byte COUNT below misrepresents what crossed the wire.
                // Measured on the 2026-08-31 checkpoint: 3,638,308 B raw -> 1,985,514 B gzip (~55% of raw) —
                // real weight data doesn't compress as aggressively as text, but it's a real, meaningful cut.
                var (bytes, gzLen) = await CheckpointFetch.FetchAndDecompressGzipAsync(Http, "data/oracle-brain.bin.gz");
                var peek = HoloFormer.Deserialize(bytes);   // one-time peek at Layers/ParamCount for the boot log +
                // the alpha-reconstruction guard below — HoloSession.FromCheckpoint needs K/alpha as ctor args
                // (see field comment above), which in turn need Layers, so this has to happen before the session
                // can be built.
                Finish(sb, $"{gzLen:N0} B gzip → {bytes.Length:N0} B → {peek.ParamCount:N0} params deserialized");
                var alpha = (peek.Layers == 1 && _rounds is not null && _trainedIterWarm is > 0)
                    ? AlphaRamp.Reconstruct(_rounds.Value, addRound: 0, _trainedIterWarm.Value)
                    : 1.0;
                // HoloSession.FromCheckpoint requires K/alpha as explicit ctor args — the kernel enforces the
                // "checkpoint doesn't carry them" gotcha by construction rather than a footnote (see field comment).
                return HoloSession.FromCheckpoint(bytes, _k, alpha);
            });
            if (reused) Finish(Begin("data/oracle-brain.bin.gz"), "reused from earlier this visit (no re-download)");
            _stats = _session.Stats();
            // Recomputed from the session actually in hand (not the factory's local "peek"/"alpha", which don't
            // exist on the reused-cache path) — same formula, so identical on a first-ever visit either way.
            _trainedAlpha = (_stats.Layers == 1 && _rounds is not null && _trainedIterWarm is > 0)
                ? AlphaRamp.Reconstruct(_rounds.Value, addRound: 0, _trainedIterWarm.Value)
                : 1.0;

            // Real example round, seeded into _history BEFORE _loaded=true (2026-08-28) — REPLACES two
            // earlier attempts that both tried to pre-pay WASM's cold-start cost (no AOT here, so the
            // first real invocation of a given code path — compute OR render — is measurably slower
            // than every call after it) without keeping anything: a throwaway compute-only LogitsFor
            // call, then a synthetic _generating-flip render warm-up. Both were fragile — the render
            // warm-up in particular depended on catching Blazor's render batching at exactly the right
            // moment, and even after fixing a missing-yield bug it still didn't reliably work live
            // (confirmed by the user). This is simpler and more robust: run one REAL generation now,
            // against a fixed example prompt, and KEEP the result as _history's first entry — a
            // permanent piece of UI state that renders through the component's completely ordinary
            // initial render (the same `.or-run` markup a real user round uses), no special timing
            // tricks needed. It pays the LogitsFor/render cold-start cost as a side effect of doing
            // real work, and unlike a hardcoded placeholder string, it stays honest with this site's
            // "no mocked output" rule — what a visitor sees on load really did come out of the model,
            // just one page-load earlier than their own first click.
            try
            {
                const string examplePrompt = "Hello!";
                var seq = new List<int>(_vocab.Encode(examplePrompt));
                var outIds = new List<int>();
                var vocabLimit = _vocab.Size;
                var guard = new DegenGuard(Policy);
                var trailedOff = false;
                for (var step = 0; step < MaxReplyChars; step++)
                {
                    var ctx = BuildContext(seq, _stats.Context);
                    var logits = _session.Logits(ctx);
                    var t = Gate.Pick(logits, vocabLimit, Policy, Random.Shared);
                    if (t == CharVocab.End) break;
                    outIds.Add(t); seq.Add(t);
                    if (guard.Observe(t)) { trailedOff = true; break; }
                }
                var shown = _vocab.Decode(outIds).TrimEnd();
                var continuationText = shown.Length > 0 ? shown : "(blank — this checkpoint is still very early in training)";
                AddHistory(new RunEntry(examplePrompt, continuationText, trailedOff));
            }
            catch { /* example generation only — never user-visible as an error, never blocks page load */ }

            _loaded = true;
        }
        catch (Exception ex) { _loadError = "Couldn't load the checkpoint: " + ex.Message; }
    }

    // K has no UI control anymore — this is purely the explanatory ramp detail for the outro copy's fact
    // statement (no "exploring"/"what if" branch needed, since there's nothing to explore away from).
    string KFactDetail
    {
        get
        {
            if (_trainedStackK is null) return "depth metadata wasn't shipped with this build, so K falls back to the bare checkpoint file's own K=1";
            var ramp = _stats is not null && _stats.Layers == 1 && _trainedIterWarm is > 0 && _rounds is not null
                ? (_rounds.Value >= _trainedIterWarm.Value
                    ? $"ramp fully complete (finished {_trainedIterWarm:N0} rounds in)"
                    : $"reconstructed from {_rounds:N0} of {_trainedIterWarm:N0} ramp rounds trained — still ramping in")
                : "fully composed";
            return ramp;
        }
    }

    // Rendered in the "why it's called Prism" outro paragraph — @_rounds is optional (only shown if
    // data/oracle-rounds.txt was published alongside the checkpoint, see field comment above), so this
    // degrades to a true-but-vaguer phrase rather than rendering a blank/null when it's missing.
    string RoundsPhrase => _rounds is not null ? $"{_rounds.Value:N0} rounds" : "a long time";

    // Shared by OnInitializedAsync's example generation and Ask() below (was duplicated LINQ
    // `seq.Skip(seq.Count - take).ToArray()`, called once per token — up to MaxReplyChars times per
    // submission). `Skip().ToArray()` allocates an iterator object AND the destination array on every call;
    // this does the same slice with one allocation (the array only) via List<T>.CopyTo. A real, confirmed
    // minor contributor investigated alongside the OOM report — nowhere near as large as the render-count/
    // history-size issues fixed elsewhere on this page, but free to remove while in here.
    static int[] BuildContext(List<int> seq, int maxContext)
    {
        var take = Math.Min(seq.Count, maxContext);
        if (take == 0) return new[] { 0 };
        var ctx = new int[take];
        seq.CopyTo(seq.Count - take, ctx, 0, take);
        return ctx;
    }

    async Task OnKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await Ask(); }

    // Genuinely live streaming (2026-08-30, direct instruction — replaces the earlier producer/
    // consumer split over an unbounded Channel<int> described in the comment this replaces). That
    // split ran the real LogitsFor/Gate.Pick loop with NO delay, writing every token to a channel the
    // instant it was computed, while a separate loop drained the channel and revealed one token per a
    // FIXED ~60ms Task.Delay tick — fully independent of how long compute actually took. That was a
    // deliberate call from early in the project, when this checkpoint's context was tiny and a single
    // LogitsFor call was likely near-instant; an artificial pacer was the only way to get ANY visible
    // cadence at all back then. A real user caught the tell live: "its still being pre-generated then
    // fake typed" — a fair complaint, since the two loops genuinely were decoupled exactly as
    // described.
    //
    // The checkpoint has grown a lot since then, and it changes the calculus: measured with a
    // throwaway console harness (native x64 JIT, NOT WASM — see below) against the real, currently
    // shipped checkpoint (data/oracle-brain.bin as of this change: Dim=1536, K=8 weight-tied passes
    // read live off data/oracle-stackk.txt, Context=52 tokens, ~245k rounds trained), one real
    // LogitsFor call now costs mean=97ms / median=98ms / p90=107ms / range 72-114ms (N=60, JIT-warmed
    // first). That's ALREADY inside typing-cadence territory running as fast native code — and the
    // real deployment is WASM (AOT-compiled per Showroom.csproj's RunAOTCompilation, still measurably
    // slower than native JIT for numeric hot loops like this one), so genuine in-browser per-token
    // compute is at least that slow, plausibly slower, never faster. Real compute now serves as its
    // own honest pacer, so the fake one is gone: this loop computes one token, reveals it immediately,
    // computes the next. No Channel anywhere in this path, no Task.Delay(60), no artificial pacing of
    // any kind. Simpler code too, not just more honest.
    //
    // The one `await Task.Yield()` below is NOT a pacer — it adds zero artificial wait. Blazor only
    // SCHEDULES a render on StateHasChanged(); without yielding to the sync context afterward, the
    // browser never gets a chance to actually paint the just-computed token before the next (real,
    // ~100ms+) LogitsFor call blocks the UI thread again — remove the yield and every token would
    // still take exactly as long to compute, you'd just never see the intermediate frames land.
    //
    // RENDER BATCHING (2026-08-30, real Arg_OutOfMemoryException report investigated — see
    // Showroom/CLAUDE.md's Prism section for the full write-up). Calling StateHasChanged() after every
    // single real token — which is exactly what "genuinely live streaming" above landed — means a full
    // MaxReplyChars reply costs up to that many Blazor render+diff cycles in ONE submission (was up to
    // 600 at the time this was written, now the live checkpoint's own context length — see
    // MaxReplyChars' own field comment), where the old fake-typing pacer bounded render count to
    // whatever a fixed ~60ms tick produced. WASM's linear memory is documented to grow but rarely
    // shrink back down (allocations accumulate; the runtime doesn't reliably hand freed pages back to
    // the OS) — hundreds of render cycles per submission, repeated over many submissions in one sitting
    // ("some period of use"), is a real slow-growth path
    // to the reported OOM, especially compounding with the (now-capped, see _history above) render-tree
    // size Blazor re-diffs on every one of those calls.
    //
    // Fix: batch the RENDER, not the compute — RenderBatch tokens are computed and appended to
    // `revealed` exactly as before (compute is NEVER throttled, no delay was added anywhere in this
    // method), but the DOM only actually repaints once every RenderBatch tokens (plus always on the
    // stopping/final token, so the visitor never waits past what they'd already see land). This is a
    // different thing from the fake-typing pacer this method's own history describes: that pacer set
    // the PACE of REVEAL independent of compute; this only reduces how often an already-computed,
    // already-revealed token gets painted, cutting render-diff work by ~RenderBatch times per
    // submission without changing when a token is computed or how fast the reply grows.
    const int RenderBatch = 4;
    async Task Ask()
    {
        if (_session is null || _vocab is null || string.IsNullOrWhiteSpace(_prompt) || _generating) return;
        var promptText = _prompt.Trim();
        _prompt = "";
        _pendingPrompt = promptText;
        _pendingContinuation = "";
        _generating = true; _error = null;
        StateHasChanged();
        await Task.Yield();   // let the prompt echo paint before the first real (~100ms+) compute call blocks the thread

        try
        {
            // fresh context every run (seeded ONLY from this submission's own tokens — nothing from a
            // prior run's prompt/continuation ever gets folded in, so there's no cross-run "memory" to
            // leak — autocomplete, not chat).
            var seq = new List<int>(_vocab.Encode(promptText));
            var outIds = new List<int>();
            var revealed = new List<int>();
            var vocabLimit = _vocab.Size;
            var guard = new DegenGuard(Policy);   // HoloKernel port of HoloEngine's ProbeDegenRepeat=4 —
            // a known behaviour this early in training (the confidence gate still reads GREEDY on a
            // collapsed distribution), surfaced honestly rather than silently padded with spaces
            var trailedOff = false;

            for (var step = 0; step < MaxReplyChars; step++)
            {
                var ctx = BuildContext(seq, _stats!.Context);

                // lean serving path — a single LogitsFor pass, honouring Iters/K exactly like the
                // full-recompute Inspector path did (removed 2026-08-28, see Showroom\CLAUDE.md). This
                // call's own real latency IS the visible cadence now — see method comment.
                var logits = _session.Logits(ctx);
                var t = Gate.Pick(logits, vocabLimit, Policy, Random.Shared);

                if (t == CharVocab.End) break;   // stop marker — see tokenizer field comment for why this id doubles as "\n"
                outIds.Add(t); seq.Add(t);
                revealed.Add(t);
                var stopping = guard.Observe(t);
                if (stopping) trailedOff = true;

                // Batch the RENDER, not the compute (see method comment above): every token above is
                // computed and appended to `revealed` unconditionally; the DOM paint + the (relatively
                // cheap but still O(n)) full Decode(revealed) rebuild only happen every RenderBatch
                // tokens, or on the very last/stopping token so the final state is never stale.
                var isLastStep = step == MaxReplyChars - 1;
                if (stopping || isLastStep || revealed.Count % RenderBatch == 0)
                {
                    // NOT trimmed — trimming mid-stream would make trailing spaces flicker in and out as
                    // later characters land; the final decode below trims once.
                    _pendingContinuation = _vocab.Decode(revealed);
                    StateHasChanged();
                    await Task.Yield();   // paint this batch now — not a delay, see method comment
                }
                if (stopping) break;
            }

            var shown = _vocab.Decode(outIds).TrimEnd();
            var continuationText = shown.Length > 0 ? shown : "(blank — this checkpoint is still very early in training)";
            AddHistory(new RunEntry(promptText, continuationText, trailedOff));
        }
        catch (Exception ex) { _error = "Prism stumbled: " + ex.Message; }
        finally { _generating = false; _pendingContinuation = ""; StateHasChanged(); }
    }
}
