@page "/prism"
@implements IDisposable
@inject HttpClient Http
@inject HoloKernel.SessionHost Sessions
@inject Microsoft.JSInterop.IJSRuntime JS
@using System.Text
@using System.Globalization
@using PrismFormer
@using HoloKernel
@* global:: required — this page's own generated class is Showroom.Pages.Prism (route "/prism"),
   which shadows the "Prism" NuGet package's root namespace in this exact scope (CS0426 without it,
   confirmed by trying the plain form first: the razor codegen emits @using directives INSIDE the
   generated Showroom.Pages namespace block, where the sibling Prism page class takes precedence
   over the global Prism namespace of the same simple name). *@
@using global::Prism.Inference
@* global::Prism.Lineage's LineageJournal is no longer called directly here — the alpha-reconstruction
   formula moved into HoloKernel.PrismCheckpoint.ReconstructAlpha (2026-09-21), shared with Stories.razor. *@

<PageTitle>Prism — a tiny AI that runs in your browser</PageTitle>

<div class="room" data-cat="algformer">
    <header class="room-head">
        <nav class="crumb"><a href="/">Evaluated Applications</a> <span>/</span> Prism</nav>
        <h1>Prism</h1>
        <p class="lede">A tiny AI, running in your browser. Say something and it replies. It is still learning,
            so the replies are rough.</p>
    </header>

    @if (_loadError is not null)
    {
        <p class="err">@_loadError</p>
    }
    else if (!_loaded)
    {
        <div class="boot-crt ck-boot">
            <div class="boot-head"><span class="boot-dot" aria-hidden="true"></span>downloading the model</div>
            <div class="boot-sub">one time only — your browser keeps it after this.</div>
            <div class="boot-log">
                @foreach (var s in _loadSteps)
                {
                    <span class="l @s.Cls"><span class="p">&gt;</span> @s.Label <span class="boot-status">@s.Status</span></span>
                }
            </div>
        </div>
    }
    else
    {
        <TokenVoiceControls Voice="_voice!" />
        <p class="sound-note hint">Each piece of a reply plays a short chord built from the model's own numbers for that
            word piece. Off by default. <a href="#explain-title">What you're hearing</a> is explained below the chat.
            <a href="/stories">Nano Stories</a> shares this exact voice — same model, same sound.</p>

        <div class="cr-stats">
            <div class="stat"><div class="n">@_stats!.ParamCount.ToString("N0")</div><div class="l">parameters</div></div>
            @* 8 bytes per parameter (they are doubles) — this lands on the real prism-holo.bin size, 862,244 B
               for 107,776 params, so the figure a visitor reads matches the file that was actually downloaded. *@
            <div class="stat"><div class="n">@((_stats.ParamCount * 8 / 1024).ToString("N0"))&nbsp;KB</div><div class="l">how big it is, in total</div></div>
            @if (_rounds is not null)
            {
                <div class="stat"><div class="n">@_rounds.Value.ToString("N0")</div><div class="l">practice rounds so far</div></div>
            }
        </div>

        <div class="or-runs">
            @* the ref goes on .or-run-list, not .or-runs: the outer box is overflow:hidden, the inner list is
               the one with max-height + overflow-y:auto, so it is the element that actually scrolls *@
            <div class="or-run-list" @ref="_scrollBox">
                @if (_turns.Count == 0)
                {
                    <p class="hint">Say hi. It remembers the last few turns, and nothing is saved.</p>
                }
                @foreach (var turn in _turns)
                {
                    <div class="or-turn @(turn.IsUser ? "user" : "prism")">
                        <span class="or-who">@(turn.IsUser ? "you" : "prism")</span>
                        <span class="or-text">@DisplayText(turn)</span>
                        @if (turn.Reason == StopReason.DegenLoop)
                        {
                            <span class="or-note">⋯ got stuck repeating itself</span>
                        }
                        else if (turn.Reason == StopReason.Cap)
                        {
                            <span class="or-note">⋯ ran on until it was stopped</span>
                        }
                    </div>
                }
                @if (_generating)
                {
                    <div class="or-turn prism pending">
                        <span class="or-who">prism</span>
                        <span class="or-text">@_pendingReply<span class="car" aria-hidden="true"></span></span>
                    </div>
                }
            </div>
            <div class="or-input-row">
                <input class="or-input" @bind="_prompt" @bind:event="oninput" @onkeydown="OnKeyDown" disabled="@_generating"
                       placeholder="Say hi to Prism" maxlength="140" />
                <button class="go" @onclick="Ask" disabled="@(_generating || string.IsNullOrWhiteSpace(_prompt))">
                    @(_generating ? "thinking…" : "Send")
                </button>
                <button class="ghost" @onclick="ClearChat" disabled="@(_generating || _turns.Count == 0)"
                        title="Start a new conversation">
                    Clear
                </button>
            </div>
        </div>

        @if (_error is not null) { <p class="err">@_error</p> }

        @* Condensed from the site's "Meaning as chords" page (site/holoformer.html), 2026-09-15, on the user's request, plus
           an honest account of what the audible tokens are. Keep the "What you're hearing" claims in lockstep with
           HoloKernel.TokenVoice's PlayTone/BaseFrequency: 32 tones = this checkpoint's FrozenPrefix/2 (the codec band), "twice" = its StackK of 2. If either changes on a
           new checkpoint, update this copy too — and Nano Stories' own copy of the same claim, since it shares this voice. *@
        <section class="explain" aria-labelledby="explain-title">
            <h2 id="explain-title">How Prism works, as sound</h2>
            <p>Prism is a holographic transformer, and the easiest way to understand one is as music. This is the short
                version of <a href="/holoformer.html">Meaning as chords</a>.</p>
            <ul>
                <li><strong>Every word is a chord.</strong> Prism stores each piece of a word as a chord, a stack of pure tones
                    played together. Chords that sound alike mean alike, so related ideas end up close to each other.</li>
                <li><strong>Ideas combine by playing chords together.</strong> To link two things it plays both chords at once and
                    they merge into a new one. Number chords are tuned so that merging them is the arithmetic itself.</li>
                <li><strong>It remembers like a radio.</strong> Everything it has read folds into one running sound. To recall
                    something it tunes to that frequency, and the match rings out while the rest cancels to silence.</li>
                <li><strong>It thinks by replaying.</strong> Each layer plays its part twice before handing the sound on. The
                    first pass sketches, the second turns the sketch into the answer.</li>
            </ul>
            <h3>What you're hearing</h3>
            <p>Turn sound on and every piece of a word Prism writes plays its own chord, right as it appears. That chord is not
                a sound effect someone picked. It is built from the model's own numbers for that word piece: 32 tones, each
                taking its loudness and starting point from the model, with its frequency worked out from those same numbers.</p>
            <p>The note and the tone colour come from opposite halves of the model's numbers for that word. The note comes from
                what Prism has learned about the word, so its pitch moves as Prism keeps training. The tone colour comes from the
                word's fixed identity, which never changes, so every word keeps its own sound. The one choice we made is where the
                chord sits in your hearing range.</p>
            <p>That is also why it doesn't sound like an ordinary instrument. The model's tones aren't tuned to any musical
                scale, and we left them that way rather than dress them up.</p>
        </section>
        <div class="outro">
            <p><a href="/stories">Nano Stories</a> is this exact model — same weights, same training run — asked to
                write a story instead of hold a conversation. Also here: <a href="/creature">The Creature</a> and
                <a href="/forecaster">The Forecaster</a>.</p>
        </div>
    }
</div>

@code {
    // ---- decode policy — migrated onto Prism.Inference.DecodePolicy 2026-09-05 (was HoloKernel's own
    // hand-copy of the same type, ported from PrismStudio's HoloEngine originally 2026-08-28; the
    // numbers are unchanged, just single-sourced in Prism now). ConfidentThreshold=0.60, Temperature=
    // 0.80, Floor=ResonanceSigma, FloorK=3.0, DegenRepeat=4 — all confirmed identical to the values
    // this page ran before the migration.
    //
    // DegenNonGreedyRun explicitly ZEROED, not left at Prism's own Default (5): Prism.Inference.
    // DegenGuard fires on TWO independent triggers (repeat-count AND a non-greedy-pick streak);
    // HoloKernel's now-removed DegenGuard only ever implemented the repeat trigger. Adopting the
    // second trigger at its live default would make generation on this deployed page stop EARLIER
    // than it does today — a real, visible behaviour change nobody asked for. `DegenGuard.Observe`
    // treats a threshold <= 0 as "disabled" (see Prism.Inference.DegenGuard's own doc), so this `with`
    // keeps every other field at Prism's real production default while making the new trigger inert —
    // net effect: byte-for-byte the same decode as before this migration. Enabling it for real (a
    // second, separate degeneracy signal — see DegenGuard's own doc for the "ABAB" blind spot it
    // would help with) is a deliberate follow-on decision for the user, not taken here. Unchanged by
    // the 2026-09-08 turn-based-chat rework below — same policy, now applied once per CHAT TURN
    // instead of once per one-shot completion.
    static readonly DecodePolicy Policy = DecodePolicy.Default with { DegenNonGreedyRun = 0 };
    // The real stop condition is CharVocab.End (the model's own stop token) or DegenGuard catching a
    // collapsed repeat run — those are unchanged and still fire first when they fire at all.
    int MaxReplySteps => MaxReplyStepsConst;

    // Per-reply token-step cap — one HoloFormer step, NOT one character (a subword emits several chars
    // per step). Renamed off `MaxReplyChars` on 2026-09-14: the old name said characters, the loop
    // always counted steps, and that gap is what hid the regression below.
    //
    // PINNED TO A MEASURED CONSTANT (2026-09-14, user: "limit the model response to the good portion
    // again like we did before"). It used to be `Context / 2`, which quietly broke when the checkpoint
    // was replaced. Two multipliers compounded: context grew 192 -> 512, so the cap went 96 -> 256
    // steps, AND the re-minted vocabulary emits far more text per step (1.8 -> a MEASURED 3.13 bytes
    // per token on generated text). Replies went from roughly 170 characters to roughly 800. Nothing
    // about the model got worse; the reply just got six times longer.
    //
    // 56 steps x 3.13 bytes/token is about 175 characters, which reproduces the reading length the
    // previous checkpoint actually shipped at. Deliberately NOT a fraction of the context window any
    // more: that coupling is what caused this, and a bigger window is not a reason to talk longer.
    //
    // WHAT THE MEASUREMENT ACTUALLY SHOWED, because it contradicts the obvious theory. Scored over 90
    // gated-decode runs (15 openers x 6 seeds) against a 78,796-word dictionary built from the model's
    // OWN training corpus, the real-word rate is FLAT at 88-91% across all 256 steps — it does not
    // decay with length, so there is no "good portion" to cut at. Greedy decoding DOES loop early, but
    // the page does not decode greedily; under the real gate, repetition never fired inside 400
    // characters. The actual defect is that the model emitted its own STOP token in 0 of 90 runs, so
    // every reply runs to whatever this cap is and then stops mid-sentence. Shortening it does not
    // raise quality per word, it just stops handing the visitor 800 characters of it.
    //
    // Re-measure this against every new checkpoint: it depends on the vocabulary's bytes/token, which
    // changes on every re-mint. Do NOT "fix" the mid-sentence ending with a sentence-boundary
    // heuristic — chat quality gets fixed by training, not by trimming (see AboutUs CLAUDE.md).
    const int MaxReplyStepsConst = 56;
    //
    // HALVED 2026-09-12, from one full context window to half of one, because the full window was
    // measured to be well past where this checkpoint's output survives. The old reasoning — "a full
    // window of self-written text is the point where none of the human's words are still in view, so
    // anything past it is drift by construction" — is correct as a CEILING and wrong as a working cap:
    // drift does not begin where the human's last word leaves the window, it begins where the model's
    // own output starts dominating it, which is half a window earlier.
    //
    // Measured at r338501 (d=96 L=6 ctx=192), greedy, scored in 16-step chunks by the share of emitted
    // words that are real words, for two different openers:
    //     steps   0-96    100% real words   "a little girl named Lily. She loved to play with her mom."
    //     steps  96-160   100% real words   but visibly looping: "They were had a big scared." twice over
    //     steps 160-192   0-50%             collapsed: "TheZtty!uly ugbem* nt"
    // So the final sixth is garbage and the third quarter is repetition. Half the window keeps every
    // clean chunk and cuts both. This is a measured value, not a taste call — re-measure it against a
    // new checkpoint rather than assuming it carries over (scratchpad `arith-probe taper` does this).
    //
    // Still also the backstop for the turn-based chat below (see StopReason.Cap): a reply that neither
    // emits the stop token nor trips DegenGuard cannot run forever.

    // ---- Audible tokens (2026-09-13). OFF by default — a page that makes noise unannounced is
    // hostile. LIFTED into HoloKernel.TokenVoice 2026-09-21 (see that type's own header comment) so
    // Nano Stories can share the exact same sound and pacing rather than re-derive it — every tuning
    // history comment that used to live here (the beat/sway/pitch/timbre rationale) now lives there;
    // this page just owns one instance of it.
    TokenVoice? _voice;

    HoloSession? _session;
    ModelStats? _stats;
    SubwordVocab? _vocab;   // published PrismFormer.SubwordVocab — the checkpoint's OWN vocab, loaded
                             // from oracle-vocab.txt below (NOT the studio's shared default table —
                             // this matters for BuildContextTokens, which measures token counts through this
                             // exact vocab). CharN=>CharVocab.N=96 already treats id 95 (CharVocab.End)
                             // as "\n" internally (Symbol(95)=="\n"), matching this file's OWN "id 95 is
                             // both newline and the stop marker" quirk exactly — the ctor takes ONLY the
                             // merges list (2-4 char strings), NOT the base chars (handled internally),
                             // and Encode() folds non-printable input (including '\n') to space.
    bool _loaded; string? _loadError; string? _error;
    long? _rounds;   // optional: only shown if data/oracle-rounds.txt was published alongside the checkpoint

    // ---- real per-file boot log for the checkpoint fetch (2026-08-28) — reuses the SAME .boot-crt/.boot-log/.l/.p
    // classes as the app-shell's own boot screen (wwwroot/css/boot.css, linked globally in index.html, so a
    // Razor component can use those classes directly without duplicating any CSS). Every line/status below is a
    // REAL fetch of a REAL file that already had to happen — this narrates it, it doesn't add a single extra
    // request or delay anything (Finish() only ever runs after the awaited fetch it's reporting on completes).
    sealed class LoadStep { public string Label = ""; public string Status = "fetching…"; public string Cls = ""; }
    readonly List<LoadStep> _loadSteps = new();
    LoadStep Begin(string label) { var s = new LoadStep { Label = label }; _loadSteps.Add(s); StateHasChanged(); return s; }
    void Finish(LoadStep s, string status, string cls = "core") { s.Status = status; s.Cls = cls; StateHasChanged(); }

    // ---- REAL trained depth — K is NOT a visitor-adjustable knob (fixed 2026-08-28, twice: first to default to
    // the real value, then the user caught that a slider shouldn't exist at all — "k is not a parameter, its
    // fixed to the model count"). The .bin file itself doesn't persist Iters/IterAlphaServe (verified by round-
    // tripping Serialize()/Deserialize() against the real checkpoint), so its own on-disk value reads back a
    // meaningless K=1 — `_k` is set ONCE at load from the real trained depth and never changes after. Sourced
    // live from `oracle-stackk.txt`/`oracle-iterwarm.txt` (same hand-off pattern as `oracle-rounds.txt`) carrying
    // PrismStudio's live `OneShotStackK`/`OneShotIterWarm` AT THE MOMENT this checkpoint snapshot was taken —
    // never hardcoded here, since both are the user's own live-hand-edited training knobs and change between
    // snapshots.
    int? _trainedStackK;
    int? _trainedIterWarm;

    double _trainedAlpha = 1.0;   // reconstructed below via Prism.Lineage.LineageJournal.AlphaFor — a mid-ramp
    // snapshot deserves a mid-ramp alpha, not a flat 1.0 guess (that would ALSO misrepresent it, just in the
    // opposite direction). Only valid for a single-layer checkpoint (layer 0's real add-round is 0 by
    // construction — it's present from round 0); falls back to 1.0 (fully composed) if the checkpoint ever ships
    // with >1 layer, or if either metadata file is missing. Multi-layer/K>1 serving itself is NOT gated by this —
    // see the HoloSession.FromCheckpoint call below for why a deeper checkpoint (e.g. L6/K2) still serves
    // correctly through the same call.

    int _k = 1;   // the model's one real trained depth — set once at load, never mutated (no slider, see field comments above)
    bool _generating;
    string _prompt = "";
    string _pendingReply = "";   // the in-flight reply, streamed live and re-decoded after every emitted batch of
    // tokens while _generating — this is what makes generation render as a typewriter: the markup binds to THIS
    // field, so the per-batch StateHasChanged() call in GenerateReplyAsync actually has new text to paint.

    // ---- turn-based chat, rolling context. TAGGED WIRE FORMAT (2026-09-15, user: "set up the user prism and the new line
    // framing on website", once the model started training on pairs). Reverses the 2026-09-09 untagged format.
    //
    // The transcript the model sees is one tagged line per turn, exactly what StudioModel.Serve builds in the studio:
    //     user: Hello there\nprism: Hi, how are you\nuser: What's up\n
    // and the question being answered ends in "prism: " so the model writes the next reply; every FINISHED exchange ends in STOP (see BuildContextTokens). This is the framing the pairs lane trains on:
    // HoloEngine wraps every raw "Q\tA" pair through GroupChat.AsChat into "user: Q\nprism: " -> A, then PairSource
    // appends CharVocab.End (id 95) after the answer. Train and serve now agree token for token.
    //
    // TWO FACTS ABOUT NEWLINES THAT ARE EASY TO GET WRONG. (1) A newline in the TEXT is not a token: SubwordVocab and
    // the studio's MintTokenizer both fold every non-printable character, "\n" included, to a SPACE when encoding, so
    // "user: Q\nprism: " reaches the model as "user: Q prism: " in training and here alike. (2) Id 95 is the STOP
    // token, and it is the only id that DECODES as "\n" (Symbol(95)), but nothing ever ENCODES to it: it only exists
    // because PairSource appends it after each answer. So the model learns to end a reply by emitting STOP, and the
    // "\n" separators below never become STOP; they are turn boundaries for BuildContextTokens and spaces for the model.
    //
    // Why the tags are affordable again: the untagged format was a context-budget trade made at ctx=192, where "user: "
    // (4 tokens) + "prism: " (5) cost 23% of a ten-turn window. At ctx=512 that is ~9 tokens per exchange out of 512.
    sealed record ChatTurn(bool IsUser, string Text, StopReason? Reason = null);

    enum StopReason
    {
        Stop,       // the model emitted its own trained stop token (CharVocab.End, id 95) — the clean case
        DegenLoop,  // Prism.Inference.DegenGuard caught a repetition/low-confidence collapse and cut it short
        Cap,        // ran to MaxReplySteps without either of the above. STOP (id 95) is only ever a training
                    // TARGET on PAIR data — PairSource appends it after the answer — never on plain corpus
                    // text, and pairs are a small minority of the live training mix (HoloEngine's own mix
                    // comment puts them at roughly 1.5% of signal at the current MixAlpha). So this case is
                    // real and expected this early in training, not a bug — flagged honestly in the UI rather
                    // than silently truncated.
    }

    // Bounds the DOM/render-diff cost across a long session — supersedes the old one-shot page's HistoryCap
    // (real Arg_OutOfMemoryException report, "after some period of use": Blazor rediffs this component's whole
    // render tree on every StateHasChanged(), so an unbounded list compounds an unbounded render count). Higher
    // than the old HistoryCap=40 since one chat turn's own markup is lighter than the old prompt+continuation run.
    const int TurnCap = 60;
    readonly List<ChatTurn> _turns = new();
    void AddTurn(ChatTurn t) { _turns.Add(t); while (_turns.Count > TurnCap) _turns.RemoveAt(0); }

    static string CleanTurnText(string s) => s.Replace('\r', ' ').Replace('\n', ' ').Trim();

    // PACKED-TURN CONTEXT (2026-09-15, user: "fix the website so it handles the stop tokens right"). The studio now trains
    // pairs PACKED (PrismGym PackedPairSource, PackPairWindows): whole turns back to back, each exactly PairSource's own run,
    //     Encode("user: Q\nprism: ") + Encode(A) + [STOP]
    // with nothing between one turn's STOP and the next "user: ". This builds the model's context the same way: every
    // FINISHED exchange is its prompt run + answer run + STOP, and the question being answered is its prompt run alone, so
    // the model's next token is the first word of its reply and the trained way to end that reply is STOP. Prompt and
    // answer are encoded SEPARATELY, exactly as PairSource does, so the seam tokenises identically. A "\n" inside the text
    // still encodes to a space; STOP (CharVocab.End) is only ever appended here as an id, Encode never produces it.
    // Typed text is folded through AsciiPunctuation.Fold first (2026-09-16): phone keyboards autocorrect the plain
    // apostrophe to U+2019, which SubwordVocab.Fold turns into a SPACE, so "what" + curly + "s this" reached the model
    // as "what s this" and the model answered the damaged question. Mirrors MintTokenizer.AsciiTwin in the trainer.
    // Capping drops whole leading EXCHANGES until the rest fits the window, so the context always starts on a turn
    // boundary, which is where packed training windows start.
    static List<int> BuildContextTokens(SubwordVocab vocab, IReadOnlyList<ChatTurn> turns, int maxTokens)
    {
        var chunks = new List<List<int>>();
        List<int>? open = null;
        foreach (var t in turns)
        {
            if (t.IsUser)
            {
                open = new List<int>(vocab.Encode(HoloKernel.AsciiPunctuation.Fold(GroupChat.HumanTag + t.Text.Trim() + "\n" + GroupChat.AiTag)));
                chunks.Add(open);
            }
            else if (open is not null)   // a reply closes the exchange it answers; a reply with no question in view is dropped
            {
                open.AddRange(vocab.Encode(HoloKernel.AsciiPunctuation.Fold(t.Text)));
                open.Add(CharVocab.End);
                open = null;
            }
        }
        var start = 0; var total = 0; foreach (var c in chunks) total += c.Count;
        while (start < chunks.Count - 1 && total > maxTokens) { total -= chunks[start].Count; start++; }
        var seq = new List<int>(total);
        for (var i = start; i < chunks.Count; i++) seq.AddRange(chunks[i]);
        return seq;
    }

    static string DisplayText(ChatTurn t) => t.Text.Length > 0 ? t.Text : "(blank — this checkpoint is still very early in training)";

    // The one generation loop, shared by the boot-time seed exchange (below) and every real Send click — unified
    // 2026-09-08, previously duplicated as two independent loops that could quietly drift apart. `onPartial`,
    // when supplied, is invoked (and awaited, so the browser actually gets to paint) every RenderBatch tokens for
    // a live typewriter effect; pass null for a silent, straight-through run — the boot-time seed doesn't need to
    // stream, since it renders as an already-complete turn the first time the chat UI paints at all.
    async Task<(string Text, StopReason Reason)> GenerateReplyAsync(Func<string, Task>? onPartial)
    {
        var seq = BuildContextTokens(_vocab!, _turns, _stats!.Context);   // packed-turn context: finished exchanges end in STOP, see BuildContextTokens
        var outIds = new List<int>();
        var revealed = new List<int>();
        var vocabLimit = _vocab!.Size;
        var guard = new DegenGuard(Policy);
        var reason = StopReason.Cap;   // default — overwritten the moment either real stop condition fires below

        // KV-CACHE SERVING PATH (2026-09-10, replaces a per-token full recompute). The old loop called
        // _session.Logits(ctx) — a fresh O(context) forward over up to _stats.Context tokens — EVERY step, so
        // generating N tokens cost O(N x context): 178 tokens at ctx~11 measured ~106x slower than this path,
        // 40ms/token -> 10ms/token even once the rolling window is fully overflowing (see below). Uses
        // HoloKernel's HoloSession.ServeCache (HoloSession.cs) — AlgFormer's StackK-aware NewCache/PrimeIter/
        // StepIter pair, NOT the plain K=1-only Prime/Step pair. Verified bit-for-bit identical output to the
        // old per-step Logits() loop against the real live checkpoint (same seed, same prompt, same generated
        // token ids) across a short prompt, a near-full-context prompt that forces mid-generation eviction, and
        // 5 more prompts x 3 seeds each — see HoloSession.ServeCache's own doc for the one real caveat (only
        // verified equivalent for a multi-layer checkpoint, which is what Prism ships; Creature/Forecaster are
        // Layers=1 and would need their own re-verification before ever adopting this path).
        //
        // EVICTION: the cache can't forget its oldest token, so once cache.Filled would reach _stats.Context
        // (the rolling window BuildContextTokens/BuildContext already enforce for the old path) the code below
        // re-Primes from the same freshly-sliced BuildContext window instead of Stepping — an O(context)
        // re-prime for exactly the steps that need it, identical cost to what the old loop always paid, never
        // worse. Everything before that point runs O(1) per token.
        var cache = _session!.NewServeCache();
        var primedTail = BuildContext(seq, _stats.Context);
        var logits = _session.Prime(cache, primedTail);

        _voice!.ResetBeat();   // fresh pacing beat for this reply — see TokenVoice.ResetBeat
        for (var step = 0; step < MaxReplySteps; step++)
        {
            if (step > 0)
            {
                logits = cache.Filled < _stats.Context
                    ? _session.StepToken(cache, seq[^1])
                    : _session.Prime(cache, BuildContext(seq, _stats.Context));
            }

            // Evaluate before Pick to get the real greedy flag DegenGuard.Observe needs — Evaluate draws
            // nothing from rng, so Pick's own draw/result is byte-identical to calling Pick alone.
            var decision = Gate.Evaluate(logits, vocabLimit, Policy);
            var t = Gate.Pick(logits, vocabLimit, Policy, Random.Shared);

            if (t == CharVocab.End) { reason = StopReason.Stop; break; }   // the model's own stop token — never
            // appended to the visible reply or fed back into the context; compute stops here rather than
            // throwing away a token that was never meant to be seen.

            outIds.Add(t); seq.Add(t); revealed.Add(t);
            if (onPartial is not null && _voice.SoundOn)   // re-read every step, so toggling sound mid-reply takes effect on the next note
                await _voice.WaitForBeatAsync();
            var stopping = guard.Observe(t, decision.Greedy);
            if (stopping) reason = StopReason.DegenLoop;

            if (onPartial is not null)
            {
                // Batch the RENDER, not the compute (2026-08-30 OOM fix, still load-bearing here): every token
                // is computed and appended to `revealed` unconditionally; the DOM only actually repaints once
                // every RenderBatch tokens, or on the stopping/final token so the visitor never sees stale state.
                var isLastStep = step == MaxReplySteps - 1;
                if (TokenVoice.ShouldRepaint(revealed.Count, stopping, isLastStep, _voice.SoundOn))
                    await onPartial(_vocab.Decode(revealed));
            }
            _voice.PlayTone(_session, t);   // AFTER the paint above: while sound is on every token repaints first, so each note starts
            // as its token appears at the end of the reply, and the last printed token is always the one sounding
            // (2026-09-15, user: "The last one printed gives the sound"). No highlight or animation, by request. A no-op
            // while sound is off; every token gets its own note, never one per render batch.
            if (stopping) break;
        }

        // HARD CUT, not a hide: a degenerate tail is REMOVED from outIds before it is decoded, so it never
        // reaches the visible turn AND never reaches BuildContextTokens — the next turn's rolling context is
        // built from the surviving prefix only. This matters more than the cosmetics: a 192-token window
        // filled with "ERE ERE ERE" both crowds out real conversation and teaches the model, from its own
        // context, that a "prism: " turn looks like that. HoloKernel.DegenerateTail (lifted out 2026-09-21,
        // shared with Stories.razor) — see its own doc for why this isn't just DegenGuard again.
        var cut = DegenerateTail.Start(outIds);
        if (cut < outIds.Count)
        {
            outIds.RemoveRange(cut, outIds.Count - cut);
            reason = StopReason.DegenLoop;   // surfaced in the UI, so a cut is visible rather than silent
        }

        var text = _vocab.Decode(outIds).TrimEnd();
        return (text, reason);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Restore the sound preference BEFORE anything else — cheap, and TokenVoice.InitializeAsync
            // reading localStorage is not itself a user gesture, so even a restored SoundOn=true from an
            // earlier visit may still start suspended until the visitor's first real click on this page
            // (see TokenVoiceControls' own toggle for where the actual unlock happens). Never blocks page load.
            _voice = new TokenVoice(JS);
            await _voice.InitializeAsync();

            var s = Begin("data/oracle-vocab.txt");
            var vocabBytes = await Http.GetByteArrayAsync("data/oracle-vocab.txt");
            var merges = Encoding.UTF8.GetString(vocabBytes).Replace("\r\n", "\n").Split('\n').Where(l => l.Length > 0).ToList();
            _vocab = new SubwordVocab(merges);   // throws (caught below, degrades to _loadError) on a malformed merge line
            Finish(s, $"{vocabBytes.Length:N0} B → {_vocab.Size:N0}-symbol vocab");

            // Metadata sidecars fetched BEFORE the checkpoint bytes now (was after) — they're tiny and are
            // needed to compute K/alpha, which the SessionHost factory below needs up front (it only ever
            // runs once per model key, so it can't come back later to ask for them).
            s = Begin("data/oracle-rounds.txt");
            try { _rounds = long.Parse((await Http.GetStringAsync("data/oracle-rounds.txt")).Trim()); Finish(s, $"{_rounds:N0} rounds trained"); }
            catch { Finish(s, "not shipped (optional)", "fail"); _rounds = null; }

            s = Begin("data/oracle-stackk.txt");
            try { _trainedStackK = int.Parse((await Http.GetStringAsync("data/oracle-stackk.txt")).Trim()); Finish(s, $"K={_trainedStackK}"); }
            catch { Finish(s, "not shipped (optional)", "fail"); _trainedStackK = null; }

            s = Begin("data/oracle-iterwarm.txt");
            try { _trainedIterWarm = int.Parse((await Http.GetStringAsync("data/oracle-iterwarm.txt")).Trim()); Finish(s, $"{_trainedIterWarm:N0}-round ramp"); }
            catch { Finish(s, "not shipped (optional)", "fail"); _trainedIterWarm = null; }

            // fixed to the REAL trained depth (falls back to the file's bare K=1 only if the metadata sidecar is
            // missing) — never adjusted after this; see the field comments above for why. PrismCheckpoint.ResolveK
            // is shared with Stories.razor so the two tools can't disagree on this.
            _k = PrismCheckpoint.ResolveK(_trainedStackK);

            // SessionHost dedupes by MODEL key ("prism"): the FIRST visit to this page in a page load fetches
            // + deserializes the checkpoint exactly as before. A LATER visit reuses that same in-memory
            // HoloSession instead of re-downloading/re-parsing it — the factory below (and its boot-log step)
            // simply never runs a second time.
            //
            // NOTE on deeper/K>1 checkpoints (e.g. an L6/K2 shape): FromCheckpoint passes spec:null, so
            // ModelSpec.Validate() (which used to reject Layers>1 && KPass>1) never runs on this path at all —
            // HoloSession.Logits() below dispatches straight to HoloFormer.LogitsFor, which itself now routes
            // any Layers>1 shape to StackIterForward with a uniform per-layer alpha (AlgFormer 2.4.0, fixed
            // 2026-08-28, confirmed serving correctly in production against a real checkpoint that grew a
            // second layer while training at StackK=2 — see HoloKernel/ModelSpec.cs's own SupportsKPassServing
            // doc). Nothing here needs to change for a deeper checkpoint to serve; the chat rework above doesn't
            // touch model shape at all, only how the model is prompted.
            bool reused = Sessions.IsLoaded(PrismCheckpoint.SessionKey);
            _session = await Sessions.GetOrCreateAsync(PrismCheckpoint.SessionKey, async () =>
            {
                var sb = Begin("data/oracle-brain.bin.gz");
                // gzip-precompressed at rest — GitHub Pages serves this byte-for-byte with no on-the-fly
                // compression, so shipping a pre-gzipped sidecar + decompressing it here
                // (HoloKernel.CheckpointFetch) is the only way to actually shrink the transfer.
                var (bytes, gzLen) = await CheckpointFetch.FetchAndDecompressGzipAsync(Http, "data/oracle-brain.bin.gz");
                var peek = HoloFormer.Deserialize(bytes);   // one-time peek at Layers/ParamCount for the boot log +
                // the alpha-reconstruction guard below — HoloSession.FromCheckpoint needs K/alpha as ctor args
                // (see field comment above), which in turn need Layers, so this has to happen before the session
                // can be built.
                Finish(sb, $"{gzLen:N0} B gzip → {bytes.Length:N0} B → {peek.ParamCount:N0} params deserialized");
                var alpha = PrismCheckpoint.ReconstructAlpha(peek.Layers, _rounds, _trainedIterWarm);
                // HoloSession.FromCheckpoint requires K/alpha as explicit ctor args — the kernel enforces the
                // "checkpoint doesn't carry them" gotcha by construction rather than a footnote (see field comment).
                return HoloSession.FromCheckpoint(bytes, _k, alpha);
            });
            if (reused) Finish(Begin("data/oracle-brain.bin.gz"), "reused from earlier this visit (no re-download)");
            _stats = _session.Stats();
            // Recomputed from the session actually in hand (not the factory's local "peek"/"alpha", which don't
            // exist on the reused-cache path) — same formula, so identical on a first-ever visit either way.
            _trainedAlpha = PrismCheckpoint.ReconstructAlpha(_stats.Layers, _rounds, _trainedIterWarm);

            // No example exchange on load (removed 2026-09-15, user: "remove the first prompt"): the chat opens empty on
            // the "Say hi" hint and the visitor's own message is the first thing the model answers. What the removed seed
            // exchange ALSO did, paying WASM's cold-start cost for the generation path before the first real Send, is kept
            // as a silent warm-up: one prime and one step through the same serve cache GenerateReplyAsync uses, with the
            // result discarded. Nothing is added to the chat and nothing is shown.
            try
            {
                var warm = _session.NewServeCache();
                var warmCtx = BuildContext(BuildContextTokens(_vocab!, new List<ChatTurn> { new(IsUser: true, Text: "hi") }, _stats.Context), _stats.Context);
                _ = _session.Prime(warm, warmCtx);
                _ = _session.StepToken(warm, warmCtx[^1]);
            }
            catch { /* warm-up only, never user-visible, never blocks page load */ }

            _loaded = true;
        }
        catch (Exception ex) { _loadError = "Couldn't load the checkpoint: " + ex.Message; }
    }

    // K has no UI control anymore — this is purely the explanatory ramp detail for the outro copy's fact
    // statement (no "exploring"/"what if" branch needed, since there's nothing to explore away from).
    string KFactDetail
    {
        get
        {
            if (_trainedStackK is null) return "depth metadata wasn't shipped with this build, so K falls back to the bare checkpoint file's own K=1";
            var ramp = _stats is not null && _stats.Layers == 1 && _trainedIterWarm is > 0 && _rounds is not null
                ? (_rounds.Value >= _trainedIterWarm.Value
                    ? $"ramp fully complete (finished {_trainedIterWarm:N0} rounds in)"
                    : $"reconstructed from {_rounds:N0} of {_trainedIterWarm:N0} ramp rounds trained — still ramping in")
                : "fully composed";
            return ramp;
        }
    }

    // Rendered in the "why it's called Prism" outro paragraph — @_rounds is optional (only shown if
    // data/oracle-rounds.txt was published alongside the checkpoint, see field comment above), so this
    // degrades to a true-but-vaguer phrase rather than rendering a blank/null when it's missing.
    string RoundsPhrase => _rounds is not null ? $"{_rounds.Value:N0} rounds" : "a long time";

    // Shared by GenerateReplyAsync's per-step context slice. `Skip().ToArray()` would allocate an iterator
    // object AND the destination array on every call (up to MaxReplySteps times per reply); this does the same
    // slice with one allocation via List<T>.CopyTo.
    static int[] BuildContext(List<int> seq, int maxContext)
    {
        var take = Math.Min(seq.Count, maxContext);
        if (take == 0) return new[] { 0 };
        var ctx = new int[take];
        seq.CopyTo(seq.Count - take, ctx, 0, take);
        return ctx;
    }

    // Audible tokens (face -> tone) and the pacing beat both now live in HoloKernel.TokenVoice — see
    // that type's own doc comment for the full tuning history (mid-bass -> robot -> 80s arcade robot,
    // the reversed note/flavour mapping, the harmonic-series bug the additive rewrite fixed). Both
    // GenerateReplyAsync's PlayTone/WaitForBeatAsync calls above go through `_voice`.

    // Navigating away mid-reply must not leave a note ringing behind in this single-page app (the
    // AudioContext lives on window, not on this component, so it otherwise would). Does not touch the
    // sound-on/volume preference — only the currently-sounding notes.
    public void Dispose() => _voice?.Dispose();

    async Task OnKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await Ask(); }

    // Genuinely live streaming (2026-08-30, still true here): one real LogitsFor() call per token, revealed
    // immediately, no artificial pacer unless sound is on (paced via TokenVoice.WaitForBeatAsync above) —
    // real compute latency (measured ~100ms+ at this checkpoint's shape, native-JIT floor; WASM is at least
    // that slow) IS the visible cadence otherwise. The one `await Task.Yield()` calls below add zero
    // artificial wait; they exist only so the browser actually gets a chance to paint the just-computed
    // batch before the next real compute call blocks the UI thread again. RenderBatch itself now lives on
    // TokenVoice (see TokenVoice.ShouldRepaint, used in GenerateReplyAsync above).

    // The chat scroll container. Auto-scroll is STICKY rather than unconditional: forced when you send, and
    // during Prism's streaming reply only if you were already near the bottom (see window.prismScrollToBottom
    // in index.html). Scrolling up to re-read an earlier turn mid-reply therefore doesn't drag you back down.
    ElementReference _scrollBox;
    async Task ScrollToBottom(bool force)
    {
        try { await JS.InvokeVoidAsync("prismScrollToBottom", _scrollBox, force); }
        catch { /* interop unavailable (prerender / torn-down circuit) — scrolling is cosmetic, never fail a reply over it */ }
    }

    async Task Ask()
    {
        if (_session is null || _vocab is null || string.IsNullOrWhiteSpace(_prompt) || _generating) return;
        var userText = CleanTurnText(_prompt.Trim());
        _prompt = "";
        AddTurn(new ChatTurn(IsUser: true, Text: userText));
        _pendingReply = "";
        _generating = true; _error = null;
        StateHasChanged();
        await Task.Yield();   // let the user's own turn paint before the first real (~100ms+) compute call blocks the thread
        await ScrollToBottom(force: true);   // your own turn always pulls the view down, whatever you were reading

        try
        {
            var (text, reason) = await GenerateReplyAsync(async partial =>
            {
                // NOT trimmed mid-stream — trimming would make trailing spaces flicker in and out as later
                // tokens land; GenerateReplyAsync's own final Decode(outIds).TrimEnd() trims once, at the end.
                _pendingReply = partial;
                StateHasChanged();
                await Task.Yield();
                await ScrollToBottom(force: false);   // follow the stream, but only if the reader hasn't scrolled away
            });
            AddTurn(new ChatTurn(IsUser: false, Text: text, Reason: reason));
        }
        catch (Exception ex) { _error = "Prism stumbled: " + ex.Message; }
        finally
        {
            _generating = false; _pendingReply = ""; StateHasChanged();
            await ScrollToBottom(force: false);
        }
    }

    void ClearChat()
    {
        // Forgets the CONVERSATION only — the checkpoint's own weights are untouched (visitors here never
        // train; see HoloKernel's browser contract). Nothing was ever persisted in the first place (WASM has
        // no filesystem, and this page never writes to local storage), so this is really just "start a new
        // rolling window" rather than a real reset of anything durable.
        if (_generating) return;
        _turns.Clear();
        _error = null;
    }
}
