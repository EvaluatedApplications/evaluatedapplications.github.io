@page "/prism"
@attribute [BlazierPage("prism", Title = "Prism: a tiny AI that runs in your browser", Layout = typeof(MainLayout), Static = true)]
@inject IBuildTime Build
@inject NavigationManager Nav
@inject PrismLoader Loader
@implements IDisposable
@using Showroom.Services.PrismTab
@* ONE tool, ONE model, five tabs: Chat, Stories, Map (the old Cartographer), Creature, Forecaster. Every tab reads the same Prism
   checkpoint (SessionHost key "prism", loaded once by PrismLoader). Only the active tab is rendered: a tab fetches or trains nothing until
   it is opened, and leaving it disposes its trainer and its TokenVoice. The tab is named by the fragment (#stories) or ?tab=stories.
   Creature and Forecaster never change the shared model: their Retrain button trains a PRIVATE copy (PrivateCopy). *@

<PageTitle>Prism: a tiny AI that runs in your browser</PageTitle>

<div class="room" data-cat="@Cat">
    <header class="room-head">
        <nav class="crumb"><a href="/">Evaluated Applications</a> <span>/</span> Prism</nav>
        <h1>Prism</h1>
        <p class="lede">A tiny AI that runs entirely in your browser. One model, five ways to use it: talk to it, have it
            write a story, watch one of its decisions take shape on a map, then point the same model at two other jobs and train it yourself.</p>
    </header>

    <nav class="pt-tabs" role="tablist" aria-label="What to do with Prism">
        @foreach (var t in PrismTabs.All)
        {
            if (Build.IsPrerender)
            {
                <a class="pt-tab-btn" role="tab" href="/tools/prism/#@t.Slug" data-blazier-go>@t.Title</a>
            }
            else
            {
                <a class="pt-tab-btn @(t.Tab == _tab ? "on" : "")" role="tab" aria-selected="@(t.Tab == _tab ? "true" : "false")"
                   href="/tools/prism/#@t.Slug" @onclick="() => Select(t.Tab)" @onclick:preventDefault>@t.Title</a>
            }
        }
    </nav>

    @if (Build.IsPrerender)
    {
        @* The shell: every tab's real heading and lede as indexable text, then one start button. The tab links above start the app on that tab. *@
        @foreach (var t in PrismTabs.All)
        {
            <section class="pt-shell-tab" id="@t.Slug">
                <h2>@t.Heading</h2>
                <p class="lede">@t.Lede</p>
            </section>
        }
        <ToolStart Tool="Prism" Data="the model file" />
    }
    else if (_loadError is not null)
    {
        <p class="err">@_loadError</p>
    }
    else if (_model is null)
    {
        <div class="boot-crt ck-boot">
            <div class="boot-head"><span class="boot-dot" aria-hidden="true"></span>downloading the model</div>
            <div class="boot-sub">one time only. Your browser keeps it after this, and every tab here uses this same download.</div>
            <div class="boot-log">
                @foreach (var s in Loader.Steps)
                {
                    <span class="l @s.Cls"><span class="p">&gt;</span> @s.Label <span class="boot-status">@s.Status</span></span>
                }
            </div>
        </div>
    }
    else
    {
        var info = PrismTabs.Of(_tab);
        <section class="pt-tab" role="tabpanel" aria-label="@info.Title">
            <h2>@info.Heading</h2>
            <p class="lede">@info.Lede</p>
            @switch (_tab)
            {
                case TabId.Chat:
                    <PrismChatPanel @key="_tab" Model="_model" />
                    break;
                case TabId.Stories:
                    <PrismStoriesPanel @key="_tab" Model="_model" />
                    break;
                case TabId.Map:
                    <PrismMapPanel @key="_tab" Model="_model" />
                    break;
                case TabId.Creature:
                    <PrismCreaturePanel @key="_tab" Model="_model" />
                    break;
                case TabId.Forecaster:
                    <PrismForecasterPanel @key="_tab" Model="_model" />
                    break;
            }
        </section>
    }

    <div class="outro">
        <p>The model is AlgFormer's holographic transformer, served with the Prism package; the Creature tab's answer key is Tracer's
            pathfinder. Pure managed .NET, running client-side.
            <code>dotnet add package EvaluatedApplications.AlgFormer</code></p>
    </div>
</div>

@code {
    TabId _tab = TabId.Chat;
    PrismModel? _model;
    string? _loadError;
    bool _subscribed;

    string Cat => _tab == TabId.Creature && !Build.IsPrerender ? "algformer-tracer" : "algformer";

    protected override async Task OnInitializedAsync()
    {
        if (Build.IsPrerender) return;   // the static shell fetches nothing (Blazier); the live page starts here
        _tab = PrismTabs.FromUri(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
        Loader.Changed += OnLoaderChanged;
        _subscribed = true;
        try { _model = await Loader.EnsureAsync(); }
        catch (Exception ex) { _loadError = "Couldn't load the checkpoint: " + ex.Message; }
    }

    // Choosing a tab writes it to the address (#slug) so the tab can be linked, reloaded and used with Back; the location change does the switch.
    void Select(TabId tab)
    {
        if (tab == _tab) return;
        Nav.NavigateTo("prism#" + PrismTabs.Of(tab).Slug);
        _tab = tab;
    }

    void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var rel = Nav.ToBaseRelativePath(e.Location);
        var path = rel.Split('#', '?')[0].TrimEnd('/');
        if (path != "prism") return;   // going to another page: this component is about to be disposed
        if (PrismTabs.Named(e.Location) is { } t && t != _tab) { _tab = t; InvokeAsync(StateHasChanged); }
    }

    void OnLoaderChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (!_subscribed) return;
        Nav.LocationChanged -= OnLocationChanged;
        Loader.Changed -= OnLoaderChanged;
    }
}
