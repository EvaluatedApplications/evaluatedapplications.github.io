@page "/prism"
@inject HttpClient Http
@using System.Text
@using PrismFormer

<PageTitle>Prism — talk to a live holographic-transformer checkpoint</PageTitle>

<div class="room">
    <header class="room-head">
        <nav class="crumb"><a href="/">Evaluated Applications</a> <span>/</span> Prism</nav>
        <h1>Prism</h1>
        <p class="lede">Type something, get a reply — from a real, working copy of our own trained <strong>HoloFormer</strong>
            checkpoint, running entirely <strong>in your browser</strong>. Not a finished chatbot: a small, honest,
            still-learning research model, with its internals laid bare underneath every reply.</p>
        <div class="badges">
            <span>Real trained checkpoint</span><span>Holographic-transformer brain</span><span>Full per-pass trace</span>
        </div>
    </header>

    @if (_loadError is not null)
    {
        <p class="err">@_loadError</p>
        <p class="hint">This tool ships a point-in-time copy of a live, evolving checkpoint — if the checkpoint asset
            hasn't been published to this build yet, that's expected, not a bug.</p>
    }
    else if (!_loaded)
    {
        <p class="hint">Loading the trained checkpoint (a few MB — cached by your browser after the first visit)…</p>
    }
    else
    {
        <div class="cr-stats">
            <div class="stat"><div class="n">@_brain!.ParamCount.ToString("N0")</div><div class="l">real stored parameters</div></div>
            <div class="stat"><div class="n">@EquivCompute.ToString("N0")</div><div class="l">dense-transformer-equivalent compute / token</div></div>
            <div class="stat"><div class="n">@(InvisibleX.ToString("F0"))×</div><div class="l">compute bought per stored parameter</div></div>
            <div class="stat"><div class="n">@_brain.Context</div><div class="l">tokens of context</div></div>
        </div>
        <div class="badges or-shape">
            <span>d=@_brain.Dim</span><span>@_brain.Layers layer(s)</span><span>shifts=@_brain.Shifts@(_brain.Golden ? " golden" : "")</span>
            <span>vocab=@_sym.Count subwords</span>@if (_rounds is not null) { <span>@_rounds.Value.ToString("N0") rounds trained</span> }
        </div>

        <div class="or-kctl">
            <label class="speed">K-pass depth (experimental, yours to try)
                <input type="range" min="1" max="6" step="1" value="@_kUser" @oninput="OnKChanged" disabled="@_generating" />
            </label>
            <span class="or-kval">K=@_kUser — @(_kUser == 1 ? "the checkpoint's own default (no extra resonance passes)" : $"reuses the same {_brain.Layers} layer(s) {_kUser}× — heavier, and this file was never trained at this depth")</span>
        </div>

        <div class="or-chat">
            <div class="or-transcript">
                @if (_transcript.Count == 0)
                {
                    <p class="hint">Try a short prompt — a word or two. The context window above is small on purpose;
                        this checkpoint is early in training.</p>
                }
                @foreach (var (who, text) in _transcript)
                {
                    <div class="or-msg @who"><span class="or-who">@(who == "you" ? "you" : "prism")</span><span class="or-text">@text</span></div>
                }
                @if (_generating) { <div class="or-msg prism pending"><span class="or-who">prism</span><span class="or-text">…</span></div> }
            </div>
            <div class="or-input-row">
                <input class="or-input" @bind="_prompt" @bind:event="oninput" @onkeydown="OnKeyDown" disabled="@_generating"
                       placeholder="say something short…" maxlength="60" />
                <button class="go" @onclick="Ask" disabled="@(_generating || string.IsNullOrWhiteSpace(_prompt))">
                    @(_generating ? "thinking…" : "Ask")
                </button>
            </div>
        </div>

        @if (_error is not null) { <p class="err">@_error</p> }

        @if (_lastTrace is not null && _lastTrace.Count > 0)
        {
            <div class="or-inspector">
                <div class="or-insp-head">
                    <h2>Inside that last reply</h2>
                    <p class="hint">One card per emitted character. <strong>GREEDY</strong> = the top decoded token cleared the
                        @((DecodeConfident * 100).ToString("F0"))% confidence gate outright. <strong>SAMPLED</strong> = it didn't, so the
                        model drew from every token whose resonance cleared a floor of mean + @(DecodeFloorK.ToString("0.#"))σ
                        (the "resonance floor" — everything under it reads as crosstalk noise, not signal) at temperature
                        @(DecodeTemp.ToString("0.00")). The row marked <span class="or-settle-tag">settles</span> is the first
                        layer/pass whose own top-1 decode already matches what actually got emitted.</p>
                </div>
                @for (int ci = 0; ci < _lastTrace.Count; ci++)
                {
                    var c = _lastTrace[ci];
                    <details class="or-char" open="@(ci == 0)">
                        <summary>
                            <span class="or-char-glyph">'@c.Ch'</span>
                            <span class="or-gate @(c.Greedy ? "greedy" : "sampled")">@(c.Greedy ? "GREEDY" : "SAMPLED")</span>
                            <span class="or-gate-detail">top '@c.TopSym' @((c.TopProb * 100).ToString("F1"))%@(c.Greedy ? "" : $" · {c.OverFloor} token(s) over the floor")</span>
                        </summary>
                        <div class="or-passes">
                            @foreach (var row in c.Rows)
                            {
                                <div class="or-pass-row @(row.Settle ? "settle" : "")">
                                    <div class="or-pass-label">@row.Label@(row.Settle ? " ◄ settles" : "")</div>
                                    <div class="or-faces">
                                        @foreach (var f in row.Top)
                                        {
                                            <span class="or-face">'@f.Sym' @(f.Pct.ToString("F0"))%</span>
                                        }
                                    </div>
                                    @if (row.Attn is not null)
                                    {
                                        <div class="or-attn-row">
                                            <span class="or-attn-lbl">attends</span>
                                            @foreach (var a in row.Attn)
                                            {
                                                <span class="or-attn">'@a.Sym'@@@a.Pos @(a.Pct.ToString("F0"))%</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </details>
                }
            </div>
        }

        <div class="outro">
            <p><strong>What's actually happening when you hit Ask.</strong> Every prompt becomes a handful of subword
                tokens, each bound into the model's holographic memory as a phase-and-magnitude pattern — a chord, not a
                row in a lookup table. Reading a prediction back out is an act of <em>resonance</em>: which stored
                pattern rings loudest against the current context. A conventional transformer buys depth by stacking
                many physically distinct, separately-trained layers. This model buys depth differently: the K-pass
                slider above re-runs the <em>same small transformation</em> over its own output, weight-tied, again and
                again. Each pass doesn't add new information so much as let the pattern interfere with itself again —
                building up harmonics, sharpening whichever resonance was already strongest, the way plucking a string
                at the right moment reinforces its own overtones instead of damping them. It's a real nonlinear
                dynamical system iterating on its own state, not a deeper stack of unique weights — which is exactly
                why the parameter count above is worth reading twice: <code>@_brain.ParamCount.ToString("N0")</code>
                real numbers, reused <code>@_kUser</code>× per layer, standing in for the
                <code>@EquivCompute.ToString("N0")</code>-parameter dense transformer it would otherwise take to
                build that same depth of transformation from scratch.</p>

            <p><strong>Where this checkpoint stands, and where it's headed.</strong> Right now: @_brain.ParamCount.ToString("N0")
                real stored parameters, a @_sym.Count-token subword vocabulary, and an @_brain.Context-token context
                window — an honest, early snapshot of an ongoing training run, not a finished product.
                <strong>Next rung:</strong> GPT-2 small (OpenAI, 2019) — 124,000,000 real dense parameters, the smallest
                of the original public GPT-2 releases and the field's most commonly-cited "smallest real language
                model" reference point. That's the next milestone on the dense-equivalent-compute axis: grow context,
                vocabulary and resonance depth until this checkpoint's own compute budget clears that line, while its
                real stored-parameter count stays a small fraction of it. <strong>Further out:</strong> GPT-2 medium
                (355M) and large (774M) sit beyond that as the next horizons. None of this is a promise the model will
                write like GPT-2 once the compute number clears a line — compute budget and capability are not the
                same thing — it's just an honest way to watch a real number move over time.</p>

            <p><strong>Being honest about it.</strong> This checkpoint's vocabulary and context window are both still
                small — expect short, rough, sometimes broken output, not fluent conversation, and don't be surprised
                if a reply trails into a repeated character: the confidence gate above can read GREEDY even once the
                model has settled into a loop, a known, real behaviour this early in training (the Inspector will show
                you exactly where it happened, rather than hiding it). It's a frozen copy from one point in an active
                training run in PrismStudio, not a live link to it — the real model keeps training after this snapshot
                was taken. The K-pass slider above lets you explore depths this exact checkpoint was never actually
                trained at; treat anything above K=1 as "what if", not "what it does."</p>

            <p>The brain is <code>AlgFormer</code>'s holographic transformer — the same substrate behind
                <a href="/creature">The Creature</a> and <a href="/forecaster">The Forecaster</a>, and the one that lets
                <a href="/analyst">The Analyst</a>'s database hold a running total as a single vector. Pure managed
                .NET, running entirely client-side. <code>dotnet add package EvaluatedApplications.AlgFormer</code></p>
        </div>
    }
</div>

@code {
    // ---- ported constants (from PrismStudio/PrismGym's HoloEngine.cs PickToken/GateInfo — reference only; this repo
    // consumes the checkpoint file + the published AlgFormer NuGet API, never MonoRepo/PrismFormer source directly).
    // Greedy when the top decoded token clears DecodeConfident outright; otherwise sample at DecodeTemp from every
    // token whose resonance clears a floor of mean + DecodeFloorK standard deviations (the "resonance floor" — the
    // decode is a correlation readback against the codebook, so most tokens form a crosstalk noise bulk and the real
    // signal stands out above it).
    const double DecodeConfident = 0.60, DecodeTemp = 0.80, DecodeFloorK = 3.0;
    const int InspectTopK = 3;      // top-K faces/attention entries shown per pass row
    const int MaxReplyChars = 40;   // a runaway guard — this checkpoint's context is tiny, long replies aren't meaningful yet
    const int DegenRepeat = 4;      // ported from HoloEngine.cs's ProbeDegenRepeat — N identical tokens in a row = a collapsed run

    HoloFormer? _brain;
    bool _loaded; string? _loadError; string? _error;
    long? _rounds;   // optional: only shown if data/oracle-rounds.txt was published alongside the checkpoint

    // ---- vocab: CharVocab.Lo..Hi (published PrismFormer.CharVocab) as the 95-char base + "\n" + merged subwords
    // loaded from the bundled vocab.txt — a from-scratch greedy-longest-match tokenizer built to match EXACTLY how
    // the embedded checkpoint's own vocab.txt was produced (ported algorithm, not a MonoRepo reference at runtime).
    readonly List<string> _sym = new();
    readonly Dictionary<string, int> _id = new(StringComparer.Ordinal);
    readonly Dictionary<char, int> _firstMax = new();
    int _stop;   // CharVocab.End — doubles as both the "\n" token id and the generation stop marker (real, ported behaviour)

    int _kUser = 1;
    bool _generating;
    string _prompt = "";
    readonly List<(string who, string text)> _transcript = new();
    List<CharTrace>? _lastTrace;

    long EquivCompute => HoloShape.EquivCompute(_brain!.Dim, _brain.Layers, Math.Max(1, _brain.Iters));
    double InvisibleX => HoloShape.InvisibleMultiplier(_brain!.ParamCount, _brain.Dim, _brain.Layers, Math.Max(1, _brain.Iters));

    sealed record FaceItem(string Sym, double Pct);
    sealed record AttnItem(string Sym, int Pos, double Pct);
    sealed record PassRow(string Label, List<FaceItem> Top, List<AttnItem>? Attn, bool Settle);
    sealed record CharTrace(string Ch, bool Greedy, string TopSym, double TopProb, int OverFloor, List<PassRow> Rows);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var vocabText = await Http.GetStringAsync("data/oracle-vocab.txt");
            BuildVocab(vocabText);
            var bytes = await Http.GetByteArrayAsync("data/oracle-brain.bin");
            _brain = HoloFormer.Deserialize(bytes);
            _kUser = Math.Max(1, _brain.Iters);
            _brain.Iters = _kUser;
            _brain.IterAlphaServe = 1.0;   // the file doesn't carry the live app's K-pass ramp state — always serve fully composed
            try { _rounds = long.Parse((await Http.GetStringAsync("data/oracle-rounds.txt")).Trim()); } catch { _rounds = null; }
            _loaded = true;
        }
        catch (Exception ex) { _loadError = "Couldn't load the checkpoint: " + ex.Message; }
    }

    void BuildVocab(string vocabText)
    {
        for (var i = 0; i < CharVocab.End; i++) AddSym(((char)(CharVocab.Lo + i)).ToString());
        AddSym("\n");
        foreach (var line in vocabText.Replace("\r\n", "\n").Split('\n'))
            if (line.Length > 0) AddSym(line);
        _stop = CharVocab.End;
    }

    void AddSym(string s)
    {
        if (_id.ContainsKey(s)) return;
        var id = _sym.Count; _sym.Add(s); _id[s] = id;
        var f = s[0];
        if (!_firstMax.TryGetValue(f, out var m) || s.Length > m) _firstMax[f] = s.Length;
    }

    static string Normalize(string text)
    {
        var sb = new StringBuilder(text.Length);
        foreach (var c in text) sb.Append(c >= CharVocab.Lo && c <= CharVocab.Hi ? c : ' ');
        return sb.ToString();
    }

    int[] Encode(string text)
    {
        var s = Normalize(text);
        var outp = new List<int>(s.Length);
        var i = 0;
        while (i < s.Length)
        {
            var c0 = s[i];
            int matched = 1, id = _id.TryGetValue(c0.ToString(), out var cid) ? cid : 0;
            var max = _firstMax.TryGetValue(c0, out var fm) ? Math.Min(fm, s.Length - i) : 1;
            for (var len = max; len >= 2; len--)
                if (_id.TryGetValue(s.Substring(i, len), out var tid)) { id = tid; matched = len; break; }
            outp.Add(id); i += matched;
        }
        return outp.ToArray();
    }

    string Decode(IEnumerable<int> ids)
    {
        var sb = new StringBuilder();
        foreach (var id in ids) if (id != _stop && id >= 0 && id < _sym.Count) sb.Append(_sym[id]);
        return sb.ToString();
    }

    // display glyph for a symbol id — the stop id doubles as "\n" in the real vocab (the model was trained on
    // single-line snippets, so a newline IS the stop signal; shown explicitly rather than as an invisible blank)
    string SymDisplay(int id)
    {
        if (id == _stop) return "⏹";
        var s = id >= 0 && id < _sym.Count ? _sym[id] : "?";
        return s == " " ? "·" : s;
    }

    // ---- ported PickToken/GateInfo (HoloEngine.cs) — same thresholds, GateInfo without the RNG draw so the
    // Inspector can label WHY a character was emitted without re-drawing the sample itself.
    static (int top, double topProb, bool greedy, int overFloor) GateInfo(double[] lg, int V)
    {
        var top = 0; var max = lg[0];
        for (var i = 1; i < V; i++) if (lg[i] > max) { max = lg[i]; top = i; }
        double sum = 0; for (var i = 0; i < V; i++) sum += Math.Exp(lg[i] - max);
        var topProb = 1.0 / sum;
        if (topProb >= DecodeConfident) return (top, topProb, true, 1);
        double mean = 0; for (var i = 0; i < V; i++) mean += lg[i]; mean /= V;
        double var2 = 0; for (var i = 0; i < V; i++) { var dd = lg[i] - mean; var2 += dd * dd; } var2 /= V;
        var floor = Math.Min(mean + DecodeFloorK * Math.Sqrt(var2), max);
        int over = 0; for (var i = 0; i < V; i++) if (lg[i] >= floor) over++;
        return (top, topProb, false, over);
    }

    static int PickToken(double[] lg, int V)
    {
        var top = 0; var max = lg[0];
        for (var i = 1; i < V; i++) if (lg[i] > max) { max = lg[i]; top = i; }
        double sum = 0; for (var i = 0; i < V; i++) sum += Math.Exp(lg[i] - max);
        if (1.0 / sum >= DecodeConfident) return top;
        double mean = 0; for (var i = 0; i < V; i++) mean += lg[i]; mean /= V;
        double var2 = 0; for (var i = 0; i < V; i++) { var dd = lg[i] - mean; var2 += dd * dd; } var2 /= V;
        var floor = Math.Min(mean + DecodeFloorK * Math.Sqrt(var2), max);
        var tp = new double[V]; double tsum = 0;
        for (var i = 0; i < V; i++) { tp[i] = lg[i] >= floor ? Math.Exp((lg[i] - max) / DecodeTemp) : 0.0; tsum += tp[i]; }
        var r = Random.Shared.NextDouble() * tsum; double acc = 0;
        for (var i = 0; i < V; i++) { acc += tp[i]; if (r <= acc) return i; }
        return top;
    }

    List<FaceItem> TopFaces(double[] face, int n)
    {
        var lg = _brain!.DecodeFace(face);
        var V = Math.Min(lg.Length, _sym.Count);
        double mx = double.NegativeInfinity; for (var i = 0; i < V; i++) if (lg[i] > mx) mx = lg[i];
        var p = new double[V]; double s = 0;
        for (var i = 0; i < V; i++) { p[i] = Math.Exp(lg[i] - mx); s += p[i]; }
        return Enumerable.Range(0, V).OrderByDescending(i => p[i]).Take(n).Select(i => new FaceItem(SymDisplay(i), 100 * p[i] / s)).ToList();
    }

    List<AttnItem> TopAttn(int[] ctx, double[] res, int n)
    {
        double mx = res.Max(); double s = 0; var p = new double[res.Length];
        for (var i = 0; i < res.Length; i++) { p[i] = Math.Exp(res[i] - mx); s += p[i]; }
        return Enumerable.Range(0, res.Length).OrderByDescending(j => p[j]).Take(n)
            .Select(j => new AttnItem(SymDisplay(ctx[j]), j, 100 * p[j] / s)).ToList();
    }

    void OnKChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var k)) { _kUser = Math.Clamp(k, 1, 6); if (_brain is not null) _brain.Iters = _kUser; }
    }

    async Task OnKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await Ask(); }

    async Task Ask()
    {
        if (_brain is null || string.IsNullOrWhiteSpace(_prompt) || _generating) return;
        var promptText = _prompt.Trim();
        _prompt = "";
        _generating = true; _error = null;
        _transcript.Add(("you", promptText));
        StateHasChanged();

        try
        {
            var seq = new List<int>(Encode(promptText));
            var outIds = new List<int>();
            var trace = new List<CharTrace>();
            var K = Math.Max(1, _brain.Iters);
            var alpha = _brain.IterAlphaServe;
            var prevT = -1; var repeatStreak = 0; var trailedOff = false;   // repetition-collapse guard, ported from
            // HoloEngine.cs's own ProbeDegenRepeat=4 — a known behaviour this early in training (the confidence gate
            // still reads GREEDY on a collapsed distribution), surfaced honestly rather than silently padded with spaces

            for (var step = 0; step < MaxReplyChars; step++)
            {
                var take = Math.Min(seq.Count, _brain.Context);
                var ctx = take > 0 ? seq.Skip(seq.Count - take).ToArray() : new[] { 0 };

                var snaps = _brain.InspectStackIter(ctx, K, alpha);
                var attn = _brain.InspectAttention(ctx, K, alpha);
                var final = _brain.DecodeFace(snaps[^1]);
                var V = Math.Min(final.Length, _sym.Count);
                var gate = GateInfo(final, V);
                var t = PickToken(final, V);

                var settleAt = -1;
                for (var i = 0; i < snaps.Length; i++)
                {
                    var lg = _brain.DecodeFace(snaps[i]);
                    var vv = Math.Min(lg.Length, _sym.Count);
                    var top = 0; var mx = lg[0]; for (var j = 1; j < vv; j++) if (lg[j] > mx) { mx = lg[j]; top = j; }
                    if (top == t) { settleAt = i; break; }
                }
                var rows = new List<PassRow>();
                for (var i = 0; i < snaps.Length; i++)
                {
                    var label = i == 0 ? "input (embedding)" : i == snaps.Length - 1 ? "final" : $"layer {(i - 1) / K + 1} · pass {(i - 1) % K + 1}";
                    var top = TopFaces(snaps[i], InspectTopK);
                    List<AttnItem>? at = i == 0 ? null : TopAttn(ctx, attn[i - 1], InspectTopK);
                    rows.Add(new PassRow(label, top, at, i == settleAt));
                }
                trace.Add(new CharTrace(SymDisplay(t), gate.greedy, SymDisplay(gate.top), gate.topProb, gate.overFloor, rows));

                if (t == _stop) break;
                outIds.Add(t); seq.Add(t);
                repeatStreak = t == prevT ? repeatStreak + 1 : 1; prevT = t;
                if (repeatStreak >= DegenRepeat) { trailedOff = true; break; }
                _generating = true;
                StateHasChanged();
                await Task.Delay(20);
            }

            var shown = Decode(outIds).TrimEnd();
            var responseText = shown.Length > 0 ? shown : "(blank — this checkpoint is still very early in training)";
            if (trailedOff) responseText += "  ⋯ settled into a repeat loop (a known behaviour this early in training, not a bug)";
            _transcript.Add(("prism", responseText));
            _lastTrace = trace;
        }
        catch (Exception ex) { _error = "Prism stumbled: " + ex.Message; }
        finally { _generating = false; StateHasChanged(); }
    }
}
