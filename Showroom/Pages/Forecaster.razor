@page "/forecaster"
@inject HttpClient Http
@inject HoloKernel.SessionHost Sessions
@using System.Text
@using System.Text.Json
@using PrismFormer
@using HoloKernel

<PageTitle>The Forecaster — a price-direction brain that learns live in your browser</PageTitle>

<div class="room" data-cat="algformer">
    <header class="room-head">
        <nav class="crumb"><a href="/">Evaluated Applications</a> <span>/</span> The Forecaster</nav>
        <h1>The Forecaster</h1>
        <p class="lede">Give it real historical price ticks, then watch a small brain learn to call the <strong>next
            move — in your browser, on your machine</strong>. Same holographic transformer as <a href="/creature">The
            Creature</a> (AlgFormer), pointed at a different stream: instead of a foraging trail, it reads a
            candle-by-candle price tape and learns to predict whether the next tick goes up, down, or stays flat.</p>
        <div class="badges">
            <span>Holographic-transformer brain</span><span>~2 years of real historical ticks</span><span>Learns live, on your device</span>
        </div>
    </header>

    @if (_loadError is not null)
    {
        <p class="err">@_loadError</p>
    }
    else if (!_loaded)
    {
        <p class="hint">Loading the price tape…</p>
    }
    else
    {
        <div class="fc-source">
            <span class="fc-src-label">Price tape</span>
            <span class="fc-src-name">@SymbolName · hourly OHLC · @_candles.Count.ToString("N0") ticks</span>
            <span class="fc-src-note">real historical data pulled from Yahoo Finance at build time (no server at
                runtime — this bundle ships with the app and replays locally)@(_liveNote is null ? "" : " · ")@_liveNote</span>
        </div>

        <div class="fc-stage">
            @((MarkupString)ChartSvg())

            @if (_revealing)
            {
                <div class="fc-predict-strip" @key="_revealTick">
                    <span class="fc-predict-dir dir-@DirClass(_pendingPredDir)">@DirGlyph(_pendingPredDir)</span>
                    <span class="fc-predict-label">the brain's guess for the next tick — revealing…</span>
                    <div class="fc-countdown"><div class="fc-countdown-bar" style="animation-duration:@(_revealMs)ms"></div></div>
                </div>
            }
            @if (_lastResult is not null)
            {
                <div class="fc-flash fc-flash-@_lastResult" @key="@("flash" + _revealTick)">
                    @(_lastResult == "win" ? "✓ called it" : "✗ missed it")
                </div>
            }
        </div>

        <div class="cr-controls">
            <button class="go" @onclick="ToggleRun">@(_running ? "Pause" : (_session is null ? "Start training" : "Resume training"))</button>
            <button class="ghost" @onclick="TrainOnce" disabled="@_running" type="button">Train one tick</button>
            <button class="ghost" @onclick="ResetBrain" type="button">Reset brain</button>
            <button class="ghost @(_showInspector ? "on" : "")" @onclick="ToggleInspector" type="button">🔍 inspect brain</button>
            <label class="speed">speed
                <input type="range" min="1" max="10" @bind="_speed" @bind:event="oninput" />
            </label>
        </div>

        @if (_error is not null) { <p class="err">@_error</p> }

        @if (_trained > 0)
        {
            <div class="cr-stats">
                <div class="stat"><div class="n">@_trained.ToString("N0")</div><div class="l">ticks trained</div></div>
                <div class="stat"><div class="n">@(_recentAcc.ToString("F0"))%</div><div class="l">accuracy, last @Math.Min(_recentWindow.Count, RecentCap)</div></div>
                <div class="stat"><div class="n">@(_lifetimeAcc.ToString("F0"))%</div><div class="l">lifetime accuracy</div></div>
            </div>
            <figure class="cr-curve">
                <figcaption>rolling accuracy (last @RecentCap ticks) over training — it should climb above the 50/50 baseline as the brain learns</figcaption>
                @if (_accCurve.Count > 1) { @((MarkupString)AccCurveSvg()) }
            </figure>
        }

        @if (_log.Count > 0)
        {
            <div class="cr-log">
                <div class="log-head">training log <span class="log-sub">newest first · loss backpropped through the @_kPass weight-tied passes</span></div>
                <div class="log-body">
                    @foreach (var line in _log) { <div class="log-line">@line</div> }
                </div>
            </div>
        }

        @if (_showInspector && _lastTrace is not null && _lastCtx is not null)
        {
            <div class="cr-log">
                <div class="log-head">last prediction <span class="log-sub">direction confidence, pass by pass — the same per-pass view as <a href="/creature">The Creature</a> and <a href="/prism">Prism</a></span></div>
                <div class="log-body">
                    @for (int p = 0; p < _lastTrace.Passes.Count; p++)
                    {
                        <div class="log-line">pass @p @(p == _lastTrace.Passes.Count - 1 ? "(final)" : "") — @TopDirText(_lastTrace.Passes[p].Logits)</div>
                    }
                    <div class="log-line">attends → @AttentionText(_lastCtx, _lastTrace.Attention[^1])</div>
                </div>
            </div>
        }

        <div class="outro">
            <p><strong>What it's actually predicting.</strong> Every hourly tick becomes two tokens — an hour-of-day
                bucket and a return bucket (how big the move was and which way) — read off tight-deadband edges
                sized so a real move registers as up or down instead of collapsing to "flat". The brain reads the
                recent tape and predicts the <em>next</em> return bucket; it scores as right when it calls the
                right <em>direction</em>. It uses the same live-training approach as <a href="/creature">The
                Creature</a> — one holographic layer applied twice, weight-tied, composed fully from the very
                first tick. Each candle is revealed as a two-step beat: the brain's guess appears first (the
                dashed strip above the chart, with a countdown bar), then the real candle lands and you see
                whether it called it — same order the brain itself experiences it in, just slowed down enough
                to watch.</p>
            <p><strong>Where the data comes from.</strong> The bulk of the tape (~2 years of real hourly AAPL
                candles) is pulled from Yahoo Finance's public chart API at build time — that endpoint has no
                CORS headers at all, so it can only ever be fetched server-side, not from your browser, which is
                why it ships as a bundled file rather than a live call. @(_liveNote is not null ? _liveNote + " " : "")
                When available, one genuinely live tick is layered on top from a CORS-open real-time quote API,
                fetched once when this page loads.</p>
            <p><strong>Being honest about it:</strong> this is a demo, not investment advice — even a couple of
                thousand hourly ticks of one stock is a small, noisy sample, and "right direction" is a
                coin-flip-adjacent bar. Watch the accuracy curve rather than trusting any single prediction.</p>
            <p>The brain is <code>AlgFormer</code>'s holographic transformer, the very same substrate that lets
                <a href="/analyst">The Analyst</a>'s database hold a running total as one vector. Pure managed .NET,
                running entirely client-side. <code>dotnet add package EvaluatedApplications.AlgFormer</code></p>
        </div>
    }
</div>

@code {
    // ---- tokenisation (ported from MarketSim.PriceForecaster's proven scheme; STOCK_i token dropped — single symbol here) ----
    const int TimeBuckets = 8;
    // Tight-deadband return edges, ported VERBATIM from MarketSim.PriceForecaster.RetEdges — tuned so a small real
    // price move registers as up/down instead of collapsing to "flat". Real hourly moves on this sample skew toward
    // the outer buckets (the edges were tuned for MarketSim's simulated poll-to-poll ticks, which are smaller than a
    // real hourly close-to-close move) — direction still splits close to 50/50, which is what accuracy is scored on.
    static readonly double[] RetEdges = { -0.0020, -0.0009, -0.0004, -0.00003, 0.00003, 0.0004, 0.0009, 0.0020 };
    const int PriceBuckets = 9, FlatBucket = 4;
    const int Vocab = TimeBuckets + PriceBuckets;   // 17 — time tokens then price tokens
    const int PriceBase = TimeBuckets;

    // ---- model shape — ported onto HoloKernel's ModelSpec 2026-08-28 (was a hand-rolled HoloFormer ctor + a
    // MinShifts block comment re-deriving the bindRank=shifts*d/2 reasoning The Creature's file already carried;
    // ModelSpec.MinShifts's own doc comment holds that reasoning once now). Numbers unchanged from prior tuning —
    // this pass (2026-08-29) only changed the DATA feeding training, not the model architecture.
    const int Dim = 128;          // MarketSim's tuned width for this task class
    const int Layers = 1;         // one layer, applied K times weight-tied (below)
    // K-pass depth — LIVE-READ from data/oracle-stackk.txt 2026-08-28 (was a hardcoded `const int KPass = 2`, a
    // made-up number unrelated to anything real). The site's single real trained depth is Prism's own checkpoint
    // metadata (the exact sidecar Prism.razor's OnInitializedAsync already fetches) — every HoloFormer tool on
    // the site now reads K from THAT one source of truth instead of inventing its own, so it auto-updates if the
    // checkpoint is ever retrained at a different K, no code change needed anywhere. Forecaster still trains its
    // OWN model from scratch on its OWN task (price-bucket vocab=17) — only the K NUMBER is shared, never
    // weights/vocab/checkpoint (architecturally unrelated tasks). Fetch/parse/fallback mirrors Prism.razor's
    // oracle-stackk.txt handling exactly (try→parse→trim; any failure — file missing, malformed, network error —
    // is swallowed and falls back to Prism's own bare-checkpoint fallback value of 1, never blocking page load).
    int _kPass = 1;                // weight-tied extra pass (Iters)
    // Alpha-ramp REMOVED 2026-08-28 (direct instruction): the old IterWarm ease-in existed because this tool
    // used to pick its own made-up KPass (2) as a fresh design decision that needed easing in. That premise is
    // gone — K is live-read from Prism's own already-proven trained depth (above), not something new being
    // introduced, so there's nothing to ease into. The model composes fully from the first tick; see
    // HoloKernel.AlphaRamp.Complete at the EnsureBrain call site.
    const int CandleContext = 128;              // ~128 candles of history
    const int MaxContext = CandleContext * 2;   // 256 tokens — TIME+RETURN pair per candle
    const int MinShifts = 8;   // verified no-op here: ModelSpec.Shifts (ShiftsFor(256,128)=16) already clears it

    const double Lr = 0.005;   // a reasoned starting point (between MarketSim's batched-epoch 0.02 and Creature's
                                // per-step 0.0025-0.004), NOT yet measured live — flag for tuning once someone watches it train
    const int RecentCap = 50;  // rolling-accuracy window
    const string SymbolName = "AAPL";

    // ---- data (2026-08-29 rework: bigger build-time bundle + optional live top-up, see
    // Showroom/todo/forecaster-live-data-research.md for the full research this is based on) ----
    // Full OHLC now (was close-only) — the historical pull already carries open/high/low for free from Yahoo's
    // chart endpoint, so the chart can render real candlesticks instead of a bare close-price line.
    sealed record RawCandle(long T, double O, double H, double L, double C);
    sealed record CandleData(int TimeTok, int Bucket, double Open, double High, double Low, double Close, DateTime TimeUtc);
    readonly List<CandleData> _candles = new();
    bool _loaded; string? _loadError;
    string? _liveNote;   // set describing whether/why a live Finnhub top-up did or didn't land — null means "no attempt", not an error

    // brain — HoloKernel, same as The Creature (see that file for the full rationale): HoloSession wraps the
    // model + K/alpha, RefinementLoop.Observe replaces the hand-written NewGrads->IterAccumulate->Step triple
    // this file used to carry independently. AlphaRamp.Complete (no ease-in, see _kPass comment above) is
    // passed straight through rather than stored on the instance — nothing needs to read its state.
    HoloSession? _session;
    RefinementLoop? _loop;
    readonly List<int> _seq = new();   // the growing token tape the brain reads as context
    int _pos = 1;                      // cursor into the bundled series (wraps — it's a finite real sample)
    long _trained;

    // Inspector (NEW capability, 2026-08-28 — see The Creature's file for why it's opt-in).
    bool _showInspector;
    PositionTrace? _lastTrace;
    int[]? _lastCtx;

    readonly Queue<bool> _recentWindow = new();
    long _correctLifetime, _totalLifetime;
    double _recentAcc, _lifetimeAcc;
    readonly List<double> _accCurve = new();

    sealed record Point(double Open, double High, double Low, double Close, DateTime TimeUtc, int PredDir, int ActualDir, bool Correct);
    readonly List<Point> _recent = new();
    const int ChartWindow = 70;

    // ---- predict-ahead / countdown / win-lose animation state (2026-08-29, direct instruction) ----
    // The chart now shows the brain's guess BEFORE the real candle lands, counts down, then reveals — same
    // predict-then-train order the loop always ran in, just staged into two visible beats instead of one
    // instantaneous update. This REPLACES the old burst-of-N-ticks-then-pause loop pacing in ToggleRun (below):
    // the speed slider used to control how many ticks got trained per animation frame; it now controls how FAST
    // the predict/countdown/reveal cycle runs, since running many ticks per frame is incompatible with watching
    // each one resolve. A real, deliberate throughput tradeoff, not an oversight.
    bool _revealing;            // true while the countdown to reveal is running (drives the dashed strip + bar)
    int _pendingPredDir;        // the strip's predicted direction, -1/0/1
    int _revealMs = 500;        // current countdown duration in ms, recomputed from _speed every tick — the SAME
                                 // number drives both the real await delay and the CSS bar's animation-duration,
                                 // so the bar never lies about how long the wait actually is.
    int _revealTick;            // increments every predict — used as a Blazor @key so the countdown/flash elements
                                 // remount each tick, which is what makes their CSS animation restart from 0 instead
                                 // of just sitting there (Blazor otherwise diffs/reuses the existing DOM node).
    string? _lastResult;        // "win" | "lose" once a reveal has happened, null before the first one / while predicting

    readonly List<string> _log = new();
    void Log(string s) { _log.Insert(0, s); if (_log.Count > 200) _log.RemoveAt(_log.Count - 1); }

    bool _running; int _speed = 5; string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var opts = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var raw = await Http.GetFromJsonAsync<List<RawCandle>>("data/forecaster-history.json", opts) ?? new();

            // Optional live top-up (2026-08-29) — see TryFetchLiveTopUpAsync for the full graceful-degradation
            // story. Only appended if it's genuinely newer than the bundle's own last row, so the return-bucket
            // math below (which assumes strictly increasing time / a real close-to-close move) stays sound.
            var live = await TryFetchLiveTopUpAsync();
            if (live is not null && raw.Count > 0 && live.T > raw[^1].T) raw.Add(live);

            for (int i = 1; i < raw.Count; i++)
            {
                double ret = (raw[i].C - raw[i - 1].C) / raw[i - 1].C;
                int timeTok = (int)(DateTimeOffset.FromUnixTimeSeconds(raw[i].T).UtcDateTime.TimeOfDay.TotalHours) % TimeBuckets;
                var timeUtc = DateTimeOffset.FromUnixTimeSeconds(raw[i].T).UtcDateTime;
                _candles.Add(new CandleData(timeTok, Bucket(ret), raw[i].O, raw[i].H, raw[i].L, raw[i].C, timeUtc));
            }

            // Mirrors Prism.razor's own oracle-stackk.txt fetch exactly (GetStringAsync -> Trim -> int.Parse),
            // including its degrade-gracefully behaviour: any failure (file missing, malformed, network error)
            // is swallowed and falls back to the same K=1 Prism itself falls back to — never blocks page load.
            try { _kPass = int.Parse((await Http.GetStringAsync("data/oracle-stackk.txt")).Trim()); }
            catch { _kPass = 1; }

            _loaded = true;
        }
        catch (Exception ex) { _loadError = "Couldn't load the price tape: " + ex.Message; }
    }

    // ---- live top-up (2026-08-29) — Finnhub's /quote endpoint, the one genuinely CORS-open, US-real-time-capable
    // free API found in Showroom/todo/forecaster-live-data-research.md's research. Every failure mode here is
    // NON-fatal by design: no key present, market closed, network error, rate-limited — all just mean "no top-up",
    // never a page error, matching the house `_loadError`/graceful-degradation pattern used everywhere else in
    // this app. The key itself is NOT embedded in source (this repo has no server to keep a secret anyway, and no
    // key exists to embed here — registering one is a real self-serve step, instant, no card, at finnhub.io/register)
    // — it's read from an optional sidecar file, data/finnhub-key.txt, that simply doesn't exist by default. This
    // is the exact same hand-off shape this repo already uses for Prism's checkpoint (see Showroom/CLAUDE.md's
    // "Checkpoint hand-off" boundary note): drop the file, the capability turns on; leave it absent, the tool
    // still works fully on the historical bundle alone.
    sealed record FinnhubQuote(double c, double h, double l, double o, double pc, long t);

    async Task<RawCandle?> TryFetchLiveTopUpAsync()
    {
        try
        {
            var key = (await Http.GetStringAsync("data/finnhub-key.txt")).Trim();
            if (string.IsNullOrEmpty(key)) return null;

            if (!IsNyseOpenNowUtc())
            {
                _liveNote = "live top-up skipped (NYSE is closed right now) — historical bundle only";
                return null;
            }

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(6));
            var url = $"https://finnhub.io/api/v1/quote?symbol={SymbolName}&token={Uri.EscapeDataString(key)}";
            var resp = await Http.GetAsync(url, cts.Token);
            if (!resp.IsSuccessStatusCode)
            {
                _liveNote = $"live top-up unavailable ({(int)resp.StatusCode}) — historical bundle only";
                return null;
            }
            var q = await resp.Content.ReadFromJsonAsync<FinnhubQuote>(cancellationToken: cts.Token);
            if (q is null || q.c <= 0 || q.t <= 0)
            {
                _liveNote = "live top-up returned no data — historical bundle only";
                return null;
            }

            _liveNote = "+ one genuinely live Finnhub tick layered on top (fetched at page load)";
            double open = q.o > 0 ? q.o : q.pc;
            double hi = Math.Max(q.h, Math.Max(open, q.c));
            double lo = q.l > 0 ? Math.Min(q.l, Math.Min(open, q.c)) : Math.Min(open, q.c);
            return new RawCandle(q.t, open, hi, lo, q.c);
        }
        catch
        {
            // Covers: sidecar file missing (the default/undeployed state — expected, silent), network failure,
            // CORS-blocked (shouldn't happen per the research, but fail closed if Finnhub ever changes that),
            // malformed JSON, timeout. Deliberately no _liveNote set here for the "file missing" case specifically
            // (the common case) so the UI doesn't show a permanent "live top-up failed" note on every single visit
            // when nobody has ever dropped a key — only genuine attempt-then-fail paths above set an explanatory
            // note; a bare missing key file is just silence, exactly like oracle-stackk.txt's own fallback.
            return null;
        }
    }

    // Fails CLOSED on purpose: if the IANA "America/New_York" zone can't be resolved (unlikely in a modern WASM
    // ICU build, but not guaranteed), this returns false rather than guessing a fixed UTC window — a missed live
    // top-up is a cosmetic loss; a wrong-hours guess making a pointless request against a rate limit is not worth
    // risking. See Showroom/todo/forecaster-live-data-research.md §3 for the market-hours table this reflects.
    static bool IsNyseOpenNowUtc()
    {
        try
        {
            var tz = TimeZoneInfo.FindSystemTimeZoneById("America/New_York");
            var nowEt = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, tz);
            if (nowEt.DayOfWeek == DayOfWeek.Saturday || nowEt.DayOfWeek == DayOfWeek.Sunday) return false;
            var open = nowEt.Date.AddHours(9).AddMinutes(30);
            var close = nowEt.Date.AddHours(16);
            return nowEt >= open && nowEt <= close;
        }
        catch { return false; }
    }

    static int Bucket(double r) { int b = 0; while (b < RetEdges.Length && r >= RetEdges[b]) b++; return b; }
    static int Dir(int bucket) => bucket < FlatBucket ? -1 : bucket > FlatBucket ? 1 : 0;
    static string DirGlyph(int d) => d > 0 ? "▲" : d < 0 ? "▼" : "–";
    static string DirClass(int d) => d > 0 ? "up" : d < 0 ? "down" : "flat";

    static int ArgMaxPriceBucket(double[] logits)
    {
        int predBucket = 0; double best = double.NegativeInfinity;
        for (int b = 0; b < PriceBuckets; b++) { double v = logits[PriceBase + b]; if (v > best) { best = v; predBucket = b; } }
        return predBucket;
    }

    int[] BuildCtx()
    {
        int take = Math.Min(_seq.Count, MaxContext);
        var a = new int[take];
        for (int j = 0; j < take; j++) a[j] = _seq[_seq.Count - take + j];
        return a;
    }

    async Task EnsureBrain()
    {
        if (_session is not null) return;
        var spec = new ModelSpec { Vocab = Vocab, MaxContext = MaxContext, Dim = Dim, Layers = Layers, MinShifts = MinShifts, KPass = _kPass, FrozenPrefix = 0, Golden = true };
        // SessionHost dedupes by MODEL key ("forecaster"): first visit this page load builds untrained
        // exactly as before; a later visit in the same load reuses the same in-memory session instead of
        // rebuilding it — the factory below simply never runs a second time.
        bool reused = Sessions.IsLoaded("forecaster");
        _session = await Sessions.GetOrCreateAsync("forecaster", () => Task.FromResult(HoloSession.Create(spec)));
        // No ease-in (2026-08-28, direct instruction): K is Prism's own already-proven trained depth, not a
        // fresh design choice this tool is introducing, so there's nothing to ramp into — serve fully
        // composed from the very first tick, not just once the first Observe() call happens to run.
        _session.ApplyServe(AlphaRamp.Complete);
        _loop = new RefinementLoop(_session, AlphaRamp.Complete, Lr);
        Log(reused
            ? $"brain reused from earlier this visit · L={Layers} · K={_kPass} weight-tied passes · ctx={MaxContext} tokens (~{CandleContext} candles) · shifts={spec.Shifts} golden · d={Dim} · vocab={Vocab} · {_session.Model.ParamCount:N0} params"
            : $"brain ready · L={Layers} · K={_kPass} weight-tied passes · ctx={MaxContext} tokens (~{CandleContext} candles) · shifts={spec.Shifts} golden · d={Dim} · vocab={Vocab} · {_session.Model.ParamCount:N0} params");
    }

    // One full predict -> countdown -> reveal+train beat. Replaces the old synchronous TrainOnceStep: the
    // PREDICT half runs first and is shown immediately (the dashed strip + countdown bar), then after the same
    // real delay the bar animates over, the REVEAL half trains on the true label and shows win/lose. Shared by
    // both the manual "Train one tick" button and the continuous run loop below — one code path, one visible beat.
    async Task RunOneAnimatedTick()
    {
        if (_candles.Count == 0) return;
        if (_pos >= _candles.Count) _pos = 1;   // wrap the finite real sample
        var c = _candles[_pos];

        _seq.Add(c.TimeTok);
        var ctx = BuildCtx();

        // ---- PREDICT phase: read the brain's guess BEFORE the real candle is revealed ----
        double[] logits;
        if (_showInspector)
        {
            var trace = Inspector.Capture(_session!, ctx, DecodePolicy.Default);
            _lastTrace = trace; _lastCtx = ctx;
            logits = trace.Final.Logits;
        }
        else { _lastTrace = null; logits = _session!.Logits(ctx); }   // honours KPass at serve time

        int predBucket = ArgMaxPriceBucket(logits);
        int predDir = Dir(predBucket);

        _pendingPredDir = predDir;
        _revealMs = Math.Max(120, 700 - _speed * 55);   // speed 1..10 -> ~645ms..150ms; the slider now paces the
                                                          // visible reveal cadence, not a computed-ticks-per-frame burst
        _revealTick++;
        _lastResult = null;
        _revealing = true;
        StateHasChanged();

        await Task.Delay(_revealMs);   // the literal countdown — same duration the CSS bar's animation-duration uses

        // ---- REVEAL + TRAIN phase ----
        double loss = _loop!.Observe(ctx, PriceBase + c.Bucket);   // NewGrads->IterAccumulate->Step

        int actualDir = Dir(c.Bucket);
        bool correct = predDir == actualDir;

        _seq.Add(PriceBase + c.Bucket);
        if (_seq.Count > MaxContext * 6) _seq.RemoveRange(0, _seq.Count - MaxContext * 6);

        _trained++; _pos++;

        _totalLifetime++; if (correct) _correctLifetime++;
        _lifetimeAcc = _totalLifetime > 0 ? 100.0 * _correctLifetime / _totalLifetime : 0;
        _recentWindow.Enqueue(correct); if (_recentWindow.Count > RecentCap) _recentWindow.Dequeue();
        _recentAcc = _recentWindow.Count > 0 ? 100.0 * _recentWindow.Count(x => x) / _recentWindow.Count : 0;
        if (_trained % 5 == 0) { _accCurve.Add(_recentAcc); if (_accCurve.Count > 80) _accCurve.RemoveAt(0); }

        _recent.Add(new Point(c.Open, c.High, c.Low, c.Close, c.TimeUtc, predDir, actualDir, correct));
        if (_recent.Count > ChartWindow) _recent.RemoveAt(0);

        _revealing = false;
        _lastResult = correct ? "win" : "lose";

        if (_trained <= 5 || _trained % 10 == 0)
            Log($"tick {_trained,4}   pred {DirGlyph(predDir)}   actual {DirGlyph(actualDir)}   {(correct ? "hit" : "miss")}   recent {_recentAcc:F0}%   loss {loss:F3}");

        StateHasChanged();
    }

    // ---- Inspector display helpers — same pattern as The Creature: the real decision lives in a SLICE of the
    // vocab (price buckets at PriceBase..PriceBase+8), softmaxed and grouped by DIRECTION (Dir()) since 9 raw
    // buckets collapse to 3 meaningful outcomes for accuracy purposes.
    string TopDirText(double[] logits)
    {
        double max = double.NegativeInfinity;
        for (int b = 0; b < PriceBuckets; b++) if (logits[PriceBase + b] > max) max = logits[PriceBase + b];
        var p = new double[PriceBuckets]; double sum = 0;
        for (int b = 0; b < PriceBuckets; b++) { p[b] = Math.Exp(logits[PriceBase + b] - max); sum += p[b]; }
        double up = 0, down = 0, flat = 0;
        for (int b = 0; b < PriceBuckets; b++)
        {
            double frac = sum > 0 ? p[b] / sum : 0;
            int d = Dir(b);
            if (d > 0) up += frac; else if (d < 0) down += frac; else flat += frac;
        }
        return $"▲{up * 100:F0}%  –{flat * 100:F0}%  ▼{down * 100:F0}%";
    }

    string AttentionText(int[] ctx, double[] resonance)
    {
        var top = Inspector.Focus(ctx, resonance, 3);
        return top.Count == 0 ? "(nothing yet)" : string.Join("  ", top.Select(t => $"pos {t.Position} {t.Percent:F0}%"));
    }

    void ToggleInspector() { _showInspector = !_showInspector; if (!_showInspector) { _lastTrace = null; _lastCtx = null; } }

    async Task TrainOnce() { await EnsureBrain(); await RunOneAnimatedTick(); }

    async Task ToggleRun()
    {
        if (_running) { _running = false; return; }
        if (_candles.Count == 0) return;
        await EnsureBrain();
        _running = true;
        try
        {
            while (_running)
            {
                await RunOneAnimatedTick();
                // A short settle so the win/lose flash is actually visible before the next countdown starts —
                // scales down with speed same as the reveal duration itself (see RunOneAnimatedTick), never
                // below a floor. This, together with RunOneAnimatedTick's own delay, is now the WHOLE pacing
                // mechanism for continuous run — replaces the old "burst of _speed ticks with 1ms gaps, then a
                // longer between-burst pause" shape, which is incompatible with watching each individual
                // prediction resolve (that old shape traded visibility for raw throughput; this trades some
                // throughput back for the visible predict/countdown/reveal beat the user asked to watch).
                await Task.Delay(Math.Max(60, 220 - _speed * 15));
            }
        }
        catch (Exception ex) { _error = "The forecaster stumbled: " + ex.Message; _running = false; StateHasChanged(); }
    }

    void ResetBrain()
    {
        Sessions.Forget("forecaster");   // drop the shared instance too, or the next visit would just get the old one back
        _running = false; _session = null; _loop = null; _lastTrace = null; _lastCtx = null;
        _seq.Clear(); _pos = 1; _trained = 0;
        _correctLifetime = 0; _totalLifetime = 0; _recentWindow.Clear(); _recentAcc = 0; _lifetimeAcc = 0;
        _accCurve.Clear(); _recent.Clear(); _log.Clear();
        _revealing = false; _lastResult = null; _pendingPredDir = 0; _revealTick = 0;
    }

    // ---- rendering ----
    // Real OHLC candlesticks (was a close-price line) + a time axis along the bottom — both made possible by the
    // 2026-08-29 data rework carrying Open/High/Low through instead of Close only. Correctness (hit/miss) is now
    // a subtle border treatment on the candle body rather than a separate dot, so it doesn't fight the up/down
    // colour coding candlesticks already use.
    string ChartSvg()
    {
        if (_recent.Count < 2) return "<p class=\"hint\">Click \"Start training\" — each tick trained shows up here as it's predicted.</p>";
        int w = 720, h = 170, axisBand = 22;
        int chartH = h - axisBand;
        double maxP = _recent.Max(p => p.High), minP = _recent.Min(p => p.Low);
        if (maxP <= minP) maxP = minP + 1;
        int n = _recent.Count;
        double slot = (double)w / n;
        double bodyW = Math.Max(1.5, Math.Min(10, slot * 0.6));

        double Y(double price) => 8 + (chartH - 16) - (price - minP) / (maxP - minP) * (chartH - 16);

        var sb = new StringBuilder();
        sb.Append($"<svg viewBox=\"0 0 {w} {h}\" preserveAspectRatio=\"none\" class=\"fc-chart-svg\">");
        sb.Append($"<line class=\"fc-axis-line\" x1=\"0\" y1=\"{chartH}\" x2=\"{w}\" y2=\"{chartH}\"/>");

        for (int i = 0; i < n; i++)
        {
            var p = _recent[i];
            double cx = slot * i + slot / 2;
            double yOpen = Y(p.Open), yClose = Y(p.Close), yHigh = Y(p.High), yLow = Y(p.Low);
            double top = Math.Min(yOpen, yClose);
            double bh = Math.Max(1.2, Math.Abs(yClose - yOpen));
            string dirCls = p.Close >= p.Open ? "up" : "down";
            string hitCls = p.Correct ? "hit" : "miss";
            sb.Append($"<line class=\"fc-wick {dirCls}\" x1=\"{F(cx)}\" y1=\"{F(yHigh)}\" x2=\"{F(cx)}\" y2=\"{F(yLow)}\"/>");
            sb.Append($"<rect class=\"fc-body {dirCls} {hitCls}\" x=\"{F(cx - bodyW / 2)}\" y=\"{F(top)}\" width=\"{F(bodyW)}\" height=\"{F(bh)}\"/>");
        }

        int labelEvery = Math.Max(1, n / 6);
        for (int i = 0; i < n; i += labelEvery)
        {
            double cx = slot * i + slot / 2;
            string label = System.Net.WebUtility.HtmlEncode(_recent[i].TimeUtc.ToString("MM/dd HH:mm"));
            sb.Append($"<text class=\"fc-axis-label\" x=\"{F(cx)}\" y=\"{h - 5}\" text-anchor=\"middle\">{label}</text>");
        }

        sb.Append("</svg>");
        return sb.ToString();
    }

    string AccCurveSvg()
    {
        if (_accCurve.Count < 2) return "";
        int w = 640, h = 90, n = _accCurve.Count;
        var sb = new StringBuilder();
        sb.Append($"<svg viewBox=\"0 0 {w} {h}\" preserveAspectRatio=\"none\" class=\"curve-svg\">");
        double midY = h - 10 - 0.5 * (h - 20);
        sb.Append($"<line class=\"curve-base\" x1=\"0\" y1=\"{F(midY)}\" x2=\"{w}\" y2=\"{F(midY)}\"/>");
        var pts = new StringBuilder();
        for (int i = 0; i < n; i++)
        {
            double px = n == 1 ? 0 : (double)i / (n - 1) * w;
            double py = h - 10 - (_accCurve[i] / 100.0) * (h - 20);
            pts.Append(F(px)).Append(',').Append(F(py)).Append(' ');
        }
        sb.Append($"<polyline class=\"curve-line\" points=\"{pts}\"/>");
        sb.Append("</svg>");
        return sb.ToString();
    }

    static string F(double v) => v.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
}
