@page "/doctrine"
@attribute [BlazierPage("doctrine", Title = "Doctrine: a lane battle between two castles, in your browser", Layout = typeof(MainLayout), Static = true)]
@implements IAsyncDisposable
@inject IBuildTime Build
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ShowroomPlenum.IPlenumRelayFactory Relays
@inject ShowroomPlenum.IPlenumClock Clock
@using ShowroomLane
@using Doctrine
@using Doctrine.Lane

@* DOCTRINE, the lane battle. Soldiers march down three lanes between two castles. The canvas script and pictures are in wwwroot/doctrine (NOTICE.txt and KENNEY-LICENSE.txt stay with them).
   The static shell (Blazier) shows the title, the intro and How to play as real text; the match itself starts only when the visitor starts the runtime.
   Two ways to play: against the computer, or against another person (a room: create it and share its code, join with a code, or pick an open room). The online part is the UI-free
   service in Services/Doctrine/Lane/Online (LaneOnline, LaneLobby); this page only shows what it says. *@

<PageTitle>Doctrine: a lane battle between two castles, in your browser</PageTitle>

<div class="room ln">
    <header class="room-head">
        <nav class="crumb"><a href="/tools/">Tools</a> <span>/</span> Doctrine</nav>
        <h1>Doctrine</h1>
        <p class="lede">Two castles, three lanes. Send soldiers down the lanes, give each lane an order, and watch the battle play out in your browser. Play the computer or another person. Nothing is uploaded.</p>
    </header>

    @if (_m is null && _on is null)
    {
    <section class="ln-how" aria-label="How to play">
        <h2>How to play</h2>
        <ol>
            <li>Pick a lane.</li>
            <li>Tap a pack of soldiers to send it down that lane. Each pack costs points, and you get new points every pause.</li>
            <li>Tap an order to tell that lane's soldiers what to do.</li>
            <li>Press Ready. You have 30 seconds to choose, then the battle starts anyway.</li>
            <li>Watch the battle for 30 seconds. Then it pauses and you choose again. The enemy chooses at the same time, and both sets of plays arrive together.</li>
        </ol>
        <p><strong>Destroy the other castle before yours falls.</strong></p>
        <p>You can also play another person: make a room and share its code, join with a code, or pick an open room. You each choose in secret and the plays are shown together. Both of you run the same battle in your own browser.</p>
    </section>
    }
    @if (Build.IsPrerender)
    {
        <ToolStart Tool="Doctrine" Label="Start Doctrine" />
    }
    else if (_m is null && _on is null)
    {
        <div class="ln-modes">
        <section class="ln-start">
            <h2>Play the computer</h2>
            <label class="ln-label" for="ln-seed">Match number (the same number gives the same match)</label>
            <input id="ln-seed" class="ln-input" type="number" inputmode="numeric" @bind="_seed" />
            @if (_err.Length > 0) { <p class="err" role="alert">@_err</p> }
            <button class="ln-btn strong" type="button" @onclick="StartAsync" disabled="@_starting">@(_starting ? "Building the lanes..." : "Start the battle")</button>
        </section>

        <section class="ln-online" aria-label="Play another person">
            <h2>Play another person</h2>
            <label class="ln-label" for="ln-name">Your name (optional; use a made-up one)</label>
            <input id="ln-name" class="ln-input" type="text" maxlength="24" autocomplete="off" placeholder="Lord ..." @bind="_name" @bind:event="oninput" />
            <div class="ln-actions">
                <button class="ln-btn" type="button" @onclick="CreateRoomAsync" disabled="@_busy">Create a room</button>
            </div>
            <label class="ln-label" for="ln-code">Join with a code</label>
            <div class="ln-actions">
                <input id="ln-code" class="ln-input ln-codebox" type="text" maxlength="14" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="Room code" @bind="_joinCode" @bind:event="oninput" />
                <button class="ln-btn" type="button" @onclick="() => JoinAsync(_joinCode)" disabled="@(_busy || _joinCode.Trim().Length == 0)">Join with a code</button>
            </div>
            <div class="ln-actions">
                <button class="ln-btn" type="button" aria-expanded="@B(_showRooms)" @onclick="ToggleRoomsAsync" disabled="@_busy">@(_showRooms ? "Hide open rooms" : "Open rooms")</button>
            </div>
            @if (_showRooms)
            {
                <div class="ln-rooms" aria-live="polite">
                    @if (_lobby is { Online: false } l0 && l0.Problem.Length > 0) { <p class="err" role="alert">@l0.Problem</p> }
                    else if (_lobby is null || _rooms.Count == 0) { <p class="hint">No open rooms right now. Make one and wait, or ask a friend for their code.</p> }
                    else
                    {
                        <ul>
                            @foreach (var r in _rooms)
                            {
                                var code = r.Code;
                                <li>
                                    <span class="ln-rname">@r.Host</span>
                                    <span class="ln-rage">@AgeWords(r.AgeSeconds)</span>
                                    <button class="ln-btn" type="button" disabled="@_busy" @onclick="() => JoinAsync(code)">Join</button>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
            @if (_onErr.Length > 0) { <p class="err" role="alert">@_onErr</p> }
            <p class="hint ln-public">A room lives on a public message relay. Anyone who has a room's code can see that room and the plays made in it, and the list of open rooms is visible to everyone who opens it, with the host's name. There are no accounts. Pick any made-up name: nothing else about you is sent.</p>
        </section>
        </div>
    }
    else if (_m is null && _on is { } waiting)
    {
        <section class="ln-room" aria-live="polite" aria-label="Your room">
            @switch (waiting.Phase)
            {
                case OnlinePhase.Idle:
                    <h2>Opening your room</h2>
                    <p>Reaching the message relay.</p>
                    break;
                case OnlinePhase.Waiting:
                    <h2>Your room is open</h2>
                    <p class="ln-code">Room code <strong class="mono ln-codeshow">@waiting.Code</strong> <button class="ln-btn" type="button" @onclick="CopyCode">@(_copied ? "Copied" : "Copy code")</button></p>
                    <p>Waiting for a second player. Send them the code, or wait: your room is also listed under Open rooms for anyone who looks.</p>
                    <p class="hint">Anyone with the code can join, so share it only with the person you mean to play.</p>
                    break;
                case OnlinePhase.Joining:
                    <h2>Joining room @waiting.Code</h2>
                    <p>Asking for the second seat.</p>
                    break;
                case OnlinePhase.Ended:
                    <h2>The match did not start</h2>
                    <p>@(waiting.End?.Text ?? "")</p>
                    break;
                default:
                    <h2>@(waiting.OpponentName.Length > 0 ? waiting.OpponentName : "The other player") is in the room</h2>
                    <p>Building the lanes. The battle starts as soon as both of you are ready.</p>
                    break;
            }
            @if (waiting.Notices.Count > 0 && waiting.Phase != OnlinePhase.Ended) { <p class="hint ln-last">@waiting.Notices[^1]</p> }
            @if (_onErr.Length > 0) { <p class="err" role="alert">@_onErr</p> }
            <p class="ln-net" role="status"><span class="ln-dot @(waiting.Online ? "on" : "off")" aria-hidden="true"></span> @(waiting.Online ? "Connected to the relay." : "Connection lost. Trying to get it back.")</p>
            <div class="ln-actions"><button class="ln-btn" type="button" @onclick="LeaveAsync">@(waiting.Phase == OnlinePhase.Ended ? "Back" : "Leave the room")</button></div>
        </section>
    }
    else if (_m is not null)
    {
        bool online = _on is not null;
        bool onEnded = _on is { Phase: OnlinePhase.Ended };
        bool starting = _on is { Phase: OnlinePhase.Starting };
        <div class="ln-stage">
            <div class="ln-board"><canvas @ref="_canvas" class="ln-canvas" aria-label="The battlefield: three lanes between your base and theirs. Tap a lane to pick it, then tap an order on the lane. The Sound button is in the top corner."></canvas></div>

            <section class="ln-dock" aria-label="Your soldiers and the clock">
                <div class="ln-status" aria-live="polite">
                    <div class="ln-clock">
                        @if (onEnded)
                        {
                            <span class="ln-tag over">Over</span>
                            <strong class="ln-time ln-outcome">@_on!.End!.Text</strong>
                        }
                        else if (starting)
                        {
                            <span class="ln-tag pause">Starting</span>
                            <strong class="ln-time">@LaneWords.Clock(_on!.StartInMs / 1000.0)</strong>
                            <span class="ln-hintline">to the start</span>
                        }
                        else
                        {
                            @switch (_m.Stage)
                            {
                                case MatchStage.Pause:
                                    <span class="ln-tag pause">Pause</span>
                                    <strong class="ln-time">@(_bots ? "Bots only" : LaneWords.Clock(_m.PauseLeft))</strong>
                                    <span class="ln-hintline">@(_bots ? "" : "to choose")</span>
                                    break;
                                case MatchStage.Run:
                                    <span class="ln-tag run">Battle</span>
                                    <strong class="ln-time">@LaneWords.Clock(_m.Battle.TicksToPause / (double)(LaneRules.TicksPerSecond * _m.Speed))</strong>
                                    <span class="ln-hintline">to the next pause</span>
                                    break;
                                default:
                                    <span class="ln-tag over">Over</span>
                                    <strong class="ln-time ln-outcome">@LaneWords.Outcome(_m.Status, _m.LocalSide)</strong>
                                    break;
                            }
                        }
                    </div>
                    @if (!onEnded && _m.Stage != MatchStage.Over)
                    {
                        <span class="ln-pts">Points left: <strong>@(_m.Human?.Remaining ?? _m.LocalEconomy.Balance)</strong></span>
                    }
                    <div class="ln-ctl">
                        @if (online)
                        {
                            @if (!onEnded && _on!.Phase == OnlinePhase.Playing && _m.Stage == MatchStage.Pause)
                            {
                                <button class="ln-btn strong" type="button" disabled="@(_on.MyCommitted || !_on.PauseOpen)" @onclick="OnReady">@(_on.MyCommitted ? (_on.OpponentCommitted ? "Ready" : "Waiting for opponent") : "Ready")</button>
                            }
                            @if (onEnded)
                            {
                                @if (_on!.CanRematch)
                                {
                                    <button class="ln-btn strong" type="button" disabled="@_on.MyRematch" @onclick="RematchAsync">@(_on.MyRematch ? "Waiting for " + _on.OpponentName : (_on.OpponentRematch ? "Accept the rematch" : "Rematch"))</button>
                                }
                                <button class="ln-btn" type="button" @onclick="LeaveAsync">Leave</button>
                            }
                            else
                            {
                                <button class="ln-btn" type="button" @onclick="LeaveClickAsync">@(_confirmLeave ? "Tap again to leave. The other player wins." : "Leave")</button>
                            }
                        }
                        else
                        {
                            @if (_m.Stage == MatchStage.Pause && !_bots)
                            {
                                <button class="ln-btn strong" type="button" @onclick="OnReady">Ready</button>
                            }
                            @if (_m.Stage == MatchStage.Run)
                            {
                                <span class="ln-speed" role="group" aria-label="Battle speed">
                                    @foreach (var sp in new[] { 1, 2, 4 })
                                    {
                                        var s = sp;
                                        <button class="ln-btn @(_m.Speed == s ? "on" : "")" type="button" aria-pressed="@B(_m.Speed == s)" @onclick="() => OnSpeed(s)">@(s)x</button>
                                    }
                                </span>
                            }
                            @if (_m.Stage == MatchStage.Over)
                            {
                                <button class="ln-btn strong" type="button" @onclick="PlayAgain">Play again</button>
                                <button class="ln-btn" type="button" @onclick="SameSeed">Same match again</button>
                            }
                        }
                    </div>
                </div>
                @if (online)
                {
                    <p class="ln-net" role="status"><span class="ln-dot @(_on!.Online ? "on" : "off")" aria-hidden="true"></span> <span class="ln-who">@(_on.OpponentName.Length > 0 ? _on.OpponentName : "Opponent"):</span> @_on.StatusLine</p>
                }
                @if (_m.Behind) { <p class="ln-warn">This device cannot keep up with the battle, so it is running slower than the clock.</p> }
                @if (_err.Length > 0) { <p class="err" role="alert">@_err</p> }

                @if (!onEnded && _m.Stage == MatchStage.Pause && _m.Human is { } me)
                {
                    <p class="ln-tip" role="status">
                        @if (_sel < 0)
                        {
                            <span>Pick a lane. Tap one on the board.</span>
                        }
                        else
                        {
                            <span>@LaneWords.LaneName(_sel, _lanes), @LaneWords.LaneGround(_sel, _lanes). Tap soldiers to send them here. Tap an order on the lane.</span>
                            @if (me.Orders.TryGetValue(_sel, out var staged)) { <span> @LaneWords.OrderName(staged): @LaneWords.OrderLine(staged)</span> }
                        }
                        @if (_note.Length > 0) { <span> @_note</span> }
                    </p>
                    <div class="ln-packs" role="group" aria-label="Soldiers to send">
                        @for (int k = 0; k < Roster.Size; k++)
                        {
                            var kind = k;
                            <button class="ln-pack" type="button" disabled="@(_sel < 0 || me.Frozen || LaneEconomy.Cost(kind) > me.Remaining)" @onclick="() => Buy(kind)">
                                @if (_icons.Length > kind) { <img class="ln-icon" src="@_icons[kind]" alt="" /> }
                                <span class="ln-pname">@LaneWords.KindName(kind) <small>x@(LaneEconomy.PackSize)</small></span>
                                <span class="ln-pcost">@LaneEconomy.Cost(kind) points</span>
                                <span class="ln-pline">@LaneWords.KindLine(kind)</span>
                            </button>
                        }
                    </div>
                    @if (me.Packs.Count > 0)
                    {
                        <div class="ln-staged" role="group" aria-label="Sent this pause">
                            @for (int i = 0; i < me.Packs.Count; i++)
                            {
                                var idx = i; var p = me.Packs[i];
                                <button type="button" class="ln-x" disabled="@me.Frozen" @onclick="() => Unbuy(idx)"><span>@LaneWords.LaneName(p.Lane, _lanes): @LaneWords.KindName(p.Kind) x@(LaneEconomy.PackSize)</span> <b>Take back</b></button>
                            }
                        </div>
                    }
                }
                else if (!onEnded && _m.Stage == MatchStage.Run)
                {
                    <p class="ln-tip">Plays are made at the pause. You have @_m.Battle.Bodies(_m.LocalSide) soldiers on the field, they have @_m.Battle.Bodies(_m.LocalSide == Side.Player ? Side.Enemy : Side.Player). Your plays show on the lanes.</p>
                }
                else if (_m.Stage == MatchStage.Over)
                {
                    <p class="ln-tip">The battle lasted @_m.Phase phases. Same match number, same plays, same match.</p>
                }
            </section>
        </div>

        @if (_bots)
        {
            <section class="ln-hash" aria-label="Pause hashes">
                <h2>Hash at every pause (tick:hash)</h2>
                <p class="mono">@HashLine</p>
            </section>
        }
    }
    <p class="hint ln-credit">Terrain pictures: RTS Pack: Medieval by Kenney (kenney.nl), CC0.</p>
</div>

@code {
    ElementReference _canvas;
    LaneMatch? _m;
    LaneOnline? _on;
    LaneLobby? _lobby;
    CancellationTokenSource? _ticker;
    DotNetObjectReference<LaneBattlePage>? _self;
    IJSObjectReference? _js;
    string[] _icons = Array.Empty<string>();
    IReadOnlyList<LaneLobbyEntry> _rooms = Array.Empty<LaneLobbyEntry>();
    string _err = "", _note = "", _onErr = "", _name = "", _joinCode = "";
    bool _starting, _bots, _jsReady, _framing, _busy, _showRooms, _copied, _disposed, _confirmLeave;
    int _seed = 1, _sel = -1, _lanes = 3, _lastSec = -1, _lastBal = -1, _lastSpeed, _packedStage = -1;

    protected override void OnInitialized()
    {
        _seed = Environment.TickCount & 0xFFFF;
        if (Build.IsPrerender) return;   // the static shell is built without a page address
        // ?seed=7 fixes the match number; ?bots=1 lets the bots play both seats (a check mode: the hash line is shown and can be compared with the batch run)
        foreach (var part in new Uri(Nav.Uri).Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            var val = kv.Length > 1 ? Uri.UnescapeDataString(kv[1]) : "";
            if (kv[0] == "seed" && int.TryParse(val, out var s)) _seed = s;
            else if (kv[0] == "bots" && (val == "1" || val == "true")) _bots = true;
        }
    }

    /// <summary>A new match is on the board: the board starts clean (nothing picked, the script told to start again on the new canvas).</summary>
    void AttachMatch(LaneMatch m)
    {
        _m = m;
        _lanes = m.Battle.Setup.Lanes; _sel = -1;   // no lane picked: the tray asks for one
        _jsReady = false; _note = ""; _lastSec = -1; _lastBal = -1; _packedStage = -1;
    }

    async Task StartAsync()
    {
        _starting = true; _err = "";
        try
        {
            var o = new LaneMatchOptions { Seed = _seed, Player = _bots ? new LaneBot() : null };
            AttachMatch(await LaneMatch.CreateAsync(o));
        }
        catch (Exception e) { _err = "Could not start: " + e.Message; _m = null; }
        _starting = false;
    }

    // ---------------------------------------------------------------------------------------------- online: rooms, the list, joining

    LaneOnlineOptions OnlineOptions() => new() { Relays = Relays, Clock = Clock };

    void StartTicker()
    {
        if (_ticker is not null) return;
        _ticker = new CancellationTokenSource();
        _ = TickLoop(_ticker.Token);
    }

    /// <summary>About four times a second (the browser runs a timer in a hidden tab too): lets the online service answer the other player and the list drop expired rooms.</summary>
    async Task TickLoop(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(250, ct);
                if (_disposed) return;
                try
                {
                    if (_lobby is { } l) { l.Tick(); }
                    if (_on is { } on) { await on.AdvanceAsync(ct); }
                }
                catch (OperationCanceledException) { throw; }
                catch (Exception) { }
                if (_on is not null || _lobby is not null) await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    void OnOnlineChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            SyncOnline();
            StateHasChanged();
        });
    }

    void SyncOnline()
    {
        if (_on is not { } on) return;
        if (on.Match is { } m && !ReferenceEquals(m, _m)) AttachMatch(m);
        else if (on.Match is null && _m is not null) _m = null;
    }

    async Task CreateRoomAsync()
    {
        if (_busy) return;
        _busy = true; _onErr = "";
        try
        {
            await CloseLobbyAsync();
            var on = new LaneOnline(OnlineOptions());
            on.Changed += OnOnlineChanged;
            _on = on;
            await on.CreateRoomAsync(_name);
            StartTicker();
        }
        catch (Exception e) { _onErr = "Could not open a room: the message relay could not be reached (" + e.Message + ")."; await DropOnlineAsync(); }
        _busy = false;
    }

    async Task JoinAsync(string code)
    {
        if (_busy) return;
        _busy = true; _onErr = "";
        try
        {
            await CloseLobbyAsync();
            var on = new LaneOnline(OnlineOptions());
            on.Changed += OnOnlineChanged;
            _on = on;
            StartTicker();
            var err = await on.JoinAsync(code, _name);
            if (err is not null) { _onErr = err; await DropOnlineAsync(); }
        }
        catch (Exception e) { _onErr = "Could not join: " + e.Message; await DropOnlineAsync(); }
        _busy = false;
    }

    async Task ToggleRoomsAsync()
    {
        if (_showRooms) { await CloseLobbyAsync(); return; }
        _showRooms = true; _onErr = "";
        var lobby = new LaneLobby(new LaneLobbyOptions { Relays = Relays, Clock = Clock });
        lobby.Changed += () => { _rooms = lobby.Rooms; _ = InvokeAsync(StateHasChanged); };
        _lobby = lobby;
        StartTicker();
        await lobby.StartAsync();
        _rooms = lobby.Rooms;
    }

    async Task CloseLobbyAsync()
    {
        _showRooms = false;
        var l = _lobby; _lobby = null; _rooms = Array.Empty<LaneLobbyEntry>();
        if (l is not null) { try { await l.DisposeAsync(); } catch { } }
    }

    async Task DropOnlineAsync()
    {
        var on = _on; _on = null;
        if (on is not null) { on.Changed -= OnOnlineChanged; try { await on.LeaveAsync(); } catch { } }
        _m = null;
    }

    /// <summary>Leaving a running match gives it to the other player, so the first tap only asks.</summary>
    async Task LeaveClickAsync()
    {
        if (_on is { Phase: OnlinePhase.Playing } && !_confirmLeave) { _confirmLeave = true; return; }
        await LeaveAsync();
    }

    async Task LeaveAsync()
    {
        _confirmLeave = false;
        _onErr = "";
        await DropOnlineAsync();
        _sel = -1; _note = "";
    }

    async Task RematchAsync() { if (_on is { } on) await on.RematchAsync(); }

    async Task CopyCode()
    {
        if (_on is null) return;
        try { await JS.InvokeVoidAsync("copyText", _on.Code); _copied = true; } catch (JSException) { } catch (JSDisconnectedException) { }
    }

    static string AgeWords(int seconds) => seconds < 5 ? "just now" : seconds < 60 ? seconds + " s ago" : (seconds / 60) + " min ago";

    // ---------------------------------------------------------------------------------------------- the canvas

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Build.IsPrerender || _m is null || _jsReady) return;
        _jsReady = true;   // set first: a render during the awaits below must not start a second init
        try
        {
            _self ??= DotNetObjectReference.Create(this);
            _js ??= await JS.InvokeAsync<IJSObjectReference>("import", Nav.BaseUri + "doctrine/lane.js");
            await _js.InvokeVoidAsync("init", _canvas, _self, LanePayload.Layout(_m), Nav.BaseUri + "doctrine/img/");
            _icons = await _js.InvokeAsync<string[]>("icons") ?? Array.Empty<string>();
            await SyncInfo();
            StateHasChanged();
        }
        catch (Exception e) { _err = "The battlefield could not start: " + e.Message; StateHasChanged(); }
    }

    /// <summary>Called by the canvas script once per animation frame with the seconds since its last call. Returns the picture packet while the battle runs (and once at each change), else null.</summary>
    [JSInvokable]
    public async Task<byte[]?> Frame(double dt)
    {
        var m = _m;
        if (m is null || _framing) return null;
        _framing = true;
        try
        {
            LaneAdvance adv;
            if (_on is { } on)
            {
                adv = await on.AdvanceAsync();   // the online service owns the clock (both players' shared start), so the frame's own seconds are not used
                if (on.Match is { } om && !ReferenceEquals(om, m)) { AttachMatch(om); return null; }
                if (on.Match is null) return null;
            }
            else adv = await m.AdvanceAsync(dt);
            int sec = m.Stage == MatchStage.Pause ? (int)Math.Ceiling(m.PauseLeft) : (int)Math.Ceiling(m.Battle.TicksToPause / (double)(LaneRules.TicksPerSecond * m.Speed));
            int bal = m.LocalEconomy.Balance;
            bool stageMoved = (int)m.Stage != _packedStage;
            if (adv.StageChanged || stageMoved || sec != _lastSec || bal != _lastBal || m.Speed != _lastSpeed || m.Behind)
            {
                _lastSec = sec; _lastBal = bal; _lastSpeed = m.Speed;
                if (adv.StageChanged || stageMoved) _note = "";
                await SyncInfo();
                await InvokeAsync(StateHasChanged);
            }
            bool send = m.Stage == MatchStage.Run || adv.StageChanged || stageMoved;
            _packedStage = (int)m.Stage;
            return send ? LanePack.Pack(m) : null;
        }
        catch (Exception e) { _err = "The battle stopped: " + e.Message; await InvokeAsync(StateHasChanged); return null; }
        finally { _framing = false; }
    }

    /// <summary>A tap on a lane on the board (the canvas script calls this). -1 puts the lane down (no lane picked).</summary>
    [JSInvokable]
    public async Task OnLaneTap(int lane)
    {
        if (lane < -1 || lane >= _lanes) return;
        _sel = lane;
        await SyncInfo();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>A tap on an order chip drawn on a lane: sets that lane's order, or clears it when it is the one already staged. The lane is the one the chip sits on.</summary>
    [JSInvokable]
    public async Task OnOrderTap(int lane, int order)
    {
        if (_m?.Human is not { } h || lane < 0 || lane >= _lanes) return;
        h.Order(lane, (FieldOrderKind)order, out var why); _note = why;
        await SyncInfo();
        await InvokeAsync(StateHasChanged);
    }

    async Task SyncInfo()
    {
        if (_js is null || _m is null) return;
        try { await _js.InvokeVoidAsync("setInfo", LanePayload.Info(_m, _sel)); } catch (JSException) { }
    }

    async Task Buy(int kind)
    {
        if (_m?.Human is not { } h || _sel < 0) return;   // a pack always goes into the lane that is picked
        bool ok = h.Buy(_sel, kind, out var why); _note = why;
        await SyncInfo();
        await Sfx(ok ? "stage" : "tap");
    }

    async Task Unbuy(int index) { _m?.Human?.RemovePack(index); _note = ""; await SyncInfo(); await Sfx("orderClear"); }

    async Task Sfx(string name)
    {
        try { if (_js is not null) await _js.InvokeVoidAsync("sfx", name); } catch (JSException) { } catch (JSDisconnectedException) { }
    }

    async Task OnReady()
    {
        if (_on is { } on) { await on.ReadyAsync(); await SyncInfo(); }
        else _m?.Ready();
    }
    void OnSpeed(int s) => _m?.SetSpeed(s);

    void PlayAgain() { _seed = Environment.TickCount & 0xFFFF; _m = null; }
    void SameSeed() { _m = null; }

    static string B(bool v) => v ? "true" : "false";

    string HashLine => string.Join("  ", _m!.PauseHashes.Select(h => h.Tick + ":" + LaneMatch.ShortHash(h.Hash)));

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _ticker?.Cancel();
        _m = null;
        if (_on is { } on) { _on = null; on.Changed -= OnOnlineChanged; try { await on.LeaveAsync(); } catch { } }
        if (_lobby is { } l) { _lobby = null; try { await l.DisposeAsync(); } catch { } }
        try { if (_js is not null) { await _js.InvokeVoidAsync("dispose"); await _js.DisposeAsync(); } } catch (JSDisconnectedException) { } catch (JSException) { }
        _self?.Dispose();
    }
}
