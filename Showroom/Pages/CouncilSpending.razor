    void EnsureDb()
    {
        if (_db is not null) return;
        _db = Database.Open(null);
        _db.Execute("CREATE TABLE spend (id INT PRIMARY KEY, council TEXT, year TEXT, transid TEXT, " +
            "paydate TEXT, net REAL, gross REAL, vattype TEXT, servicearea TEXT, costcentre TEXT, " +
            "description TEXT, supplierkey TEXT, supplier TEXT)");
    }

    async Task<byte[]> FetchGunzipAsync(string url)
    {
        var compressed = await Http.GetByteArrayAsync(url);
        using var input = new MemoryStream(compressed, writable: false);
        using var gz = new GZipStream(input, CompressionMode.Decompress);
        using var output = new MemoryStream(compressed.Length * 4);
        await gz.CopyToAsync(output);
        return output.ToArray();
    }

    // Loads the selected, not-yet-loaded Wokingham years as compact pre-normalised files (built
    // offline by CouncilDbBuilder from the same raw hosted files, see that project's own header
    // comment) and BulkLoads them into the shared in-memory HoloDb. The council-wide precomputed
    // exceptions file loads once, alongside the first year, rather than re-running AuditEngine
    // client-side at all for this council.
    async Task LoadSelectedYears()
    {
        _error = null; _busy = true; _phase = "Loading…"; StateHasChanged(); await Task.Delay(1);
        try
        {
            EnsureDb();
            var toLoad = _wokinghamYears.Where(y => y.Checked && !y.Loaded).ToList();
            foreach (var y in toLoad)
            {
                _phase = $"Fetching {y.Tag}…"; StateHasChanged(); await Task.Delay(1);
                var bytes = await FetchGunzipAsync($"data/councils/wokingham/{y.Tag}.norm.csv.gz");
                _phase = $"Loading {y.Tag} into HoloDb…"; StateHasChanged(); await Task.Delay(1);
                var table = CsvReader.Parse(bytes); // plain UTF-8, no BOM — written by CouncilDbBuilder
                int m = table.Count - 1;
                int baseId = _spendRowsLoaded;
                var id = new long[m]; var council = new string[m]; var year = new string[m];
                var transid = new string[m]; var paydate = new string[m];
                var net = new double[m]; var gross = new double[m];
                var vattype = new string[m]; var servicearea = new string[m]; var costcentre = new string[m];
                var description = new string[m]; var supplierkey = new string[m]; var supplier = new string[m];
                for (int i = 1; i < table.Count; i++)
                {
                    var f = table[i]; int j = i - 1;
                    id[j] = baseId + j;
                    council[j] = f[0]; year[j] = f[1]; transid[j] = f[2]; paydate[j] = f[3];
                    net[j] = double.Parse(f[4], CultureInfo.InvariantCulture);
                    gross[j] = double.Parse(f[5], CultureInfo.InvariantCulture);
                    vattype[j] = f[6]; servicearea[j] = f[7]; costcentre[j] = f[8]; description[j] = f[9];
                    supplierkey[j] = f[10]; supplier[j] = f[11];
                }
                _db!.BulkLoad("spend",
                    new[] { "id", "council", "year", "transid", "paydate", "net", "gross", "vattype",
                            "servicearea", "costcentre", "description", "supplierkey", "supplier" },
                    new Array[] { id, council, year, transid, paydate, net, gross, vattype,
                                   servicearea, costcentre, description, supplierkey, supplier }, m);
                y.Loaded = true; y.Checked = false;
                _spendRowsLoaded += m;
            }

            if (!_exceptionsLoaded)
            {
                _phase = "Loading precomputed exceptions…"; StateHasChanged(); await Task.Delay(1);
                var excBytes = await FetchGunzipAsync("data/councils/wokingham/exceptions.csv.gz");
                var excTable = CsvReader.Parse(excBytes);
                BuildTestsFromExceptionsRows(excTable);
                _exceptionsLoaded = true;
                _exceptionsLoadedCount = excTable.Count - 1;
            }

            _showDoubleListingNote = _wokinghamYears.Any(y => y.Tag == "FY2020-21" && y.Loaded)
                && _tests.Any(t => t.Label.Contains("test 5") && t.Items.Count > 0);
        }
        catch (Exception ex)
        {
            _error = "Something went wrong loading that data: " + ex.Message;
        }
        finally { _busy = false; StateHasChanged(); }
    }

    static readonly Dictionary<string, string> TestDescByLabel = new()
    {
        ["Exception test 1 - payments above the stated invoice amount"] =
            "The sum of the payments published against this transaction is larger than the invoice " +
            "amount stated for it.",
        ["Exception test 2 - invoice amounts not covered by published payments"] =
            "The stated invoice amount is larger than the payments published against this transaction " +
            "— the remainder isn't in the published data.",
        ["Exception test 3 - same supplier, amount, description and date under different transaction numbers"] =
            "A pattern, not a contradiction: these rows share the same supplier, amount, description " +
            "and pay date but are logged against different transaction numbers. Rows with a redacted " +
            "supplier or transaction id are excluded — the redaction placeholder repeats across " +
            "unrelated payments and would otherwise produce false matches.",
        ["Exception test 4 - one transaction number covering several payees or pay dates"] =
            "The same transaction number appears against more than one payee, or more than one pay " +
            "date, in the published data.",
        ["Exception test 5 - the same line listed more than once in the published file"] =
            "The exact same transaction number, supplier, amount, description and pay date appears on " +
            "more than one row of the same published file.",
    };

    // Builds the same TestGroup/ExceptionItem shape the UI already renders, straight from the
    // council-wide precomputed exceptions file — council,testlabel,type,sourcetag,transid,supplier,
    // paydate,amount,servicearea,description,handverified,compareamount,groupkey,groupsize,
    // oppositesign (the last 4 columns, added for the evidence/highlighting panel, are produced by
    // CouncilDbBuilder — see that project's own header comment for the exact schema). No
    // AuditEngine.Run call for Wokingham; this file is a precomputed snapshot of its output.
    void BuildTestsFromExceptionsRows(List<string[]> table)
    {
        var byLabel = new Dictionary<string, TestGroup>();
        var order = new List<string>();
        for (int i = 1; i < table.Count; i++)
        {
            var f = table[i];
            string label = f[1];
            if (!byLabel.TryGetValue(label, out var grp))
            {
                grp = new TestGroup { Label = label, Description = TestDescByLabel.GetValueOrDefault(label, "") };
                byLabel[label] = grp; order.Add(label);
            }
            var type = Enum.TryParse<ExceptionType>(f[2], out var t) ? t : ExceptionType.Discrepancy;
            decimal? compareAmount = f.Length > 11 && decimal.TryParse(f[11], NumberStyles.Any, CultureInfo.InvariantCulture, out var ca) ? ca : null;
            string? groupKey = f.Length > 12 ? NullIfEmpty(f[12]) : null;
            int groupSize = f.Length > 13 && int.TryParse(f[13], out var gs) ? gs : 1;
            bool oppositeSign = f.Length > 14 && f[14] == "True";
            grp.Items.Add(new ExceptionItem
            {
                TestLabel = label, Type = type, SourceTag = f[3], TransactionId = f[4], Supplier = f[5],
                PayDate = NullIfEmpty(f[6]),
                Amount = decimal.TryParse(f[7], NumberStyles.Any, CultureInfo.InvariantCulture, out var amt) ? amt : null,
                ServiceArea = NullIfEmpty(f[8]),
                Description = NullIfEmpty(f[9]),
                HandVerified = f[10] == "True",
                Kind = compareAmount is not null ? EvidenceKind.AmountCompare : groupKey is not null ? EvidenceKind.GroupEvidence : EvidenceKind.None,
                CompareAmount = compareAmount,
                CompareLabel = compareAmount is not null ? "Stated invoice amount" : null,
                OppositeSign = oppositeSign,
                GroupKey = groupKey,
                GroupSize = groupSize,
            });
        }
        _tests = order.OrderBy(l => l, StringComparer.Ordinal).Select(l => byLabel[l]).ToList();
        SetDefaultCollapse();
    }

    // A test panel starts expanded only if it contains at least one hand-verified example —
    // every other panel starts collapsed so the page doesn't render thousands of rows unopened.
    void SetDefaultCollapse()
    {
        foreach (var t in _tests) t.Collapsed = !t.Items.Any(i => i.HandVerified);
    }

    // Cross-council correlation search across EVERYTHING loaded this session (any council, any
    // year). Two modes:
    //  - Graded (default): HoloDb's own holographic NEAREST similarity search against the
    //    normalised supplier key, ranked by the `score` pseudo-column. Originally shipped as
    //    LIKE-only — tried NEAREST first against real Wokingham data and found it unreliable
    //    (score column threw, truncated names didn't rank near their real match), flagged to
    //    holodb-owner rather than guessed around. holodb-owner's F-04 fix (HoloDb 2.1.0, this repo
    //    bumped to 2.1.0 2026-10-03) is re-verified against the real 42,405-row Wokingham dataset
    //    (LSH regime, above the ~8,000-row exact-search cutover): a deliberately truncated query
    //    ("A Wise Solution") now ranks the real supplier ("A Wise Solution Ltd") first with
    //    score=0.856, on both the raw supplier column and this normalised key. Safe to turn on.
    //  - Exact substring (LIKE): kept as a fallback for when a visitor wants to be certain nothing
    //    beyond a literal substring is being matched — NEAREST's closeness is a well-behaved local
    //    ranking, not a global total order (two far values can occasionally tie/swap rank), so an
    //    exact mode stays useful alongside it, not merely as a historical relic.
    async Task RunNearestSupplierSearch()
    {
        if (_db is null || string.IsNullOrWhiteSpace(_nearestSupplierQuery)) return;
        _busy = true; StateHasChanged(); await Task.Delay(1);
        try
        {
            var key = new string(_nearestSupplierQuery.Trim().ToUpperInvariant()
                .Where(c => char.IsLetterOrDigit(c) || c == ' ').ToArray()).Replace("'", "''");
            if (_searchMode == SearchMode.Graded)
            {
                var result = _db.Execute(
                    $"SELECT supplier, council, score FROM spend NEAREST (supplierkey = '{key}') LIMIT 20");
                _nearestResults = result.Rows
                    .Select(r => (r.TryGetValue("supplier", out var s) ? s?.ToString() ?? "" : "",
                                   r.TryGetValue("council", out var c) ? c?.ToString() ?? "" : "",
                                   r.TryGetValue("score", out var sc) && sc is not null ? Convert.ToDouble(sc) : 0.0))
                    .DistinctBy(x => (x.Item1, x.Item2))
                    .ToList();
            }
            else
            {
                var result = _db.Execute($"SELECT supplier, council FROM spend WHERE supplierkey LIKE '%{key}%' LIMIT 20");
                _nearestResults = result.Rows
                    .Select(r => (r.TryGetValue("supplier", out var s) ? s?.ToString() ?? "" : "",
                                   r.TryGetValue("council", out var c) ? c?.ToString() ?? "" : "", 0.0))
                    .DistinctBy(x => (x.Item1, x.Item2))
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            _error = "Supplier search failed: " + ex.Message;
        }
        finally { _busy = false; StateHasChanged(); }
    }

    const long MaxOwnFileUpload = 64L * 1024 * 1024;

    async Task OnOwnFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        _error = null; _ownHeader = new();
        try
        {
            using var stream = file.OpenReadStream(MaxOwnFileUpload);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _ownBytes = ms.ToArray();
            _ownFormat = file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase) ? SourceFormat.Xlsx : SourceFormat.Csv;
            var table = _ownFormat == SourceFormat.Xlsx ? XlsxReader.Parse(_ownBytes) : CsvReader.Parse(_ownBytes);
            if (table.Count == 0) { _error = "That file has no rows."; return; }
            var header = table[0].Select(h => h.Trim().TrimStart('﻿')).ToArray();
            _ownHeader = header.ToList();
            UseGuessedMapping(header);
        }
        catch (Exception ex)
        {
            _error = "Couldn't read that file: " + ex.Message;
        }
    }

    void UseGuessedMapping(string[] header)
    {
        var guess = ColumnMapper.Guess(header);
        _ownMapTrans = guess.TransactionId;
        _ownMapSupplier = guess.Supplier;
        _ownMapGross = guess.Gross ?? "";
        _ownMapNet = guess.Net ?? "";
        _ownMapVatAmount = guess.VatAmount ?? "";
        _ownMapVatType = guess.VatType ?? "";
        _ownMapPayDate = guess.PayDate ?? "";
        _ownMapDesc = guess.Description ?? "";
        _ownMapService = guess.ServiceArea ?? "";
    }

    async Task RunOwnFile()
    {
        Reset();
        if (_ownBytes is null) { _error = "Load a file first."; return; }
        _busy = true; _phase = "Parsing…"; StateHasChanged(); await Task.Delay(1);
        try
        {
            List<string[]> table = _ownFormat == SourceFormat.Xlsx ? XlsxReader.Parse(_ownBytes) : CsvReader.Parse(_ownBytes);
            var mapping = new ColumnMapping(
                _ownMapTrans, _ownMapSupplier, NullIfEmpty(_ownMapPayDate), NullIfEmpty(_ownMapDesc),
                NullIfEmpty(_ownMapService), NullIfEmpty(_ownMapNet), _ownMapGross,
                NullIfEmpty(_ownMapVatAmount), NullIfEmpty(_ownMapVatType));
            var warnings = new List<string>();
            var rows = AuditEngine.MapRows(table, mapping, "Your file", warnings);
            var result = AuditEngine.Run(rows, _ownIdScope, _ownGrossMeaning, warnings);
            _warnings = warnings;
            _councilDisplayName = string.IsNullOrWhiteSpace(_ownCouncilName) ? "this council" : _ownCouncilName.Trim();
            BuildTests(result, rows);
        }
        catch (Exception ex)
        {
            _error = "Something went wrong: " + ex.Message;
        }
        finally { _busy = false; StateHasChanged(); }
    }

    void BuildTests(AuditResult result, List<SpendRow> rawRows)
    {
        _tests = new();

        var t1 = new TestGroup
        {
            Label = "Exception test 1 — payments above the stated invoice amount",
            Description = "The sum of the payments published against this transaction is larger than the " +
                "invoice amount stated for it."
        };
        var t2 = new TestGroup
        {
            Label = "Exception test 2 — invoice amounts not covered by published payments",
            Description = "The stated invoice amount is larger than the payments published against this " +
                "transaction — the remainder isn't in the published data."
        };
        foreach (var r in result.ScheduleA)
        {
            bool paymentsExceed = r.Gross < r.ExpectedGross;
            var item = new ExceptionItem
            {
                TestLabel = paymentsExceed ? t1.Label : t2.Label,
                Type = paymentsExceed ? ExceptionType.Discrepancy : ExceptionType.Unreconciled,
                SourceTag = r.SourceTag, TransactionId = r.TransactionId, Supplier = r.Supplier,
                PayDate = r.PayDate, Amount = r.Gross, ServiceArea = r.ServiceArea, Description = r.Description,
                HandVerified = HandVerifiedTransNos.Contains(r.TransactionId),
                Kind = EvidenceKind.AmountCompare,
                CompareAmount = r.ExpectedGross,
                CompareLabel = "Stated invoice amount",
                OppositeSign = !paymentsExceed && r.Net != 0 && r.Gross != 0 && r.Net == -r.Gross,
            };
            (paymentsExceed ? t1 : t2).Items.Add(item);
        }
        _tests.Add(t1); _tests.Add(t2);

        var t3 = new TestGroup
        {
            Label = "Exception test 3 — same supplier, amount, description and date under different transaction numbers",
            Description = "A pattern, not a contradiction: these rows share the same supplier, amount, " +
                "description and pay date but are logged against different transaction numbers. Rows " +
                "with a redacted supplier or transaction id are excluded (see the warnings above) — the " +
                "redaction placeholder repeats across unrelated payments and would otherwise produce " +
                "false matches."
        };
        int g3Id = 0;
        foreach (var g in result.ScheduleB)
        {
            g3Id++;
            var groupKey = $"g3-{g3Id}";
            foreach (var m in g.Members)
            {
                t3.Items.Add(new ExceptionItem
                {
                    TestLabel = t3.Label, Type = ExceptionType.Anomaly,
                    SourceTag = m.SourceTag, TransactionId = m.TransactionId, Supplier = m.Supplier,
                    PayDate = m.PayDateRaw, Amount = m.Net, ServiceArea = m.ServiceArea, Description = m.Description,
                    HandVerified = HandVerifiedTransNos.Contains(m.TransactionId),
                    Kind = EvidenceKind.GroupEvidence, GroupKey = groupKey, GroupSize = g.Members.Count,
                });
            }
        }
        _tests.Add(t3);

        var t4 = new TestGroup
        {
            Label = "Exception test 4 — one transaction number covering several payees or pay dates",
            Description = result.ScheduleDScope == TransactionIdScope.SupplierFurnished
                ? "This council's transaction number is the supplier's own invoice number, not one the " +
                  "council assigns itself — two unrelated suppliers using the same number is most likely " +
                  "coincidence, not a shared transaction. Shown for completeness, not as a finding."
                : "The same transaction number appears against more than one payee, or more than one pay " +
                  "date, in the published data."
        };
        foreach (var g in result.ScheduleD)
        {
            var groupKey = $"g4-{g.SourceTag}-{g.TransactionId}";
            foreach (var m in g.Members)
            {
                t4.Items.Add(new ExceptionItem
                {
                    TestLabel = t4.Label, Type = ExceptionType.Discrepancy,
                    SourceTag = m.SourceTag, TransactionId = m.TransactionId, Supplier = m.Supplier,
                    PayDate = m.PayDateRaw, Amount = m.Gross, ServiceArea = m.ServiceArea, Description = m.Description,
                    HandVerified = HandVerifiedTransNos.Contains(m.TransactionId),
                    Kind = EvidenceKind.GroupEvidence, GroupKey = groupKey, GroupSize = g.Members.Count,
                });
            }
        }
        _tests.Add(t4);

        // Exception test 5 — the same line listed more than once in the published file (same
        // transaction, supplier, amount, description and pay date repeated on separate rows). Computed
        // here rather than inside AuditEngine (which doesn't expose this), using the same
        // redaction exclusion the engine applies to Schedules A/B/D.
        bool IsRedacted(string s) => s.Contains("REDACT", StringComparison.OrdinalIgnoreCase);
        var clean = rawRows.Where(r => !IsRedacted(r.TransactionId) && !IsRedacted(r.Supplier)).ToList();
        var t5 = new TestGroup
        {
            Label = "Exception test 5 — the same line listed more than once in the published file",
            Description = "The exact same transaction number, supplier, amount, description and pay date " +
                "appears on more than one row of the same published file."
        };
        var dupLineGroups = clean
            .GroupBy(r => (r.SourceTag, r.TransactionId, r.Supplier, r.Net, r.Gross, (r.Description ?? "").Trim(), r.PayDateRaw))
            .Where(g => g.Count() > 1);
        // One ExceptionItem per REPEATED ROW (not one aggregate per group) so the evidence panel can
        // show the actual repeated lines paired up, same shape as test 3/4's group evidence.
        int g5Id = 0;
        foreach (var g in dupLineGroups)
        {
            g5Id++;
            var groupKey = $"g5-{g5Id}";
            int n = g.Count();
            foreach (var m in g)
            {
                t5.Items.Add(new ExceptionItem
                {
                    TestLabel = t5.Label, Type = ExceptionType.Discrepancy,
                    SourceTag = m.SourceTag, TransactionId = m.TransactionId, Supplier = m.Supplier,
                    PayDate = m.PayDateRaw, Amount = m.Gross, ServiceArea = m.ServiceArea,
                    Description = m.Description,
                    HandVerified = HandVerifiedTransNos.Contains(m.TransactionId),
                    Kind = EvidenceKind.GroupEvidence, GroupKey = groupKey, GroupSize = n,
                });
            }
        }
        _tests.Add(t5);
        SetDefaultCollapse();
    }

    string TagClass(ExceptionType t) => t switch
    {
        ExceptionType.Discrepancy => "tag-discrepancy",
        ExceptionType.Unreconciled => "tag-unreconciled",
        ExceptionType.Anomaly => "tag-anomaly",
        _ => ""
    };

    const int PageSize = 50;

    void ToggleCollapse(TestGroup t) => t.Collapsed = !t.Collapsed;

    // Filter (and sort) a test's full item list — this runs over EVERY item in the test, not just
    // the current page, since paging/"select all" both need to operate on the full matching set.
    List<ExceptionItem> FilteredItems(TestGroup t)
    {
        IEnumerable<ExceptionItem> q = t.Items;
        if (!string.IsNullOrWhiteSpace(t.FilterText))
        {
            var f = t.FilterText.Trim();
            q = q.Where(i => (i.Supplier?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false)
                           || (i.Description?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        if (!string.IsNullOrWhiteSpace(t.FilterYear))
            q = q.Where(i => i.SourceTag == t.FilterYear);
        q = t.SortColumn switch
        {
            "year" => t.SortDesc ? q.OrderByDescending(i => i.SourceTag, StringComparer.Ordinal) : q.OrderBy(i => i.SourceTag, StringComparer.Ordinal),
            "trans" => t.SortDesc ? q.OrderByDescending(i => i.TransactionId, StringComparer.Ordinal) : q.OrderBy(i => i.TransactionId, StringComparer.Ordinal),
            "paydate" => t.SortDesc ? q.OrderByDescending(i => i.PayDate, StringComparer.Ordinal) : q.OrderBy(i => i.PayDate, StringComparer.Ordinal),
            "amount" => t.SortDesc ? q.OrderByDescending(i => i.Amount) : q.OrderBy(i => i.Amount),
            "payee" => t.SortDesc ? q.OrderByDescending(i => i.Supplier, StringComparer.OrdinalIgnoreCase) : q.OrderBy(i => i.Supplier, StringComparer.OrdinalIgnoreCase),
            "service" => t.SortDesc ? q.OrderByDescending(i => i.ServiceArea, StringComparer.Ordinal) : q.OrderBy(i => i.ServiceArea, StringComparer.Ordinal),
            _ => q
        };
        return q.ToList();
    }

    List<string> DistinctYears(TestGroup t) => t.Items.Select(i => i.SourceTag).Distinct().OrderBy(x => x, StringComparer.Ordinal).ToList();

    int TotalPages(int filteredCount) => Math.Max(1, (int)Math.Ceiling(filteredCount / (double)PageSize));

    void ChangePage(TestGroup t, int delta, int totalPages) => t.Page = Math.Clamp(t.Page + delta, 1, totalPages);

    void OnFilterChanged(TestGroup t) => t.Page = 1;

    void SetSort(TestGroup t, string col)
    {
        if (t.SortColumn == col) t.SortDesc = !t.SortDesc;
        else { t.SortColumn = col; t.SortDesc = false; }
        t.Page = 1;
    }

    string SortArrow(TestGroup t, string col) => t.SortColumn != col ? "" : (t.SortDesc ? " ▼" : " ▲");

    // "Select all" always operates on every FILTERED item, not just the page currently rendered —
    // selection must cover everything matching the current filter, visible or not.
    bool AllFilteredSelected(List<ExceptionItem> filtered) => filtered.Count > 0 && filtered.All(i => i.Selected);

    void SelectAllFiltered(List<ExceptionItem> filtered, bool on)
    {
        foreach (var it in filtered)
        {
            it.Selected = on;
            if (on) _selected[it.Key] = it; else _selected.Remove(it.Key);
        }
    }

    string SelectAllLabel(TestGroup t, int filteredCount) => filteredCount != t.Items.Count
        ? $"select all matching ({filteredCount:N0})"
        : "select all in this test";

    string ShowingLabel(TestGroup t, int filteredCount, int startIdx, int endIdx) => filteredCount == t.Items.Count
        ? $"Showing {startIdx}-{endIdx} of {filteredCount:N0}"
        : $"Showing {startIdx}-{endIdx} of {filteredCount:N0} (filtered from {t.Items.Count:N0})";

    // ---- evidence / highlighting: let a reader see the actual discrepancy, not just a count ----
    static readonly CultureInfo GB = CultureInfo.GetCultureInfo("en-GB");

    void ToggleEvidence(ExceptionItem it) => it.EvidenceOpen = !it.EvidenceOpen;

    // The signed gap between what was published as paid and what was stated as owed — the number
    // every "payment above/below invoice" exception is actually about.
    string EvidenceDiff(ExceptionItem it)
    {
        if (it.Amount is null || it.CompareAmount is null) return "—";
        var d = it.Amount.Value - it.CompareAmount.Value;
        return (d >= 0 ? "+" : "") + d.ToString("C2", GB);
    }

    // A loose heuristic, surfaced as a note not a conclusion: if the sum paid is roughly double the
    // stated invoice, the SAME published line being counted twice (test 5) is a plausible, neutral
    // explanation worth checking before assuming anything else.
    bool LooksLikeDoubleCount(ExceptionItem it) =>
        it.Kind == EvidenceKind.AmountCompare && it.Amount is { } a && it.CompareAmount is { } c && c != 0
        && (double)(a / c) is > 1.85 and < 2.15;

    // Every sibling row sharing this item's GroupKey within the SAME test — pulled from the test's
    // full (unfiltered, unpaged) item list, so the evidence panel is always complete regardless of
    // which page or filter happens to be showing right now.
    List<ExceptionItem> GroupSiblings(TestGroup t, ExceptionItem it) =>
        it.GroupKey is null ? new List<ExceptionItem> { it } : t.Items.Where(x => x.GroupKey == it.GroupKey).ToList();

    // Which evidence-table columns read as "matching" vs "differs" for a given test — derived from
    // the test number in its own label rather than stored per-row, since it's the same for every
    // row in that test. year/trans/paydate/amount/payee/desc are the column keys ColClass checks.
    (string[] Match, string[] Differ) GroupColsFor(TestGroup t) => t.Label switch
    {
        var l when l.Contains("test 3") => (new[] { "payee", "amount", "desc", "paydate" }, new[] { "trans" }),
        var l when l.Contains("test 4") => (new[] { "trans" }, new[] { "payee", "paydate" }),
        var l when l.Contains("test 5") => (new[] { "trans", "payee", "amount", "desc", "paydate", "year" }, Array.Empty<string>()),
        _ => (Array.Empty<string>(), Array.Empty<string>())
    };

    string ColClass(TestGroup t, string col)
    {
        var (match, differ) = GroupColsFor(t);
        return match.Contains(col) ? "ev-col-match" : differ.Contains(col) ? "ev-col-differ" : "";
    }

    string GroupEvidenceIntro(TestGroup t, int groupSize) => groupSize <= 1 ? "" : t.Label switch
    {
        var l when l.Contains("test 5") =>
            $"This exact line appears {groupSize:N0} times in the published file — every column below " +
            "matches, which is the point: it's the same line, repeated.",
        _ =>
            $"{groupSize:N0} rows share this evidence group — columns highlighted green match across all " +
            "of them, columns highlighted amber are where they differ."
    };

    void ToggleSelect(ExceptionItem it, bool on)
    {
        it.Selected = on;
        if (on) _selected[it.Key] = it; else _selected.Remove(it.Key);
    }

    async Task DownloadTest(TestGroup t)
    {
        var sb = new StringBuilder();
        sb.AppendLine("Year,TransactionNo,PayDate,Amount,Payee,ServiceArea,Description,ExceptionType,HandVerified");
        foreach (var it in t.Items)
        {
            sb.AppendLine(string.Join(",",
                Csv(it.SourceTag), Csv(it.TransactionId), Csv(it.PayDate ?? ""), it.Amount?.ToString("F2") ?? "",
                Csv(it.Supplier), Csv(it.ServiceArea ?? ""), Csv(it.Description ?? ""), it.Type.ToString(), it.HandVerified.ToString()));
        }
        await JS.InvokeVoidAsync("analystDownload", SafeFileName(t.Label) + ".csv", sb.ToString(), "text/csv");
    }

    static string Csv(string s) => s.Contains(',') || s.Contains('"') || s.Contains('\n')
        ? "\"" + s.Replace("\"", "\"\"") + "\"" : s;
    static string SafeFileName(string s) => new string(s.Where(c => char.IsLetterOrDigit(c) || c is ' ' or '-').ToArray()).Replace(' ', '-');

    string BuildFoiLetter()
    {
        var sb = new StringBuilder();
        var name = string.IsNullOrWhiteSpace(_foiName) ? "[Your name]" : _foiName.Trim();
        sb.AppendLine(name);
        sb.AppendLine(DateTime.Now.ToString("d MMMM yyyy", CultureInfo.InvariantCulture));
        sb.AppendLine();
        sb.AppendLine("Freedom of Information request");
        sb.AppendLine();
        sb.AppendLine($"To: {_councilDisplayName} — Freedom of Information team");
        sb.AppendLine(_foiContactVerified
            ? $"{_foiContactEmail} ({_foiContactCheckedNote})"
            : "[VERIFY BEFORE SENDING: this council's Freedom of Information contact address has not been " +
              "hand-checked for this tool — find it on the council's own website before sending.]");
        sb.AppendLine();
        sb.AppendLine("Dear Sir or Madam,");
        sb.AppendLine();
        sb.AppendLine($"Under the Freedom of Information Act 2000, I am requesting the following records and " +
            $"information relating to {_councilDisplayName}'s published spending-over-£500 data.");
        sb.AppendLine();
        sb.AppendLine($"The items below were identified as exceptions by a set of mechanical tests run " +
            $"against {_councilDisplayName}'s own published spending data. An exception here is a fact " +
            "about the published numbers, not proof of an error or wrongdoing — I am asking for the " +
            "underlying records and the reason, not for an admission.");
        sb.AppendLine();

        void Section(ExceptionType type, string heading, string definition, string request)
        {
            var items = _selected.Values.Where(i => i.Type == type)
                .OrderBy(i => i.SourceTag).ThenBy(i => i.TransactionId, StringComparer.Ordinal).ToList();
            if (items.Count == 0) return;
            sb.AppendLine($"{heading} ({definition}):");
            sb.AppendLine();
            sb.AppendLine("Year | Transaction no. | Pay date | Amount | Payee | Service area | Cost centre");
            sb.AppendLine("-----|-----------------|----------|--------|-------|---------------|-------------");
            foreach (var it in items)
            {
                sb.AppendLine(string.Join(" | ",
                    it.SourceTag, it.TransactionId, it.PayDate ?? "—",
                    it.Amount is { } a ? a.ToString("C2", CultureInfo.GetCultureInfo("en-GB")) : "—",
                    it.Supplier, it.ServiceArea ?? "—", "— (not published in this dataset)"));
            }
            sb.AppendLine();
            sb.AppendLine("For each item above, please provide: " + request);
            sb.AppendLine();
        }

        Section(ExceptionType.Discrepancy, "Discrepancies", "the published record contradicts itself",
            "a copy of the invoice(s) and payment record(s) for the transaction, and the reason for the " +
            "difference between the invoice amount and the amount(s) paid, for the line being listed more " +
            "than once, or for more than one payee or pay date being recorded against the same transaction " +
            "number (whichever applies to the item).");
        Section(ExceptionType.Unreconciled, "Unreconciled items", "published payments do not cover the stated invoice amount",
            "a copy of the invoice(s) and payment record(s) for the transaction, and the reason the " +
            "published payments do not cover the full stated invoice amount.");
        Section(ExceptionType.Anomaly, "Anomalies", "the same supplier, amount, description and date recorded under different transaction numbers",
            "a copy of the invoice(s) and payment record(s) for each transaction number listed, and the " +
            "reason the same supplier, amount, description and date appear under more than one transaction number.");

        sb.AppendLine("I understand you are required to respond within 20 working days of receipt.");
        sb.AppendLine();
        if (_foiElectronic)
        {
            sb.AppendLine(string.IsNullOrWhiteSpace(_foiEmail)
                ? "I am happy to receive your response electronically."
                : $"I am happy to receive your response electronically, to {_foiEmail.Trim()}.");
        }
        else
        {
            sb.AppendLine("Please send your response by post.");
        }
        sb.AppendLine();
        sb.AppendLine("Yours faithfully,");
        sb.AppendLine();
        sb.AppendLine(name);
        if (!string.IsNullOrWhiteSpace(_foiEmail)) sb.AppendLine(_foiEmail.Trim());
        return sb.ToString();
    }

    async Task CopyFoi() => await JS.InvokeVoidAsync("copyText", BuildFoiLetter());
    async Task DownloadFoi() => await JS.InvokeVoidAsync("analystDownload", "foi-request.txt", BuildFoiLetter(), "text/plain");
}
