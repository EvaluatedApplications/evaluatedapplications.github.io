            else if (h.Key == "westberkshire")
            {
                <p>Contains data from <a href="@h.Profile.TransparencyPageUrl" target="_blank" rel="noopener">West
                    Berkshire Council</a> (its "Expenditure over £500" page), used under the <a href="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/" target="_blank" rel="noopener">Open
                    Government Licence v3.0</a>. Every file below was retrieved <b>@h.RetrievedOn</b>. The @h.Periods.Count months
