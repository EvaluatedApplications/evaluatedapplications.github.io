        @if (h.Key == "reading")
        {
            <p class="note-callout">Reading publishes one signed <b>Amount</b> column — there is no
                separate invoice amount to compare a payment against, so <b>Exception tests 1 and 2
                (payment vs. stated invoice amount) do not apply to this council</b> — not a clean
                result, a structural fact about what's published. Negative amounts are real credits
                and corrections, not errors. Tests 3-5 (repeated payments, multi-payee transactions,
                repeated lines) still run below.</p>
        }
        else if (h.Key == "westberkshire")
        {
            <p class="note-callout">West Berkshire publishes one amount per row and <b>no transaction, invoice or
                voucher reference at all</b>. The tool gives every row its own reference internally, so <b>Exception tests 1,
                2, 4 and 5 (payment vs. invoice, one reference with several payees, the same line listed twice) cannot find
                anything for this council by construction</b> — not a clean result, a structural fact about what's published.
                Test 3 (the same payment repeated) and the standing-payment check do still run.</p>
        }
        else if (h.Key == "rbwm")
        {
            <p class="note-callout">The Royal Borough publishes <b>every payment of £100 or more</b> charged to a cost
                centre (not £500 as most councils do), with one amount per row and no invoice or VAT split, so
                <b>Exception tests 1 and 2 (payment vs. stated invoice amount) do not apply to this council</b> — a structural
                fact about what's published, not a clean result. Lines the council already published in an earlier file were
                removed before the checks ran, so the same payment is not counted twice (the "Files" check below shows what that
                rule leaves).</p>
        }

        <section class="loaded-stats">
            <h2>Loaded data</h2>
            <p class="hint">@StatsLine()</p>
            @foreach (var key in _loadedCouncils.OrderBy(x => x))
            {
                if (_redaction.TryGetValue(key, out var rd) && rd.Redacted > 0)
                {
                    <p class="hint">@CouncilName(key): <b>@rd.Redacted.ToString("N0") of @rd.Rows.ToString("N0")</b> loaded rows
                        (@((double)rd.Redacted / rd.Rows * 100).ToString("0.#")%) carry a redacted payee or reference (the council
                        withholds it, for example for safeguarding) and are <b>left out of every exception test</b>; they are excluded,
                        not ignored, so the totals on this page do not include them.</p>
                }
            }
        </section>

        <section class="years">
            <h2>Add council / @h.PeriodNoun</h2>
            <p class="hint">@LoadHint(h) Each file BulkLoads straight into a real database running in your browser tab —
                the same engine behind <a href="/tools/analyst">The Analyst</a>. The other councils hosted here load the same
                way (go back to the picker and open another), and the cross-council views get more complete the more you load.</p>
            <div class="council-add">
                <div class="council-add-head">
                    <b>@h.Profile.Name</b>
                    <span class="hint">@h.Periods.Count(y => y.Loaded) of @h.Periods.Count @(h.PeriodNoun)s loaded</span>
                </div>
                <div class="period-tools">
                    <button class="ghost" type="button" @onclick="() => TickAll(h, true)" disabled="@(_busy || h.Periods.All(y => y.Loaded))">Select all</button>
                    <button class="ghost" type="button" @onclick="() => TickAll(h, false)" disabled="@(_busy || TickedCount(h) == 0)">Clear</button>
                    <span class="hint">@TickedCount(h) ticked</span>
                </div>
                @if (h.Grouped)
                {
                    @foreach (var g in PeriodGroups(h))
                    {
                        <div class="fy-group">
                            <label class="fy-head">
                                <input type="checkbox" checked="@GroupAllTicked(g)" @onchange="e => TickGroup(g, (bool)e.Value!)" disabled="@(_busy || g.All(y => y.Loaded))" />
                                <b>@g.Key</b> <span class="hint">@g.Count(y => y.Loaded) of @g.Count() loaded</span>
                            </label>
                            <div class="year-grid">
                                @foreach (var y in g)
                                {
                                    <label class="year-pick @(y.Loaded ? "loaded" : "")">
                                        <input type="checkbox" checked="@y.Checked" @onchange="e => y.Checked = (bool)e.Value!" disabled="@(_busy || y.Loaded)" />
                                        <span class="year-tag">@y.Tag</span>
                                        <span class="year-fmt">@(y.Loaded ? "loaded" : y.Format == SourceFormat.Xlsx ? "xlsx source" : "csv source")</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="year-grid">
                        @foreach (var y in h.Periods)
                        {
                            <label class="year-pick @(y.Loaded ? "loaded" : "")">
                                <input type="checkbox" checked="@y.Checked" @onchange="e => y.Checked = (bool)e.Value!" disabled="@(_busy || y.Loaded)" />
                                <span class="year-tag">@y.Tag</span>
                                <span class="year-fmt">@(y.Loaded ? "loaded" : y.Format == SourceFormat.Xlsx ? "xlsx source" : "csv source")</span>
                            </label>
                        }
                    </div>
                }
                <button class="go" @onclick="() => LoadSelected(h)" disabled="@(_busy || TickedCount(h) == 0)" type="button">
                    @(_busy ? _phase : "Load selected")
                </button>
            </div>
        </section>
    </div>;


    // =====================================================================================================
    // "Every check at a glance" table: one row per check (the exception tests, then the Session 25/26 checks), a grand total.
    // =====================================================================================================
    RenderFragment GlanceTable() => @<section class="summary-bar glance">
        <h2>Every check at a glance</h2>
        <p class="hint">One row per check: how many items it highlights, and the £ figure it measures. The £ column means
            something different in each row (the right-hand words say what), and a larger number is not a worse finding.</p>
        @{ var rows = SummaryRows(); decimal grand = rows.Where(r => r.Value is not null).Sum(r => r.Value!.Value); }
        <div class="table-scroll">
            <table class="exc-table glance-table">
                <thead><tr><th>Check</th><th>Items</th><th>What the £ measures</th><th>£</th></tr></thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        <tr>
                            <td>@r.Title</td>
                            <td>@r.Count</td>
                            <td>@r.ValueMeaning</td>
                            <td class="num">@(r.Value is { } v ? Money(v) : "—")</td>
                        </tr>
                    }
                    <tr class="grand-total">
                        <td><b>Grand total</b></td><td></td><td>everything listed above, added together</td><td class="num"><b>@Money(grand)</b></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="hint">The grand total is a plain sum of the rows above. The same payment can appear under more than one check
            (a standing payment is also a repeated payment; a flagged month is part of its payee's total; a payment between councils
            is listed both as a flow and, if it is debt-labelled, as a loan figure), so it is the total of everything highlighted, not a
            count of distinct money. <strong>None of it is money proven lost, wasted or owed.</strong></p>
    </section>;

    // =====================================================================================================
    // "More checks": the Session 25/26 sections
    // =====================================================================================================
    RenderFragment Card(string id, string title, ExceptionType? term, string countText, decimal? total, RenderFragment body) => @<div class="test-card" id="@id">
        <button class="test-head" type="button" @onclick="() => Toggle(id)" aria-expanded="@IsOpen(id)">
            <span class="collapse-arrow">@(IsOpen(id) ? "▾" : "▸")</span>
            <h3>@title</h3>
            @if (term is { } tm) { <span class="tag @TagClass(tm)">@tm.ToString()</span> }
            <span class="count">@countText</span>
            @if (total is { } tv) { <span class="count count-total">@Money(tv)</span> }
        </button>
        @if (IsOpen(id)) { <div class="test-body">@body</div> }
    </div>;

    RenderFragment SelectCell(ExceptionItem? it) => @<td>
        @if (it is not null)
        {
            <input type="checkbox" checked="@it.Selected" @onchange="e => ToggleSelect(it, (bool)e.Value!)" aria-label="Add to the Freedom of Information request" />
        }
    </td>;

    RenderFragment MoreButton(string id, int shown, int total) => @<div class="pagination">
        <span class="hint">Showing @Math.Min(shown, total).ToString("N0") of @total.ToString("N0")</span>
        @if (shown < total)
        {
            <button class="ghost" type="button" @onclick="() => More(id)">Show @Math.Min(MoreRows, total - shown) more</button>
        }
    </div>;

    RenderFragment FilterBox(string id, string placeholder) => @<input type="text" class="filter-text" placeholder="@placeholder"
        value="@Filter(id)" @oninput="e => SetFilter(id, e.Value?.ToString())" />;

    RenderFragment SourceTable(string key) => @<div class="table-scroll">
        @if (!_srcRows.TryGetValue(key, out var sr))
        {
            <p class="hint">No rows found for this.</p>
        }
        else
        {
            <table class="ev-table">
                <thead><tr><th>File</th><th>Trans. no.</th><th>Pay date</th><th>Payee</th><th>Net</th><th>Description</th></tr></thead>
                <tbody>
                    @foreach (var r in sr)
                    {
                        <tr><td>@r.Tag</td><td>@r.TransId</td><td>@PayDateText(r.PayDate)</td><td>@r.Supplier</td><td>@Money(r.Net)</td><td>@r.Description</td></tr>
                    }
                </tbody>
            </table>
            <p class="hint">First @sr.Count of the rows concerned (read back from the in-browser database, as published).</p>
        }
    </div>;

    RenderFragment InsightsBlock() => @<section class="insights">
        <h2>More checks</h2>
        <p class="hint">Each check below says in words what it looks at and runs the same way for every council. They read
            the published files and nothing else; none of them says <i>why</i> a figure looks the way it does, and a council can
            only answer that.</p>
        <div class="scope-box">
            <p class="hint">The checks that read the councils' whole files (payments between councils, loan interest, file
                repeats, repeated lines, what grows and what comes back) cover: <b>@ScopeLine()</b>. The checks that need the rows
                themselves (standing payments, correction pairs, files that do not match their name) cover what you have loaded.</p>
            <label class="select-all">
                <input type="checkbox" checked="@_showAllSix" @onchange="e => _showAllSix = (bool)e.Value!" />
                Include all six councils the files cover (Wokingham, Merton, Reading, Bracknell Forest, West Berkshire, RBWM)
            </label>
            @{ var credits = ScopeProfiles(); }
            <p class="hint">Contains public sector information published by
                @for (int ci = 0; ci < credits.Count; ci++)
                {
                    <a href="@credits[ci].TransparencyPageUrl" target="_blank" rel="noopener">@credits[ci].Name</a>@(ci < credits.Count - 2 ? ", " : ci == credits.Count - 2 ? " and " : "")
                }
                and used under the <a href="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/" target="_blank" rel="noopener">Open Government Licence v3.0</a>.</p>
        </div>
        @if (_crossLoading) { <p class="hint">Loading the cross-council files…</p> }
        @if (_crossError is not null) { <p class="err">@_crossError</p> }
        @if (_checksRunning) { <p class="hint">Running the in-browser checks…</p> }
        @if (_checksError is not null) { <p class="err">@_checksError</p> }

        @StandingSection()
        @if (_crossLoaded) { @FlowsSection() @LoansSection() }
        @CorrectionsSection()
        @PubFaultsSection()
        @if (_crossLoaded) { @FileDupSection() @WithinSection() @SinkSection() }
    </section>;

    // ---------------------------------------------------------------- 5. standing payments

    RenderFragment StandingSection()
    {
        var all = StandingGroups();
        var catchUp = all.Where(g => g.Classification == "StandingScheduleCatchUp").ToList();
        var surplus = all.Where(g => g.Classification == "StandingScheduleSurplus").ToList();
        decimal total = all.Sum(g => g.Total);
        return @<div>
            <div class="plain-explain">
                <p>Some payments are made <b>once a month, month after month</b>, to the same supplier for the same amount (a
                    <b>standing payment</b>). This check counts them against the calendar: on a date when that amount was paid several times,
                    are there empty months that make up the difference? For example, <i>this amount is paid once a month; this month it was
                    paid three times because two earlier months have none</i> (audit term: an <b>anomaly</b>, a pattern in the published rows).
                    @if (all.Count > 0)
                    {
                        <text>In what you've loaded, <b>@all.Count.ToString("N0") groups</b> of repeated payments (@Money(total)) fit that shape:
                        @catchUp.Count.ToString("N0") where empty months make up the difference, and @surplus.Count.ToString("N0") where there are
                        more payments than months and nothing returned.</text>
                    }
                    else
                    {
                        <text>Load a period of a council above to see which of its repeated payments fit.</text>
                    }
                </p>
                <p><b>What this could mean:</b> a payment that was late and then caught up, one made ahead of time, one made twice and later
                    repaid, or a genuine extra payment. The files show the count, not the reason. @EndsInFoiLine</p>
            </div>
            @Card("standing", "Standing payments paid late, then caught up", ExceptionType.Anomaly, $"{all.Count:N0} groups", total, StandingBody(all, catchUp, surplus))
        </div>;
    }

    RenderFragment StandingBody(List<StandingGroup> all, List<StandingGroup> catchUp, List<StandingGroup> surplus)
    {
        var f = Filter("standing");
        var shown = all.Where(g => f == "" || g.Supplier.Contains(f, StringComparison.OrdinalIgnoreCase) || g.Council.Contains(f, StringComparison.OrdinalIgnoreCase)).ToList();
        int lim = Limit("standing");
        return @<div>
            <p class="test-desc"><b>Rule:</b> a supplier-and-amount counts as a standing payment when it appears in at least six different calendar
                months and in at least 60% of those months exactly once. For a group paid on one date, payments are then counted from the first month
                that amount appears to three months after the group's own month, against the number of months elapsed (plus any empty months since that
                supplier's previous standing amount ended), less credits of the same amount. If the payments do not outnumber the months the group is
                <b>caught up</b>; if they do, and nothing was returned, it is a <b>surplus</b>. Only rows with no supplier invoice number to check
                are tested this way.</p>
            @if (all.Count == 0)
            {
                <p class="hint">None found in the councils you've loaded.</p>
            }
            else
            {
                <div class="classification-legend">
                    <div class="classification-row classification-unexplained">
                        <div class="classification-row-top">
                            <span class="tag tag-unexplained">Standing payment, surplus</span>
                            <span class="classification-count">@surplus.Count.ToString("N0")</span>
                            <span class="classification-total">@Money(surplus.Sum(g => g.Total))</span>
                        </div>
                        <details class="classification-meaning-details"><summary>What this means</summary>
                            <p class="classification-meaning">@ClassificationMeanings["StandingScheduleSurplus"]</p></details>
                    </div>
                    <div class="classification-row">
                        <div class="classification-row-top">
                            <span class="tag tag-label">Standing payment, caught up</span>
                            <span class="classification-count">@catchUp.Count.ToString("N0")</span>
                            <span class="classification-total">@Money(catchUp.Sum(g => g.Total))</span>
                        </div>
                        <details class="classification-meaning-details"><summary>What this means</summary>
                            <p class="classification-meaning">@ClassificationMeanings["StandingScheduleCatchUp"]</p></details>
                    </div>
                </div>
                <p class="ev-note ev-note-warn">For a surplus: more payments than months in the published data; the files do not say why.</p>
                <div class="panel-controls">@FilterBox("standing", "Filter payee / council…")</div>
                <div class="table-scroll table-scroll-fixed">
                    <table class="exc-table">
                        <thead><tr><th></th><th>Council</th><th>Files</th><th>Payee</th><th>Pay date</th><th>Each</th><th>Payments</th><th>Total</th><th>Label</th></tr></thead>
                        <tbody>
                            @foreach (var g in shown.Take(lim))
                            {
                                <tr class="@(g.Classification == "StandingScheduleSurplus" ? "" : "labelled-row")">
                                    @SelectCell(g.Rep)
                                    <td>@g.Council</td><td>@g.Years</td><td>@g.Supplier</td><td>@(PayDateText(g.PayDate))</td>
                                    <td>@Money(g.Each)</td><td>@g.Payments.ToString("N0")</td><td>@Money(g.Total)</td>
                                    <td><span class="tag @(g.Classification == "StandingScheduleSurplus" ? "tag-unexplained" : "tag-label")">@ClassificationDisplay(g.Classification)</span></td>
                                </tr>
                                @if (g.Detail != "")
                                {
                                    <tr class="caption-row"><td></td><td colspan="8"><span class="row-caption">@g.Detail</span></td></tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                @MoreButton("standing", lim, shown.Count)
            }
        </div>;
    }

    // ---------------------------------------------------------------- 1. flows between councils (alias-aware)

    RenderFragment FlowsSection()
    {
        var ents = FlowEntities();
        var lines = FlowsScoped("accept");
        decimal total = lines.Sum(l => l.Net);
        var probable = FlowsScoped("probable");
        var grades = _grades.Where(g => InScope(g.PayerSlug)).OrderByDescending(g => g.Score).ToList();
        return @<div>
            <div class="plain-explain">
                <p>This adds up <b>how much each council paid to another council, or to a company one of them owns</b>, even when the
                    other side is spelled differently on the payer's books. A finance system holds one supplier record per spelling, so a
                    search on one exact name misses the rest.
                    @if (ents.Count > 0)
                    {
                        <text>In the councils shown, <b>@lines.Count.ToString("N0") spellings</b> make up <b>@ents.Count.ToString("N0") bodies</b>, @Money(total) in all
                        (@(ents.OrderByDescending(e => e.Spellings).First().Entity) appears under @ents.Max(e => e.Spellings) spellings).</text>
                    }
                </p>
                <p><b>What this could mean:</b> ordinary business between public bodies (shared services, pooled pensions, care placements,
                    jointly owned companies). Which spellings belong to which body was decided by a person reading the names, not by a score;
                    see "How the matches were graded" below. @EndsInFoiLine</p>
                <p class="ev-note ev-note-warn"><b>What the payer says it paid; never reconciled to the payee's income.</b></p>
            </div>
            @Card("flows", "Payments between councils and their companies", null, $"{ents.Count:N0} bodies, {lines.Count:N0} spellings", total, FlowsBody(ents, probable, grades))
        </div>;
    }

    RenderFragment FlowsBody(List<(string Entity, decimal Net, int Rows, int Spellings, int Payers, List<FlowLine> Lines)> ents, List<FlowLine> probable, List<AliasGrade> grades)
    {
        return @<div>
            @if (ents.Count == 0)
            {
                <p class="hint">No payments between these councils are recorded in the files for the councils shown.</p>
            }
            @foreach (var e in ents)
            {
                <div class="entity">
                    <h4>@e.Entity <span class="hint">— @Money(e.Net) in @e.Rows.ToString("N0") payments, @e.Spellings spelling@(e.Spellings == 1 ? "" : "s") across @e.Payers payer@(e.Payers == 1 ? "" : "s")</span></h4>
                    <div class="table-scroll">
                        <table class="exc-table">
                            <thead><tr><th></th><th>Paid by</th><th>Name as published</th><th>Payments</th><th>Total</th><th>Files</th><th>Found by</th><th>Rows</th></tr></thead>
                            <tbody>
                                @foreach (var l in e.Lines)
                                {
                                    var fl = l;
                                    <tr>
                                        @SelectCell(fl.Item)
                                        <td>@CouncilName(fl.PayerSlug)</td><td>@fl.SupplierName</td><td>@fl.Rows.ToString("N0")</td><td>@Money(fl.Net)</td>
                                        <td title="@fl.Years">@FilesSummary(fl.Years)</td>
                                        <td>@(fl.InOldExactPass ? "exact name" : "alias match only")</td>
                                        <td><button class="evidence-toggle" type="button" @onclick="() => ToggleFlowRows(fl)">@(fl.Open ? "Hide ▴" : "See the rows ▾")</button></td>
                                    </tr>
                                    @if (fl.Open)
                                    {
                                        <tr class="evidence-row">
                                            <td colspan="8">
                                                @if (_flowRowsLoading) { <p class="hint">Loading the rows…</p> }
                                                else
                                                {
                                                    var src = FlowSource(fl);
                                                    <div class="table-scroll table-scroll-fixed">
                                                        <table class="ev-table">
                                                            <thead><tr><th>File</th><th>Trans. no.</th><th>Pay date</th><th>Payee</th><th>Net</th><th>Description</th></tr></thead>
                                                            <tbody>
                                                                @foreach (var r in src.Take(100))
                                                                {
                                                                    <tr><td>@r.Year</td><td>@r.TransactionId</td><td>@PayDateText(r.PayDate)</td><td>@r.Supplier</td><td>@Money(r.Net)</td><td>@r.Description</td></tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <p class="hint">@src.Count.ToString("N0") published lines (first @Math.Min(100, src.Count) shown), exactly as published.
                                                        <button class="evidence-toggle" type="button" @onclick="() => DownloadFlowRows(fl)">↓ All of them (CSV)</button></p>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            @if (probable.Count > 0)
            {
                <details class="retrieved">
                    <summary>Possible matches, shown separately and left out of every total above (@probable.Count)</summary>
                    <ul>
                        @foreach (var l in probable)
                        {
                            <li>@CouncilName(l.PayerSlug) → @l.SupplierName (possibly @l.Entity): @l.Rows.ToString("N0") payment@(l.Rows == 1 ? "" : "s"), @Money(l.Net)</li>
                        }
                    </ul>
                </details>
            }
            <details class="retrieved">
                <summary>How the matches were graded (@grades.Count proposals)</summary>
                <p class="hint">A search proposed supplier names that might be the same body; <b>a person then graded each proposal</b>
                    accept, probable or reject. No similarity score separates right from wrong (a near-identical name can be a different company and
                    a very different spelling can be the same body), so the score below is shown for information only, never as the rule.</p>
                <div class="table-scroll table-scroll-fixed">
                    <table class="exc-table">
                        <thead><tr><th>Body</th><th>Paid by</th><th>Name as published</th><th>Similarity</th><th>Grade</th><th>Note</th></tr></thead>
                        <tbody>
                            @foreach (var g in grades)
                            {
                                <tr><td>@g.Entity</td><td>@CouncilName(g.PayerSlug)</td><td>@g.SupplierName</td><td>@g.Score.ToString("0.00")</td><td>@g.Verdict</td><td>@g.Note</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        </div>;
    }

    // "FY2020-21 FY2021-22 ... FY2025-26" -> "6 files, FY2020-21 to FY2025-26"
    static string FilesSummary(string years)
    {
        var parts = years.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length <= 2 ? string.Join(", ", parts) : $"{parts.Length} files, {parts[0]} to {parts[^1]}";
    }

    // ---------------------------------------------------------------- 2. loan interest between councils

    static string RebuildText(LoanLine l)
    {
        if (l.Status == "NotApplicable") return "Not a loan payment (" + (l.Kind == "re3-waste-pfi" ? "an instalment under a shared waste contract" : "a different kind of payment") + ")";
        string tidy = l.Note.Replace(" (rate x term is a hyperbola)", "").Replace("rate x term is a hyperbola", "").Trim();
        if (l.RateBp is { } bp && l.Days is { } d && l.Principal is { } pr)
            return $"{Money(pr)} at {bp / 100m:0.00}% for {d} days (actual days over 365)" + (l.Status == "DecodesPrincipalUnpublished" ? "; principal inferred, not published" : "");
        if (l.Status == "Decodes") return $"{l.Candidates} rate-and-days pairs fit, so none can be singled out: " + tidy;
        if (l.Status == "DecodesPrincipalUnpublished") return $"{l.Candidates} loan sizes, rates and day counts fit, principal not published: " + tidy;
        return "Not rebuilt: " + tidy;
    }

    RenderFragment LoansSection()
    {
        var all = LoansScoped();
        var rel = all.Where(l => l.Status != "NotApplicable").ToList();
        int notRebuilt = rel.Count(l => l.Status == "DoesNotDecode");
        decimal total = rel.Sum(l => l.Amount);
        return @<div>
            <div class="plain-explain">
                <p>For a payment between councils that looks like <b>loan interest</b>, can the figure be rebuilt from a round loan, a rate and
                    a number of days? If yes, the rebuild is shown; if not, it is shown as <b>not rebuilt</b>. Only payments to another council that
                    the council's own file labels as debt, interest or a loan are listed; payments to banks, brokers, the Public Works Loan Board or
                    to companies a council owns are different instruments and are not tested here.
                    @if (rel.Count > 0)
                    {
                        <text>In the councils shown: <b>@rel.Count.ToString("N0") payments</b> (@Money(total)), @(rel.Count(l => l.Status == "Decodes")) rebuilt with a published principal,
                        @(rel.Count(l => l.Status == "DecodesPrincipalUnpublished")) rebuilt only if the principal is inferred, and <b>@notRebuilt.ToString("N0") not rebuilt</b>.</text>
                    }
                </p>
                <p><b>What this could mean:</b> loan interest is usually quoted at a rate on the actual number of days over 365. A figure that is not rebuilt
                    may use a variable rate, part of a period, a different day count, an arrangement fee, or a loan the file does not describe; the file does
                    not say which. @EndsInFoiLine</p>
            </div>
            @Card("loans", "Loan interest between councils: can the figure be rebuilt?", ExceptionType.Anomaly, $"{rel.Count:N0} payments, {notRebuilt:N0} not rebuilt", total, LoansBody(all))
        </div>;
    }

    RenderFragment LoansBody(List<LoanLine> all)
    {
        int lim = Limit("loans");
        return @<div>
            @if (all.Count == 0)
            {
                <p class="hint">No debt- or interest-labelled payments between councils in the councils shown.</p>
            }
            else
            {
                <div class="table-scroll table-scroll-fixed">
                    <table class="exc-table">
                        <thead><tr><th></th><th>Council</th><th>File</th><th>Trans. no.</th><th>Paid to</th><th>Pay date</th><th>Amount</th><th>Result</th><th>The rebuild</th></tr></thead>
                        <tbody>
                            @foreach (var l in all.Take(lim))
                            {
                                <tr class="@(l.Status == "DoesNotDecode" ? "" : "labelled-row")">
                                    @SelectCell(l.Item)
                                    <td>@l.Council</td><td>@l.Year</td><td>@l.TransactionId</td><td>@l.Counterparty</td><td>@l.PayDate</td><td>@Money(l.Amount)</td>
                                    <td><span class="tag @(l.Status == "DoesNotDecode" ? "tag-unexplained" : "tag-label")">@(l.Status switch { "Decodes" => "Rebuilt", "DecodesPrincipalUnpublished" => "Rebuilt, principal inferred", "DoesNotDecode" => "Not rebuilt", _ => "Not a loan" })</span></td>
                                    <td class="wrap-cell">@RebuildText(l)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @MoreButton("loans", lim, all.Count)
            }
        </div>;
    }

    // ---------------------------------------------------------------- 3. reversal-and-correction pairs

    RenderFragment CorrectionsSection()
    {
        var items = _checks?.Corrections ?? Array.Empty<CorrectionFinding>();
        int examined = _checks?.GroupsExamined ?? 0;
        decimal total = items.Sum(c => Math.Abs(c.Residual));
        return @<div>
            <div class="plain-explain">
                <p>Some bookings <b>reverse one amount and post another</b> that differ in a <b>single digit</b>, leaving a small amount on the books.
                    This check looks inside every transaction number that carries a handful of lines (eight or fewer, each of £1,000 or more) for a
                    negative line and a positive line that differ in exactly one digit and whose difference is everything the group leaves over
                    (audit term: a <b>discrepancy</b>, the published record disagreeing with itself).
                    @if (_checks is null)
                    {
                        <text>Load a period of a council above to run it.</text>
                    }
                    else
                    {
                        <text>In what you've loaded it examined <b>@examined.ToString("N0")</b> small groups and found <b>@items.Count.ToString("N0")</b>@(items.Count == 0 ? "." : $" ({Money(total)} left over).")</text>
                    }
                </p>
                <p><b>What this could mean:</b> a keying slip that was corrected, a deliberate re-posting, or two unrelated lines that happen to look alike.
                    <b>The files do not show which figure was right, or that either was a slip.</b> @EndsInFoiLine</p>
            </div>
            @Card("corrections", "Reversal-and-correction pairs", ExceptionType.Discrepancy, $"{items.Count:N0} of {examined:N0} groups", total, CorrectionsBody(items, examined))
        </div>;
    }

    RenderFragment CorrectionsBody(IReadOnlyList<CorrectionFinding> items, int examined)
    {
        return @<div>
            @if (_checks is null)
            {
                <p class="hint">Nothing loaded yet.</p>
            }
            else if (items.Count == 0)
            {
                <p class="hint">None found among the @examined.ToString("N0") small transaction groups in what you've loaded.</p>
            }
            else
            {
                <div class="table-scroll">
                    <table class="exc-table">
                        <thead><tr><th></th><th>Council</th><th>File</th><th>Trans. no.</th><th>Payee</th><th>Negative line</th><th>Positive line</th><th>The digit</th><th>Left over</th><th>Lines</th></tr></thead>
                        <tbody>
                            @foreach (var c in items)
                            {
                                var cc = c;
                                var item = _corrItems.FirstOrDefault(i => i.Council == CouncilName(cc.Council) && i.SourceTag == cc.SourceTag && i.TransactionId == cc.TransactionId);
                                <tr>
                                    @SelectCell(item)
                                    <td>@CouncilName(cc.Council)</td><td>@cc.SourceTag</td><td>@cc.TransactionId</td><td>@cc.Supplier</td>
                                    <td>@Money(cc.NegativeLine)</td><td>@Money(cc.PositiveLine)</td>
                                    <td>@DigitPlace(cc.DigitPositionFromRight): @cc.NegativeDigit against @cc.PositiveDigit</td>
                                    <td>@Money(cc.Residual)</td><td>@cc.Lines</td>
                                </tr>
                                <tr class="evidence-row">
                                    <td colspan="10">
                                        <div class="table-scroll">
                                            <table class="ev-table">
                                                <thead><tr><th>File</th><th>Trans. no.</th><th>Pay date</th><th>Payee</th><th>Net</th><th>Description</th></tr></thead>
                                                <tbody>
                                                    @foreach (var ln in CorrectionLines(cc))
                                                    {
                                                        <tr class="@(ln.Net == cc.NegativeLine || ln.Net == cc.PositiveLine ? "this-row" : "")">
                                                            <td>@ln.SourceTag</td><td>@ln.TransactionId</td><td>@(ln.PayDate ?? "—")</td><td>@ln.Supplier</td><td>@(ln.Net is { } n ? Money(n) : "—")</td><td>@(ln.Description ?? "—")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        <p class="hint">The two lines the rule picked are outlined. The files do not show which figure was right, or that either was a slip.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>;
    }

    // ---------------------------------------------------------------- 4. publication faults

    RenderFragment PubFaultsSection()
    {
        var faults = _checks?.Faults ?? Array.Empty<FileFault>();
        var marked = MarkedFaults().ToList();
        decimal total = _pubItems.Sum(p => p.Amount ?? 0m);
        int overlapRows = marked.Sum(m => m.OverlapRows);
        return @<div>
            <div class="plain-explain">
                <p>Does this council's file for a month <b>actually contain that month's payments</b>, and did any payment <b>appear in two files</b>?
                    Two facts are worked out for every file you load: the share of its dated rows whose pay date falls in the month the file is named for
                    (only for files named for a single month), and the rows that already appeared in an earlier file of the same council, matched on the
                    transaction number, pay date, payee and net amount (audit term: a <b>discrepancy</b>).
                    @if (_checks is null)
                    {
                        <text>Load a period of a council above to run it.</text>
                    }
                    else
                    {
                        <text>In what you've loaded: <b>@marked.Count.ToString("N0") of @faults.Count.ToString("N0") files</b> are marked (@Money(total) of net amounts concerned).</text>
                    }
                </p>
                <p><b>What this could mean:</b> a file published under the wrong month, a file that was republished or re-extracted, or a council that
                    publishes late payments in a later file. The engine already removes repeated lines before it checks anything else (for RBWM, lines
                    already published in an earlier file), which is why this page's totals can differ from a plain sum of the files. This check does not infer a
                    cause. @EndsInFoiLine</p>
            </div>
            @Card("pubfaults", "Files whose contents do not match their name, or overlap another file", ExceptionType.Discrepancy, $"{marked.Count:N0} of {faults.Count:N0} files", total, PubFaultsBody(faults, marked))
        </div>;
    }

    RenderFragment PubFaultsBody(IReadOnlyList<FileFault> faults, List<FileFault> marked)
    {
        bool all = IsOpen("pubfaults-all");
        var list = (all ? faults.OrderByDescending(f => IsMarked(f)).ThenBy(f => f.InsideShare).ThenBy(f => f.Council).ThenBy(f => f.Tag).ToList() : marked.OrderBy(f => f.InsideShare).ThenBy(f => f.Council).ThenBy(f => f.Tag).ToList());
        return @<div>
            <p class="test-desc"><b>Rule:</b> a file is <b>marked</b> when it is named for a single month and fewer than 9 in 10 of its dated rows are paid in that
                month, or when any of its lines were already published in an earlier file of the same council. Files named for a longer period (a year, a quarter) are
                not judged on the first fact, because the period a council's own file covers is not stated in its name the way a month is.</p>
            @if (_checks is null)
            {
                <p class="hint">Nothing loaded yet.</p>
            }
            else
            {
                <label class="select-all"><input type="checkbox" checked="@all" @onchange='e => _open["pubfaults-all"] = (bool)e.Value!' /> Show all @faults.Count.ToString("N0") loaded files, not only the marked ones</label>
                @if (list.Count == 0)
                {
                    <p class="hint">No loaded file is marked by this rule.</p>
                }
                else
                {
                    <div class="table-scroll table-scroll-fixed">
                        <table class="exc-table">
                            <thead><tr><th></th><th>Council</th><th>File</th><th>Rows</th><th>Paid in its named month</th><th>Paid outside it</th><th>Lines already in an earlier file</th><th>Source rows</th></tr></thead>
                            <tbody>
                                @foreach (var f in list)
                                {
                                    var ff = f;
                                    string outKey = $"pub-out:{ff.Council}:{ff.Tag}", ovKey = $"pub-ov:{ff.Council}:{ff.Tag}";
                                    <tr class="@(IsMarked(ff) ? "" : "labelled-row")">
                                        @SelectCell(PubItem(ff))
                                        <td>@CouncilName(ff.Council)</td><td>@ff.Tag</td><td>@ff.Rows.ToString("N0")</td>
                                        <td>@(ff.SingleMonth && ff.DatedRows > 0 ? $"{ff.InsideRows:N0} of {ff.DatedRows:N0} ({ff.InsideShare:P0})" : "not judged (not a single month)")</td>
                                        <td>@(ff.SingleMonth ? $"{ff.DatedRows - ff.InsideRows:N0} rows, {Money((decimal)ff.OutsideNetAbs)}" : "—")</td>
                                        <td>@(ff.OverlapRows > 0 ? $"{ff.OverlapRows:N0} ({string.Join(", ", ff.OverlapWith.Select(o => $"{o.OtherTag}: {o.Rows:N0}"))}), {Money((decimal)ff.OverlapNetAbs)}" : "none")</td>
                                        <td>
                                            @if (OutsideMarked(ff)) { <button class="evidence-toggle" type="button" @onclick="() => ToggleSource(outKey, ff.OutsideIds)">@(_srcOpen.Contains(outKey) ? "Hide ▴" : "Outside rows ▾")</button> }
                                            @if (ff.OverlapRows > 0) { <button class="evidence-toggle" type="button" @onclick="() => ToggleSource(ovKey, ff.OverlapIds)">@(_srcOpen.Contains(ovKey) ? "Hide ▴" : "Repeated rows ▾")</button> }
                                        </td>
                                    </tr>
                                    @if (_srcOpen.Contains(outKey))
                                    {
                                        <tr class="evidence-row"><td colspan="8"><p class="hint">Rows in <b>@ff.Tag</b> paid outside @ff.PeriodLabel:</p>@SourceTable(outKey)</td></tr>
                                    }
                                    @if (_srcOpen.Contains(ovKey))
                                    {
                                        <tr class="evidence-row"><td colspan="8"><p class="hint">Rows in <b>@ff.Tag</b> already published in an earlier file:</p>@SourceTable(ovKey)</td></tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>;
    }

    // ---------------------------------------------------------------- 6. files that list the same row twice

    RenderFragment FileDupSection()
    {
        var all = FileDupsScoped();
        var flagged = all.Where(d => d.Flagged).ToList();
        decimal total = flagged.Sum(d => d.RepeatNet);
        return @<div>
            <div class="plain-explain">
                <p>Does a file <b>list the same payment twice</b>, compared with the files either side? Every file contains some exactly repeated rows
                    (ordinary repeated lines), and the rate differs a lot between councils, so each file is judged against its own council's neighbouring
                    files (audit term: a <b>discrepancy</b>, the same line listed more than once).
                    @if (all.Count > 0)
                    {
                        <text>In the councils shown, <b>@flagged.Count.ToString("N0") of @all.Count.ToString("N0") files</b> repeat far more rows than their neighbours@(flagged.Count == 0 ? "." : $" ({Money(total)} of net amounts in the second copies).")</text>
                    }
                </p>
                <p><b>What this could mean:</b> a file extracted twice into one, a batch loaded twice, or genuine repeated payments. This check does not infer a
                    cause. @EndsInFoiLine</p>
            </div>
            @Card("filedup", "Files that list the same row twice", ExceptionType.Discrepancy, $"{flagged.Count:N0} of {all.Count:N0} files", total, FileDupBody(all, flagged))
        </div>;
    }

    RenderFragment FileDupBody(List<FileDupLine> all, List<FileDupLine> flagged)
    {
        bool showAll = IsOpen("filedup-all");
        var list = showAll ? all.OrderByDescending(d => d.Flagged).ThenByDescending(d => d.Rate).ToList() : flagged;
        return @<div>
            <p class="test-desc"><b>Rule:</b> a row is a repeat when every published column matches an earlier row of the same file. A file is <b>flagged</b> when it has at
                least 50 repeated rows, they are at least 2% of the file, and that rate is at least three times the 75th-percentile repeat rate of up to five files either side
                (never less than 0.5%). Rows with a redacted payee or reference are left out.</p>
            <label class="select-all"><input type="checkbox" checked="@showAll" @onchange='e => _open["filedup-all"] = (bool)e.Value!' /> Show all @all.Count.ToString("N0") files, not only the flagged ones</label>
            @if (list.Count == 0)
            {
                <p class="hint">No file is flagged by this rule.</p>
            }
            else
            {
                <div class="table-scroll table-scroll-fixed">
                    <table class="exc-table">
                        <thead><tr><th></th><th>Council</th><th>File</th><th>Rows</th><th>Repeated rows</th><th>Net of the repeats</th><th>Share of file</th><th>Neighbours' usual share</th></tr></thead>
                        <tbody>
                            @foreach (var d in list)
                            {
                                <tr class="@(d.Flagged ? "" : "labelled-row")">
                                    @SelectCell(d.Item)
                                    <td>@CouncilName(d.Council)</td><td>@d.File</td><td>@d.Rows.ToString("N0")</td><td>@d.Repeats.ToString("N0")</td><td>@Money(d.RepeatNet)</td>
                                    <td>@d.Rate.ToString("P1")</td><td>@d.NeighbourRate.ToString("P1")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>;
    }

    // ---------------------------------------------------------------- 7. same line repeated inside one transaction

    RenderFragment WithinSection()
    {
        var all = WithinScoped();
        decimal total = all.Sum(w => w.ExtraValue);
        return @<div>
            <div class="plain-explain">
                <p>Does one transaction number list <b>the same line more than once</b> — same payee, amount, description and pay date? There is no invoice total to compare
                    these against, so they are shown as published, largest extra value first (audit term: an <b>anomaly</b>). The same amount paid on twelve
                    different dates is a payment schedule, not a repeat, so only lines sharing a pay date count.
                    @if (all.Count > 0)
                    {
                        <text>In the councils shown: <b>@all.Count.ToString("N0") repeated lines</b>, @Money(total) in the extra copies.</text>
                    }
                </p>
                <p><b>What this could mean:</b> one real payment entered twice, several genuine instalments paid on one day, or a batch that lists identical items.
                    The last column says whether the same payee and amount also turn up in other transactions, which makes a regular amount more likely. @EndsInFoiLine</p>
            </div>
            @Card("withintxn", "The same line repeated inside one transaction", ExceptionType.Anomaly, $"{all.Count:N0} lines", total, WithinBody(all))
        </div>;
    }

    RenderFragment WithinBody(List<WithinLine> all)
    {
        var f = Filter("withintxn");
        var shown = all.Where(w => f == "" || w.Supplier.Contains(f, StringComparison.OrdinalIgnoreCase) || w.Description.Contains(f, StringComparison.OrdinalIgnoreCase) || w.TransactionId.Contains(f, StringComparison.OrdinalIgnoreCase)).ToList();
        int lim = Limit("withintxn");
        return @<div>
            <p class="test-desc"><b>Rule:</b> inside one transaction number (rows with a redacted payee or reference are left out; a reference a spreadsheet has turned into
                scientific notation is not one transaction), a line repeated with the same payee, amount, description and pay date, for amounts of £10,000 or more. Wokingham is not
                scanned this way: its published invoice total is compared with the lines by exception tests 1 and 2 instead.</p>
            @if (all.Count == 0)
            {
                <p class="hint">No repeated lines in the councils shown.</p>
            }
            else
            {
                <div class="panel-controls">@FilterBox("withintxn", "Filter payee / description / trans. no.…")</div>
                <div class="table-scroll table-scroll-fixed">
                    <table class="exc-table">
                        <thead><tr><th></th><th>Council</th><th>File</th><th>Trans. no.</th><th>Payee</th><th>Pay date</th><th>Amount</th><th>Times listed</th><th>Extra value</th><th>Same payee and amount elsewhere</th></tr></thead>
                        <tbody>
                            @foreach (var w in shown.Take(lim))
                            {
                                <tr>
                                    @SelectCell(w.Item)
                                    <td>@CouncilName(w.Council)</td><td>@w.Year</td><td>@w.TransactionId</td><td>@w.Supplier</td><td>@PayDateText(w.PayDate)</td>
                                    <td>@Money(w.Net)</td><td>@w.Copies.ToString("N0")</td><td>@Money(w.ExtraValue)</td>
                                    <td>@(w.OtherTransactions == 0 ? "in no other transaction" : $"in {w.OtherTransactions:N0} other transaction{(w.OtherTransactions == 1 ? "" : "s")}")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @MoreButton("withintxn", lim, shown.Count)
            }
        </div>;
    }

    // ---------------------------------------------------------------- 8. what grows, what comes back, what does not fit the usual month

    RenderFragment SinkSection()
    {
        var sinks = SinksScoped(); var mis = MisfitsScoped();
        decimal total = sinks.Sum(s => s.NetOut);
        int oneOff = mis.Count(m => m.LabelCheck.StartsWith("LABEL SEEN ONLY", StringComparison.Ordinal));
        return @<div>
            <div class="plain-explain">
                <p>Money between councils and their companies: <b>what grows, what comes back, and what does not fit the usual month</b>. For each payer and payee
                    pair the first table adds up what was paid over the years, notes any credit rows in the same files, and whether the yearly total kept rising.
                    The second table lists months in which the payer's payments to that payee were far above that payee's own usual month.
                    @if (sinks.Count > 0)
                    {
                        <text>In the councils shown: <b>@sinks.Count.ToString("N0") payer-and-payee pairs</b> (@Money(total)) and <b>@mis.Count.ToString("N0") unusual months</b>, of which
                        @oneOff.ToString("N0") have a largest-row label that appears in no other month; the rest are bigger months of the usual kind.</text>
                    }
                </p>
                <p class="ev-note ev-note-warn"><b>A spending file shows only the payer's side. Nothing coming back in this file does not mean a debt is unpaid; repayments and income are in other records.</b></p>
                <p><b>What this could mean:</b> an ongoing contract or service charge that rises with demand, a loan or advance whose repayment is recorded elsewhere, or a
                    one-off grant or settlement. The files do not say which. @EndsInFoiLine</p>
            </div>
            @Card("sink", "What grows, what comes back, what does not fit the usual month", ExceptionType.Anomaly, $"{sinks.Count:N0} pairs, {mis.Count:N0} months", total, SinkBody(sinks, mis))
        </div>;
    }

    RenderFragment SinkBody(List<SinkLine> sinks, List<MisfitLine> mis)
    {
        int lim = Limit("misfit");
        return @<div>
            <h4>Payer and payee over the years</h4>
            <p class="test-desc"><b>Rule:</b> total paid out (credit-typed and negative rows kept apart), credits as a share of it, and the longest run of full calendar years each higher
                than the one before (the first and last calendar year of the files are part-years and cannot start or end a run). Marked "no credit rows" or "credits under 2%" when
                three or more years and over £100,000 were paid.</p>
            @if (sinks.Count == 0)
            {
                <p class="hint">No pairs in the councils shown.</p>
            }
            else
            {
                <div class="table-scroll table-scroll-fixed">
                    <table class="exc-table">
                        <thead><tr><th></th><th>Paid by</th><th>Paid to</th><th>Years</th><th>Payments</th><th>Total paid</th><th>Credit rows</th><th>Credits as share</th><th>What the file shows</th><th>Year by year</th></tr></thead>
                        <tbody>
                            @foreach (var s in sinks)
                            {
                                <tr>
                                    @SelectCell(s.Item)
                                    <td>@CouncilName(s.Payer)</td><td>@s.Entity</td><td>@s.FirstYear to @s.LastYear</td><td>@s.Rows.ToString("N0")</td><td>@Money(s.NetOut)</td>
                                    <td>@s.CreditRows.ToString("N0") (@Money(Math.Abs(s.CreditNet)))</td><td>@s.SettleRatio.ToString("P1")</td>
                                    <td class="wrap-cell">@(string.IsNullOrEmpty(s.Flags) ? "—" : FlagWords(s.Flags))</td>
                                    <td class="wrap-cell">@s.YearSeries</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <h4>Months that do not fit the usual month</h4>
            <p class="test-desc"><b>Rule:</b> for a payee paid in at least 12 different months, a month whose total is over £100,000 and more than three times that payee's own
                median month. "Label seen only in this month" means the council's own wording for that month's largest row appears in no other month; otherwise it is a bigger
                month of the usual kind.</p>
            @if (mis.Count == 0)
            {
                <p class="hint">No months in the councils shown.</p>
            }
            else
            {
                <div class="table-scroll table-scroll-fixed">
                    <table class="exc-table">
                        <thead><tr><th></th><th>Paid by</th><th>Paid to</th><th>Month</th><th>That month</th><th>Usual month</th><th>Times usual</th><th>Rows</th><th>Label check</th><th>Largest row's label</th></tr></thead>
                        <tbody>
                            @foreach (var m in mis.Take(lim))
                            {
                                <tr class="@(m.LabelCheck.StartsWith("LABEL SEEN ONLY", StringComparison.Ordinal) ? "" : "labelled-row")">
                                    @SelectCell(m.Item)
                                    <td>@CouncilName(m.Payer)</td><td>@m.Entity</td><td>@m.Month</td><td>@Money(m.MonthNet)</td><td>@Money(m.MedianMonthNet)</td><td>@m.Ratio.ToString("0.#")</td><td>@m.Rows.ToString("N0")</td>
                                    <td>@(m.LabelCheck.StartsWith("LABEL SEEN ONLY", StringComparison.Ordinal) ? "label seen only in this month" : "label seen in other months")</td>
                                    <td class="wrap-cell">@m.TopDescription</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @MoreButton("misfit", lim, mis.Count)
            }
        </div>;
    }


    async Task CopyFoi() => await JS.InvokeVoidAsync("copyText", BuildFoiLetter());
    async Task DownloadFoi() => await JS.InvokeVoidAsync("analystDownload", "foi-request.txt", BuildFoiLetter(), "text/plain");
}
