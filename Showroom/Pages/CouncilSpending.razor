@page "/council-spending"
@inject HttpClient Http
@inject IJSRuntime JS
@using System.Globalization
@using System.Text
@using System.IO.Compression
@using CouncilAudit
@using HoloDb

<PageTitle>Council Spending Scanner — Evaluated Applications</PageTitle>

<div class="room" data-cat="councilaudit">
    <header class="room-head">
        <nav class="crumb"><a href="/">Tools</a> <span>/</span> Council Spending Scanner</nav>
        <h1>Council Spending Scanner</h1>
        <p class="lede">Councils in England publish every payment over £500 under the Local Government
            Transparency Code. This tool loads a council's own published files — right here in your
            browser, nothing is uploaded anywhere — and runs a set of mechanical checks against the
            numbers <strong>as published</strong>. It never concludes anything about why a number looks
            the way it does. It finds places where the published figures don't add up on their own
            terms, and lets you ask the council why.</p>
    </header>

    <section class="wordpanel">
        <h2>What these words mean</h2>
        <dl>
            <dt><span class="tag tag-exception">Exception</span></dt>
            <dd>The umbrella word for anything one of the checks below flags — a row or group of rows
                that fails a defined test against the published data. An exception is not an accusation;
                it's a fact about the numbers as published.</dd>
            <dt><span class="tag tag-discrepancy">Discrepancy</span></dt>
            <dd>The published record contradicts itself — a payment larger than its own stated invoice
                amount, the same line listed more than once, or one transaction number covering more
                than one payee or pay date.</dd>
            <dt><span class="tag tag-unreconciled">Unreconciled</span></dt>
            <dd>The published payments don't cover the stated invoice amount — the remainder simply
                isn't in the published data; it may exist elsewhere, in a part of the dataset not shown
                here, or not yet have been paid.</dd>
            <dt><span class="tag tag-anomaly">Anomaly</span></dt>
            <dd>A pattern, not a contradiction — the same supplier, amount, description and date appear
                more than once under different transaction numbers.</dd>
            <dt><span class="tag tag-status">Status</span></dt>
            <dd>Every exception starts <b>Unconfirmed</b>. This tool has no way to change that on its
                own — a status only ever moves to <i>Explained by council</i> or <i>Confirmed by
                council</i> once an official reply exists, and would be shown with its source. Nothing
                on this page currently carries either status.</dd>
        </dl>
    </section>

    <p class="caveat"><strong>An exception here is a fact about the published numbers, not proof of an
        error or wrongdoing.</strong> Councils publish corrections, instalments, and VAT treatments that
        can look like a mismatch until explained. If you intend to raise this with the council or its
        auditor, ask for the records and the reason, not for an admission.</p>

    @if (_mode == Mode.Pick)
    {
        <section class="picker">
            <h2>Choose a council</h2>
            <div class="picker-grid">
                <button class="pick-card" @onclick="PickWokingham" type="button">
                    <h3>Wokingham Borough Council</h3>
                    <p>Six financial years hosted here, ready to scan — no download hunting required.</p>
                    <span class="go-in">Open →</span>
                </button>
                <button class="pick-card" @onclick="PickReading" type="button">
                    <h3>Reading Borough Council</h3>
                    <p>Five sample months hosted here. Reading publishes one signed Amount column with
                        no separate invoice/payment split, so the payment-vs-invoice test doesn't apply —
                        repeated-payment and multi-payee checks still run.</p>
                    <span class="go-in">Open →</span>
                </button>
                <button class="pick-card" @onclick="() => _mode = Mode.OwnFile" type="button">
                    <h3>Use your own file</h3>
                    <p>Any English council publishes this data under the same Transparency Code. Drop a
                        file and map its columns by hand — nothing is pre-verified for an unsupported
                        council, so check the mapping before you trust the result.</p>
                    <span class="go-in">Open →</span>
                </button>
            </div>
        </section>
    }
    else
    {
        <button class="back-link" @onclick="BackToPicker" type="button">← choose a different council</button>

        @if (_mode == Mode.Wokingham)
        {
            <section class="licence">
                <p>Contains data from <a href="@SupportedCouncils.Wokingham.TransparencyPageUrl" target="_blank" rel="noopener">Wokingham
                    Borough Council</a>, used under the <a href="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/" target="_blank" rel="noopener">Open
                    Government Licence v3.0</a>. Source: <a href="https://www.wokingham.gov.uk/council-and-meetings/open-data-and-transparency/data-sets-and-open-data?field_media_asset_browser_target_id=101" target="_blank" rel="noopener">the council's open-data page</a>.
                    Every file below was retrieved <b>2 October 2026</b>.</p>
            </section>

            <section class="loaded-stats">
                <h2>Loaded data</h2>
                <p class="hint">@StatsLine()</p>
            </section>

            <section class="years">
                <h2>Add council / year</h2>
                <p class="hint">Each year loads as a small, pre-normalised file (well under a megabyte
                    compressed) and BulkLoads straight into a real database running in your browser tab —
                    the same engine behind <a href="/tools/analyst">The Analyst</a>. Your own council
                    loads first; add more councils here as they're onboarded, and the cross-council
                    correlations below get more complete the more you load.</p>
                <div class="council-add">
                    <div class="council-add-head">
                        <b>@SupportedCouncils.Wokingham.Name</b>
                        <span class="hint">@_wokinghamYears.Count(y => y.Loaded) of @_wokinghamYears.Count years loaded</span>
                    </div>
                    <div class="year-grid">
                        @foreach (var y in _wokinghamYears)
                        {
                            <label class="year-pick @(y.Loaded ? "loaded" : "")">
                                <input type="checkbox" checked="@y.Checked" @onchange="e => y.Checked = (bool)e.Value!" disabled="@(_busy || y.Loaded)" />
                                <span class="year-tag">@y.Tag</span>
                                <span class="year-fmt">@(y.Loaded ? "loaded" : y.Format == SourceFormat.Xlsx ? "xlsx source" : "csv source")</span>
                            </label>
                        }
                    </div>
                    <button class="go" @onclick="LoadSelectedYears" disabled="@(_busy || !_wokinghamYears.Any(y => y.Checked && !y.Loaded))" type="button">
                        @(_busy ? _phase : "Load selected years")
                    </button>
                </div>
                <div class="council-add @(_loadedCouncils.Contains("reading") ? "" : "council-add-disabled")">
                    <div class="council-add-head">
                        <b>Reading Borough Council</b>
                        <span class="hint">@(_loadedCouncils.Contains("reading")
                            ? $"{_readingMonths.Count(y => y.Loaded)} of {_readingMonths.Count} months loaded"
                            : "Go back and choose Reading from the picker to load it alongside Wokingham.")</span>
                    </div>
                </div>
            </section>
        }
        else if (_mode == Mode.Reading)
        {
            <section class="licence">
                <p>Contains data from <a href="@SupportedCouncils.Reading.TransparencyPageUrl" target="_blank" rel="noopener">Reading
                    Borough Council</a>. The council's own spending page states: "This data has been
                    published in accordance with Governmental guidelines and is available for reuse
                    under the <a href="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/" target="_blank" rel="noopener">Open
                    Government Licence</a>" (checked live against that page <b>3 October 2026</b>; the
                    page doesn't itself name a version, so this links the current v3.0 text, the same
                    licence Wokingham publishes under). Every file below was retrieved <b>3 October 2026</b>.</p>
            </section>

            <p class="note-callout">Reading publishes one signed <b>Amount</b> column — there is no
                separate invoice amount to compare a payment against, so <b>Exception tests 1 and 2
                (payment vs. stated invoice amount) do not apply to this council</b> — not a clean
                result, a structural fact about what's published. Negative amounts are real credits
                and corrections, not errors. Tests 3-5 (repeated payments, multi-payee transactions,
                repeated lines) still run below.</p>

            <section class="loaded-stats">
                <h2>Loaded data</h2>
                <p class="hint">@StatsLine()</p>
            </section>

            <section class="years">
                <h2>Add council / month</h2>
                <p class="hint">Reading republishes monthly, not annually — five representative months
                    are hosted here. Each loads as a small, pre-normalised file and BulkLoads straight
                    into the same in-browser database as Wokingham's own data, so the cross-council
                    view below works the moment both are loaded.</p>
                <div class="council-add">
                    <div class="council-add-head">
                        <b>@SupportedCouncils.Reading.Name</b>
                        <span class="hint">@_readingMonths.Count(y => y.Loaded) of @_readingMonths.Count months loaded</span>
                    </div>
                    <div class="year-grid">
                        @foreach (var y in _readingMonths)
                        {
                            <label class="year-pick @(y.Loaded ? "loaded" : "")">
                                <input type="checkbox" checked="@y.Checked" @onchange="e => y.Checked = (bool)e.Value!" disabled="@(_busy || y.Loaded)" />
                                <span class="year-tag">@y.Tag</span>
                                <span class="year-fmt">@(y.Loaded ? "loaded" : "csv source")</span>
                            </label>
                        }
                    </div>
                    <button class="go" @onclick="LoadSelectedReadingMonths" disabled="@(_busy || !_readingMonths.Any(y => y.Checked && !y.Loaded))" type="button">
                        @(_busy ? _phase : "Load selected months")
                    </button>
                </div>
                <div class="council-add @(_loadedCouncils.Contains("wokingham") ? "" : "council-add-disabled")">
                    <div class="council-add-head">
                        <b>Wokingham Borough Council</b>
                        <span class="hint">@(_loadedCouncils.Contains("wokingham")
                            ? $"{_wokinghamYears.Count(y => y.Loaded)} of {_wokinghamYears.Count} years loaded"
                            : "Go back and choose Wokingham from the picker to load it alongside Reading.")</span>
                    </div>
                </div>
            </section>
        }

        @if ((_mode == Mode.Wokingham || _mode == Mode.Reading) && _spendRowsLoaded > 0)
        {
            <section class="crosscouncil">
                <h2>Cross-council correlations</h2>
                <p class="hint">@CrossCouncilStateLine()</p>
                @if (_loadedCouncils.Contains("wokingham") && _loadedCouncils.Contains("reading"))
                {
                    <p class="note-callout">Wokingham's figures include a stated invoice amount; Reading's
                        don't (one signed Amount column only, see above) — a cross-council match tells you
                        the same supplier was paid by both councils, not that the two payments are
                        reconciled against each other the way Schedule A reconciles a single council's own
                        invoice vs. payment.</p>
                }
                <div class="cc-controls">
                    <input type="text" @bind="_nearestSupplierQuery" @bind:event="oninput"
                           placeholder="Type a supplier name to search everything loaded…" disabled="@_busy" />
                    <select @bind="_searchMode" disabled="@_busy">
                        <option value="@SearchMode.Graded">Graded match (ranked by similarity)</option>
                        <option value="@SearchMode.ExactSubstring">Exact substring (LIKE)</option>
                    </select>
                    <button class="ghost" @onclick="RunNearestSupplierSearch"
                            disabled="@(string.IsNullOrWhiteSpace(_nearestSupplierQuery) || _busy)" type="button">
                        Search loaded suppliers
                    </button>
                </div>
                @if (_searchMode == SearchMode.Graded)
                {
                    <p class="hint">Ranked by HoloDb's holographic <code>NEAREST</code> similarity search
                        against the normalised supplier key — a council name change, merger, or small
                        spelling difference ("ACME LTD" vs "ACME LTD.") still surfaces the real supplier
                        near the top, ranked by the <b>score</b> column (cosine similarity, 1.0 = exact
                        match). Graded closeness is a well-behaved local ranking, not a global guarantee
                        that every distant pair orders strictly by distance — treat a low score as a weak
                        match, not a confident one.</p>
                }
                else
                {
                    <p class="hint">An exact substring match on the normalised supplier name — only rows
                        whose key literally contains what you typed. Use this when you want to be certain
                        nothing beyond a literal substring is being matched.</p>
                }
                @if (_nearestResults.Count > 0)
                {
                    <div class="table-scroll table-scroll-fixed">
                        <table class="exc-table">
                            <thead>
                                <tr>
                                    <th>Supplier (as published)</th><th>Council</th>
                                    @if (_searchMode == SearchMode.Graded) { <th>Score</th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in _nearestResults)
                                {
                                    <tr>
                                        <td>@r.Supplier</td><td>@r.Council</td>
                                        @if (_searchMode == SearchMode.Graded) { <td>@r.Score.ToString("F3")</td> }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }

        @if (_mode == Mode.OwnFile)
        {
            <section class="ownfile">
                <h2>Load your own file</h2>
                <p class="hint">Works for any council's "spending over £500" export — CSV or xlsx. You
                    confirm the column mapping before anything runs; nothing here is pre-verified the way
                    Wokingham's own profile is.</p>
                <label class="council-name-field">Council name (for the FOI letter)
                    <input type="text" @bind="_ownCouncilName" @bind:event="oninput" placeholder="e.g. Example Borough Council" disabled="@_busy" />
                </label>
                <InputFile OnChange="OnOwnFile" accept=".csv,.tsv,.xlsx" disabled="@_busy" />
                @if (_ownHeader.Count > 0)
                {
                    <div class="map-grid">
                        <label>Transaction / invoice number column
                            <select @bind="_ownMapTrans">@foreach (var h in _ownHeader) { <option value="@h">@h</option> }</select>
                        </label>
                        <label>Supplier / payee column
                            <select @bind="_ownMapSupplier">@foreach (var h in _ownHeader) { <option value="@h">@h</option> }</select>
                        </label>
                        <label>Gross / invoice amount column
                            <select @bind="_ownMapGross">@foreach (var h in _ownHeader) { <option value="@h">@h</option> }</select>
                        </label>
                        <label>Net amount column (optional)
                            <select @bind="_ownMapNet"><option value="">(none)</option>@foreach (var h in _ownHeader) { <option value="@h">@h</option> }</select>
                        </label>
                        <label>VAT amount column (optional)
                            <select @bind="_ownMapVatAmount"><option value="">(none)</option>@foreach (var h in _ownHeader) { <option value="@h">@h</option> }</select>
                        </label>
                        <label>VAT type/rate column (optional)
                            <select @bind="_ownMapVatType"><option value="">(none)</option>@foreach (var h in _ownHeader) { <option value="@h">@h</option> }</select>
                        </label>
                        <label>Pay date column (optional)
                            <select @bind="_ownMapPayDate"><option value="">(none)</option>@foreach (var h in _ownHeader) { <option value="@h">@h</option> }</select>
                        </label>
                        <label>Description column (optional)
                            <select @bind="_ownMapDesc"><option value="">(none)</option>@foreach (var h in _ownHeader) { <option value="@h">@h</option> }</select>
                        </label>
                        <label>Service area / directorate column (optional)
                            <select @bind="_ownMapService"><option value="">(none)</option>@foreach (var h in _ownHeader) { <option value="@h">@h</option> }</select>
                        </label>
                        <label>Transaction id scope
                            <select @bind="_ownIdScope">
                                <option value="@TransactionIdScope.CouncilWideUnique">Council assigns and tracks it (e.g. "TransNo")</option>
                                <option value="@TransactionIdScope.SupplierFurnished">It's the supplier's own invoice number</option>
                            </select>
                        </label>
                        <label>What the invoice amount means on a multi-line transaction
                            <select @bind="_ownGrossMeaning">
                                <option value="@GrossMeaning.RepeatedInvoiceTotal">One total, repeated on every line</option>
                                <option value="@GrossMeaning.PerLineAmount">Each line's own amount</option>
                            </select>
                        </label>
                    </div>
                    <p class="hint warn-hint">The two dropdowns above cannot be guessed from the data —
                        confirm them against the council's own documentation or a multi-line example
                        before trusting Exception tests 1, 2 and 4.</p>
                    <button class="go" @onclick="RunOwnFile" disabled="@_busy" type="button">@(_busy ? _phase : "Run the checks")</button>
                }
            </section>
        }

        @if (_error is not null)
        {
            <p class="err">@_error</p>
        }

        @if (_warnings.Count > 0)
        {
            <section class="warnings">
                <h2>Warnings from the engine</h2>
                <ul>@foreach (var w in _warnings) { <li>@w</li> }</ul>
            </section>
        }

        @if (_tests.Count > 0)
        {
            var unexplainedSummary = DistinctSummary(unexplainedOnly: true);
            var overallSummary = DistinctSummary(unexplainedOnly: false);
            <section class="summary-bar">
                <h2>Totals across everything loaded</h2>
                <div class="summary-cards">
                    <div class="summary-card summary-card-unexplained">
                        <span class="summary-label">Unexplained — genuinely unaccounted for</span>
                        <span class="summary-count">@unexplainedSummary.Count.ToString("N0") transactions</span>
                        <span class="summary-total">@Money(unexplainedSummary.Total)</span>
                    </div>
                    <div class="summary-card">
                        <span class="summary-label">All exceptions, every label combined</span>
                        <span class="summary-count">@overallSummary.Count.ToString("N0") transactions</span>
                        <span class="summary-total">@Money(overallSummary.Total)</span>
                    </div>
                </div>
                <p class="hint">Counted over DISTINCT transactions, so a row flagged by more than one test below is
                    only counted once here. <strong>An exception total is the value of items that fail one of the
                    mechanical tests below — it is not money proven to be lost or wasted.</strong></p>
            </section>

            var ranked = RankedUnexplained();
            if (ranked.Count > 0)
            {
                <section class="topunexplained">
                    <h2>Largest unexplained items in what you've loaded</h2>
                    <p class="hint"><strong>Ranking rule:</strong> every row below is marked Unexplained by the
                        tests further down this page, across everything you've loaded into this session so far,
                        sorted by the £ amount published against it — highest first, top 20 shown. This list is
                        recomputed from your own loaded data every time you load more; the same rule runs for
                        every council, and nothing on it is picked by hand.</p>
                    <div class="table-scroll table-scroll-fixed">
                        <table class="exc-table">
                            <thead>
                                <tr>
                                    <th>Year</th><th>Trans. no.</th><th>Pay date</th><th>Amount</th>
                                    <th>Payee</th><th>Council</th><th>Test</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var it in ranked)
                                {
                                    <tr>
                                        <td>@it.SourceTag</td>
                                        <td>@it.TransactionId</td>
                                        <td>@(it.PayDate ?? "—")</td>
                                        <td>@(it.Amount is { } ra ? ra.ToString("C2", GB) : "—")</td>
                                        <td>@it.Supplier</td>
                                        <td>@it.Council</td>
                                        <td>@ShortTestLabel(it.TestLabel)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }

            <section class="results">
                <h2>Exception tests</h2>
                @foreach (var t in _tests)
                {
                    var filtered = FilteredItems(t);
                    var totalPages = TotalPages(filtered.Count);
                    if (t.Page > totalPages) { t.Page = totalPages; }
                    var pageItems = filtered.Skip((t.Page - 1) * PageSize).Take(PageSize).ToList();
                    var startIdx = filtered.Count == 0 ? 0 : (t.Page - 1) * PageSize + 1;
                    var endIdx = Math.Min(t.Page * PageSize, filtered.Count);
                    var testTotal = TestTotal(filtered);
                    var selectedInTest = filtered.Where(i => i.Selected).ToList();
                    var classTotals = ClassificationTotals(filtered);
                    <div class="test-card">
                        <button class="test-head" type="button" @onclick="() => ToggleCollapse(t)" aria-expanded="@(!t.Collapsed)">
                            <span class="collapse-arrow">@(t.Collapsed ? "▸" : "▾")</span>
                            <h3>@t.Label</h3>
                            <span class="tag @TagClass(t.Items.Count > 0 ? t.Items[0].Type : ExceptionType.Discrepancy)">@t.Items.FirstOrDefault()?.Type.ToString() ?? "—"</span>
                            <span class="count">@t.Items.Count.ToString("N0") exceptions</span>
                            <span class="count count-total" title="@TestAmountLabel(t.Label)">@Money(testTotal)</span>
                        </button>
                        @if (!t.Collapsed)
                        {
                            <div class="test-body">
                                <p class="test-desc">@t.Description</p>
                                @if (t.Items.Count == 0)
                                {
                                    <p class="hint">None found in the year(s) you loaded.</p>
                                }
                                else
                                {
                                    <p class="test-amount-label">The £ figure above is the @TestAmountLabel(t.Label), @(filtered.Count == t.Items.Count ? "across every item below" : "for the current filter").
                                        @if (t.Label.Contains("test 3"))
                                        {
                                            <text> The narrower value of just the repeats beyond each group's first payment: <b>@Money(RepeatsBeyondFirstTotal(filtered))</b>.</text>
                                        }
                                    </p>
                                    @if (classTotals.Count > 1 || (classTotals.Count == 1 && !classTotals[0].Classification.Equals("Unreconciled") && !classTotals[0].Classification.Equals("Unclear")))
                                    {
                                        <div class="classification-legend">
                                            @foreach (var ct in classTotals)
                                            {
                                                <div class="classification-row @(ct.Classification is "Unreconciled" or "Unclear" or "Unmatched" or "" ? "classification-unexplained" : "")">
                                                    <div class="classification-row-top">
                                                        <span class="tag @(ct.Classification is "Unreconciled" or "Unclear" or "Unmatched" or "" ? "tag-unexplained" : "tag-label")">@ClassificationDisplay(ct.Classification)</span>
                                                        <span class="classification-count">@ct.Count.ToString("N0")</span>
                                                        <span class="classification-total">@Money(ct.Total)</span>
                                                    </div>
                                                    <details class="classification-meaning-details">
                                                        <summary>What this means</summary>
                                                        <p class="classification-meaning">@ClassificationMeanings.GetValueOrDefault(ct.Classification, "")</p>
                                                    </details>
                                                </div>
                                            }
                                        </div>
                                    }
                                    <div class="panel-controls">
                                        <label class="select-all">
                                            <input type="checkbox" checked="@AllFilteredSelected(filtered)" @onchange="e => SelectAllFiltered(filtered, (bool)e.Value!)" />
                                            @SelectAllLabel(t, filtered.Count)
                                        </label>
                                        <span class="selected-total">Selected: <b>@selectedInTest.Count.ToString("N0")</b> item@(selectedInTest.Count == 1 ? "" : "s"), <b>@Money(TestTotal(selectedInTest))</b></span>
                                        <input type="text" class="filter-text" placeholder="Filter supplier / description…"
                                               @bind="t.FilterText" @bind:event="oninput" @bind:after="() => OnFilterChanged(t)" />
                                        <select class="filter-year" @bind="t.FilterYear" @bind:after="() => OnFilterChanged(t)">
                                            <option value="">All years</option>
                                            @foreach (var y in DistinctYears(t))
                                            {
                                                <option value="@y">@y</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="table-scroll table-scroll-fixed">
                                        <table class="exc-table">
                                            <thead>
                                                <tr>
                                                    <th></th>
                                                    <th class="sortable" @onclick='() => SetSort(t, "year")'>Year@SortArrow(t, "year")</th>
                                                    <th class="sortable" @onclick='() => SetSort(t, "trans")'>Trans. no.@SortArrow(t, "trans")</th>
                                                    <th class="sortable" @onclick='() => SetSort(t, "paydate")'>Pay date@SortArrow(t, "paydate")</th>
                                                    <th class="sortable" @onclick='() => SetSort(t, "amount")'>Amount@SortArrow(t, "amount")</th>
                                                    <th class="sortable" @onclick='() => SetSort(t, "payee")'>Payee@SortArrow(t, "payee")</th>
                                                    <th class="sortable" @onclick='() => SetSort(t, "service")'>Service area@SortArrow(t, "service")</th>
                                                    <th>Council</th>
                                                    <th title="Ranked below the genuinely unexplained rows — see the legend above this table">Label</th>
                                                    <th>Status</th>
                                                    <th>Evidence</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var it in pageItems)
                                                {
                                                    <tr class="@(it.IsUnexplained ? "" : "labelled-row")">
                                                        <td><input type="checkbox" checked="@it.Selected" @onchange="e => ToggleSelect(it, (bool)e.Value!)" /></td>
                                                        <td>@it.SourceTag</td>
                                                        <td>@it.TransactionId</td>
                                                        <td>@(it.PayDate ?? "—")</td>
                                                        <td>@(it.Amount is { } a ? a.ToString("C2", GB) : "—")</td>
                                                        <td>@it.Supplier</td>
                                                        <td>@(it.ServiceArea ?? "—")</td>
                                                        <td>@it.Council</td>
                                                        <td>
                                                            @if (it.IsUnexplained)
                                                            {
                                                                <span class="tag tag-unexplained">Unexplained</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="tag tag-label" title="@ClassificationMeanings.GetValueOrDefault(it.Classification, "")">@ClassificationDisplay(it.Classification)</span>
                                                            }
                                                        </td>
                                                        <td><span class="tag tag-status">@it.Status</span></td>
                                                        <td>
                                                            @if (it.Kind != EvidenceKind.None)
                                                            {
                                                                <button class="evidence-toggle" type="button" @onclick="() => ToggleEvidence(it)">@(it.EvidenceOpen ? "Hide ▴" : "Show ▾")</button>
                                                            }
                                                            else
                                                            {
                                                                <span class="hint">—</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                    @if (it.EvidenceOpen && it.Kind == EvidenceKind.AmountCompare)
                                                    {
                                                        <tr class="evidence-row">
                                                            <td colspan="11">
                                                                <div class="evidence">
                                                                    <p class="ev-sentence">@ExplainItem(t, it)</p>
                                                                    <div class="evidence-pair">
                                                                        <div class="ev-box"><span class="ev-label">Sum of payments published</span><span class="ev-val">@(it.Amount is { } ea ? ea.ToString("C2", GB) : "—")</span></div>
                                                                        <div class="ev-op">vs</div>
                                                                        <div class="ev-box"><span class="ev-label">@it.CompareLabel</span><span class="ev-val">@(it.CompareAmount is { } eb ? eb.ToString("C2", GB) : "—")</span></div>
                                                                        <div class="ev-op">=</div>
                                                                        <div class="ev-box ev-diff"><span class="ev-label">Difference</span><span class="ev-val">@EvidenceDiff(it)</span></div>
                                                                    </div>
                                                                    @if (LooksLikeDoubleCount(it))
                                                                    {
                                                                        <p class="ev-note ev-note-warn">This sum is close to <b>2 × the stated invoice amount</b> — one plausible,
                                                                            neutral explanation is the same published line being counted twice (see Exception
                                                                            test 5, "the same line listed more than once"). Not a conclusion — just something to
                                                                            check before assuming anything else.</p>
                                                                    }
                                                                    @if (it.OppositeSign)
                                                                    {
                                                                        <p class="ev-note ev-note-warn">The net and gross amounts published for this transaction
                                                                            have opposite signs (one is negative) — check whether this is a credit or refund line
                                                                            before treating it as unreconciled.</p>
                                                                    }
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                    else if (it.EvidenceOpen && it.Kind == EvidenceKind.GroupEvidence)
                                                    {
                                                        var siblings = GroupSiblings(t, it);
                                                        <tr class="evidence-row">
                                                            <td colspan="11">
                                                                <div class="evidence">
                                                                    <p class="ev-sentence">@ExplainItem(t, it)</p>
                                                                    <p class="ev-note">@GroupEvidenceIntro(t, siblings.Count)</p>
                                                                    <div class="table-scroll">
                                                                        <table class="ev-table">
                                                                            <thead>
                                                                                <tr>
                                                                                    <th class="@ColClass(t, "year")">Year</th>
                                                                                    <th class="@ColClass(t, "trans")">Trans. no.</th>
                                                                                    <th class="@ColClass(t, "paydate")">Pay date</th>
                                                                                    <th class="@ColClass(t, "amount")">Amount</th>
                                                                                    <th class="@ColClass(t, "payee")">Payee</th>
                                                                                    <th class="@ColClass(t, "desc")">Description</th>
                                                                                </tr>
                                                                            </thead>
                                                                            <tbody>
                                                                                @foreach (var sib in siblings)
                                                                                {
                                                                                    <tr class="@(sib == it ? "this-row" : "")">
                                                                                        <td class="@ColClass(t, "year")">@sib.SourceTag</td>
                                                                                        <td class="@ColClass(t, "trans")">@sib.TransactionId</td>
                                                                                        <td class="@ColClass(t, "paydate")">@(sib.PayDate ?? "—")</td>
                                                                                        <td class="@ColClass(t, "amount")">@(sib.Amount is { } sa ? sa.ToString("C2", GB) : "—")</td>
                                                                                        <td class="@ColClass(t, "payee")">@sib.Supplier</td>
                                                                                        <td class="@ColClass(t, "desc")">@(sib.Description ?? "—")</td>
                                                                                    </tr>
                                                                                }
                                                                            </tbody>
                                                                        </table>
                                                                    </div>
                                                                    <p class="ev-legend"><span class="ev-chip ev-chip-match">matching</span><span class="ev-chip ev-chip-differ">differs</span></p>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                    else if (it.EvidenceOpen && it.Kind == EvidenceKind.CreditMatch)
                                                    {
                                                        <tr class="evidence-row">
                                                            <td colspan="11">
                                                                <div class="evidence">
                                                                    <p class="ev-sentence">@ExplainItem(t, it)</p>
                                                                    <p class="ev-note">Engine detail: @it.ClassificationDetail</p>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                @if (pageItems.Count == 0)
                                                {
                                                    <tr><td colspan="11" class="hint">No rows match this filter.</td></tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="pagination">
                                        <span class="hint">@ShowingLabel(t, filtered.Count, startIdx, endIdx)</span>
                                        <div class="page-controls">
                                            <button class="ghost" type="button" disabled="@(t.Page <= 1)" @onclick="() => ChangePage(t, -1, totalPages)">← Prev</button>
                                            <span class="hint">Page @t.Page of @totalPages</span>
                                            <button class="ghost" type="button" disabled="@(t.Page >= totalPages)" @onclick="() => ChangePage(t, 1, totalPages)">Next →</button>
                                        </div>
                                    </div>
                                    <button class="ghost" @onclick="() => DownloadTest(t)" type="button">↓ Download this test's full list (CSV)</button>
                                }
                            </div>
                        }
                    </div>
                }
            </section>
        }

        @if (_selected.Count > 0)
        {
            <section class="tray">
                @{ var selDistinct = SelectedDistinctSummary(); }
                <div class="tray-row">
                    <span><b>@_selected.Count.ToString("N0")</b> exception@(_selected.Count == 1 ? "" : "s") selected
                        (<b>@selDistinct.Count.ToString("N0")</b> distinct transaction@(selDistinct.Count == 1 ? "" : "s"),
                        <b>@Money(selDistinct.Total)</b>)</span>
                    <button class="go" @onclick="() => _showFoi = true" type="button">Generate FOI request</button>
                </div>
                <div class="tray-breakdown">
                    @foreach (var (type, count, total) in SelectedTypeBreakdown())
                    {
                        <span class="tray-chip"><span class="tag @TagClass(type)">@type</span> @count.ToString("N0") · @Money(total)</span>
                    }
                </div>
            </section>
        }

        @if (_showFoi && _selected.Count > 0)
        {
            <section class="foi">
                <h2>Freedom of Information request</h2>
                <p class="hint">This drafts a letter for <i>you</i> to review and send — nothing is sent
                    from this page. FOI requests must give a real name and get a reply within 20
                    working days.</p>

                <div class="foi-fields">
                    <label>Your name (required to generate)
                        <input type="text" @bind="_foiName" @bind:event="oninput" placeholder="Jane Smith" />
                    </label>
                    <label><input type="checkbox" @bind="_foiElectronic" /> I'm happy to receive the reply electronically</label>
                    @if (_foiElectronic)
                    {
                        <label>Your email (optional, shown in the letter)
                            <input type="email" @bind="_foiEmail" @bind:event="oninput" placeholder="jane@example.com" />
                        </label>
                    }
                </div>

                @if (!_foiContactVerified)
                {
                    <p class="note-callout">This council's Freedom of Information contact address has not
                        been hand-verified for this tool. The letter below leaves a placeholder — look up
                        the council's own FOI contact page before sending.</p>
                }
                else
                {
                    <p class="hint">Addressed to <b>@_foiContactEmail</b> (@_foiContactCheckedNote).</p>
                }

                <p class="hint">Keep a request focused: a council can refuse to answer under the Act's
                    cost limit if it would take too long, and several people asking about the same thing
                    in a short period can be added together toward that limit. Consider sending this via
                    <a href="https://www.whatdotheyknow.com/" target="_blank" rel="noopener">WhatDoTheyKnow.com</a>
                    instead of directly — it publishes both your request and the council's reply.</p>

                <textarea class="foi-letter" rows="22" readonly>@BuildFoiLetter()</textarea>
                <div class="controls">
                    <button class="go" @onclick="CopyFoi" disabled="@string.IsNullOrWhiteSpace(_foiName)" type="button">Copy to clipboard</button>
                    <button class="ghost" @onclick="DownloadFoi" disabled="@string.IsNullOrWhiteSpace(_foiName)" type="button">↓ Download as .txt</button>
                    @if (string.IsNullOrWhiteSpace(_foiName)) { <span class="hint">Enter your name to enable these.</span> }
                </div>
            </section>
        }

        <div class="outro">
            <p>This tool runs on <b>CouncilAudit</b>, an engine built by the EA virtual-customer agent — a
                plain, reusable set of mechanical checks against councils' own published spending data,
                with no network calls and no file-system access, so it runs the same way in your browser
                as it did on the raw files when it was built.</p>
        </div>
    }
</div>

@code {
    enum Mode { Pick, Wokingham, Reading, OwnFile }
    enum ExceptionType { Discrepancy, Unreconciled, Anomaly }
    enum SearchMode { Graded, ExactSubstring }
    // What kind of evidence comparison a row supports, for the highlighted "show the discrepancy"
    // panel — None (no evidence to show), AmountCompare (test 1/2: sum paid vs stated invoice),
    // GroupEvidence (test 3/4/5: sibling rows sharing GroupKey, with matching/differing columns).
    enum EvidenceKind { None, AmountCompare, GroupEvidence, CreditMatch }

    sealed class ExceptionItem
    {
        public string TestLabel = "";
        public ExceptionType Type;
        public string Council = "";      // display name, e.g. "Wokingham Borough Council" — which
        // council this row came from, so a cross-council merged test table stays unambiguous.
        public string SourceTag = "";
        public string TransactionId = "";
        public string Supplier = "";
        public string? PayDate;
        public decimal? Amount;
        public string? ServiceArea;
        public string? Description;
        // Leaves room for a later status change — only ever moved by hand once an official
        // council/auditor reply exists, and always paired with where that reply came from.
        public string Status = "Unconfirmed";
        public string? StatusSource;
        public bool Selected;
        // ---- evidence/highlighting, so a reader can see the actual discrepancy, not just a count ----
        public EvidenceKind Kind;
        public decimal? CompareAmount;   // AmountCompare: the "other" figure (stated invoice amount)
        public string? CompareLabel;
        public bool OppositeSign;        // AmountCompare, test 2 only: net == -gross
        public string? GroupKey;         // GroupEvidence: links sibling rows within this SAME test
        public int GroupSize;
        public int LineCount = 1;        // AmountCompare (test 1/2) only: how many raw published
        // payment lines were summed into Amount — carried so the generated sentence can say
        // "one payment of £X" vs "N payments totalling £X" instead of always assuming one line.
        public bool EvidenceOpen;        // UI-only: this row's evidence panel expanded
        // ---- classification label (AuditEngine's ScheduleAClassification/ScheduleBClassification,
        // see CouncilAudit/Models.cs) — "Unreconciled"/"Unclear" means no pattern was recognised
        // (the genuinely unexplained rows this page leads with); anything else is a named, neutral
        // label ranked below those, with a one-line "what this means" shown per test (see
        // ClassificationMeanings below).
        public string Classification = "Unreconciled";
        public string? ClassificationDetail;
        public bool IsUnexplained => Classification is "Unreconciled" or "Unclear" or "Unmatched" or "";
        public string Key => $"{Council}|{TestLabel}|{SourceTag}|{TransactionId}|{Supplier}|{Amount}|{PayDate}";
    }

    sealed class TestGroup
    {
        public string Label = "";
        public string Description = "";
        public List<ExceptionItem> Items = new();
        // ---- panel UI state: collapsed by default, expanded only when this test contains a
        // hand-verified example (see SetDefaultCollapse below) — paging/sort/filter live here so
        // each test's panel state survives a page re-render independently of the others.
        public bool Collapsed = true;
        public string FilterText = "";
        public string FilterYear = "";
        public string? SortColumn;
        public bool SortDesc;
        public int Page = 1;
    }

    // Neutral "what this label means" line per classification name, shown once per test (not
    // per row) — covers both ScheduleAClassification and ScheduleBClassification names, since a
    // test only ever carries one family or the other. "Unreconciled"/"Unclear" are included too
    // (so the legend is complete) but rendered first/muted in the UI, same rank as the row itself.
    static readonly Dictionary<string, string> ClassificationMeanings = new()
    {
        ["Unreconciled"] = "No specific pattern was recognised — the published numbers simply don't add up under any of the checks below. This is the actual target: ask the council for the invoice and the reason.",
        ["DoubleListing"] = "The same invoice line appears to have been published more than once (the lines sum to an exact whole-number multiple of the stated invoice), rather than several genuinely different charges.",
        ["DebtCharge"] = "The stated amount splits exactly into a round principal plus a non-round interest/charge remainder — consistent with a loan repayment or debt-recovery invoice, not an unexplained gap.",
        ["EarlyPaymentProgramme"] = "A batch of negative early-payment discount fees under the council's own named scheme (a supply-chain-finance arrangement) — a known pattern, not an arithmetic mismatch.",
        ["VatRoundingNoise"] = "The gap is a few pence, consistent with VAT being rounded per line and then summed, rather than once on the total — not a genuine unexplained gap.",
        ["NegativeNetSignFlip"] = "The published net figure is the exact negative of the value needed to reconcile the stated invoice — the magnitude and VAT arithmetic are both correct, only the sign is inverted. This is reported as a named, recurring shape, not an explanation: why the sign is inverted is not established.",
        ["Unclear"] = "No supplier invoice number was available to check — reported exactly as published, with no verdict either way.",
        ["LikelyDuplicate"] = "Every member of this group shares the same supplier invoice number as well as the same amount — the strongest signal of a genuine duplicate payment.",
        ["LikelyRecurring"] = "Members carry different supplier invoice numbers despite the identical amount — consistent with a standardised recurring rate (e.g. a placement or rent-scheme payment), not a repeat error.",
        ["Unmatched"] = "No same-supplier published charge of matching magnitude was found within 365 days — not established to be an error (the matching charge may simply be in a file not loaded this session), reported as published.",
        ["MatchedOffsettingCharge"] = "A same-supplier published charge of matching magnitude exists within 365 days — a plausible explanation exists in the loaded data, not a claim that this specific credit offsets that specific charge.",
    };

    static string ClassificationDisplay(string c) => c switch
    {
        "DoubleListing" => "Double listing", "DebtCharge" => "Debt charge",
        "EarlyPaymentProgramme" => "Early payment programme", "VatRoundingNoise" => "VAT rounding noise",
        "NegativeNetSignFlip" => "Net sign flip", "LikelyDuplicate" => "Likely duplicate",
        "LikelyRecurring" => "Likely recurring", "MatchedOffsettingCharge" => "Matched offsetting charge",
        "" => "—",
        _ => c, // "Unreconciled" / "Unclear" / "Unmatched"
    };

    static readonly Dictionary<string, string> CouncilDisplayNames = new()
    {
        ["wokingham"] = "Wokingham Borough Council",
        ["reading"] = "Reading Borough Council",
    };

    sealed class YearPick
    {
        public string Tag = "";
        public string FileName = "";
        public SourceFormat Format;
        public bool Checked;
        public bool Loaded;
    }

    Mode _mode = Mode.Pick;
    bool _busy;
    string _phase = "";
    string? _error;
    List<string> _warnings = new();
    List<TestGroup> _tests = new();
    Dictionary<string, ExceptionItem> _selected = new();
    bool _showFoi;
    string _foiName = "";
    string _foiEmail = "";
    bool _foiElectronic = true;
    // Verified by hand against the council's own FOI contact page for Wokingham only (see
    // PickWokingham below); unset ("") for "use your own file" councils until someone hand-checks
    // that council's own FOI contact page the same way.
    string _foiContactEmail = "";
    string _foiContactCheckedNote = "";
    bool _foiContactVerified => !string.IsNullOrEmpty(_foiContactEmail);
    string _councilDisplayName = "";

    // ---- HoloDb data layer: one in-memory database shared across every council/year loaded this
    // session (so cross-council SQL/NEAREST queries just work) — see LoadSelectedYears below.
    Database? _db;
    int _spendRowsLoaded;
    HashSet<string> _exceptionsLoadedFor = new();
    int _exceptionsLoadedCount;
    string _nearestSupplierQuery = "";
    SearchMode _searchMode = SearchMode.Graded;
    List<(string Supplier, string Council, double Score)> _nearestResults = new();

    List<YearPick> _wokinghamYears = new()
    {
        new() { Tag = "FY2020-21", FileName = "wokingham-2020-21.csv", Format = SourceFormat.Csv },
        new() { Tag = "FY2021-22", FileName = "wokingham-2021-22.csv", Format = SourceFormat.Csv },
        new() { Tag = "FY2022-23", FileName = "wokingham-2022-23.csv", Format = SourceFormat.Csv },
        new() { Tag = "FY2023-24", FileName = "wokingham-2023-24.xlsx", Format = SourceFormat.Xlsx },
        new() { Tag = "FY2024-25", FileName = "wokingham-2024-25.csv", Format = SourceFormat.Csv },
        new() { Tag = "FY2025-26", FileName = "wokingham-2025-26.csv", Format = SourceFormat.Csv },
    };

    // Reading publishes monthly, not annually — same YearPick shape, a month tag instead of a
    // financial-year tag. Reading has NO Schedule A (see HasScheduleA note on CouncilDbBuilder) —
    // its own picker-mode panel says so plainly rather than rendering an empty test 1/2 panel.
    List<YearPick> _readingMonths = new()
    {
        new() { Tag = "2021-12", FileName = "reading-2021-12.csv", Format = SourceFormat.Csv },
        new() { Tag = "2022-04", FileName = "reading-2022-04.csv", Format = SourceFormat.Csv },
        new() { Tag = "2023-03", FileName = "reading-2023-03.csv", Format = SourceFormat.Csv },
        new() { Tag = "2024-06", FileName = "reading-2024-06.csv", Format = SourceFormat.Csv },
        new() { Tag = "2026-02", FileName = "reading-2026-02.csv", Format = SourceFormat.Csv },
    };

    // Which hosted councils have actually been loaded into _db/_tests this session — drives the
    // cross-council correlation section's wording and the summary bar, independent of which
    // picker-mode panel happens to be showing right now.
    HashSet<string> _loadedCouncils = new();

    // ---- "use your own file" state ----
    byte[]? _ownBytes;
    SourceFormat _ownFormat;
    List<string> _ownHeader = new();
    string _ownMapTrans = "", _ownMapSupplier = "", _ownMapGross = "", _ownMapNet = "",
           _ownMapVatAmount = "", _ownMapVatType = "", _ownMapPayDate = "", _ownMapDesc = "", _ownMapService = "";
    TransactionIdScope _ownIdScope = TransactionIdScope.CouncilWideUnique;
    GrossMeaning _ownGrossMeaning = GrossMeaning.RepeatedInvoiceTotal;
    string _ownCouncilName = "";

    // Picking a hosted council only switches which "add council/year" panel and FOI contact are
    // active — it deliberately does NOT wipe already-loaded data from another hosted council (see
    // _loadedCouncils above): the whole point of hosting more than one council is the cross-council
    // correlation view below, which needs everything loaded this session to stay loaded while you
    // switch between panels.
    void PickWokingham()
    {
        _mode = Mode.Wokingham; _councilDisplayName = SupportedCouncils.Wokingham.Name;
        // Verified by hand against the council's own page, checked 3 October 2026:
        // https://www.wokingham.gov.uk/foi/receiving-foi-requests-email (the page itself writes
        // this address as "Informationrequests[at]Wokingham.gov.uk").
        _foiContactEmail = "informationrequests@wokingham.gov.uk";
        _foiContactCheckedNote = "checked 3 October 2026 against the council's own FOI contact page";
        _error = null; _showFoi = false;
    }
    void PickReading()
    {
        _mode = Mode.Reading; _councilDisplayName = SupportedCouncils.Reading.Name;
        // Verified by hand against the council's own FOI contact page, checked 3 October 2026:
        // https://www.reading.gov.uk/contact-us/freedom-of-information-foi/freedom-of-information-act-procedure-for-dealing-with-requests/.
        _foiContactEmail = "FOI.CRT@reading.gov.uk";
        _foiContactCheckedNote = "checked 3 October 2026 against the council's own FOI contact page";
        _error = null; _showFoi = false;
    }

    void BackToPicker()
    {
        // Deliberately does not clear _db/_tests/_selected/_loadedCouncils — see the note above.
        _mode = Mode.Pick; _foiContactEmail = ""; _foiContactCheckedNote = ""; _error = null; _showFoi = false;
    }

    static string? NullIfEmpty(string s) => string.IsNullOrWhiteSpace(s) ? null : s;

    string StatsLine()
    {
        if (_spendRowsLoaded == 0)
            return "Nothing loaded yet — pick a year/month below to load your first council into the browser's database.";
        var parts = new List<string>();
        if (_loadedCouncils.Contains("wokingham"))
            parts.Add($"{_wokinghamYears.Count(y => y.Loaded)} of {_wokinghamYears.Count} Wokingham years");
        if (_loadedCouncils.Contains("reading"))
            parts.Add($"{_readingMonths.Count(y => y.Loaded)} of {_readingMonths.Count} Reading months");
        return $"{string.Join(", ", parts)} loaded ({_spendRowsLoaded:N0} spend rows), " +
               $"{_exceptionsLoadedCount:N0} precomputed exceptions. {_loadedCouncils.Count} council(s) loaded so far.";
    }

    string CrossCouncilStateLine() =>
        "Only one council is loaded today, so same-supplier and payments-between-councils views have " +
        "nothing to compare against yet — they fill in automatically as more councils are loaded above. " +
        "The search below already runs against everything loaded this session, and will start surfacing " +
        "cross-council matches the moment a second council joins.";

    void EnsureDb()
    {
        if (_db is not null) return;
        _db = Database.Open(null);
        _db.Execute("CREATE TABLE spend (id INT PRIMARY KEY, council TEXT, year TEXT, transid TEXT, " +
            "paydate TEXT, net REAL, gross REAL, vattype TEXT, servicearea TEXT, costcentre TEXT, " +
            "description TEXT, supplierkey TEXT, supplier TEXT)");
    }

    async Task<byte[]> FetchGunzipAsync(string url)
    {
        var compressed = await Http.GetByteArrayAsync(url);
        using var input = new MemoryStream(compressed, writable: false);
        using var gz = new GZipStream(input, CompressionMode.Decompress);
        using var output = new MemoryStream(compressed.Length * 4);
        await gz.CopyToAsync(output);
        return output.ToArray();
    }

    async Task LoadSelectedYears() => await LoadSelectedPeriods("wokingham", _wokinghamYears);
    async Task LoadSelectedReadingMonths() => await LoadSelectedPeriods("reading", _readingMonths);

    // Loads the selected, not-yet-loaded periods (financial years for Wokingham, months for
    // Reading) as compact pre-normalised files (built offline by CouncilDbBuilder from the same
    // raw hosted files, see that project's own header comment) and BulkLoads them into the shared
    // in-memory HoloDb — SHARED across every hosted council loaded this session, so cross-council
    // SQL/NEAREST queries just work the moment a second council joins. Each council's own
    // precomputed exceptions file loads once, alongside its first period, rather than re-running
    // AuditEngine client-side at all.
    async Task LoadSelectedPeriods(string councilKey, List<YearPick> periods)
    {
        _error = null; _busy = true; _phase = "Loading…"; StateHasChanged(); await Task.Delay(1);
        try
        {
            EnsureDb();
            var toLoad = periods.Where(y => y.Checked && !y.Loaded).ToList();
            foreach (var y in toLoad)
            {
                _phase = $"Fetching {y.Tag}…"; StateHasChanged(); await Task.Delay(1);
                var bytes = await FetchGunzipAsync($"data/councils/{councilKey}/{y.Tag}.norm.csv.gz");
                _phase = $"Loading {y.Tag} into HoloDb…"; StateHasChanged(); await Task.Delay(1);
                var table = CsvReader.Parse(bytes); // plain UTF-8, no BOM — written by CouncilDbBuilder
                int m = table.Count - 1;
                int baseId = _spendRowsLoaded;
                var id = new long[m]; var council = new string[m]; var year = new string[m];
                var transid = new string[m]; var paydate = new string[m];
                var net = new double[m]; var gross = new double[m];
                var vattype = new string[m]; var servicearea = new string[m]; var costcentre = new string[m];
                var description = new string[m]; var supplierkey = new string[m]; var supplier = new string[m];
                for (int i = 1; i < table.Count; i++)
                {
                    var f = table[i]; int j = i - 1;
                    id[j] = baseId + j;
                    council[j] = f[0]; year[j] = f[1]; transid[j] = f[2]; paydate[j] = f[3];
                    net[j] = double.Parse(f[4], CultureInfo.InvariantCulture);
                    gross[j] = double.Parse(f[5], CultureInfo.InvariantCulture);
                    vattype[j] = f[6]; servicearea[j] = f[7]; costcentre[j] = f[8]; description[j] = f[9];
                    supplierkey[j] = f[10]; supplier[j] = f[11];
                }
                _db!.BulkLoad("spend",
                    new[] { "id", "council", "year", "transid", "paydate", "net", "gross", "vattype",
                            "servicearea", "costcentre", "description", "supplierkey", "supplier" },
                    new Array[] { id, council, year, transid, paydate, net, gross, vattype,
                                   servicearea, costcentre, description, supplierkey, supplier }, m);
                y.Loaded = true; y.Checked = false;
                _spendRowsLoaded += m;
                _loadedCouncils.Add(councilKey);
            }

            if (!_exceptionsLoadedFor.Contains(councilKey))
            {
                _phase = "Loading precomputed exceptions…"; StateHasChanged(); await Task.Delay(1);
                var excBytes = await FetchGunzipAsync($"data/councils/{councilKey}/exceptions.csv.gz");
                var excTable = CsvReader.Parse(excBytes);
                BuildTestsFromExceptionsRows(excTable);
                _exceptionsLoadedFor.Add(councilKey);
                _exceptionsLoadedCount += excTable.Count - 1;
            }
        }
        catch (Exception ex)
        {
            _error = "Something went wrong loading that data: " + ex.Message;
        }
        finally { _busy = false; StateHasChanged(); }
    }

    static readonly Dictionary<string, string> TestDescByLabel = new()
    {
        ["Exception test 1 - payments above the stated invoice amount"] =
            "The sum of the payments published against this transaction is larger than the invoice " +
            "amount stated for it.",
        ["Exception test 2 - invoice amounts not covered by published payments"] =
            "The stated invoice amount is larger than the payments published against this transaction " +
            "— the remainder isn't in the published data.",
        ["Exception test 3 - same supplier, amount, description and date under different transaction numbers"] =
            "A pattern, not a contradiction: these rows share the same supplier, amount, description " +
            "and pay date but are logged against different transaction numbers. Rows with a redacted " +
            "supplier or transaction id are excluded — the redaction placeholder repeats across " +
            "unrelated payments and would otherwise produce false matches.",
        ["Exception test 4 - one transaction number covering several payees or pay dates"] =
            "The same transaction number appears against more than one payee, or more than one pay " +
            "date, in the published data.",
        ["Exception test 5 - the same line listed more than once in the published file"] =
            "The exact same transaction number, supplier, amount, description and pay date appears on " +
            "more than one row of the same published file.",
        ["Exception test R - credit/refund rows vs. a matching same-supplier charge"] =
            "Every row the council's own Invoice Type column labels a credit or refund, checked against " +
            "whether a same-supplier charge of matching size exists anywhere in the loaded data within a " +
            "year either way. A credit sign convention changed between publishing eras — this test never " +
            "assumes a sign, it reads the council's own Invoice Type label instead.",
    };

    // Persistent across loads so a second hosted council's exceptions MERGE into the same test
    // panels (by label) instead of replacing the first council's — this is what makes the merged
    // "Exception tests" section genuinely cross-council once more than one is loaded.
    Dictionary<string, TestGroup> _testsByLabel = new();
    List<string> _testOrder = new();

    // Builds the same TestGroup/ExceptionItem shape the UI already renders, straight from a
    // council's own precomputed exceptions file — council,testlabel,type,sourcetag,transid,
    // supplier,paydate,amount,servicearea,description,handverified,compareamount,groupkey,
    // groupsize,oppositesign,classification,classificationdetail (the last 6 columns, added for
    // the evidence/highlighting panel and the classification labels, are produced by
    // CouncilDbBuilder — see that project's own header comment for the exact schema). No
    // AuditEngine.Run call in the browser for a hosted council; this file is a precomputed
    // snapshot of its output. Safe to call once per council, additively.
    void BuildTestsFromExceptionsRows(List<string[]> table)
    {
        for (int i = 1; i < table.Count; i++)
        {
            var f = table[i];
            string councilKey = f[0];
            string label = f[1];
            if (!_testsByLabel.TryGetValue(label, out var grp))
            {
                grp = new TestGroup { Label = label, Description = TestDescByLabel.GetValueOrDefault(label, "") };
                _testsByLabel[label] = grp; _testOrder.Add(label);
            }
            var type = Enum.TryParse<ExceptionType>(f[2], out var t) ? t : ExceptionType.Discrepancy;
            decimal? compareAmount = f.Length > 11 && decimal.TryParse(f[11], NumberStyles.Any, CultureInfo.InvariantCulture, out var ca) ? ca : null;
            string? groupKey = f.Length > 12 ? NullIfEmpty(f[12]) : null;
            int groupSize = f.Length > 13 && int.TryParse(f[13], out var gs) ? gs : 1;
            bool oppositeSign = f.Length > 14 && f[14] == "True";
            string classification = f.Length > 15 ? f[15] : "";
            string? classificationDetail = f.Length > 16 ? NullIfEmpty(f[16]) : null;
            int lineCount = f.Length > 17 && int.TryParse(f[17], out var lc) ? lc : 1;
            grp.Items.Add(new ExceptionItem
            {
                TestLabel = label, Type = type,
                Council = CouncilDisplayNames.GetValueOrDefault(councilKey, councilKey),
                SourceTag = f[3], TransactionId = f[4], Supplier = f[5],
                PayDate = NullIfEmpty(f[6]),
                Amount = decimal.TryParse(f[7], NumberStyles.Any, CultureInfo.InvariantCulture, out var amt) ? amt : null,
                ServiceArea = NullIfEmpty(f[8]),
                Description = NullIfEmpty(f[9]),
                Kind = label.Contains("test R") ? EvidenceKind.CreditMatch
                     : compareAmount is not null ? EvidenceKind.AmountCompare
                     : groupKey is not null ? EvidenceKind.GroupEvidence : EvidenceKind.None,
                CompareAmount = compareAmount,
                CompareLabel = compareAmount is not null ? "Stated invoice amount" : null,
                OppositeSign = oppositeSign,
                GroupKey = groupKey,
                GroupSize = groupSize,
                Classification = string.IsNullOrEmpty(classification)
                    ? (type == ExceptionType.Anomaly ? "Unclear" : "Unreconciled") : classification,
                ClassificationDetail = classificationDetail,
                LineCount = lineCount,
            });
        }
        _tests = _testOrder.OrderBy(l => l, StringComparer.Ordinal).Select(l => _testsByLabel[l]).ToList();
        SetDefaultCollapse();
    }

    // Every test panel starts collapsed, uniformly — no panel is pre-opened or singled out;
    // a visitor opens whichever ones they want to look at.
    void SetDefaultCollapse()
    {
        foreach (var t in _tests) t.Collapsed = true;
    }

    // Replaces any hand-picked "top items" list: a plain, stated, engine-computed ranking over
    // whatever is actually loaded into _tests right now — every row currently marked Unexplained
    // (IsUnexplained) by the tests below, sorted by the absolute £ amount published against it,
    // highest first. Recomputed fresh every render; the same rule runs for every council, and
    // nothing in this list is chosen by hand.
    List<ExceptionItem> RankedUnexplained(int take = 20) =>
        _tests.SelectMany(t => t.Items)
            .Where(i => i.IsUnexplained)
            .OrderByDescending(i => Math.Abs(i.Amount ?? 0m))
            .Take(take)
            .ToList();

    // "Exception test 3 — same supplier, ..." -> "Exception test 3", for a compact column in the
    // ranked-items table above.
    static string ShortTestLabel(string label)
    {
        var dash = label.IndexOfAny(new[] { '—', '-' });
        return dash > 0 ? label[..dash].Trim() : label;
    }

    // Cross-council correlation search across EVERYTHING loaded this session (any council, any
    // year). Two modes:
    //  - Graded (default): HoloDb's own holographic NEAREST similarity search against the
    //    normalised supplier key, ranked by the `score` pseudo-column. Originally shipped as
    //    LIKE-only — tried NEAREST first against real Wokingham data and found it unreliable
    //    (score column threw, truncated names didn't rank near their real match), flagged to
    //    holodb-owner rather than guessed around. holodb-owner's F-04 fix (HoloDb 2.1.0, this repo
    //    bumped to 2.1.0 2026-10-03) is re-verified against the real 42,405-row Wokingham dataset
    //    (LSH regime, above the ~8,000-row exact-search cutover): a deliberately truncated query
    //    ("A Wise Solution") now ranks the real supplier ("A Wise Solution Ltd") first with
    //    score=0.856, on both the raw supplier column and this normalised key. Safe to turn on.
    //  - Exact substring (LIKE): kept as a fallback for when a visitor wants to be certain nothing
    //    beyond a literal substring is being matched — NEAREST's closeness is a well-behaved local
    //    ranking, not a global total order (two far values can occasionally tie/swap rank), so an
    //    exact mode stays useful alongside it, not merely as a historical relic.
    async Task RunNearestSupplierSearch()
    {
        if (_db is null || string.IsNullOrWhiteSpace(_nearestSupplierQuery)) return;
        _busy = true; StateHasChanged(); await Task.Delay(1);
        try
        {
            var key = new string(_nearestSupplierQuery.Trim().ToUpperInvariant()
                .Where(c => char.IsLetterOrDigit(c) || c == ' ').ToArray()).Replace("'", "''");
            if (_searchMode == SearchMode.Graded)
            {
                var result = _db.Execute(
                    $"SELECT supplier, council, score FROM spend NEAREST (supplierkey = '{key}') LIMIT 20");
                _nearestResults = result.Rows
                    .Select(r => (r.TryGetValue("supplier", out var s) ? s?.ToString() ?? "" : "",
                                   r.TryGetValue("council", out var c) ? c?.ToString() ?? "" : "",
                                   r.TryGetValue("score", out var sc) && sc is not null ? Convert.ToDouble(sc) : 0.0))
                    .DistinctBy(x => (x.Item1, x.Item2))
                    .ToList();
            }
            else
            {
                var result = _db.Execute($"SELECT supplier, council FROM spend WHERE supplierkey LIKE '%{key}%' LIMIT 20");
                _nearestResults = result.Rows
                    .Select(r => (r.TryGetValue("supplier", out var s) ? s?.ToString() ?? "" : "",
                                   r.TryGetValue("council", out var c) ? c?.ToString() ?? "" : "", 0.0))
                    .DistinctBy(x => (x.Item1, x.Item2))
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            _error = "Supplier search failed: " + ex.Message;
        }
        finally { _busy = false; StateHasChanged(); }
    }

    const long MaxOwnFileUpload = 64L * 1024 * 1024;

    async Task OnOwnFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        _error = null; _ownHeader = new();
        try
        {
            using var stream = file.OpenReadStream(MaxOwnFileUpload);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _ownBytes = ms.ToArray();
            _ownFormat = file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase) ? SourceFormat.Xlsx : SourceFormat.Csv;
            var table = _ownFormat == SourceFormat.Xlsx ? XlsxReader.Parse(_ownBytes) : CsvReader.Parse(_ownBytes);
            if (table.Count == 0) { _error = "That file has no rows."; return; }
            var header = table[0].Select(h => h.Trim().TrimStart('﻿')).ToArray();
            _ownHeader = header.ToList();
            UseGuessedMapping(header);
        }
        catch (Exception ex)
        {
            _error = "Couldn't read that file: " + ex.Message;
        }
    }

    void UseGuessedMapping(string[] header)
    {
        var guess = ColumnMapper.Guess(header);
        _ownMapTrans = guess.TransactionId;
        _ownMapSupplier = guess.Supplier;
        _ownMapGross = guess.Gross ?? "";
        _ownMapNet = guess.Net ?? "";
        _ownMapVatAmount = guess.VatAmount ?? "";
        _ownMapVatType = guess.VatType ?? "";
        _ownMapPayDate = guess.PayDate ?? "";
        _ownMapDesc = guess.Description ?? "";
        _ownMapService = guess.ServiceArea ?? "";
    }

    // Own-file mode is a standalone, one-off analysis — not part of the hosted-council
    // cross-council merge (_testsByLabel/_db), so it's safe (and correct) to wipe its own
    // state outright on every run rather than merging.
    void ResetOwnFileResult()
    {
        _error = null; _warnings = new(); _tests = new(); _selected.Clear();
        _showFoi = false;
    }

    async Task RunOwnFile()
    {
        ResetOwnFileResult();
        if (_ownBytes is null) { _error = "Load a file first."; return; }
        _busy = true; _phase = "Parsing…"; StateHasChanged(); await Task.Delay(1);
        try
        {
            List<string[]> table = _ownFormat == SourceFormat.Xlsx ? XlsxReader.Parse(_ownBytes) : CsvReader.Parse(_ownBytes);
            var mapping = new ColumnMapping(
                _ownMapTrans, _ownMapSupplier, NullIfEmpty(_ownMapPayDate), NullIfEmpty(_ownMapDesc),
                NullIfEmpty(_ownMapService), NullIfEmpty(_ownMapNet), _ownMapGross,
                NullIfEmpty(_ownMapVatAmount), NullIfEmpty(_ownMapVatType));
            var warnings = new List<string>();
            var rows = AuditEngine.MapRows(table, mapping, "Your file", warnings);
            var result = AuditEngine.Run(rows, _ownIdScope, _ownGrossMeaning, warnings);
            _warnings = warnings;
            _councilDisplayName = string.IsNullOrWhiteSpace(_ownCouncilName) ? "this council" : _ownCouncilName.Trim();
            BuildTests(result, rows);
        }
        catch (Exception ex)
        {
            _error = "Something went wrong: " + ex.Message;
        }
        finally { _busy = false; StateHasChanged(); }
    }

    void BuildTests(AuditResult result, List<SpendRow> rawRows)
    {
        _tests = new();

        var t1 = new TestGroup
        {
            Label = "Exception test 1 — payments above the stated invoice amount",
            Description = "The sum of the payments published against this transaction is larger than the " +
                "invoice amount stated for it."
        };
        var t2 = new TestGroup
        {
            Label = "Exception test 2 — invoice amounts not covered by published payments",
            Description = "The stated invoice amount is larger than the payments published against this " +
                "transaction — the remainder isn't in the published data."
        };
        foreach (var r in result.ScheduleA)
        {
            bool paymentsExceed = r.Gross < r.ExpectedGross;
            var item = new ExceptionItem
            {
                TestLabel = paymentsExceed ? t1.Label : t2.Label,
                Type = paymentsExceed ? ExceptionType.Discrepancy : ExceptionType.Unreconciled,
                Council = _councilDisplayName,
                SourceTag = r.SourceTag, TransactionId = r.TransactionId, Supplier = r.Supplier,
                // FIX (2026-10-03, caught while building the FOI-letter sentence generator): this
                // used to store the STATED invoice amount (r.Gross) as "Amount" (labelled "Sum of
                // payments published" in the evidence panel) and a derived VAT-adjusted figure
                // (r.ExpectedGross) as "CompareAmount" (labelled "Stated invoice amount") — backwards
                // on both counts. Amount is now the real sum of published PAYMENTS (r.Net); CompareAmount
                // is the real stated invoice figure (r.Gross) the CompareLabel already claimed it was.
                PayDate = r.PayDate, Amount = r.Net, ServiceArea = r.ServiceArea, Description = r.Description,
                Kind = EvidenceKind.AmountCompare,
                CompareAmount = r.Gross,
                CompareLabel = "Stated invoice amount",
                OppositeSign = !paymentsExceed && r.Net != 0 && r.Gross != 0 && r.Net == -r.Gross,
                Classification = r.Classification.ToString(),
                ClassificationDetail = r.ClassificationDetail,
                LineCount = r.LineCount,
            };
            (paymentsExceed ? t1 : t2).Items.Add(item);
        }
        _tests.Add(t1); _tests.Add(t2);

        var t3 = new TestGroup
        {
            Label = "Exception test 3 — same supplier, amount, description and date under different transaction numbers",
            Description = "A pattern, not a contradiction: these rows share the same supplier, amount, " +
                "description and pay date but are logged against different transaction numbers. Rows " +
                "with a redacted supplier or transaction id are excluded (see the warnings above) — the " +
                "redaction placeholder repeats across unrelated payments and would otherwise produce " +
                "false matches."
        };
        int g3Id = 0;
        foreach (var g in result.ScheduleB)
        {
            g3Id++;
            var groupKey = $"g3-{g3Id}";
            foreach (var m in g.Members)
            {
                t3.Items.Add(new ExceptionItem
                {
                    TestLabel = t3.Label, Type = ExceptionType.Anomaly, Council = _councilDisplayName,
                    SourceTag = m.SourceTag, TransactionId = m.TransactionId, Supplier = m.Supplier,
                    PayDate = m.PayDateRaw, Amount = m.Net, ServiceArea = m.ServiceArea, Description = m.Description,
                    Kind = EvidenceKind.GroupEvidence, GroupKey = groupKey, GroupSize = g.Members.Count,
                    Classification = g.Classification.ToString(), ClassificationDetail = g.ClassificationDetail,
                });
            }
        }
        _tests.Add(t3);

        var t4 = new TestGroup
        {
            Label = "Exception test 4 — one transaction number covering several payees or pay dates",
            Description = result.ScheduleDScope == TransactionIdScope.SupplierFurnished
                ? "This council's transaction number is the supplier's own invoice number, not one the " +
                  "council assigns itself — two unrelated suppliers using the same number is most likely " +
                  "coincidence, not a shared transaction. Shown for completeness, not as a finding."
                : "The same transaction number appears against more than one payee, or more than one pay " +
                  "date, in the published data."
        };
        foreach (var g in result.ScheduleD)
        {
            var groupKey = $"g4-{g.SourceTag}-{g.TransactionId}";
            foreach (var m in g.Members)
            {
                t4.Items.Add(new ExceptionItem
                {
                    TestLabel = t4.Label, Type = ExceptionType.Discrepancy, Council = _councilDisplayName,
                    SourceTag = m.SourceTag, TransactionId = m.TransactionId, Supplier = m.Supplier,
                    PayDate = m.PayDateRaw, Amount = m.Gross, ServiceArea = m.ServiceArea, Description = m.Description,
                    Kind = EvidenceKind.GroupEvidence, GroupKey = groupKey, GroupSize = g.Members.Count,
                });
            }
        }
        _tests.Add(t4);

        // Exception test 5 — the same line listed more than once in the published file (same
        // transaction, supplier, amount, description and pay date repeated on separate rows). Computed
        // here rather than inside AuditEngine (which doesn't expose this), using the same
        // redaction exclusion the engine applies to Schedules A/B/D.
        bool IsRedacted(string s) => s.Contains("REDACT", StringComparison.OrdinalIgnoreCase);
        var clean = rawRows.Where(r => !IsRedacted(r.TransactionId) && !IsRedacted(r.Supplier)).ToList();
        var t5 = new TestGroup
        {
            Label = "Exception test 5 — the same line listed more than once in the published file",
            Description = "The exact same transaction number, supplier, amount, description and pay date " +
                "appears on more than one row of the same published file."
        };
        var dupLineGroups = clean
            .GroupBy(r => (r.SourceTag, r.TransactionId, r.Supplier, r.Net, r.Gross, (r.Description ?? "").Trim(), r.PayDateRaw))
            .Where(g => g.Count() > 1);
        // One ExceptionItem per REPEATED ROW (not one aggregate per group) so the evidence panel can
        // show the actual repeated lines paired up, same shape as test 3/4's group evidence.
        int g5Id = 0;
        foreach (var g in dupLineGroups)
        {
            g5Id++;
            var groupKey = $"g5-{g5Id}";
            int n = g.Count();
            foreach (var m in g)
            {
                t5.Items.Add(new ExceptionItem
                {
                    TestLabel = t5.Label, Type = ExceptionType.Discrepancy, Council = _councilDisplayName,
                    SourceTag = m.SourceTag, TransactionId = m.TransactionId, Supplier = m.Supplier,
                    PayDate = m.PayDateRaw, Amount = m.Gross, ServiceArea = m.ServiceArea,
                    Description = m.Description,
                    Kind = EvidenceKind.GroupEvidence, GroupKey = groupKey, GroupSize = n,
                });
            }
        }
        _tests.Add(t5);
        SetDefaultCollapse();
    }

    string TagClass(ExceptionType t) => t switch
    {
        ExceptionType.Discrepancy => "tag-discrepancy",
        ExceptionType.Unreconciled => "tag-unreconciled",
        ExceptionType.Anomaly => "tag-anomaly",
        _ => ""
    };

    const int PageSize = 50;

    // ---- £ totals (added 2026-10-03) ----
    // A total here is "value involved" — the value of items that fail one of the mechanical tests
    // below, NOT money proven lost or wasted. What the £ figure measures differs by test family:
    // test 1/2 (payment vs. invoice) use the signed GAP between the two published figures; every
    // other test uses the row's own published amount (already the per-line or per-group value
    // CouncilDbBuilder/BuildTests wrote onto it).
    static string TestAmountLabel(string testLabel) => testLabel switch
    {
        var l when l.Contains("test 1") || l.Contains("test 2") =>
            "sum of the gaps between payments published and the stated invoice amount",
        var l when l.Contains("test 3") => "total value of the repeated payments",
        var l when l.Contains("test 4") => "total value involved in the multi-payee/multi-date transactions",
        var l when l.Contains("test 5") => "total value of the repeated lines",
        var l when l.Contains("test R") => "total value of the credit/refund rows",
        _ => "total value involved",
    };

    static decimal TestRowValue(ExceptionItem it) =>
        it.Kind == EvidenceKind.AmountCompare && it.CompareAmount is { } ca && it.Amount is { } a
            ? Math.Abs(a - ca)
            : Math.Abs(it.Amount ?? 0m); // CreditMatch (test R) rows can be negative (pre-2024 CREDIT era)

    static decimal TestTotal(IEnumerable<ExceptionItem> items) => items.Sum(TestRowValue);

    // Test 3 (repeated payments) also reports the narrower "value of the repeats beyond the
    // first" — each group's own members minus one (the original payment), summed per group
    // (GroupKey), not per row, so a 3-member group's own first row isn't itself counted as a repeat.
    static decimal RepeatsBeyondFirstTotal(IReadOnlyList<ExceptionItem> items)
    {
        decimal total = 0m;
        foreach (var g in items.Where(i => i.GroupKey is not null).GroupBy(i => i.GroupKey))
        {
            var ordered = g.ToList();
            if (ordered.Count <= 1) continue;
            total += ordered.Skip(1).Sum(TestRowValue);
        }
        return total;
    }

    // Per-classification breakdown within a test's currently FILTERED items — genuinely
    // unexplained (Unreconciled/Unclear) ranked first, matching the row-ranking rule above.
    static List<(string Classification, int Count, decimal Total)> ClassificationTotals(IReadOnlyList<ExceptionItem> items) =>
        items.GroupBy(i => i.Classification)
             .Select(g => (Classification: g.Key, Count: g.Count(), Total: TestTotal(g)))
             .OrderBy(x => x.Classification is "Unreconciled" or "Unclear" or "" ? 0 : 1)
             .ThenByDescending(x => x.Total)
             .ToList();

    // Session-wide summary bar: every loaded test's items, deduplicated to ONE entry per real
    // transaction (Council+SourceTag+TransactionId) so a transaction flagged by more than one
    // test (e.g. both test 1 and test 4) is not double-counted. Takes the first-encountered row's
    // own value for that transaction — most transactions carry one consistent published amount
    // across every test that names them, so this is a representative figure, not an undercount
    // by construction.
    (int Count, decimal Total) DistinctSummary(bool unexplainedOnly)
    {
        var seen = new HashSet<string>();
        int count = 0; decimal total = 0m;
        foreach (var t in _tests)
            foreach (var it in t.Items)
            {
                if (unexplainedOnly && !it.IsUnexplained) continue;
                var key = $"{it.Council}|{it.SourceTag}|{it.TransactionId}";
                if (!seen.Add(key)) continue;
                count++; total += TestRowValue(it);
            }
        return (count, total);
    }

    // Grand selected total for the FOI tray — same distinct-transaction dedup rule as the
    // top summary bar, but over whatever is currently ticked across every test/page/filter.
    (int Count, decimal Total) SelectedDistinctSummary()
    {
        var seen = new HashSet<string>();
        int count = 0; decimal total = 0m;
        foreach (var it in _selected.Values)
        {
            var key = $"{it.Council}|{it.SourceTag}|{it.TransactionId}";
            if (!seen.Add(key)) continue;
            count++; total += TestRowValue(it);
        }
        return (count, total);
    }

    List<(ExceptionType Type, int Count, decimal Total)> SelectedTypeBreakdown() =>
        _selected.Values.GroupBy(i => i.Type)
            .Select(g => (g.Key, g.Count(), TestTotal(g)))
            .OrderByDescending(x => x.Item3)
            .ToList();

    void ToggleCollapse(TestGroup t) => t.Collapsed = !t.Collapsed;

    // Filter (and sort) a test's full item list — this runs over EVERY item in the test, not just
    // the current page, since paging/"select all" both need to operate on the full matching set.
    List<ExceptionItem> FilteredItems(TestGroup t)
    {
        IEnumerable<ExceptionItem> q = t.Items;
        if (!string.IsNullOrWhiteSpace(t.FilterText))
        {
            var f = t.FilterText.Trim();
            q = q.Where(i => (i.Supplier?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false)
                           || (i.Description?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        if (!string.IsNullOrWhiteSpace(t.FilterYear))
            q = q.Where(i => i.SourceTag == t.FilterYear);
        q = t.SortColumn switch
        {
            "year" => t.SortDesc ? q.OrderByDescending(i => i.SourceTag, StringComparer.Ordinal) : q.OrderBy(i => i.SourceTag, StringComparer.Ordinal),
            "trans" => t.SortDesc ? q.OrderByDescending(i => i.TransactionId, StringComparer.Ordinal) : q.OrderBy(i => i.TransactionId, StringComparer.Ordinal),
            "paydate" => t.SortDesc ? q.OrderByDescending(i => i.PayDate, StringComparer.Ordinal) : q.OrderBy(i => i.PayDate, StringComparer.Ordinal),
            "amount" => t.SortDesc ? q.OrderByDescending(i => i.Amount) : q.OrderBy(i => i.Amount),
            "payee" => t.SortDesc ? q.OrderByDescending(i => i.Supplier, StringComparer.OrdinalIgnoreCase) : q.OrderBy(i => i.Supplier, StringComparer.OrdinalIgnoreCase),
            "service" => t.SortDesc ? q.OrderByDescending(i => i.ServiceArea, StringComparer.Ordinal) : q.OrderBy(i => i.ServiceArea, StringComparer.Ordinal),
            _ => q
        };
        return q.ToList();
    }

    List<string> DistinctYears(TestGroup t) => t.Items.Select(i => i.SourceTag).Distinct().OrderBy(x => x, StringComparer.Ordinal).ToList();

    int TotalPages(int filteredCount) => Math.Max(1, (int)Math.Ceiling(filteredCount / (double)PageSize));

    void ChangePage(TestGroup t, int delta, int totalPages) => t.Page = Math.Clamp(t.Page + delta, 1, totalPages);

    void OnFilterChanged(TestGroup t) => t.Page = 1;

    void SetSort(TestGroup t, string col)
    {
        if (t.SortColumn == col) t.SortDesc = !t.SortDesc;
        else { t.SortColumn = col; t.SortDesc = false; }
        t.Page = 1;
    }

    string SortArrow(TestGroup t, string col) => t.SortColumn != col ? "" : (t.SortDesc ? " ▼" : " ▲");

    // "Select all" always operates on every FILTERED item, not just the page currently rendered —
    // selection must cover everything matching the current filter, visible or not.
    bool AllFilteredSelected(List<ExceptionItem> filtered) => filtered.Count > 0 && filtered.All(i => i.Selected);

    void SelectAllFiltered(List<ExceptionItem> filtered, bool on)
    {
        foreach (var it in filtered)
        {
            it.Selected = on;
            if (on) _selected[it.Key] = it; else _selected.Remove(it.Key);
        }
    }

    string SelectAllLabel(TestGroup t, int filteredCount) => filteredCount != t.Items.Count
        ? $"select all matching ({filteredCount:N0})"
        : "select all in this test";

    string ShowingLabel(TestGroup t, int filteredCount, int startIdx, int endIdx) => filteredCount == t.Items.Count
        ? $"Showing {startIdx}-{endIdx} of {filteredCount:N0}"
        : $"Showing {startIdx}-{endIdx} of {filteredCount:N0} (filtered from {t.Items.Count:N0})";

    // ---- evidence / highlighting: let a reader see the actual discrepancy, not just a count ----
    static readonly CultureInfo GB = CultureInfo.GetCultureInfo("en-GB");

    void ToggleEvidence(ExceptionItem it) => it.EvidenceOpen = !it.EvidenceOpen;

    // The signed gap between what was published as paid and what was stated as owed — the number
    // every "payment above/below invoice" exception is actually about.
    string EvidenceDiff(ExceptionItem it)
    {
        if (it.Amount is null || it.CompareAmount is null) return "—";
        var d = it.Amount.Value - it.CompareAmount.Value;
        return (d >= 0 ? "+" : "") + d.ToString("C2", GB);
    }

    // A loose heuristic, surfaced as a note not a conclusion: if the sum paid is roughly double the
    // stated invoice, the SAME published line being counted twice (test 5) is a plausible, neutral
    // explanation worth checking before assuming anything else.
    bool LooksLikeDoubleCount(ExceptionItem it) =>
        it.Kind == EvidenceKind.AmountCompare && it.Amount is { } a && it.CompareAmount is { } c && c != 0
        && (double)(a / c) is > 1.85 and < 2.15;

    // Every sibling row sharing this item's GroupKey within the SAME test — pulled from the test's
    // full (unfiltered, unpaged) item list, so the evidence panel is always complete regardless of
    // which page or filter happens to be showing right now.
    List<ExceptionItem> GroupSiblings(TestGroup t, ExceptionItem it) =>
        it.GroupKey is null ? new List<ExceptionItem> { it } : t.Items.Where(x => x.GroupKey == it.GroupKey).ToList();

    // ---- plain-English per-item sentence (added 2026-10-03) ----
    // "each selected exception becomes a numbered item ... a plain-English sentence generated
    // from the actual values saying what doesn't add up" — used both next to the on-page evidence
    // highlighting AND, bundled with every involved line, in the FOI letter (see BuildFoiLetter).
    static string Money(decimal d) => d.ToString("C2", GB);
    static string PaymentsWord(int n) => n == 1 ? "one payment" : $"{n} payments";
    static string JoinWithAnd(IReadOnlyList<string> items) => items.Count switch
    {
        0 => "", 1 => items[0], 2 => $"{items[0]} and {items[1]}",
        _ => string.Join(", ", items.Take(items.Count - 1)) + " and " + items[^1]
    };
    static string TransactionsPhrase(IReadOnlyList<string> ids) =>
        ids.Count == 1 ? $"Transaction {ids[0]}" : $"Transactions {JoinWithAnd(ids)}";

    string ExplainItem(TestGroup t, ExceptionItem it)
    {
        var label = t.Label;
        if (it.Kind == EvidenceKind.AmountCompare && it.CompareAmount is { } inv && it.Amount is { } paid)
        {
            decimal gap = Math.Abs(paid - inv);
            string paymentsPhrase = it.LineCount <= 1 ? $"one payment of {Money(paid)}" : $"{it.LineCount} payments totalling {Money(paid)}";
            string tail = label.Contains("test 1")
                ? $"The published payments exceed the stated invoice by {Money(gap)}."
                : $"No other published payment accounts for the remaining {Money(gap)}.";
            return $"Transaction {it.TransactionId} records {paymentsPhrase} against a stated invoice amount of {Money(inv)}. {tail}";
        }
        if (it.Kind == EvidenceKind.GroupEvidence)
        {
            var sib = GroupSiblings(t, it);
            var ids = sib.Select(s => s.TransactionId).Distinct().ToList();
            if (label.Contains("test 3"))
            {
                var amt = it.Amount ?? 0m;
                var date = it.PayDate ?? "an unpublished date";
                return $"{TransactionsPhrase(ids)} record {PaymentsWord(sib.Count)} of {Money(amt)} each to {it.Supplier} on {date}, " +
                       "with the same description, under different transaction numbers.";
            }
            if (label.Contains("test 4"))
            {
                var distinctSuppliers = sib.Select(s => s.Supplier).Distinct().ToList();
                var distinctDates = sib.Select(s => s.PayDate ?? "an unpublished date").Distinct().ToList();
                var total = sib.Sum(s => s.Amount ?? 0m);
                return distinctSuppliers.Count > 1
                    ? $"Transaction {it.TransactionId} is recorded against {distinctSuppliers.Count} different payees " +
                      $"({JoinWithAnd(distinctSuppliers)}), totalling {Money(total)}."
                    : $"Transaction {it.TransactionId} is recorded on {distinctDates.Count} different pay dates " +
                      $"({JoinWithAnd(distinctDates)}), to {it.Supplier}, totalling {Money(total)}.";
            }
            if (label.Contains("test 5"))
            {
                int n = sib.Count; var amt = it.Amount ?? 0m;
                return $"Transaction {it.TransactionId} lists the same {Money(amt)} payment {n} times in the published " +
                       $"file; the {n} lines together total {Money(amt * n)}.";
            }
        }
        if (it.Kind == EvidenceKind.CreditMatch)
        {
            var amt = Math.Abs(it.Amount ?? 0m);
            var date = it.PayDate ?? "an unpublished date";
            return it.Classification == "Unmatched"
                ? $"A refund of {Money(amt)} to {it.Supplier} on {date} has no matching published charge of the same " +
                  "amount from that supplier in the preceding/following 365 days."
                : $"A refund of {Money(amt)} to {it.Supplier} on {date} is matched by a same-supplier charge of the " +
                  "same amount elsewhere in the published data (see detail below).";
        }
        return "";
    }

    // Which evidence-table columns read as "matching" vs "differs" for a given test — derived from
    // the test number in its own label rather than stored per-row, since it's the same for every
    // row in that test. year/trans/paydate/amount/payee/desc are the column keys ColClass checks.
    (string[] Match, string[] Differ) GroupColsFor(TestGroup t) => t.Label switch
    {
        var l when l.Contains("test 3") => (new[] { "payee", "amount", "desc", "paydate" }, new[] { "trans" }),
        var l when l.Contains("test 4") => (new[] { "trans" }, new[] { "payee", "paydate" }),
        var l when l.Contains("test 5") => (new[] { "trans", "payee", "amount", "desc", "paydate", "year" }, Array.Empty<string>()),
        _ => (Array.Empty<string>(), Array.Empty<string>())
    };

    string ColClass(TestGroup t, string col)
    {
        var (match, differ) = GroupColsFor(t);
        return match.Contains(col) ? "ev-col-match" : differ.Contains(col) ? "ev-col-differ" : "";
    }

    string GroupEvidenceIntro(TestGroup t, int groupSize) => groupSize <= 1 ? "" : t.Label switch
    {
        var l when l.Contains("test 5") =>
            $"This exact line appears {groupSize:N0} times in the published file — every column below " +
            "matches, which is the point: it's the same line, repeated.",
        _ =>
            $"{groupSize:N0} rows share this evidence group — columns highlighted green match across all " +
            "of them, columns highlighted amber are where they differ."
    };

    void ToggleSelect(ExceptionItem it, bool on)
    {
        it.Selected = on;
        if (on) _selected[it.Key] = it; else _selected.Remove(it.Key);
    }

    async Task DownloadTest(TestGroup t)
    {
        var sb = new StringBuilder();
        sb.AppendLine("Year,TransactionNo,PayDate,Amount,Payee,ServiceArea,Description,ExceptionType");
        foreach (var it in t.Items)
        {
            sb.AppendLine(string.Join(",",
                Csv(it.SourceTag), Csv(it.TransactionId), Csv(it.PayDate ?? ""), it.Amount?.ToString("F2") ?? "",
                Csv(it.Supplier), Csv(it.ServiceArea ?? ""), Csv(it.Description ?? ""), it.Type.ToString()));
        }
        await JS.InvokeVoidAsync("analystDownload", SafeFileName(t.Label) + ".csv", sb.ToString(), "text/csv");
    }

    static string Csv(string s) => s.Contains(',') || s.Contains('"') || s.Contains('\n')
        ? "\"" + s.Replace("\"", "\"\"") + "\"" : s;
    static string SafeFileName(string s) => new string(s.Where(c => char.IsLetterOrDigit(c) || c is ' ' or '-').ToArray()).Replace(' ', '-');

    string BuildFoiLetter()
    {
        var sb = new StringBuilder();
        var name = string.IsNullOrWhiteSpace(_foiName) ? "[Your name]" : _foiName.Trim();
        sb.AppendLine(name);
        sb.AppendLine(DateTime.Now.ToString("d MMMM yyyy", CultureInfo.InvariantCulture));
        sb.AppendLine();
        sb.AppendLine("Freedom of Information request");
        sb.AppendLine();
        sb.AppendLine($"To: {_councilDisplayName} — Freedom of Information team");
        sb.AppendLine(_foiContactVerified
            ? $"{_foiContactEmail} ({_foiContactCheckedNote})"
            : "[VERIFY BEFORE SENDING: this council's Freedom of Information contact address has not been " +
              "hand-checked for this tool — find it on the council's own website before sending.]");
        sb.AppendLine();
        sb.AppendLine("Dear Sir or Madam,");
        sb.AppendLine();
        sb.AppendLine($"Under the Freedom of Information Act 2000, I am requesting the following records and " +
            $"information relating to {_councilDisplayName}'s published spending-over-£500 data.");
        sb.AppendLine();
        sb.AppendLine($"The items below were identified as exceptions by a set of mechanical tests run " +
            $"against {_councilDisplayName}'s own published spending data. An exception here is a fact " +
            "about the published numbers, not proof of an error or wrongdoing — I am asking for the " +
            "underlying records and the reason, not for an admission.");
        sb.AppendLine();

        // Each selected exception becomes ONE numbered item that bundles every published line
        // involved (every sibling sharing the same GroupKey for test 3/4/5; the single aggregate
        // row itself for test 1/2/R, which don't carry individual component lines once aggregated)
        // — a plain-English sentence generated from the actual values says what doesn't add up,
        // THEN the specific question. No offered explanation, no accusation — records and reasons
        // only, same as the rest of this letter.
        TestGroup? FindTestGroup(ExceptionItem it) => _tests.FirstOrDefault(tg => tg.Label == it.TestLabel);

        void Section(ExceptionType type, string heading, string definition, string request)
        {
            var items = _selected.Values.Where(i => i.Type == type).ToList();
            if (items.Count == 0) return;
            var bundles = items
                .GroupBy(i => i.GroupKey ?? $"{i.Council}|{i.SourceTag}|{i.TransactionId}")
                .OrderBy(g => g.Min(i => i.SourceTag), StringComparer.Ordinal)
                .ThenBy(g => g.Min(i => i.TransactionId), StringComparer.Ordinal)
                .ToList();
            sb.AppendLine($"{heading} ({definition}):");
            sb.AppendLine();
            int n = 0;
            foreach (var bundle in bundles)
            {
                n++;
                var first = bundle.First();
                var tg = FindTestGroup(first);
                var members = (tg is not null && first.GroupKey is not null ? GroupSiblings(tg, first) : bundle.ToList())
                    .DistinctBy(m => (m.Council, m.SourceTag, m.TransactionId, m.PayDate, m.Amount)).ToList();
                var sentence = tg is not null ? ExplainItem(tg, first) : "";
                sb.AppendLine($"{n}. {sentence}");
                foreach (var m in members)
                {
                    var line = $"   - {m.Council}, {m.SourceTag}, transaction {m.TransactionId}, " +
                        $"{m.PayDate ?? "no pay date published"}, {(m.Amount is { } a ? a.ToString("C2", GB) : "—")}, {m.Supplier}";
                    if (m.Kind == EvidenceKind.AmountCompare && m.CompareAmount is { } cmp)
                        line += $" (stated invoice amount {cmp.ToString("C2", GB)})";
                    sb.AppendLine(line);
                }
                sb.AppendLine($"   For this item, please provide: {request}");
                sb.AppendLine();
            }
        }

        Section(ExceptionType.Discrepancy, "Discrepancies", "the published record contradicts itself",
            "a copy of the invoice(s) and payment record(s) for the transaction, and the reason for the " +
            "difference between the invoice amount and the amount(s) paid, for the line being listed more " +
            "than once, or for more than one payee or pay date being recorded against the same transaction " +
            "number (whichever applies to the item).");
        Section(ExceptionType.Unreconciled, "Unreconciled items",
            "published payments do not cover the stated invoice amount, or a published credit/refund has no matching charge",
            "a copy of the invoice(s) and payment record(s) for the transaction (or, for a credit/refund row, the " +
            "record of the charge it relates to), and the reason the published figures don't reconcile.");
        Section(ExceptionType.Anomaly, "Anomalies", "the same supplier, amount, description and date recorded under different transaction numbers",
            "a copy of the invoice(s) and payment record(s) for each transaction number listed, and the " +
            "reason the same supplier, amount, description and date appear under more than one transaction number.");

        sb.AppendLine("I understand you are required to respond within 20 working days of receipt.");
        sb.AppendLine();
        if (_foiElectronic)
        {
            sb.AppendLine(string.IsNullOrWhiteSpace(_foiEmail)
                ? "I am happy to receive your response electronically."
                : $"I am happy to receive your response electronically, to {_foiEmail.Trim()}.");
        }
        else
        {
            sb.AppendLine("Please send your response by post.");
        }
        sb.AppendLine();
        sb.AppendLine("Yours faithfully,");
        sb.AppendLine();
        sb.AppendLine(name);
        if (!string.IsNullOrWhiteSpace(_foiEmail)) sb.AppendLine(_foiEmail.Trim());
        return sb.ToString();
    }

    async Task CopyFoi() => await JS.InvokeVoidAsync("copyText", BuildFoiLetter());
    async Task DownloadFoi() => await JS.InvokeVoidAsync("analystDownload", "foi-request.txt", BuildFoiLetter(), "text/plain");
}
