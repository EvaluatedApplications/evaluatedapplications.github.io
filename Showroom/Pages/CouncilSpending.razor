            <details class="retrieved">
                <summary>Files retrieved @h.RetrievedOn (@h.Periods.Count@(h.Key == "reading" ? " of 64 published" : ""))</summary>
                <ul>
                    @foreach (var y in h.Periods)
                    {
                        <li><span class="year-tag">@y.Tag</span>
                            @if (!string.IsNullOrEmpty(y.Url))
