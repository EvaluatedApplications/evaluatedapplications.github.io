    void ResolveReport(int reportId, bool removeListing)
    {
        var r = _reports.FirstOrDefault(x => x.Id == reportId);
        if (r is null || r.Status != "Open") return;
        r.Status = removeListing ? "Actioned" : "Dismissed";
        if (removeListing)
        {
            var l = L(r.ListingId);
            if (l is not null) { l.Status = "Removed"; _watch.Remove(l.Id); }
            _flash = "Listing removed from the marketplace. No RCYT was involved either way.";
        }
        else
        {
            _flash = "Report dismissed — the listing stays live.";
        }
    }

