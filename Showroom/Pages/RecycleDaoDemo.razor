    // ─────────────────────────────────────────────────────────────────────────────────────────────
    // SMALL HELPERS
    // ─────────────────────────────────────────────────────────────────────────────────────────────
    static string Truncate(string s, int n) => string.IsNullOrEmpty(s) ? "" : (s.Length <= n ? s : s.Substring(0, n - 1) + "…");

    static string StatusClass(string status) => status switch
    {
        "Verified" => "ok",
        "Rejected" => "bad",
        _ => "pending",
    };

    static string OrderClass(string status) => status switch
    {
        "Collected" => "ok",
        "Cancelled" => "bad",
        _ => "pending",
    };

    static string ListingClass(string status) => status switch
    {
        "Active" => "ok",
        "Reserved" => "pending",
        _ => "bad",
    };

    static string LedClass(string kind) => kind switch
    {
        "Mint" => "ok",
        "Sale" => "ok",
        "Refund" => "ok",
        "Hold" => "pending",
        _ => "pending",
    };

    static string Initials(string name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpperInvariant();
        return (parts[0].Substring(0, 1) + parts[^1].Substring(0, 1)).ToUpperInvariant();
    }

    static string FirstName(string name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0 ? "them" : parts[0];
    }

    static string Ago(DateTime t)
    {
        var d = DateTime.Now - t;
        if (d.TotalSeconds < 60) return "just now";
        if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes} min ago";
        if (d.TotalHours < 24) return $"{(int)d.TotalHours} h ago";
        return $"{(int)d.TotalDays} d ago";
    }

    static string LevelName(int minted)
    {
        var name = Levels[0].Name;
        foreach (var l in Levels) if (minted >= l.At) name = l.Name;
        return name;
    }

    static int? NextLevelAt(int minted)
    {
        foreach (var l in Levels) if (minted < l.At) return l.At;
        return null;
    }

    static string NextLevelName(int minted)
    {
        foreach (var l in Levels) if (minted < l.At) return l.Name;
        return Levels[^1].Name;
    }

    static int LevelPct(int minted)
    {
        var next = NextLevelAt(minted);
        if (next is null) return 100;
        var prev = 0;
        foreach (var l in Levels) if (minted >= l.At) prev = l.At;
        var span = next.Value - prev;
        return span <= 0 ? 100 : Math.Clamp((int)Math.Round(100.0 * (minted - prev) / span), 2, 100);
    }

