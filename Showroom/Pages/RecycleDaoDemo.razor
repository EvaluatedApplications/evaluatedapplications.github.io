        // Seeded, already-approved history for you. Deliberately routed through MintForApproval so the
        // opening balance is explained line-by-line in the mint log and ledger rather than assigned.
        void SeedApproved(string type, string desc, double hoursAgo)
        {
            var s = new Submission
            {
                Id = _nextSubId++, ItemType = type, Description = desc, SubmitterId = 0,
                SubmittedAt = now.AddHours(-hoursAgo), Status = "Pending",
            };
            _allSubmissions.Add(s);
            MintForApproval(s, now.AddHours(-hoursAgo + 0.5));
        }

        SeedApproved("Electronics / E-waste", "Old router and two set-top boxes to the council WEEE point", 96);
