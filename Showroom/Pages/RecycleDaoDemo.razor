    void PostListing()
    {
        var title = (_sellTitle ?? "").Trim();
        var desc = (_sellDesc ?? "").Trim();
        var qty = (_sellQty ?? "").Trim();
        if (title.Length < 4 || title.Length > 80) { _err = "Title must be 4-80 characters."; return; }
        if (qty.Length == 0) { _err = "Say how much there is (e.g. \"8 kg\" or \"60 items\")."; return; }
        if (desc.Length < 10 || desc.Length > 600) { _err = "Description must be 10-600 characters."; return; }
        if (_sellPrice < 0 || _sellPrice > 9999) { _err = "Price must be between 0 and 9999 RCYT."; return; }

        var l = _sellEditId is int eid ? L(eid) : null;
        var isNew = l is null;
        if (isNew)
        {
            l = new Listing { Id = _nextListingId++, SellerId = 0, PostedAt = DateTime.Now, Status = "Active" };
            _listings.Add(l);
        }
        l!.Kind = _sellKind;
        l.Title = title;
        l.Cat = _sellCat;
        l.Condition = _sellCond;
        l.Qty = qty;
        l.Price = _sellPrice;
        l.Location = _sellLoc;
        l.Collection = _sellCollect;
        l.Description = desc;
        l.FromSubmissionId = _sellFromSub == 0 ? null : _sellFromSub;
        l.Specifics = new List<(string, string)>
        {
            ("Material", _sellCat),
            ("Condition", _sellCond),
            ("Quantity", qty),
            ("Collection", _sellCollect),
            ("Listed by", You.Name),
            ("Provenance", _sellFromSub == 0 ? "not linked to a verified submission" : $"verified submission #{_sellFromSub}"),
        };

        // Posting a listing does NOT touch the wallet in any way — no mint, no fee, no deduction.
        _err = null;
        _flash = isNew ? $"Published “{Truncate(title, 40)}” — it's live in {l.Cat} now." : "Listing updated.";
        Notify("▤", isNew ? $"Your listing “{Truncate(title, 34)}” is live." : $"Listing #{l.Id} updated.", Screen.Listing, l.Id);
        _sellEditId = null;
        Go(Screen.Listing, l.Id);
    }

    void EndListing(int id)
    {
        var l = L(id);
        if (l is null || l.SellerId != 0 || l.Status != "Active") return;
        l.Status = "Ended";
        _flash = $"Ended “{Truncate(l.Title, 40)}”. It no longer appears in search.";
    }

    // Clearly-labelled DEMO CONTROL (marked as such in the UI): invents a counterparty so the seller
    // side of the flow can be walked. It creates an Order — the same Order type the buyer flow uses —
    // and never touches the mint path, so total supply is unaffected.
    readonly Random _rng = new(20260826);
    void SimulateBuyer(int listingId)
    {
        var l = L(listingId);
        if (l is null || l.SellerId != 0 || l.Status != "Active") return;
        var candidates = _people.Where(p => p.Id != 0).ToList();
        var buyer = candidates[_rng.Next(candidates.Count)];
        var now = DateTime.Now;
        var o = new Order
        {
            Id = _nextOrderId++,
            ListingId = l.Id,
            BuyerId = buyer.Id,
            SellerId = 0,
            Price = l.Price,
            PlacedAt = now,
            Status = "Reserved",
            Method = l.Collection,
            Note = "(simulated buyer — this prototype has no other real users)",
        };
        o.Steps.Add((now, $"{buyer.Name} claimed your listing (simulated demo action)."));
        if (l.Price > 0) o.Steps.Add((now, $"{l.Price} RCYT held in their escrow, payable to you on collection."));
        _orders.Add(o);
        l.Status = "Reserved";
        Notify("▣", $"{buyer.Name} claimed “{Truncate(l.Title, 34)}” (simulated).", Screen.OrderDetail, o.Id);
        _flash = $"Simulated: {buyer.Name} claimed your listing. Mark it collected on the order page to receive the RCYT.";
        Go(Screen.OrderDetail, o.Id);
    }

