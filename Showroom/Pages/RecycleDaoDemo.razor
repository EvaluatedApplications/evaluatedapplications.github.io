    void PlaceOrder(int listingId)
    {
        var l = L(listingId);
        if (l is null || l.Status != "Active") { _err = "That listing isn't available any more."; return; }
        if (l.SellerId == 0) { _err = "You can't claim your own listing."; return; }
        if (l.Price > _balance) { _err = $"Not enough RCYT — you're {l.Price - _balance} short."; return; }

        var now = DateTime.Now;
        var o = new Order
        {
            Id = _nextOrderId++,
            ListingId = l.Id,
            BuyerId = 0,
            SellerId = l.SellerId,
            Price = l.Price,
            PlacedAt = now,
            Status = "Reserved",
            Method = _coMethod,
            Note = (_coNote ?? "").Trim(),
        };
        o.Steps.Add((now, $"Claim placed by you — listing reserved."));
        if (l.Price > 0)
        {
            _balance -= l.Price;
            _escrow += l.Price;
            _ledger.Insert(0, new Led { At = now, Kind = "Hold", Delta = -l.Price, Text = $"Held in escrow for order #{o.Id} — {Truncate(l.Title, 34)}", Ref = $"ORD-{o.Id:D4}" });
            o.Steps.Add((now, $"{l.Price} RCYT moved from your balance into escrow."));
        }
        else
        {
            o.Steps.Add((now, "Free to collect — no RCYT involved."));
        }
        l.Status = "Reserved";
        _orders.Add(o);
        _coNote = "";
        Notify("▣", $"Order #{o.Id} placed — {Truncate(l.Title, 40)} is reserved for you.", Screen.OrderDetail, o.Id);
        Go(Screen.OrderPlaced, o.Id);
    }

    void ConfirmCollected(int orderId)
    {
        var o = O(orderId);
        if (o is null || o.Status != "Reserved") return;
        var now = DateTime.Now;
        var l = L(o.ListingId);
        o.Status = "Collected";
        if (l is not null) l.Status = "Collected";

        if (o.BuyerId == 0 && o.Price > 0)
        {
            _escrow -= o.Price;
            _ledger.Insert(0, new Led { At = now, Kind = "Release", Delta = 0, Text = $"Escrow released to {P(o.SellerId).Name} — order #{o.Id}", Ref = $"ORD-{o.Id:D4}" });
            o.Steps.Add((now, $"Collection confirmed — {o.Price} RCYT released from escrow to {P(o.SellerId).Name}."));
            _flash = $"Collection confirmed. {o.Price} RCYT released to {P(o.SellerId).Name}. No tokens were created or destroyed — they moved.";
        }
        else if (o.SellerId == 0 && o.Price > 0)
        {
            _balance += o.Price;
            _ledger.Insert(0, new Led { At = now, Kind = "Sale", Delta = o.Price, Text = $"Sale of {Truncate(l?.Title ?? "listing", 34)} — order #{o.Id}", Ref = $"ORD-{o.Id:D4}" });
            o.Steps.Add((now, $"Collection confirmed — you received {o.Price} RCYT from {P(o.BuyerId).Name}."));
            _flash = $"Marked collected. You received {o.Price} RCYT — a transfer from the buyer, not a mint; total supply is unchanged.";
        }
        else
        {
            o.Steps.Add((now, "Collection confirmed — free item, no RCYT moved."));
            _flash = "Marked collected. It was free, so no RCYT moved.";
        }
        Notify("✓", $"Order #{o.Id} completed.", Screen.OrderDetail, o.Id);
    }

    void CancelOrder(int orderId)
    {
        var o = O(orderId);
        if (o is null || o.Status != "Reserved") return;
        var now = DateTime.Now;
        var l = L(o.ListingId);
        o.Status = "Cancelled";
        if (l is not null && l.Status == "Reserved") l.Status = "Active";

        if (o.BuyerId == 0 && o.Price > 0)
        {
            _escrow -= o.Price;
            _balance += o.Price;
            _ledger.Insert(0, new Led { At = now, Kind = "Refund", Delta = o.Price, Text = $"Escrow returned — order #{o.Id} cancelled", Ref = $"ORD-{o.Id:D4}" });
            o.Steps.Add((now, $"Cancelled — {o.Price} RCYT returned from escrow to your balance."));
        }
        else
        {
            o.Steps.Add((now, "Cancelled — the listing is available again."));
        }
        _flash = $"Order #{o.Id} cancelled.";
        Notify("↺", $"Order #{o.Id} was cancelled.", Screen.OrderDetail, o.Id);
    }

    string OrderMoneyBlurb(Order o)
    {
        if (o.Price == 0) return "Free to collect — no RCYT moves at any point in this order.";
        return o.Status switch
        {
            "Reserved" when o.BuyerId == 0 => $"{o.Price} RCYT is held in escrow. It goes to {P(o.SellerId).Name} when you confirm collection, or back to you if you cancel.",
            "Reserved" => $"{o.Price} RCYT is held by the buyer's escrow. It reaches you when the collection is confirmed.",
            "Collected" when o.BuyerId == 0 => $"{o.Price} RCYT was released from escrow to {P(o.SellerId).Name}.",
            "Collected" => $"You received {o.Price} RCYT from {P(o.BuyerId).Name}. A transfer, not a mint.",
            _ => o.BuyerId == 0 ? $"{o.Price} RCYT was returned to your balance." : "No RCYT changed hands.",
        };
    }

