@page "/dashboard"
@attribute [BlazierPage("dashboard", Title = "The Dashboard — a live database dashboard in your browser", Layout = typeof(MainLayout), Static = true)]
@inject IBuildTime Build
@using Showroom.Services

<PageTitle>The Dashboard — a live database dashboard in your browser</PageTitle>

<div class="room dash" data-cat="holodb">
    <header class="room-head">
        <nav class="crumb"><a href="/holodb/">HoloDb</a> <span>/</span> The Dashboard</nav>
        <h1>The Dashboard</h1>
        <p class="lede">A dashboard over a database of orders that <strong>lives inside this browser tab</strong>. Pick how many rows, build it,
            then click any chart: every other panel re-asks the database, and the page shows what each question cost <strong>on your device</strong>.
            No server, no upload.</p>
        <div class="badges">
            <span>Runs in your tab</span><span>Nothing leaves your device</span><span>Real SQL, not a mock</span><span>Your own timings</span>
        </div>
    </header>

    @if (Build.IsPrerender)
    {
        <ToolStart Tool="The Dashboard" Label="Start the dashboard" />
    }
    else
    {
        <LoadPanel S="_s" />
        @if (_s.Ready)
        {
            <p class="sr-only" aria-live="polite">@_s.Announce</p>
            <h2 class="sec">The dashboard</h2>
            <FilterBar S="_s" />
            <Tiles S="_s" />
            <div class="grid">
                <MonthChart S="_s" />
                <BarList S="_s" Dim="region" Title="Revenue by region" Singular="Region" Universe="@OrdersDemo.OrdersGenerator.Regions" Ranked="true" />
                <BarList S="_s" Dim="category" Title="Revenue by category" Singular="Category" Universe="@OrdersDemo.OrdersGenerator.Categories" Ranked="true" />
                <BarList S="_s" Dim="status" Title="Orders by status" Singular="Status" Universe="@OrdersDemo.OrdersGenerator.Statuses" />
                <TopTables S="_s" />
            </div>
            <div class="stack">
                <LatencyPanel S="_s" />
                <CodePanel S="_s" />
            </div>
        }
    }

    <div class="outro">
        <p>This runs on <a href="/holodb/">HoloDb</a>, the embeddable .NET SQL engine, compiled to WebAssembly. The totals and the region, category, status and month
            panels are answered by its Pleroma aggregate plane; the top customers and the largest orders are answered by its column scans. Each panel is tagged with the route
            HoloDb reported and the time this tab measured. The table is generated here from a fixed seed, so a console app that runs the code above builds the same rows.</p>
    </div>
</div>

@code {
    readonly DashboardSession _s = new();

    protected override void OnInitialized()
    {
        if (Build.IsPrerender) return;
        _s.Repaint = async () => { await InvokeAsync(StateHasChanged); await Task.Delay(1); };   // the delay lets the browser paint between stages
    }
}
