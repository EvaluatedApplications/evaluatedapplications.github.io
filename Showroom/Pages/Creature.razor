@page "/creature"
@using System.Text
@using PrismFormer
@using Tracer.Helpers

<PageTitle>The Creature — a brain that learns to forage</PageTitle>

<div class="room">
    <header class="room-head">
        <nav class="crumb"><a href="/holodb/">Evaluated Applications</a> <span>/</span> The Creature</nav>
        <h1>The Creature</h1>
        <p class="lede">Scatter some apples, then watch a small creature learn to forage — <strong>in your browser, on
            your machine</strong>. Its brain is a <strong>holographic transformer</strong> (AlgFormer); its sense of where
            food is comes from our pathfinder (Tracer), which measures how far each cell is from the nearest apple. At every
            step it learns the <em>decisive</em> move toward food — weighted by how much it beats just drifting — so it
            commits to eating instead of lingering where the scent is strong.</p>
        <div class="badges">
            <span>Holographic-transformer brain</span><span>Tracer distance field</span><span>Learns live, on your device</span>
        </div>
    </header>

    <div class="cr-tools">
        <div class="tool-group">
            <span class="tool-lbl">draw</span>
            <button class="tool @(_tool == "wall" ? "on" : "")" @onclick='() => _tool = "wall"' type="button">🧱 wall</button>
            <button class="tool @(_tool == "erase" ? "on" : "")" @onclick='() => _tool = "erase"' type="button">⌫ erase</button>
            <button class="tool @(_tool == "start" ? "on" : "")" @onclick='() => _tool = "start"' type="button">🥚 start</button>
            <button class="tool @(_tool == "apple" ? "on" : "")" @onclick='() => _tool = "apple"' type="button">🍎 apple</button>
        </div>
        <div class="tool-group">
            <button class="tool ghost" @onclick="ClearWalls" type="button">clear walls</button>
            <button class="tool ghost" @onclick="Scatter" type="button">scatter apples</button>
            <button class="tool ghost @(_showScent ? "on" : "")" @onclick="ToggleScent" type="button">show scent</button>
        </div>
    </div>

    <div class="cr-stage" @onmouseup="StopPaint" @onmouseleave="StopPaint">
        <svg class="cr-grid" viewBox="0 0 @(W * CS) @(H * CS)" role="img" aria-label="creature world">
            @for (int y = 0; y < H; y++)
            {
                @for (int x = 0; x < W; x++)
                {
                    int gx = x, gy = y;
                    <rect class="cell @(_wall[gy * W + gx] ? "wall" : "")" x="@(gx * CS)" y="@(gy * CS)" width="@CS" height="@CS"
                          @onmousedown="() => Paint(gx, gy, true)" @onmouseenter="() => Paint(gx, gy, false)" />
                    @if (_showScent && !_wall[gy * W + gx]) { @ScentTint(gx, gy) }
                }
            }
            @if (_trail.Count > 1)
            {
                <polyline class="trail" points="@PathPoints(_trail)" />
            }
            @if (_hasStart)
            {
                <rect class="startmark" x="@(_startX * CS + 3)" y="@(_startY * CS + 3)" width="@(CS - 6)" height="@(CS - 6)" rx="3" />
            }
            @foreach (var ap in _apples)
            {
                @Glyph(ap % W, ap / W, "food", "🍎")
            }
            @Glyph(_cx, _cy, "critter", _running ? "🐛" : "🥚")
        </svg>
    </div>

    @if (_error is not null) { <p class="err">@_error</p> }

    <div class="cr-controls">
        <button class="go" @onclick="ToggleRun" disabled="@(!CanRun)">@(_running ? "Pause" : "Let it forage")</button>
        <button class="ghost" @onclick="ResetBrain" type="button">Reset brain</button>
        <label class="speed">speed
            <input type="range" min="1" max="10" @bind="_speed" @bind:event="oninput" />
        </label>
        @if (!CanRun) { <span class="hint">Place a 🥚 start and at least one 🍎 apple (or hit “scatter apples”).</span> }
    </div>

    @if (_episode > 0 || _running)
    {
        <div class="cr-stats">
            <div class="stat"><div class="n">@_episode</div><div class="l">episodes</div></div>
            <div class="stat"><div class="n">@_lastEaten / @_applesInit.Count</div><div class="l">apples last run</div></div>
            <div class="stat"><div class="n">@(_bestEaten > 0 ? _bestEaten.ToString() : "—")</div><div class="l">best haul</div></div>
            <div class="stat"><div class="n">@((_eps * 100).ToString("F0"))%</div><div class="l">still exploring</div></div>
        </div>
        <figure class="cr-curve">
            <figcaption>apples eaten per episode — it should rise as the brain learns the scent</figcaption>
            @if (_curve.Count > 1) { @((MarkupString)CurveSvg()) }
        </figure>
    }

    @if (_log.Count > 0)
    {
        <div class="cr-log">
            <div class="log-head">training log <span class="log-sub">newest first · loss backpropped through the @KPass weight-tied passes</span></div>
            <div class="log-body">
                @foreach (var line in _log) { <div class="log-line">@line</div> }
            </div>
        </div>
    }

    <div class="outro">
        <p><strong>What makes the brain unusual.</strong> A conventional transformer scores every token against every
            other through softmax attention — an N×N matrix. <code>AlgFormer</code> is <em>holographic</em>: it
            <em>binds</em> each step to a role vector and <em>bundles</em> the whole trajectory into one fixed-size
            hologram, then <em>unbinds</em> that hologram to read it back — phase carries the meaning, magnitude carries
            the confidence. Attention becomes vector algebra: O(context), not O(context²), and small enough to learn
            <em>online, in a browser tab</em>. It is the very same holographic idea that lets
            <a href="/holodb/">HoloDb</a> hold a database's running total as a single vector — one substrate, whether it
            is storing data or thinking.</p>
        <p>The brain is <code>AlgFormer</code>'s holographic transformer — one layer applied twice weight-tied, learning
            online through the recurrence; the distance field is <code>Tracer</code>. Both are pure managed .NET running
            client-side. <code>dotnet add package EvaluatedApplications.AlgFormer</code></p>
    </div>
</div>

@code {
    const int W = 20, H = 20, CS = 26;
    // brain shape: L=1 with a weight-tied extra pass (Iters=K), a focused recent-trajectory window, and shifts pegged to it (HoloShape).
    // MaxCtx 128->32 (measured headless in CreatureLab over many worlds): a long window DILUTES the decisive signal — the current
    // cell (the last token) — across scores of stale positions, so the brain learns the scent slower AND pays ~4x the compute per
    // step. A 32-cell window keeps enough recent history to disambiguate which apples remain, without the dilution: it reaches a
    // full 8/8 haul in every test world (last-20 avg ~5.9 -> ~7.6 apples) and converges by ~episode 40 instead of still climbing.
    const int MaxCtx = 32;   // focused recent-trajectory window — fed up to this; shifts align to it (bindRank = shifts·d/2)
    const int KPass = 2;      // 1 layer applied K times, weight-tied (the "extra k-layer pass")
    const int DModel = 256;   // PhasorLayout.Dim
    const int NApples = 8;    // how many apples "scatter" drops
    const int StepBudget = 150;   // steps per foraging episode
    const int EatReward = 3;      // extra advantage for landing on an apple (on top of the +1 for getting closer)
    static readonly int[] DX = { 0, 1, 1, 1, 0, -1, -1, -1 };
    static readonly int[] DY = { -1, -1, 0, 1, 1, 1, 0, -1 };

    bool[] _wall = new bool[W * H];
    int _startX = W / 2, _startY = H / 2;
    bool _hasStart = true;
    readonly HashSet<int> _applesInit = new();   // the placed apples (respawned each episode)
    readonly HashSet<int> _apples = new();        // the live apples this episode
    int[] _dist = new int[W * H];                 // Tracer BFS distance to the nearest live apple (int.MaxValue = unreachable)
    string _tool = "apple";
    bool _painting;

    // creature + episode state
    int _cx, _cy, _steps, _eaten, _lastEaten, _bestEaten;
    int _episode;
    double _eps = 0.7;
    readonly List<int> _ctxWin = new();                 // the trajectory this episode (fed as context)
    // (context, target action, advantage weight) — an advantage-weighted training target per informative step
    readonly List<(int[] ctx, int target, double weight)> _epExp = new();
    readonly List<(int x, int y)> _trail = new();
    readonly List<int> _curve = new();                  // apples eaten per episode
    readonly List<string> _log = new();
    void Log(string s) { _log.Insert(0, s); if (_log.Count > 250) _log.RemoveAt(_log.Count - 1); }

    // brain (holographic transformer) + wandering RNG
    HoloFormer? _brain;
    int _actionBase => W * H;
    readonly Random _rng = new();

    bool _running;
    int _speed = 5;
    bool _showScent;
    string? _error;

    bool CanRun => _hasStart && _applesInit.Count > 0;

    protected override void OnInitialized()
    {
        _cx = _startX; _cy = _startY;
        Scatter();   // start with something to forage
    }

    // ---- world editing ----
    void Paint(int x, int y, bool down)
    {
        if (down) _painting = true;
        if (!down && !_painting) return;
        if (_running) return;
        int i = y * W + x;
        switch (_tool)
        {
            case "wall": if (i != _startY * W + _startX) { _wall[i] = true; _applesInit.Remove(i); } break;
            case "erase": _wall[i] = false; break;
            case "start": if (!_wall[i]) { _startX = x; _startY = y; _hasStart = true; _cx = x; _cy = y; _applesInit.Remove(i); } break;
            case "apple": if (!_wall[i]) { if (!_applesInit.Add(i)) _applesInit.Remove(i); } break;   // toggle
        }
        if (_tool == "start") _painting = false;
        InvalidateOnEdit();
    }
    void StopPaint() => _painting = false;

    void ClearWalls() { if (_running) return; Array.Clear(_wall); InvalidateOnEdit(); }

    void Scatter()
    {
        if (_running) return;
        _applesInit.Clear();
        int guard = 0;
        while (_applesInit.Count < NApples && guard++ < 4000)
        {
            int x = _rng.Next(W), y = _rng.Next(H), i = y * W + x;
            if (_wall[i] || (x == _startX && y == _startY)) continue;
            _applesInit.Add(i);
        }
        InvalidateOnEdit();
    }

    void InvalidateOnEdit()
    {
        // a changed world resets the run stats so improvement stays honest (the brain carries over; ε re-opens)
        _episode = 0; _lastEaten = 0; _bestEaten = 0; _eps = 0.7; _curve.Clear(); _trail.Clear();
        _epExp.Clear(); _ctxWin.Clear();
        _apples.Clear(); foreach (var a in _applesInit) _apples.Add(a);
        _cx = _startX; _cy = _startY; _eaten = 0;
        ComputeDist();
        StateHasChanged();
    }

    // ---- passability + the Tracer distance field ----
    bool Passable(int x, int y) => x >= 0 && y >= 0 && x < W && y < H && !_wall[y * W + x];

    void ComputeDist()
    {
        for (int i = 0; i < W * H; i++) _dist[i] = int.MaxValue;
        foreach (var ap in _apples)
        {
            int ax = ap % W, ay = ap / W;
            foreach (var kv in GridTactics.Reachable(ax, ay, W * H, Passable, diagonals: true))   // Tracer BFS from this apple
            {
                int c = kv.Key.Y * W + kv.Key.X;
                if (kv.Value < _dist[c]) _dist[c] = kv.Value;
            }
            _dist[ap] = 0;
        }
    }

    // ---- the loop ----
    bool CanMove(int act) => CanMoveFrom(_cx, _cy, act);
    bool CanMoveFrom(int x, int y, int act)
    {
        int nx = x + DX[act], ny = y + DY[act];
        if (!Passable(nx, ny)) return false;
        if (DX[act] != 0 && DY[act] != 0 && (!Passable(x + DX[act], y) || !Passable(x, y + DY[act]))) return false;   // no corner cutting
        return true;
    }

    // The dense oracle from the Tracer field: the advantage of every legal move at (x,y) — how much
    // closer to an apple it gets (+ a bonus for eating one). Returns the best move, its advantage, the
    // mean over legal moves (the baseline), and the per-action advantages. Illegal moves = -inf.
    (int bestAct, double bestAdv, double meanAdv, double[] adv) Advantages(int x, int y, int prevDist)
    {
        var adv = new double[8];
        double sum = 0; int nLegal = 0, bestAct = -1; double bestAdv = double.NegativeInfinity;
        for (int a = 0; a < 8; a++)
        {
            if (!CanMoveFrom(x, y, a)) { adv[a] = double.NegativeInfinity; continue; }
            int nc = (y + DY[a]) * W + (x + DX[a]);
            bool apple = _apples.Contains(nc);
            int nd = apple ? 0 : _dist[nc];
            double av = (prevDist == int.MaxValue || nd == int.MaxValue) ? 0 : (prevDist - nd) + (apple ? EatReward : 0);
            adv[a] = av; sum += av; nLegal++;
            if (av > bestAdv) { bestAdv = av; bestAct = a; }
        }
        return (bestAct, bestAdv, nLegal > 0 ? sum / nLegal : 0, adv);
    }

    int PickAction(int[] ctx)
    {
        // Never CHOOSE to walk into a wall or off-grid: pick the best (or, when exploring, a random) move among the
        // LEGAL ones. Before this, the brain took the global argmax and Step() silently refused an illegal move — so a
        // wall the player just dropped in the path made the creature freeze and burn the turn. Masking routes it around
        // the obstacle instead (the Tracer oracle already re-plans through the gap, and editing walls re-opens exploration).
        if (_brain is null || _rng.NextDouble() < _eps) return RandomLegalMove();
        var lg = _brain.LogitsFor(ctx);            // LogitsFor honours Iters (the k-pass) at serve time
        int best = -1; double bv = double.NegativeInfinity;
        for (int a = 0; a < 8; a++)
        {
            if (!CanMove(a)) continue;
            double v = lg[_actionBase + a]; if (v > bv) { bv = v; best = a; }
        }
        return best >= 0 ? best : RandomLegalMove();
    }

    int RandomLegalMove()
    {
        Span<int> legal = stackalloc int[8]; int n = 0;
        for (int a = 0; a < 8; a++) if (CanMove(a)) legal[n++] = a;
        return n > 0 ? legal[_rng.Next(n)] : _rng.Next(8);   // boxed in on all sides: any move (all no-ops) is equal
    }

    void Step()
    {
        int cell = _cy * W + _cx;
        _ctxWin.Add(cell); if (_ctxWin.Count > MaxCtx) _ctxWin.RemoveAt(0);
        int[] ctx = _ctxWin.ToArray();             // the full trajectory so far (capped at the model's maxContext)

        int prevDist = _dist[cell];
        var (bestAct, bestAdv, meanAdv, _) = Advantages(_cx, _cy, prevDist);
        int act = PickAction(ctx);                 // the BRAIN decides every move (ε-greedy exploration)

        // Advantage-weighted target: train toward the DECISIVE move — the best apple-ward step here
        // (the Tracer oracle), weighted by how much it beats the average move. This is what stops the
        // creature lingering in the scent: it's taught to commit to eating, not to hover where food is.
        if (bestAct >= 0 && bestAdv > meanAdv + 1e-6)
            _epExp.Add((ctx, bestAct, bestAdv - meanAdv));

        if (CanMove(act)) { _cx += DX[act]; _cy += DY[act]; }
        bool ate = _apples.Remove(_cy * W + _cx);
        if (ate) { _eaten++; ComputeDist(); }      // apples changed → refresh the field
        _steps++;
        _trail.Add((_cx, _cy)); if (_trail.Count > 400) _trail.RemoveAt(0);

        if (_apples.Count == 0 || _steps >= StepBudget) EndEpisode();
    }

    void EndEpisode()
    {
        _lastEaten = _eaten;
        _curve.Add(_eaten); if (_curve.Count > 60) _curve.RemoveAt(0);
        if (_brain is not null && _epExp.Count > 0)
        {
            bool best = _eaten > _bestEaten;
            if (best) _bestEaten = _eaten;
            double baseLr = best ? 4e-3 : 2.5e-3;
            double maxW = 1e-9; foreach (var e in _epExp) if (e.weight > maxW) maxW = e.weight;
            double sum = 0; int n = 0;
            foreach (var (ctx, target, weight) in _epExp)
            {
                double w = Math.Clamp(weight / maxW, 0.2, 1.0);   // advantage-normalized learning rate per step
                sum += KTrain(ctx, _actionBase + target, baseLr * w); n++;
            }
            Log($"ep {_episode + 1,3}   ate {_eaten,2}/{_applesInit.Count,-2}   advantage-trained {n,3} steps   loss {(n > 0 ? sum / n : 0):F3}   lr {baseLr:F4}   ε {_eps * 100:F0}%{(best ? "   ★ best haul" : "")}");
        }
        else if (_brain is not null)
        {
            Log($"ep {_episode + 1,3}   ate {_eaten,2}/{_applesInit.Count,-2}   no scent to learn from      ε {_eps * 100:F0}%");
        }
        _episode++;
        _eps = Math.Max(0.05, _eps * 0.95);
        // respawn apples + reset the creature
        _apples.Clear(); foreach (var a in _applesInit) _apples.Add(a);
        ComputeDist();
        _cx = _startX; _cy = _startY; _steps = 0; _eaten = 0; _epExp.Clear(); _trail.Clear(); _ctxWin.Clear();
    }

    // one online gradient step, backpropagated through the K weight-tied passes (α=1 = the extra pass fully on); returns the loss
    double KTrain(int[] ctx, int target, double lr)
    {
        var g = _brain!.NewGrads();
        double loss = _brain.IterAccumulate(ctx, target, g, KPass, 1.0);
        _brain.Step(g, lr);
        return loss;
    }

    async Task ToggleRun()
    {
        if (_running) { _running = false; return; }
        if (!CanRun) return;
        if (_brain is null)
        {
            int shifts = HoloShape.ShiftsFor(MaxCtx, DModel);   // aligned: bindRank = shifts·d/2 keeps a full context in the clean window
            _brain = new HoloFormer(W * H + 8, shifts: shifts, layers: 1, maxContext: MaxCtx, dModel: DModel, frozenPrefix: 64)
            {
                Iters = KPass,          // apply the single layer K times, weight-tied
                IterAlphaServe = 1      // extra pass fully on at serve (matches training α)
            };
            Log($"brain ready · L=1 · K={KPass} weight-tied passes · ctx={MaxCtx} · shifts={shifts} (pegged) · d={DModel} · vocab={W * H + 8} · {_brain.ParamCount:N0} params");
        }
        _running = true;
        _apples.Clear(); foreach (var a in _applesInit) _apples.Add(a); ComputeDist();
        _cx = _startX; _cy = _startY; _steps = 0; _eaten = 0; _epExp.Clear(); _ctxWin.Clear(); _trail.Clear();
        try
        {
            while (_running)
            {
                int burst = _speed;
                for (int b = 0; b < burst && _running; b++) Step();
                StateHasChanged();
                await Task.Delay(Math.Max(16, 120 - _speed * 10));
            }
        }
        catch (Exception ex) { _error = "The creature stumbled: " + ex.Message; _running = false; StateHasChanged(); }
    }

    void ResetBrain()
    {
        _brain = null; _log.Clear();
        InvalidateOnEdit();
    }

    void ToggleScent() { _showScent = !_showScent; StateHasChanged(); }

    // ---- rendering helpers ----
    MarkupString Glyph(int cx, int cy, string cls, string ch)
        => (MarkupString)$"<text class=\"{cls}\" x=\"{cx * CS + CS / 2}\" y=\"{cy * CS + CS - 4}\" text-anchor=\"middle\">{ch}</text>";

    // a faint tint per cell showing the Tracer distance field (brighter = closer to an apple) — what the creature learns toward
    MarkupString ScentTint(int x, int y)
    {
        int d = _dist[y * W + x];
        if (d == int.MaxValue) return (MarkupString)"";
        double closeness = 1.0 / (1.0 + d);   // 1 at an apple, fading with distance
        double op = 0.05 + 0.55 * closeness;
        return (MarkupString)$"<rect class=\"scent\" x=\"{x * CS}\" y=\"{y * CS}\" width=\"{CS}\" height=\"{CS}\" opacity=\"{op.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}\"/>";
    }

    string PathPoints(List<(int x, int y)> p)
    {
        var sb = new StringBuilder();
        foreach (var (x, y) in p) sb.Append(x * CS + CS / 2).Append(',').Append(y * CS + CS / 2).Append(' ');
        return sb.ToString();
    }

    string CurveSvg()
    {
        if (_curve.Count < 2) return "";
        int w = 640, h = 90, n = _curve.Count;
        double max = _curve.Max(), min = _curve.Min(); if (max <= min) max = min + 1;
        var sb = new StringBuilder();
        sb.Append($"<svg viewBox=\"0 0 {w} {h}\" preserveAspectRatio=\"none\" class=\"curve-svg\">");
        var pts = new StringBuilder();
        for (int i = 0; i < n; i++)
        {
            double px = n == 1 ? 0 : (double)i / (n - 1) * w;
            double py = h - 6 - (_curve[i] - min) / (max - min) * (h - 12);
            pts.Append(px.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)).Append(',').Append(py.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)).Append(' ');
        }
        sb.Append($"<polyline class=\"curve-line\" points=\"{pts}\"/>");
        sb.Append("</svg>");
        return sb.ToString();
    }
}
