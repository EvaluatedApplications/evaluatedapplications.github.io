@page "/holodb"
@inject IJSRuntime JS

<PageTitle>HoloDb — holographic SQL database</PageTitle>

<header class="hero">
    <div class="wrap">
        <span class="eyebrow">Data · EvaluatedApplications.HoloDb</span>
        <h1>HoloDb</h1>
        <p class="lede">An embeddable holographic SQL database for .NET. ACID with a write-ahead log, columnar storage
            with compiled predicates, constant-time integer aggregates, hash joins, similarity search, and an optional
            larger-than-memory tier — and small enough to compile to WebAssembly and run in a browser tab.</p>
        <div class="facts">
            <span class="fact">v<b>1.3.0</b></span>
            <span class="fact"><b>ACID</b> + WAL</span>
            <span class="fact">up to <b>766×</b> faster aggregates</span>
            <span class="fact">runs in the <b>browser</b></span>
        </div>
        <div class="hero-cta">
            <div class="install">
                <code>dotnet add package EvaluatedApplications.HoloDb</code>
                <button class="copy" @onclick="Copy">@(_copied ? "copied" : "copy")</button>
            </div>
            <div class="cta-row">
                <a class="btn btn-primary" href="holodb.html">See the benchmarks →</a>
                <a class="btn btn-ghost" href="https://www.nuget.org/packages/EvaluatedApplications.HoloDb" target="_blank" rel="noopener">NuGet</a>
            </div>
        </div>
    </div>
</header>

<section class="sec">
    <div class="wrap">
        <div class="sec-head">
            <span class="dot" style="background:var(--c-data)"></span>
            <h2>Demonstrations</h2>
            <p>the engine, live in your browser</p>
        </div>
        <div class="grid">
            <a class="card tool" href="holodb/analyst" style="--cat:var(--c-data)">
                <div class="card-top"><h3>The Analyst</h3><span class="tag live">live</span></div>
                <p class="desc">Paste any data — a CSV, a log, JSON lines, a spreadsheet dump — and HoloDb profiles the
                    whole thing in your browser: types, distributions, anomalies, hidden entities. Then query it yourself
                    at a live SQL prompt. Nothing leaves your device.</p>
                <div class="go-in">Open The Analyst →</div>
            </a>

            <div class="card tool" style="--cat:var(--c-data)">
                <div class="card-top"><h3>Similarity search</h3><span class="tag soon">soon</span></div>
                <p class="desc">Load rows, then find the nearest ones by content with HoloDb's holographic
                    <code>NEAREST</code> operator — content-addressable retrieval, no vector index to build.</p>
                <div class="go-in" style="color:var(--ink-faint)">In the workshop</div>
            </div>
        </div>
    </div>
</section>

<section class="sec">
    <div class="wrap">
        <div class="sec-head">
            <span class="dot" style="background:var(--c-data)"></span>
            <h2>What's inside</h2>
            <p>the engine</p>
        </div>
        <div class="grid">
            <article class="card" style="--cat:var(--c-data)">
                <div class="card-top"><h3>Real ACID</h3></div>
                <p class="desc">Transactions with a write-ahead log and crash recovery. Concurrent readers never block, and
                    commits are durable — not an in-memory toy.</p>
            </article>
            <article class="card" style="--cat:var(--c-data)">
                <div class="card-top"><h3>Constant-time aggregates</h3></div>
                <p class="desc">COUNT and SUM over integer columns are answered from maintained accumulators, independent of
                    row count — the source of the 766× benchmark wins over per-scan engines.</p>
            </article>
            <article class="card" style="--cat:var(--c-data)">
                <div class="card-top"><h3>Joins & similarity</h3></div>
                <p class="desc">Hash joins, a full boolean WHERE with compiled predicates, and holographic
                    <code>NEAREST</code> similarity search over the same rows — SQL and vector retrieval in one engine.</p>
            </article>
            <article class="card" style="--cat:var(--c-data)">
                <div class="card-top"><h3>Bigger than memory</h3></div>
                <p class="desc">An optional memory-mapped tier spills to disk when a table outgrows RAM, so the same API
                    scales past what fits in memory.</p>
            </article>
        </div>
    </div>
</section>
@code {
    bool _copied;
    async Task Copy()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", "dotnet add package EvaluatedApplications.HoloDb"); _copied = true; }
        catch { /* clipboard blocked; ignore */ }
    }
}
