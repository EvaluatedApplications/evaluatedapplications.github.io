    // ---- the muster (the draft drawer; it opens over the army panel) ----
    private IReadOnlyList<UnitPack> Packs => _s?.Draft?.Offer.Packs ?? [];
    /// <summary>What the bought companies cost: the offered companies' own prices.</summary>
    private int Cost() => Packs.Where((p, i) => i < _sel.Length && _sel[i]).Sum(p => p.Cost);
    /// <summary>The bought companies as picks, in the order the muster lists them (the order the preview and the pipeline both judge them in).</summary>
    private IReadOnlyList<DraftPick> Picks() => Packs.Where((p, i) => i < _sel.Length && _sel[i]).Select(UnitOffer.Pick).ToList();

    /// <summary>Asks the army (on copies) what the bought companies would do, and for every other company the line it would join if bought as well.</summary>
    private async Task RefreshPreview()
    {
        int seq = ++_previewSeq;
        var packs = Packs;
        if (_s is null || packs.Count == 0 || _sel.Length != packs.Count) { _preview = null; await InvokeAsync(StateHasChanged); return; }
        var sel = (bool[])_sel.Clone();
        int left = _s.Draft!.Army.Gold - Cost();
        IReadOnlyList<DraftPick> PicksWith(int extra) => packs.Where((p, i) => sel[i] || i == extra).Select(UnitOffer.Pick).ToList();
        var p0 = await _s.PreviewDraftAsync(PicksWith(-1));
        var rank = new int[packs.Count]; var note = new string?[packs.Count];
        for (int i = 0; i < packs.Count; i++)
        {
            rank[i] = -1;
            if (!sel[i] && (!packs[i].Affordable || packs[i].Cost > left)) continue;      // it cannot be bought now: nothing to ask
            var pv = sel[i] ? p0 : await _s.PreviewDraftAsync(PicksWith(i));
            if (pv is null) continue;
            var pick = UnitOffer.Pick(packs[i]);
            var refused = pv.Report.Refused.Where(r => r.Pick == pick).Select(r => r.Reason).FirstOrDefault();
            if (refused is not null) note[i] = DoctrineWords.Refusal(refused);
            else if (pv.After.Cohorts.FirstOrDefault(c => c.Key == packs[i].Kind) is { } c) rank[i] = c.Slot;
        }
        if (seq != _previewSeq) return;
        _preview = p0; _rank = rank; _packNote = note;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Buy a company or take it back. Only a company the muster offers, whole, and only one the purse still pays for.</summary>
    public void TogglePack(int index)
    {
        if (_s is not { Stage: DoctrineStage.Draft, Draft.Offer: { } offer } || (uint)index >= (uint)offer.Packs.Count || _sel.Length != offer.Packs.Count) return;
        var pack = offer.Packs[index];
        if (!_sel[index])
        {
            if (!pack.Affordable || pack.Cost > _s.Draft.Army.Gold - Cost()) return;
            _sel[index] = true;
        }
        else _sel[index] = false;
        _advice = "";
        _ = RefreshPreview();
    }

    private void UseDraftAdvice()
    {
        if (_s?.Army is not { } a || _s.Draft?.Offer is not { } offer) return;
        var adv = DoctrineGuide.Draft(a, offer);
        Array.Clear(_sel);
        if (adv is null) { _advice = DoctrineGuide.AdvicePrefix + " nothing to buy with this gold."; _ = RefreshPreview(); return; }
        for (int i = 0; i < offer.Packs.Count; i++) _sel[i] = adv.Picks.Contains(UnitOffer.Pick(offer.Packs[i]));
        _advice = adv.Reason;
        _ = RefreshPreview();
    }

    private RenderFragment DraftDrawer => @<section class="dc-sheet dc-draft dc-muster @(_sheet == Sheet.Draft ? "open" : "")" aria-label="The muster">
        @Grip("Muster", CloseSheet)
        @if (_s!.Draft is { } d)
        {
            <h2>The muster <span class="dc-sub">you have @d.Army.Gold gold</span></h2>
            <p class="hint">These companies are offered this round. Buy any you can pay for, each whole or not at all; a kind you already hold joins its cohort, and a new kind joins the line the balance rule gives it. The army itself decides what it will accept.</p>
            <p class="hint dc-musternote">@DoctrineWords.MusterNote</p>
            <button type="button" class="dc-btn dc-advicebtn" id="dc-advice-btn" @onclick="UseDraftAdvice">Use starter advice</button>
            @if (_advice.Length > 0) { <p class="dc-advice">@_advice</p> }
            @if (d.Army.Soldiers == 0) { <p class="dc-notice" role="status">Your army has no soldiers left. Spend your gold on cohorts: a battle needs soldiers.</p> }
            @if (d.Offer.Packs.Count == 0) { <p class="dc-nopacks" role="status">@DoctrineWords.NoCompany</p> }
            <ul class="dc-packs">
                @for (int i = 0; i < d.Offer.Packs.Count && i < _sel.Length; i++)
                {
                    int idx = i;
                    var pack = d.Offer.Packs[i];
                    bool on = _sel[i];
                    int left = d.Army.Gold - Cost();
                    bool can = on || (pack.Affordable && pack.Cost <= left);
                    <li>
                        <button type="button" class="dc-pack @(on ? "on" : "") @(can ? "" : "off")" data-kind="@pack.Kind" data-count="@pack.Count" aria-pressed="@(on ? "true" : "false")" disabled="@(!can)" @onclick="() => TogglePack(idx)">
                            <span class="nm">@DoctrineWords.PackName(pack)</span>
                            <span class="fx">@DoctrineWords.KindBlurbCap(pack.Kind)</span>
                            <span class="cost">@DoctrineWords.PackCost(pack, left, on)</span>
                            @if (_rank.Length > i && _rank[i] >= 0) { <span class="rk">@DoctrineWords.JoinWords(_rank[i], on)</span> }
                            else if (_packNote.Length > i && _packNote[i] is { } note) { <span class="rk why">@note</span> }
                            @if (on) { <span class="mk">Bought</span> }
                        </button>
                    </li>
                }
            </ul>
            @if (Enumerable.Range(0, Roster.Size).Any(k => !DoctrineUnlocks.KindOpen(k, Level)))
            {
                <p class="hint dc-lockedhint">More kinds of soldier may be offered in later rounds. Show everything opens every kind and order to the offers from the next draw.</p>
                <button type="button" class="dc-btn dc-showall" id="dc-showall" @onclick="ShowEverything">Show everything</button>
            }
            <p class="dc-sum">This draft costs @Cost() of @d.Army.Gold gold.</p>
            @if (_preview is { } pv)
            {
                @if (pv.Report.Refused.Count > 0)
                {
                    <ul class="dc-refused" role="alert">
                        @foreach (var (pick, why) in pv.Report.Refused)
                        {
                            <li>@DoctrineWords.KindName(pick.Kind) x@(pick.Count): @DoctrineWords.Refusal(why)</li>
                        }
                    </ul>
                }
                <p class="hint dc-after">After the companies you have bought the army would hold @pv.After.Soldiers soldiers in @pv.After.Kinds of @Roster.Size kinds (a host musters @Roster.Size at most), with @(pv.After.Legal.Count - 1) orders you may give.</p>
            }
        }
    </section>;

    // ---- the order tray ----
    /// <summary>A kind's name for a preview line, or "" when the kind is not open to this player yet (the line then says "more").</summary>
    private string OpenKindName(int kind) => DoctrineUnlocks.KindOpen(kind, Level) ? DoctrineWords.KindName(kind) : "";

    private void UseOrderAdvice()
    {
        if (_s?.Army is not { } a || !Choosing || _s.OrdersOffered is not { } offer) return;
        var adv = DoctrineGuide.Orders(a, offer, Level);
        Array.Clear(_slots);
        if (adv is null) { _advice = DoctrineGuide.AdvicePrefix + " no order to suggest from this council."; return; }
        int i = 0;
        foreach (var t in adv.Doctrine.Tokens) if (t != 0 && i < SlotCount) _slots[i++] = t;
        _lastAdded = adv.Doctrine.Tokens.Last(t => t != 0);
        _advice = adv.Reason;
    }

    /// <summary>The field order each line would open the battle with, from the slots as they stand (a line named twice keeps the last word; the opening is the slots before a trigger).</summary>
    private FieldOrder? LineOrder(int slot)
    {
        var set = new DoctrineSet(_slots[0], _slots[1], _slots[2], _slots[3]);
        foreach (var f in DoctrineVocabulary.FieldOrders(set)) if (f.Group == slot) return f;
        return null;
    }

    /// <summary>How many turns of Reform the ranks the slots hold in all (the orders for the whole host that turn the ranks, added up round the three lines).</summary>
    private int NetTurns()
    {
        int turns = 0;
        for (int i = 0; i < SlotCount; i++)
        {
            if (_slots[i] == 0) continue;
            var o = DoctrineVocabulary.Decode(_slots[i]);
            if (o.Family == OrderFamily.Army && (ArmyOrderKind)o.Kind == ArmyOrderKind.Rotate) turns += o.A;
        }
        return turns % DoctrineVocabulary.Groups;
    }

    private bool IsRotate(int token) => token != 0 && DoctrineVocabulary.Decode(token) is { Family: OrderFamily.Army } o && (ArmyOrderKind)o.Kind == ArmyOrderKind.Rotate;

    // ---- the council: the orders the game put on the table, the three formations, and the slots in the dock ----
    private RenderFragment Tray => @<section class="dc-tray dc-council @(_tray ? "open" : "") @(Asking ? "ask" : "")" id="dc-tray" aria-label="The council">
        @{
            var legal = _s!.Army!.Legal;
            var offer = _s.OrdersOffered ?? OrderOffer.Open();
            var picked = Choosing && !_ghostHidden && _s.Ghost is { } gh ? gh.Doctrine : DoctrineSet.Empty;
        }
        <div class="dc-trayhead" @onpointerdown="DragStart" @onpointerup="e => DragClose(e, CloseTray)">
            <h2>The council <span class="dc-sub">tap up to @SlotCount into the slots, in this order</span></h2>
            @if (Choosing) { <button type="button" class="dc-btn dc-advicebtn" id="dc-advice-btn" @onclick="UseOrderAdvice">Use starter advice</button> }
            <button type="button" class="dc-btn" id="dc-tray-close" aria-label="Close the council" @onclick="CloseTray">Close</button>
        </div>
        <div class="dc-trayscroll">
            @if (_s.Reroll is { } ask) { <p class="dc-rerollnote" role="status">@DoctrineWords.RerollWords(ask.Offer, ask.Army.Gold) Look the council over: keep it, or pay for another.</p> }
            @if (_advice.Length > 0) { <p class="dc-advice">@_advice</p> }
            <p class="hint dc-councilhint">These orders are on the table this round. Tap one to put it in the first empty slot, tap it again to take it out.</p>            <div class="dc-chipgrid">
                @foreach (var tk in offer.Tokens)
                {
                    int token = tk;
                    bool ok = legal.Allows(token);
                    int at = Array.IndexOf(_slots, token);
                    bool placed = at >= 0 && at < SlotCount;
                    bool gen = picked.Tokens.Contains(token);
                    var trial = _s.Trial(token);
                    int? cost = DoctrineWords.CostNow(token, _s.Army!, trial);
                    string? seen = DoctrineWords.Preview(token, trial, OpenKindName);
                    <button type="button" class="dc-chip @(placed ? "on" : "") @(gen ? "gen" : "") @(ok ? "" : "off")" data-token="@token" aria-pressed="@(placed ? "true" : "false")" disabled="@(!ok || !Choosing)" @onclick="() => PlaceOrder(token)">
                        <span class="lb">@DoctrineWords.Label(token)</span>
                        <span class="fx">@DoctrineWords.Effect(token)</span>
                        @if (cost is { } gold) { <span class="cost">@DoctrineWords.CostWords(gold, _s.Army!.Gold)</span> }
                        @if (seen is not null) { <span class="pv">@seen</span> }
                        @if (placed) { <span class="mk">In slot @(at + 1)</span> }
                        @if (gen) { <span class="gb">Your general's pick</span> }
                    </button>
                }
            </div>
            @if (offer.Tokens.Count == 0) { <p class="hint dc-nocards">No order is on the table.@(legal.Count <= 1 ? " With no soldiers in the army, no order can be given." : "")</p> }
            @Forms(offer, legal)
            @if (_slots.Any(t => t != 0))
            {
                <h3 class="dc-h3">What your orders say</h3>
                <ul class="dc-says">
                    @foreach (var t in _slots.Where(t => t != 0)) { <li>@DoctrineWords.Sentence(t)</li> }
                </ul>
            }
            <p class="hint">To give no orders is allowed: every line then presses on.</p>
            @if (Locked)
            {
                <p class="hint dc-lockedhint">More orders may be offered in later rounds. Show everything opens every kind and order to the offers from the next draw.</p>
                <button type="button" class="dc-btn dc-showall" id="dc-showall" @onclick="ShowEverything">Show everything</button>
            }
        </div>
    </section>;

    private RenderFragment Forms(OrderOffer offer, LegalMask legal) => @<section class="dc-forms" aria-label="The three formations">
        <h3 class="dc-h3">The three formations</h3>
        <p class="hint">Reform the ranks turns the whole host along the line. Choosing a formation puts its order in a slot.</p>
        @{ var forms = _s!.Formations(); int net = NetTurns(); }
        <div class="dc-formgrid" role="radiogroup" aria-label="Formation of the host">
            @foreach (var f in forms)
            {
                int turns = f.Turns;
                bool offered = turns == 0 || (offer.Allows(f.Token) && legal.Allows(f.Token) && DoctrineUnlocks.Allows(f.Token, Level));
                bool on = net == turns;
                <button type="button" class="dc-form @(on ? "on" : "") @(offered ? "" : "off")" role="radio" aria-checked="@(on ? "true" : "false")" data-turns="@turns" disabled="@(!offered || !Choosing)" @onclick="() => PickFormation(turns)">
                    <span class="ft">@DoctrineWords.FormationTitle(turns, f.Token)</span>
                    @if (f.Host is { } host)
                    {
                        @for (int sl = 0; sl < DoctrineVocabulary.Groups; sl++)
                        {
                            int slot = sl;
                            <span class="fl" data-slot="@slot"><b>@DoctrineWords.Slot(slot) line</b> <span class="who">@DoctrineWords.Standing(host, slot, OpenKindName)</span> <i class="by">@DoctrineWords.LineOrderWords(LineOrder(slot))</i></span>
                        }
                    }
                    else { <span class="fn">The host cannot reform now.</span> }
                    @if (!offered) { <span class="fn">Not on the council this round.</span> }
                </button>
            }
        </div>
        @if (_formNote.Length > 0) { <p class="hint dc-formnote" role="status">@_formNote</p> }
    </section>;

    /// <summary>Put an order from the council in the first empty slot, or take it out again. Only an order the game put on the table, that the army allows and this step has opened, and never more than the open slots.</summary>
    public void PlaceOrder(int token)
    {
        // A greyed card is disabled in the browser; this guard keeps every rule (on the table, the army's legal list, what is open yet, the slots) even where a tap reaches a disabled button.
        if (_s?.Army is not { } a || !Choosing || token == 0 || _s.OrdersOffered is not { } offer) return;
        if (!offer.Allows(token) || !a.Legal.Allows(token) || !DoctrineUnlocks.Allows(token, Level)) return;
        int at = Array.IndexOf(_slots, token);
        if (at >= 0 && at < SlotCount) { _slots[at] = 0; _advice = ""; _formNote = ""; return; }
        for (int i = 0; i < SlotCount; i++) if (_slots[i] == 0) { _slots[i] = token; _lastAdded = token; _advice = ""; _formNote = ""; return; }
    }

    /// <summary>Choose a formation: the order that brings it about goes in a slot (replacing a turn of the ranks already there), or none for the host as it stands.</summary>
    public void PickFormation(int turns)
    {
        if (_s?.Army is not { } a || !Choosing || _s.OrdersOffered is not { } offer || turns < 0 || turns >= DoctrineVocabulary.Groups) return;
        _formNote = "";
        int token = turns == 0 ? 0 : DoctrineVocabulary.Army(ArmyOrderKind.Rotate, turns);
        if (token != 0 && (!offer.Allows(token) || !a.Legal.Allows(token) || !DoctrineUnlocks.Allows(token, Level))) return;
        int where = -1;
        for (int i = 0; i < SlotCount; i++)
            if (IsRotate(_slots[i])) { if (where < 0) where = i; else _slots[i] = 0; }
        if (where >= 0) _slots[where] = token;
        else if (token != 0)
        {
            int free = Array.IndexOf(_slots, 0, 0, SlotCount);
            if (free < 0) { _formNote = "Every slot is full. Take an order out to put this formation in."; return; }
            _slots[free] = token;
        }
        _lastAdded = token; _advice = "";
    }

    private void ClearSlot(int slot)
    {
        if (!Choosing) return;
        _slots[slot] = 0; _advice = "";
    }

    /// <summary>Move the order in one slot to another place in the order (slot order is the order the orders are given in); the slots between shift by one.</summary>
    public void MoveSlot(int from, int to)
    {
        if (!Choosing || (uint)from >= (uint)SlotCount || (uint)to >= (uint)SlotCount || from == to) return;
        int moved = _slots[from];
        if (from < to) for (int k = from; k < to; k++) _slots[k] = _slots[k + 1];
        else for (int k = from; k > to; k--) _slots[k] = _slots[k - 1];
        _slots[to] = moved;
        _advice = "";
    }

    private void DragSlotStart(int slot) { if (Choosing && _slots[slot] != 0) _dragFromSlot = slot; }
    private void DropOnSlot(int slot) { if (_dragFromSlot >= 0) MoveSlot(_dragFromSlot, slot); _dragFromSlot = -1; }

    private void ClearAll() { if (!Choosing) return; Array.Clear(_slots); _advice = ""; _lastAdded = 0; }

    // ---- the ghost ----
    /// <summary>The glow of the whole panel: the general's per-slot match record averaged over the orders it shows, or the whole-suggestion figure when it gives no per-slot one.</summary>
    private static int PanelGlow(GeneralOutput g)
    {
        if (g.SlotConfidence is not { } sr) return g.ConfidencePermille;
        var shown = Enumerable.Range(0, DoctrineVocabulary.MaxSlots).Where(i => g.Doctrine[i] != 0).Select(i => sr[i]).ToList();
        return shown.Count == 0 ? g.ConfidencePermille : (int)shown.Average();
    }

    private static string Glow(int permille) => (Math.Clamp(permille, 0, 1000) / 1000.0).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private void Accept(GeneralOutput ghost)
    {
        if (!Choosing || !DoctrineUnlocks.AllowsAll(ghost.Doctrine, Level) || !ghost.Doctrine.Tokens.All((_s!.OrdersOffered ?? OrderOffer.Open()).Allows)) return;
        _s!.SubmitChoice(ghost.Doctrine, false);
    }

    private void EditGhost(GeneralOutput ghost)
    {
        if (!Choosing) return;
        var offer = _s!.OrdersOffered ?? OrderOffer.Open();
        Array.Clear(_slots);
        int i = 0;
        foreach (var t in ghost.Doctrine.Tokens) if (t != 0 && i < SlotCount && DoctrineUnlocks.Allows(t, Level) && offer.Allows(t)) _slots[i++] = t;
        _ghostHidden = true; _advice = ""; _lastAdded = 0;
        _sheet = Sheet.None; _tray = true;
    }

    private void IgnoreGhost() { if (!Choosing) return; _ghostHidden = true; Array.Clear(_slots); _advice = ""; _lastAdded = 0; _sheet = Sheet.None; _tray = true; }

    private void Fight(GeneralOutput ghost)
    {
        if (!Choosing) return;
        var d = new DoctrineSet(_slots[0], _slots[1], _slots[2], _slots[3]);
        _s!.SubmitChoice(d, d != ghost.Doctrine);
    }

    // ---- sheets: tap, or drag by the handle; never hover ----
    private void DragStart(PointerEventArgs e) { _dragFrom = e.ClientY; _dragged = false; }
    private void DragClose(PointerEventArgs e, Action close) { if (e.ClientY - _dragFrom >= 40) { _dragged = true; close(); } }
    private void DragOpen(PointerEventArgs e, Sheet which) { if (_dragFrom - e.ClientY >= 40) { _dragged = true; _sheet = which; _tray = false; } }
    private void ClickClose(Action close) { if (_dragged) { _dragged = false; return; } close(); }
    private void ToggleSheet(Sheet which)
    {
        if (_dragged) { _dragged = false; return; }
        _sheet = _sheet == which ? Sheet.None : which;
        if (_sheet != Sheet.None) _tray = false;
    }
    private void CloseSheet() => _sheet = Sheet.None;
    private void CloseTray() => _tray = false;
    private void OpenTray() { _tray = !_tray; if (_tray) _sheet = Sheet.None; }
    private void ToggleDraft() => _sheet = _sheet == Sheet.Draft ? Sheet.None : Sheet.Draft;

    // ---- the dock (bottom): the slots, then the one action of this stage ----
    private RenderFragment Dock => @<footer class="dc-dock @(Choosing ? "dc-editor" : "") @(Asking ? "dc-asking" : "")" aria-label="Your orders">
        @if (_s!.Stage == DoctrineStage.Map)
        {
            <div class="dc-dockbtns dc-roadsbtns">
                <button type="button" class="dc-btn strong dc-roadsbtn" id="dc-roads-btn" aria-expanded="@(_sheet == Sheet.Lanes ? "true" : "false")" aria-controls="dc-lanes" @onclick="() => ToggleSheet(Sheet.Lanes)">Pick a road</button>
            </div>
        }
        else if (_s.Stage == DoctrineStage.Epoch)
        {
            <div class="dc-dockbtns">
                <button type="button" class="dc-btn strong dc-next" id="dc-epoch-next" @onclick="_s.ContinueCampaign">@DoctrineCampaignWords.ContinueWords(Cw.Over)</button>
            </div>
        }
        else if (_s.Stage == DoctrineStage.Watch && _s.Last is { } v)
        {
            var rec = v.Record;
            var recap = DoctrineGuide.Of(v, _s.ArenaName(rec.ArenaId));
            <section class="dc-result" aria-label="Round result">
                <h2>@(War ? "Epoch" : "Round") @(rec.Round + 1): @DoctrineWords.OutcomeShort(rec.Result.Outcome) <span class="dc-sub">@_s.ArenaName(rec.ArenaId), @rec.Result.Ticks ticks</span></h2>
                <ul class="dc-recap">
                    @foreach (var line in recap.What) { <li class="dc-recap-what">@line</li> }
                    @foreach (var line in recap.Siege) { <li class="dc-recap-siege">@line</li> }
                    @if (recap.Limit is { } limitLine) { <li class="dc-recap-limit">@limitLine</li> }
                    @if (recap.TryNext is { } tn) { <li class="dc-recap-try">@tn</li> }
                </ul>
            </section>
            <div class="dc-dockbtns">
                <button type="button" class="dc-btn strong dc-next" id="dc-next" @onclick="_s.NextRound">@(War ? "Continue" : v.Last ? "See the end of the game" : "Next round")</button>
            </div>
        }
        else
        {
            @if (Choosing && !_tray && _lastAdded != 0 && _slots.Contains(_lastAdded)) { <p class="dc-lastsays">@DoctrineWords.Sentence(_lastAdded)</p> }
            @if (!Asking) {
            <ol class="dc-slots">
                @for (int i = 0; i < SlotCount; i++)
                {
                    int slot = i;
                    bool filled = _slots[slot] != 0;
                    string slotText = DoctrineWords.Label(_slots[slot]);
                    string slotAria = $"Slot {slot + 1}: {slotText}" + (!filled || !Choosing ? "" : ". Tap to clear.");
                    string slotCls = filled ? "dc-slot" : "dc-slot empty";
                    <li data-slot="@slot" draggable="@(Choosing && filled ? "true" : "false")" @ondragstart="() => DragSlotStart(slot)" @ondragover="() => { }" @ondragover:preventDefault @ondrop="() => DropOnSlot(slot)">
                        <button type="button" class="@slotCls" aria-label="@slotAria" disabled="@(!Choosing)" @onclick="() => ClearSlot(slot)">
                            <span class="n">@(slot + 1)</span><span class="t">@slotText</span>
                        </button>
                        @if (Choosing && filled)
                        {
                            <span class="dc-mv">
                                <button type="button" class="dc-btn dc-left" aria-label="Move slot @(slot + 1) earlier" disabled="@(slot == 0)" @onclick="() => MoveSlot(slot, slot - 1)">&#9664;</button>
                                <button type="button" class="dc-btn dc-right" aria-label="Move slot @(slot + 1) later" disabled="@(slot == SlotCount - 1)" @onclick="() => MoveSlot(slot, slot + 1)">&#9654;</button>
                            </span>
                        }
                    </li>
                }
            </ol>
            }
            <div class="dc-dockbtns">
                @switch (_s.Stage)
                {
                    case DoctrineStage.Draft:
                        <button type="button" class="dc-btn" id="dc-draftbtn" aria-expanded="@(_sheet == Sheet.Draft ? "true" : "false")" @onclick="ToggleDraft">Muster</button>
                        <button type="button" class="dc-btn strong" id="dc-confirm" @onclick="ConfirmDraft">@(Cost() == 0 ? "Keep the army as it is" : "Confirm the draft")</button>
                        break;
                    case DoctrineStage.Doctrine when _s.Reroll is { } ask:
                        <button type="button" class="dc-btn" id="dc-orders" aria-expanded="@(_tray ? "true" : "false")" @onclick="OpenTray">Council</button>
                        <button type="button" class="dc-btn" id="dc-reroll" @onclick="_s.RerollCouncil">Reroll for @ask.Offer.RerollCost gold (@ask.Offer.RerollsLeft left)</button>
                        <button type="button" class="dc-btn strong" id="dc-keep" @onclick="_s.KeepCouncil">Keep these</button>
                        break;
                    case DoctrineStage.Doctrine:
                        <button type="button" class="dc-btn" id="dc-orders" aria-expanded="@(_tray ? "true" : "false")" @onclick="OpenTray">Council</button>
                        <button type="button" class="dc-btn" id="dc-clear" @onclick="ClearAll">Clear</button>
                        <button type="button" class="dc-btn strong dc-go" id="dc-fight" @onclick="() => Fight(_s.Ghost!)">GO</button>
                        break;
                    case DoctrineStage.Working:
                        <button type="button" class="dc-btn" id="dc-cancel" @onclick="_s.CancelBattle">Cancel</button>
                        break;
                }
            </div>
        }
    </footer>;

    private void ConfirmDraft() => _s!.SubmitDraft(Picks());

    // ------------------------------------------------------------------------------------------------------- over
    private RenderFragment OverView => @<div>
        @if (_s!.End is { } e)
        {
            <section class="dc-panel dc-end dc-warend" aria-label="The end of the war">
                <h2 id="dc-endhead">@DoctrineCampaignWords.EndHeading(e.Outcome, e.Left)</h2>
                <p class="dc-says dc-score" id="dc-score">@DoctrineCampaignWords.ScoreWords(e)</p>
                <p class="dc-says">@e.Epochs @(e.Epochs == 1 ? "epoch" : "epochs") played. Game seed @e.Seed.</p>
                @if (e.History.Count > 0)
                {
                    <ol class="dc-rounds-list">
                        @foreach (var x in e.History) { <li>@DoctrineCampaignWords.EpochLine(x)</li> }
                    </ol>
                }
                <h3 class="dc-h3">Your army code</h3>
                <p><code class="dc-armycode" id="dc-armycode">@e.ArmyCode</code></p>
                <div class="dc-ghostbtns">
                    <button type="button" class="dc-btn" id="dc-copy" @onclick="() => Copy(e.ArmyCode)">Copy the code</button>
                </div>
                @if (_copied.Length > 0) { <p class="hint" role="status">@_copied</p> }
                <p class="hint">Paste it on the start screen to play a fixed game with this army. It holds the army only, not the map.</p>
            </section>
            <div class="dc-endbtns">
                <button type="button" class="dc-btn strong" id="dc-fresh" @onclick="_s.BackToStart">Back to the start</button>
            </div>
        }
        else if (_s!.Result is { } r)
        {
            int won = r.Rounds.Count(x => x.Result.Outcome == BattleStatus.AttackerWon), lost = r.Rounds.Count(x => x.Result.Outcome == BattleStatus.DefenderWon), drawn = r.Rounds.Count - won - lost;
            <section class="dc-panel dc-end" aria-label="The end of the game">
                <h2>The game is over</h2>
                <p class="dc-says">@r.Rounds.Count @(r.Rounds.Count == 1 ? "round" : "rounds") played: @won won, @lost lost, @drawn drawn. Game seed @r.Seed.</p>
                @if (r.Rounds.Count > 0)
                {
                    <ol class="dc-rounds-list">
                        @foreach (var x in r.Rounds)
                        {
                            <li>Round @(x.Round + 1), @DoctrineWords.OutcomeShort(x.Result.Outcome): @DoctrineWords.Orders(x.PlayerDoctrine)@(x.Overrode ? "" : " (general's suggestion)")</li>
                        }
                    </ol>
                }
                <h3 class="dc-h3">Your army code</h3>
                <p><code class="dc-armycode" id="dc-armycode">@r.PlayerArmyCode</code></p>
                <div class="dc-ghostbtns">
                    <button type="button" class="dc-btn" id="dc-copy" @onclick="() => Copy(r.PlayerArmyCode)">Copy the code</button>
                </div>
                @if (_copied.Length > 0) { <p class="hint" role="status">@_copied</p> }
                <p class="hint">Paste it on the start screen to play on with this army. It holds the army only. Your general is not in it, and a refresh forgets the general.</p>
                <p class="hint">Your general has seen @_s.Sections.General.ExamplesSeen @(_s.Sections.General.ExamplesSeen == 1 ? "example" : "examples") (each doctrine you set and each battle result) since you opened this page.</p>
            </section>
            <div class="dc-endbtns">
                <button type="button" class="dc-btn strong" id="dc-again" @onclick="() => PlayOn(r)">Play on with this army</button>
                <button type="button" class="dc-btn" id="dc-fresh" @onclick="_s.BackToStart">Back to the start</button>
            </div>
        }
    </div>;

    private void PlayOn(GameResult r)
    {
        _s!.BackToStart();
        _loadError = "";
        _news = null;
        if (!_s.NewGame((int)(Environment.TickCount64 & 0x7fffffff), _s.TotalRounds, r.PlayerArmyCode, out var why)) _loadError = why;
    }

    private async Task Copy(string text)
    {
        try { await JS.InvokeVoidAsync("copyText", text); _copied = "Copied. Paste it on the start screen to load this army."; }
        catch (JSException) { _copied = "Your browser would not copy it. Select the code and copy it by hand."; }
        catch (InvalidOperationException) { _copied = "Your browser would not copy it. Select the code and copy it by hand."; }
    }
}
