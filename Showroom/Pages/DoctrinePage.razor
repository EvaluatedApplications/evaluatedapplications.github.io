@page "/doctrine"
@attribute [BlazierPage("doctrine", Title = "Doctrine: an army game with a general that learns from you", Layout = typeof(MainLayout), Static = true)]
@implements IDisposable
@inject IBuildTime Build
@inject IJSRuntime JS
@inject IServiceProvider Services
@using ShowroomDoctrine
@using Doctrine

<PageTitle>Doctrine: an army game with a general that learns from you</PageTitle>

<div class="room dc @(_s is { InGame: true } ? "dc-ingame" : "")">
    @if (_s is not { InGame: true })
    {
        <header class="room-head">
            <nav class="crumb"><a href="/tools/">Tools</a> <span>/</span> Doctrine</nav>
            <h1>Doctrine</h1>
            <p class="lede">Draft an army, give it up to four orders, and watch the battle run on a navigation mesh. Your general learns how you set
                orders from your own choices, in your browser, with nothing pre-trained, and suggests the next one. Nothing is uploaded.</p>
        </header>
    }

    @if (Build.IsPrerender)
    {
        <ToolStart Tool="Doctrine" Label="Start Doctrine" />
    }
    else if (_s is not null)
    {
        @if (!_s.InGame)
        {
            @if (_s.Notice.Length > 0) { <p class="dc-notice" role="status">@_s.Notice</p> }
            @if (_s.Error.Length > 0) { <p class="err" role="alert">@_s.Error</p> }
        }

        @switch (_s.Stage)
        {
            case DoctrineStage.Start:
                @StartView
                break;
            case DoctrineStage.Over:
                @OverView
                break;
            default:
                @Hud
                break;
        }
    }

    <section class="outro">
        <h2>How it works</h2>
        <p>The army is a set of Pleroma stores from the Phasor package, the battle runs on a Tracer navigation mesh, the rounds run as EvalApp
            pipelines, and the general is a habit table with a tiny HoloFormer from the AlgFormer package.</p>
        <p>Each cohort of soldiers is an item in a Pleroma store: its kind is the key, its traits are the flags, its place in the line is the
            arrangement, and its veterancy is a position on a ring of nine. An order is one operation on that store. Flip relabels a trait, Rotate
            relabels the line, Age ticks the ring, Aura counts the soldiers who carry a trait, and the list of orders you may give is read from
            the store, which is why some are greyed out. Field orders go to the battle: the ground is a baked Tracer navigation mesh, and each
            cohort is a group of agents that path, take cover and strike on it.</p>
        <p>A battle is simulated once, on your device, and recorded. The replay is a recording of that one battle: playing it back does not
            run it again.</p>
        <details class="dc-about">
            <summary>About the general</summary>
            <p>Your general starts empty. It learns how you set a doctrine from your own choices, in your browser, with nothing pre-trained, and
                different players end up with different generals. It suggests and you decide: every doctrine you set is an example for it, and so is each
                battle result.</p>
            <p>Inside it are a small habit table and a tiny HoloFormer from the AlgFormer package. For each of the four slots the table speaks, unless
                the HoloFormer has been right on that slot at least two more times than the table over your recent choices, in which case it takes the
                slot. The match record shown is a score out of 1000 for how well its whole suggestion has matched what you then chose, over your recent choices. It starts low and climbs as the matches keep coming.
                Nothing is saved: refresh the page and the general is gone.</p>
        </details>
    </section>
</div>

@code {
    private enum Sheet { None, Army, General, Draft, Chronicle }

    private ReplayCursor? _cursor;          // the tick on screen, shared by the replay and the chronicle
    private Chronicle? _chron;              // the account of the battle on screen
    private RoundView? _chronFor;           // the round the account was built for

    private DoctrineSession? _s;
    private DoctrineProgress _p = new();
    private DoctrineStage _seen = DoctrineStage.Start;

    // start screen
    private int _rounds = DoctrineSession.DefaultRounds;
    private string _seedText = "";
    private string _codeText = "";
    private string _loadError = "";

    // the scene
    private Sheet _sheet = Sheet.None;      // which panel is pulled up (phone); on a wide screen the panels are always there
    private bool _tray;                     // the order tray is open
    private UnlockNews? _news;              // what opened at the start of this round, until the player confirms it
    private string _advice = "";            // the game's advice line, while the draft or slots still hold exactly what it filled
    private int _lastAdded;                 // the order last put in a slot (its effect is previewed under the slots)

    // draft
    private readonly int[] _buy = new int[Roster.Size];
    private DraftPreview? _preview;
    private int _previewSeq;

    // doctrine
    private readonly int[] _slots = new int[DoctrineVocabulary.MaxSlots];
    private bool _ghostHidden;

    private string _copied = "";

    // dragging a panel by its handle
    private double _dragFrom;
    private bool _dragged;

    /// <summary>The session behind the page (the proofs drive and read it).</summary>
    public DoctrineSession? Session => _s;
    /// <summary>What this visitor has unlocked (the proofs read it).</summary>
    public DoctrineProgress Progress => _p;

    private int Level => _p.Step;
    private int SlotCount => DoctrineUnlocks.Slots(Level);
    private bool InDoctrine => _s?.Stage == DoctrineStage.Doctrine;

    protected override void OnInitialized()
    {
        if (Build.IsPrerender) return;
        _p = Services.GetService(typeof(DoctrineProgress)) as DoctrineProgress ?? new DoctrineProgress();
        _s = new DoctrineSession(null, Services.GetService(typeof(DoctrineSectionsSource)) is DoctrineSectionsSource src ? src.Make : null);
        _s.Changed += OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        if (_s is null) return;
        if (_s.Stage != _seen) { _seen = _s.Stage; EnterStage(_seen); }
        StateHasChanged();
    });

    private void EnterStage(DoctrineStage st)
    {
        _copied = "";
        _sheet = Sheet.None; _tray = false;
        if (st == DoctrineStage.Draft)
        {
            Array.Clear(_buy); Array.Clear(_slots); _preview = null; _advice = ""; _lastAdded = 0;
            var news = _p.Reach(_s!.RoundIndex, _s.TotalRounds);
            if (news is not null) _news = news;
            _sheet = Sheet.Draft;
            _ = RefreshPreview();
        }
        if (st == DoctrineStage.Doctrine)
        {
            Array.Clear(_slots); _ghostHidden = false; _advice = ""; _lastAdded = 0;
            bool ghost = _s!.Ghost is { } g && !g.Doctrine.IsEmpty;
            _sheet = ghost ? Sheet.General : Sheet.None;
            _tray = !ghost;
        }
        if (st is DoctrineStage.Start or DoctrineStage.Over) _news = null;
    }

    public void Dispose()
    {
        if (_s is null) return;
        _s.Changed -= OnChanged;
        _s.Dispose();
    }

    // ------------------------------------------------------------------------------------------------------- start
    private RenderFragment StartView => @<div>
        <section class="dc-panel dc-start" id="dc-start" aria-label="Start a game">
            <h2>Start a game</h2>
            <p class="hint">Every game starts with an army levied for you, some gold to spend, and a run of rounds against armies the game raises. Each round you
                draft, set a doctrine, and watch one battle. Round one gives you two kinds of soldier and two orders; more open as the rounds go on.</p>
            <p class="dc-h3" id="dc-rounds-label">Rounds</p>
            <div class="dc-opts" role="radiogroup" aria-labelledby="dc-rounds-label">
                @foreach (var n in new[] { 3, 5, 8 })
                {
                    var r = n;
                    <button type="button" class="dc-btn dc-opt @(_rounds == r ? "on" : "")" role="radio" aria-checked="@(_rounds == r ? "true" : "false")" @onclick="() => _rounds = r">@r rounds</button>
                }
            </div>
            <label class="dc-label" for="dc-seed">Game seed (optional)</label>
            <input id="dc-seed" class="dc-input" type="text" inputmode="numeric" autocomplete="off" autocorrect="off" spellcheck="false" maxlength="9"
                   placeholder="A whole number" value="@_seedText" @oninput="e => _seedText = e.Value?.ToString() ?? string.Empty" />
            <p class="hint">The same seed raises the same enemies on the same ground, so you can replay a game. Leave it empty for a new one.</p>
            <button type="button" class="dc-btn strong" id="dc-new" @onclick="StartNew">Start a new game</button>
            @if (Locked)
            {
                <button type="button" class="dc-btn dc-showall" id="dc-showall" @onclick="ShowEverything">Show everything</button>
            }
        </section>

        <section class="dc-panel dc-load" aria-label="Load an army code">
            <h2>Load an army code</h2>
            <p class="hint">An army code is a short piece of text that holds an army. Paste one from an earlier game to play on with that army.</p>
            <label class="dc-label" for="dc-code">Army code</label>
            <textarea id="dc-code" class="dc-input dc-codebox" rows="3" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
                      placeholder="DA2.0...." @oninput="e => _codeText = e.Value?.ToString() ?? string.Empty">@_codeText</textarea>
            @if (_loadError.Length > 0) { <p class="err dc-loaderr" role="alert">@_loadError</p> }
            <button type="button" class="dc-btn" id="dc-load" @onclick="LoadCode">Load this army and play</button>
        </section>

        @if (_s!.Sections.General.ExamplesSeen > 0)
        {
            <section class="dc-panel" aria-label="Your general">
                <h2>Your general</h2>
                <p class="hint">It has seen @_s.Sections.General.ExamplesSeen @(_s.Sections.General.ExamplesSeen == 1 ? "example" : "examples") (each doctrine you set and each battle result) since you opened this page and will carry them into the next game. A refresh forgets them.</p>
                <button type="button" class="dc-btn" id="dc-resetgeneral" @onclick="ResetGeneral">Start with a new, empty general</button>
            </section>
        }
    </div>;

    private bool Locked => !_p.ShowAll && _p.Step < DoctrineUnlocks.LastStep;
    private void ShowEverything() { _p.ShowEverything(); _news = null; }

    private void StartNew()
    {
        _loadError = "";
        int seed;
        if (_seedText.Trim().Length == 0) seed = (int)(Environment.TickCount64 & 0x7fffffff);
        else if (!int.TryParse(_seedText.Trim(), System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out seed))
        { _loadError = "A seed is a whole number, digits only."; return; }
        _news = null;
        _s!.NewGame(seed, _rounds, null, out var why);
        if (why.Length > 0) _loadError = why;
    }

    private void LoadCode()
    {
        _loadError = "";
        if (_codeText.Trim().Length == 0) { _loadError = "Paste an army code first."; return; }
        int seed = _seedText.Trim().Length > 0 && int.TryParse(_seedText.Trim(), System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var sd)
            ? sd : (int)(Environment.TickCount64 & 0x7fffffff);
        _news = null;
        if (!_s!.NewGame(seed, _rounds, _codeText, out var why)) _loadError = why;
    }

    private void ResetGeneral() => _s!.ResetGeneral();

    // ------------------------------------------------------------------------------------------------------- the scene
    private string Goal => $"Goal: win as many of the {_s!.TotalRounds} {(_s.TotalRounds == 1 ? "field" : "fields")} as you can.";

    private string Todo()
    {
        var s = _s!;
        switch (s.Stage)
        {
            case DoctrineStage.Draft:
                return s.RoundIndex == 0 && Level == 0
                    ? "Gold buys soldiers. Tap + on a kind, then press Confirm."
                    : "Spend your gold on soldiers, then press Confirm.";
            case DoctrineStage.Doctrine:
                return $"Put up to {SlotCount} {(SlotCount == 1 ? "order" : "orders")} in the slots, then press GO."
                    + (s.Ghost is { } g && !g.Doctrine.IsEmpty ? " Your general has a suggestion in the General panel." : "");
            case DoctrineStage.Working:
                return s.Status.Length > 0 ? s.Status + "." : "Working.";
            case DoctrineStage.Watch:
                return "Watch, read the recap, then press Next round.";
            default:
                return "";
        }
    }

    /// <summary>The account of the battle on the watch screen: built once per closed round, from its recording, and shared with the replay by one cursor.</summary>
    private void EnsureWatch()
    {
        if (_s is not { Stage: DoctrineStage.Watch, Last: { } v } || ReferenceEquals(_chronFor, v)) return;
        _chronFor = v;
        _cursor = new ReplayCursor();
        _chron = BattleChronicle.Build(v.Record.Replay, v.Record.PlayerDoctrine, _s.ArenaName(v.Record.ArenaId), DoctrineWords.KindName, v.TraitsOf);
    }

    private RenderFragment Hud => @<div class="dc-hud" data-stage="@_s!.Stage.ToString().ToLowerInvariant()" data-step="@Level">
        @{ EnsureWatch(); }
        <header class="dc-top" aria-label="Where the game stands">
            <ul class="dc-status dc-chips">
                <li>Round @(_s.RoundIndex + 1) of @_s.TotalRounds</li>
                @if (_s.Army is { } a) { <li>Gold @a.Gold</li> }
            </ul>
            <div class="dc-sheetbtns">
                <button type="button" id="dc-open-army" class="dc-btn dc-sheetbtn" aria-expanded="@(_sheet == Sheet.Army ? "true" : "false")" aria-controls="dc-army"
                        @onpointerdown="DragStart" @onpointerup="e => DragOpen(e, Sheet.Army)" @onclick="() => ToggleSheet(Sheet.Army)">Army</button>
                @if (_s.Stage != DoctrineStage.Watch)
                {
                    <button type="button" id="dc-open-general" class="dc-btn dc-sheetbtn" aria-expanded="@(_sheet == Sheet.General ? "true" : "false")" aria-controls="dc-general"
                            @onpointerdown="DragStart" @onpointerup="e => DragOpen(e, Sheet.General)" @onclick="() => ToggleSheet(Sheet.General)">General</button>
                }
                @if (_s.Stage == DoctrineStage.Watch && _chron is not null)
                {
                    <button type="button" id="dc-open-chronicle" class="dc-btn dc-sheetbtn" aria-expanded="@(_sheet == Sheet.Chronicle ? "true" : "false")" aria-controls="dc-chronicle"
                            @onpointerdown="DragStart" @onpointerup="e => DragOpen(e, Sheet.Chronicle)" @onclick="() => ToggleSheet(Sheet.Chronicle)">Chronicle</button>
                }
            </div>
            <p class="dc-goal">@Goal</p>
            <p class="dc-todo" role="status">@Todo()</p>
            @if (_s.Notice.Length > 0) { <p class="dc-notice" role="status">@_s.Notice</p> }
            @if (_s.Error.Length > 0) { <p class="err" role="alert">@_s.Error</p> }
        </header>

        <div class="dc-stage">
            @ArmySheet
            <section class="dc-field" aria-label="The field">
                @FieldView
            </section>
            @GeneralSheet
            @if (_s.Stage == DoctrineStage.Watch && _chron is not null) { @ChronicleSheet }
            @if (_s.Stage == DoctrineStage.Draft) { @DraftDrawer }
            @if (InDoctrine && _tray) { @Tray }
            @if (_news is { } news) { @UnlockCard(news) }
        </div>

        @Dock
    </div>;

    // ---- the army panel (left) ----
    private RenderFragment ArmySheet => @<aside id="dc-army" class="dc-sheet dc-armypanel @(_sheet == Sheet.Army ? "open" : "")" aria-label="Your army">
        @Grip("Army", CloseSheet)
        @if (_s!.Army is { } a)
        {
            <h2>Your army <span class="dc-sub">@a.Soldiers soldiers, @a.Gold gold</span></h2>
            @if (a.Cohorts.Count == 0) { <p class="hint">No cohorts.</p> }
            else
            {
                // Only the kinds that are open at this step are named; the rest wait under one collapsed line.
                var openRows = a.Cohorts.Where(c => DoctrineUnlocks.KindOpen(c.Key, Level)).ToList();
                var otherRows = a.Cohorts.Where(c => !DoctrineUnlocks.KindOpen(c.Key, Level)).ToList();
                if (openRows.Count > 0)
                {
                    <ul class="dc-cohortlist dc-army">
                        @foreach (var c in openRows) { @CohortRow(c) }
                    </ul>
                }
                if (otherRows.Count > 0)
                {
                    <details class="dc-other">
                        <summary>Other soldiers: @otherRows.Sum(c => c.Count)</summary>
                        <ul class="dc-cohortlist dc-army">
                            @foreach (var c in otherRows) { @CohortRow(c) }
                        </ul>
                    </details>
                }
            }
        }
        else { <h2>Your army</h2><p class="hint">The army is being raised.</p> }
        @if (_s.Stage == DoctrineStage.Watch && _s.Last is { } v) { @Spoils(v) }
        @if (_s.Stage is DoctrineStage.Draft or DoctrineStage.Doctrine or DoctrineStage.Watch)
        {
            <button type="button" class="dc-btn dc-leave" id="dc-leave" @onclick="_s.Leave">Leave this game</button>
        }
    </aside>;

    /// <summary>One cohort in plain words; the traits, veterancy and power are one tap away under Details.</summary>
    private RenderFragment CohortRow(CohortRead c) => @<li>
        <span class="plain"><span class="nm">@DoctrineWords.KindName(c.Key)</span>, <span class="ct">@c.Count</span>: @DoctrineWords.KindBlurb(c.Key) in the @(DoctrineWords.Slot(c.Slot).ToLowerInvariant()) line.</span>
        <details class="dc-det">
            <summary>Details</summary>
            <span class="meta">Traits: @DoctrineWords.TraitList(c.Traits). Veterancy @c.Veterancy. Power @(c.PowerPct)%.</span>
        </details>
    </li>;

    private RenderFragment Spoils(RoundView v) => @<section class="dc-spoils" aria-label="Losses and spoils">
        @{
            var rec = v.Record;
            var lost = rec.Result.AttackerLosses.Sum(l => l.Lost);
            var theirLost = rec.Result.DefenderLosses.Sum(l => l.Lost);
        }
        <h3 class="dc-h3">Losses and spoils</h3>
        <ul class="dc-list">
            <li>You brought @v.YourSoldiers soldiers and lost @lost. The enemy brought @v.EnemySoldiers and lost @theirLost.</li>
            <li>Spoils: @rec.Spoils.Gold gold@(rec.Spoils.Experience > 0 ? $" and {rec.Spoils.Experience} veterancy step{(rec.Spoils.Experience == 1 ? "" : "s")}" : "").</li>
            <li>Your doctrine: @DoctrineWords.Orders(rec.PlayerDoctrine).</li>
            @if (rec.Orders is { Skipped: > 0 } ord)
            {
                <li class="dc-applied">@ord.Applied of your @(ord.Applied + ord.Skipped) army orders @(ord.Applied == 1 ? "was" : "were") applied. The army skipped @ord.Skipped that @(ord.Skipped == 1 ? "was" : "were") not legal when @(ord.Skipped == 1 ? "its" : "their") turn came.</li>
            }
            @if (!rec.Ghost.IsEmpty)
            {
                <li>Your general suggested: @DoctrineWords.Orders(rec.Ghost) (match record @rec.GhostConfidence of 1000). @(rec.Overrode ? "You set something different." : "You took it as it stood.")</li>
            }
            @if (rec.IllegalDropped > 0) { <li>@rec.IllegalDropped order@(rec.IllegalDropped == 1 ? "" : "s") were not legal and were dropped.</li> }
        </ul>
    </section>;

    // ---- the general panel (right) ----
    private RenderFragment GeneralSheet => @<aside id="dc-general" class="dc-sheet dc-generalpanel @(_sheet == Sheet.General ? "open" : "")" aria-label="Your general">
        @Grip("General", CloseSheet)
        <h2>Your general</h2>
        @if (InDoctrine && _s!.Ghost is { } ghost && !ghost.Doctrine.IsEmpty && !_ghostHidden)
        {
            var slotRec = ghost.SlotConfidence;
            bool fits = DoctrineUnlocks.AllowsAll(ghost.Doctrine, Level);
            <section class="dc-ghost" style="--glow:@Glow(PanelGlow(ghost))" aria-label="Your general's suggestion">
                <h3 class="dc-h3">Your general suggests</h3>
                <ol class="dc-ghostchips">
                    @for (int sl = 0; sl < DoctrineVocabulary.MaxSlots; sl++)
                    {
                        int t = ghost.Doctrine[sl];
                        if (t == 0) continue;
                        if (slotRec is { } sr)
                        {
                            <li class="dc-ghostslot" data-slot="@sl" style="--glow:@Glow(sr[sl])">@DoctrineWords.Label(t) <span class="dc-slotrec">Match record <b>@sr[sl]</b> of 1000 on this slot</span></li>
                        }
                        else
                        {
                            <li class="dc-ghostslot" data-slot="@sl">@DoctrineWords.Label(t)</li>
                        }
                    }
                </ol>
                <p class="dc-conf">Match record <b>@ghost.ConfidencePermille</b> of 1000: a score for how well its whole suggestion has matched what you then chose, over your recent choices. It starts low and climbs as the matches keep coming.</p>
                @if (!fits) { <p class="hint dc-ghostlock">Part of this suggestion uses orders or slots that are not open yet, so it cannot be used as it stands. Edit it to keep the open ones.</p> }
                <div class="dc-ghostbtns">
                    <button type="button" class="dc-btn strong" id="dc-accept" disabled="@(!fits)" @onclick="() => Accept(ghost)">Use it</button>
                    <button type="button" class="dc-btn" id="dc-edit" @onclick="() => EditGhost(ghost)">Edit</button>
                    <button type="button" class="dc-btn" id="dc-ignore" @onclick="IgnoreGhost">Mine</button>
                </div>
            </section>
        }
        else if (InDoctrine && _s!.Ghost is { } g0 && g0.Doctrine.IsEmpty)
        {
            <p class="hint dc-noghost">@(_s.Sections.General.ExamplesSeen == 0
                ? "Your general starts empty, so it has no suggestion yet. Set a doctrine; it learns from every one you set."
                : "Your general has no suggestion for this army yet. Set a doctrine; it learns from every one you set.")</p>
        }
        else if (!InDoctrine)
        {
            <p class="hint">Its suggestion arrives when you set a doctrine.</p>
        }
        <p class="dc-examples">General: @_s!.Sections.General.ExamplesSeen @(_s.Sections.General.ExamplesSeen == 1 ? "example" : "examples") seen (each doctrine you set and each battle result)</p>
    </aside>;

    // ---- the chronicle (right of the field on a wide screen, a sheet on a phone) ----
    private RenderFragment ChronicleSheet => @<aside id="dc-chronicle" class="dc-sheet dc-chroniclepanel @(_sheet == Sheet.Chronicle ? "open" : "")" aria-label="Battle chronicle">
        @Grip("Chronicle", CloseSheet)
        <DoctrineChronicle Chronicle="_chron" Cursor="_cursor" LastTick="@Math.Max(0, _s!.Last!.Record.Replay.Frames.Count - 1)" />
    </aside>;

    private RenderFragment Grip(string title, Action close) => @<button type="button" class="dc-grip" aria-label="Close the @title panel"
            @onpointerdown="DragStart" @onpointerup="e => DragClose(e, close)" @onclick="() => ClickClose(close)">
        <span class="bar" aria-hidden="true"></span><span class="lab">@title</span><span class="x" aria-hidden="true">Close</span>
    </button>;

    // ---- the field (centre) ----
    private RenderFragment FieldView => @<div class="dc-fieldin">
        @if (_s!.Stage == DoctrineStage.Watch && _s.Last is { } v)
        {
            <DoctrineArena Replay="v.Record.Replay" Layout="v.Layout" Cursor="_cursor" />
        }
        else if (_s.Stage == DoctrineStage.Working)
        {
            <div class="dc-working" id="dc-working" role="status" aria-live="polite" aria-label="Working">
                <h2>@(_s.Status.Length > 0 ? _s.Status : "Working")</h2>
                @if (_s.BattleTick > 0)
                {
                    <progress class="dc-progress" max="@_s.BattleTickLimit" value="@_s.BattleTick">Tick @_s.BattleTick</progress>
                    <p class="hint">Tick @_s.BattleTick of up to @_s.BattleTickLimit. The battle ends sooner if one side falls.</p>
                }
                <p class="hint">This runs on your device, in small steps.</p>
            </div>
        }
        else if (_s.Army is { } army)
        {
            <div class="dc-line" aria-label="Your three lines">
                <p class="hint">Your three lines, back to front, with the enemy facing your front line. A field order goes to a whole line; a line with no order advances.</p>
                <div class="dc-lines">
                    @* back to front, left to right: your side starts on the left and the enemy on the right *@
                    @for (int sl = DoctrineVocabulary.Groups - 1; sl >= 0; sl--)
                    {
                        int slot = sl;
                        var inLane = army.Cohorts.Where(c => c.Slot == slot).ToList();
                        int biggest = Math.Max(1, army.Cohorts.Select(c => c.Count).DefaultIfEmpty(1).Max());
                        <div class="dc-lane" data-slot="@slot">
                            <b>@DoctrineWords.Slot(slot) line</b>
                            @if (inLane.Count == 0) { <span class="hint">empty</span> }
                            @foreach (var c in inLane)
                            {
                                bool named = DoctrineUnlocks.KindOpen(c.Key, Level);
                                <span class="dc-disc" style="--w:@(c.Count * 100 / biggest)"><i>@(named ? DoctrineWords.KindName(c.Key) : "Other")</i> <b>@c.Count</b></span>
                            }
                        </div>
                    }
                    <div class="dc-foe" aria-label="The enemy">The enemy stands here</div>
                </div>
            </div>
        }
    </div>;

    // ---- the unlock announcement ----
    private RenderFragment UnlockCard(UnlockNews n) => @<section class="dc-unlock" role="dialog" aria-label="New this round">
        @if (n.Orders.Count > 0) { <p class="dc-unlock-line">@((n.Orders.Count == 1 ? "New order: " : "New orders: ") + string.Join(", ", n.Orders) + ".")</p> }
        @if (n.Orders.Count > 0)
        {
            <ul class="dc-unlock-fx">
                @foreach (var o in n.Orders) { <li><b>@o</b>: @DoctrineUnlocks.Effect(o)</li> }
            </ul>
        }
        @if (n.NewSlotCount is { } sc) { <p class="dc-unlock-line">@("New slot: " + sc + ".")</p> }
        @if (n.Kinds.Count > 0) { <p class="dc-unlock-line">@("New soldiers: " + string.Join(", ", n.Kinds) + ".")</p> }
        <button type="button" class="dc-btn strong" id="dc-unlock-ok" @onclick="() => _news = null">Got it</button>
    </section>;

    // ---- the draft drawer (opens over the army panel) ----
    private int Cost() => Enumerable.Range(0, Roster.Size).Sum(k => _buy[k] * Roster.PriceOf(k));
    private IReadOnlyList<DraftPick> Picks() => Enumerable.Range(0, Roster.Size).Where(k => _buy[k] > 0).Select(k => new DraftPick(k, _buy[k])).ToList();

    private async Task RefreshPreview()
    {
        int seq = ++_previewSeq;
        var p = await _s!.PreviewDraftAsync(Picks());
        if (seq != _previewSeq) return;
        _preview = p;
        await InvokeAsync(StateHasChanged);
    }

    private void Step(int kind, int delta)
    {
        _buy[kind] = Math.Clamp(_buy[kind] + delta, 0, 99);
        _advice = "";
        _ = RefreshPreview();
    }

    private void UseDraftAdvice()
    {
        if (_s?.Army is not { } a) return;
        var adv = DoctrineGuide.Draft(a, Level);
        Array.Clear(_buy);
        if (adv is null) { _advice = DoctrineGuide.AdvicePrefix + " nothing to buy with this gold."; _ = RefreshPreview(); return; }
        foreach (var p in adv.Picks) _buy[p.Kind] = p.Count;
        _advice = adv.Reason;
        _ = RefreshPreview();
    }

    private RenderFragment DraftDrawer => @<section class="dc-sheet dc-draft @(_sheet == Sheet.Draft ? "open" : "")" aria-label="Draft">
        @Grip("Draft", CloseSheet)
        @if (_s!.Draft is { } d)
        {
            <h2>Draft <span class="dc-sub">you have @d.Army.Gold gold</span></h2>
            <p class="hint">Buy soldiers for the coming battle. A kind you already hold joins its cohort; a new kind starts one. The army itself decides what it will accept.</p>
            <button type="button" class="dc-btn dc-advicebtn" id="dc-advice-btn" @onclick="UseDraftAdvice">Use starter advice</button>
            @if (_advice.Length > 0) { <p class="dc-advice">@_advice</p> }
            @if (d.Army.Soldiers == 0) { <p class="dc-notice" role="status">Your army has no soldiers left. Spend your gold on cohorts: a battle needs soldiers.</p> }
            <ul class="dc-roster">
                @for (int k = 0; k < Roster.Size; k++)
                {
                    int kind = k;
                    if (!DoctrineUnlocks.KindOpen(kind, Level)) continue;
                    <li class="dc-kind">
                        <span class="nm">@Roster.NameOf(kind)</span>
                        <span class="meta">@DoctrineWords.KindBlurbCap(kind), @Roster.PriceOf(kind) gold each</span>
                        <span class="dc-step">
                            <button type="button" class="dc-btn dc-minus" aria-label="One fewer @Roster.NameOf(kind)" disabled="@(_buy[kind] == 0)" @onclick="() => Step(kind, -1)">-</button>
                            <span class="dc-n" aria-live="polite">@_buy[kind]</span>
                            <button type="button" class="dc-btn dc-plus" aria-label="One more @Roster.NameOf(kind)" @onclick="() => Step(kind, 1)">+</button>
                        </span>
                    </li>
                }
            </ul>
            @if (Enumerable.Range(0, Roster.Size).Any(k => !DoctrineUnlocks.KindOpen(k, Level)))
            {
                <p class="hint dc-lockedhint">More kinds of soldier arrive in later rounds.</p>
                <button type="button" class="dc-btn dc-showall" id="dc-showall" @onclick="ShowEverything">Show everything</button>
            }
            <p class="dc-sum">This draft costs @Cost() of @d.Army.Gold gold.</p>
            @if (_preview is { } pv)
            {
                @if (pv.Report.Refused.Count > 0)
                {
                    <ul class="dc-refused" role="alert">
                        @foreach (var (pick, why) in pv.Report.Refused)
                        {
                            <li>@DoctrineWords.KindName(pick.Kind) x@(pick.Count): @DoctrineWords.Refusal(why)</li>
                        }
                    </ul>
                }
                <p class="hint dc-after">After the picks the army would hold @pv.After.Soldiers soldiers in @pv.After.Kinds of @Roster.Size kinds (the command span), with @(pv.After.Legal.Count - 1) orders legal.</p>
            }
        }
    </section>;

    // ---- the order tray ----
    private static IReadOnlyList<int> Tokens(ArmyOrderKind k)
    {
        var l = new List<int>();
        for (int t = 1; t < DoctrineVocabulary.Size; t++)
        {
            var o = DoctrineVocabulary.Decode(t);
            if (o.Family == OrderFamily.Army && (ArmyOrderKind)o.Kind == k) l.Add(t);
        }
        return l;
    }

    private void UseOrderAdvice()
    {
        if (_s?.Army is not { } a || !InDoctrine) return;
        var adv = DoctrineGuide.Orders(a, Level);
        Array.Clear(_slots);
        if (adv is null) { _advice = DoctrineGuide.AdvicePrefix + " no order to suggest for this army."; return; }
        int i = 0;
        foreach (var t in adv.Doctrine.Tokens) if (t != 0 && i < _slots.Length) _slots[i++] = t;
        _lastAdded = adv.Doctrine.Tokens.Last(t => t != 0);
        _advice = adv.Reason;
    }

    private RenderFragment Tray => @<section class="dc-tray" id="dc-tray" aria-label="Orders">
        @{ var legal = _s!.Army!.Legal; }
        <div class="dc-trayhead" @onpointerdown="DragStart" @onpointerup="e => DragClose(e, CloseTray)">
            <h2>Orders <span class="dc-sub">up to @SlotCount, in this order</span></h2>
            <button type="button" class="dc-btn dc-advicebtn" id="dc-advice-btn" @onclick="UseOrderAdvice">Use starter advice</button>
            <button type="button" class="dc-btn" id="dc-tray-close" aria-label="Close the orders" @onclick="CloseTray">Close</button>
        </div>
        <div class="dc-trayscroll">
            @if (_advice.Length > 0) { <p class="dc-advice">@_advice</p> }
            <p class="hint">Tap an order to put it in the first empty slot.</p>
            @if (_slots.Any(t => t != 0))
            {
                <ul class="dc-says">
                    @foreach (var t in _slots.Where(t => t != 0)) { <li>@DoctrineWords.Sentence(t)</li> }
                </ul>
            }
            <h3 class="dc-h3">Field orders</h3>
            @for (int g = 0; g < DoctrineVocabulary.Groups; g++)
            {
                @Palette(DoctrineWords.Slot(g) + " line", Enumerable.Range(0, 6).Select(f => DoctrineVocabulary.Field((FieldOrderKind)f, g)).ToList(), legal)
            }
            @if (Level >= 3)
            {
                <h3 class="dc-h3">Army orders</h3>
                @Palette("Rotate the line", Tokens(ArmyOrderKind.Rotate), legal, DoctrineUnlocks.Effect("Rotate"))
                @Palette("Flip a trait", Tokens(ArmyOrderKind.Flip), legal, DoctrineUnlocks.Effect("Flip"))
                @Palette("Age the veterans", Tokens(ArmyOrderKind.Age), legal, DoctrineUnlocks.Effect("Age"))
                @Palette("Merge a kind into the one before it", Tokens(ArmyOrderKind.Merge), legal, DoctrineUnlocks.Effect("Merge"))
                @Palette("Aura on a trait", Tokens(ArmyOrderKind.Aura), legal, DoctrineUnlocks.Effect("Aura"))
                @if (Level >= DoctrineUnlocks.LastStep)
                {
                    @if (Tokens(ArmyOrderKind.Cull).Any(legal.Allows)) { @Palette("Cull a trait", Tokens(ArmyOrderKind.Cull), legal) }
                    else { <p class="hint dc-cullnote">Cull is not offered on this army.</p> }
                }
            }
            <p class="hint">Greyed out means the army says that order is not legal right now.@(legal.Count <= 1 ? " With no soldiers in the army, no order is legal." : "") No orders is allowed: every line then advances.</p>
            @if (Locked)
            {
                <p class="hint dc-lockedhint">More orders arrive in later rounds.</p>
                <button type="button" class="dc-btn dc-showall" id="dc-showall" @onclick="ShowEverything">Show everything</button>
            }
        </div>
    </section>;

    private RenderFragment Palette(string title, IReadOnlyList<int> tokens, LegalMask legal, string? hint = null) => @<div class="dc-palette">
        @{ var open = tokens.Where(t => DoctrineUnlocks.Allows(t, Level)).ToList(); }
        @if (open.Count > 0)
        {
            <p class="dc-h3">@title</p>
            @if (!string.IsNullOrEmpty(hint)) { <p class="hint dc-palhint">@hint</p> }
            <div class="dc-chipgrid">
                @foreach (var tk in open)
                {
                    int token = tk;
                    bool ok = legal.Allows(token);
                    var ord = DoctrineVocabulary.Decode(token);
                    <button type="button" class="dc-chip @(ok ? "" : "off")" data-token="@token" disabled="@(!ok)" @onclick="() => AddToken(token)">
                        <span class="lb">@DoctrineWords.Label(token)</span>
                        @if (ord.Family == OrderFamily.Field) { <span class="fx">@DoctrineWords.FieldSentences[ord.Kind]</span> }
                    </button>
                }
            </div>
        }
    </div>;

    private void AddToken(int token)
    {
        // A greyed chip is disabled in the browser; this guard keeps both rules (the army's legal list, and what is open yet) even where a tap reaches a disabled button.
        if (_s?.Army is not { } a || !InDoctrine || !a.Legal.Allows(token) || !DoctrineUnlocks.Allows(token, Level)) return;
        for (int i = 0; i < SlotCount; i++) if (_slots[i] == 0) { _slots[i] = token; _lastAdded = token; _advice = ""; return; }
    }

    private void ClearSlot(int slot)
    {
        if (!InDoctrine) return;
        _slots[slot] = 0; _advice = "";
    }

    private void ClearAll() { if (!InDoctrine) return; Array.Clear(_slots); _advice = ""; _lastAdded = 0; }

    // ---- the ghost ----
    /// <summary>The glow of the whole panel: the general's per-slot match record averaged over the orders it shows, or the whole-suggestion figure when it gives no per-slot one.</summary>
    private static int PanelGlow(GeneralOutput g)
    {
        if (g.SlotConfidence is not { } sr) return g.ConfidencePermille;
        var shown = Enumerable.Range(0, DoctrineVocabulary.MaxSlots).Where(i => g.Doctrine[i] != 0).Select(i => sr[i]).ToList();
        return shown.Count == 0 ? g.ConfidencePermille : (int)shown.Average();
    }

    private static string Glow(int permille) => (Math.Clamp(permille, 0, 1000) / 1000.0).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private void Accept(GeneralOutput ghost)
    {
        if (!InDoctrine || !DoctrineUnlocks.AllowsAll(ghost.Doctrine, Level)) return;
        _s!.SubmitChoice(ghost.Doctrine, false);
    }

    private void EditGhost(GeneralOutput ghost)
    {
        Array.Clear(_slots);
        int i = 0;
        foreach (var t in ghost.Doctrine.Tokens) if (t != 0 && i < SlotCount && DoctrineUnlocks.Allows(t, Level)) _slots[i++] = t;
        _ghostHidden = true; _advice = ""; _lastAdded = 0;
        _sheet = Sheet.None; _tray = true;
    }

    private void IgnoreGhost() { _ghostHidden = true; Array.Clear(_slots); _advice = ""; _lastAdded = 0; _sheet = Sheet.None; _tray = true; }

    private void Fight(GeneralOutput ghost)
    {
        if (!InDoctrine) return;
        var d = new DoctrineSet(_slots[0], _slots[1], _slots[2], _slots[3]);
        _s!.SubmitChoice(d, d != ghost.Doctrine);
    }

    // ---- sheets: tap, or drag by the handle; never hover ----
    private void DragStart(PointerEventArgs e) { _dragFrom = e.ClientY; _dragged = false; }
    private void DragClose(PointerEventArgs e, Action close) { if (e.ClientY - _dragFrom >= 40) { _dragged = true; close(); } }
    private void DragOpen(PointerEventArgs e, Sheet which) { if (_dragFrom - e.ClientY >= 40) { _dragged = true; _sheet = which; _tray = false; } }
    private void ClickClose(Action close) { if (_dragged) { _dragged = false; return; } close(); }
    private void ToggleSheet(Sheet which)
    {
        if (_dragged) { _dragged = false; return; }
        _sheet = _sheet == which ? Sheet.None : which;
        if (_sheet != Sheet.None) _tray = false;
    }
    private void CloseSheet() => _sheet = Sheet.None;
    private void CloseTray() => _tray = false;
    private void OpenTray() { _tray = !_tray; if (_tray) _sheet = Sheet.None; }
    private void ToggleDraft() => _sheet = _sheet == Sheet.Draft ? Sheet.None : Sheet.Draft;

    // ---- the dock (bottom): the slots, then the one action of this stage ----
    private RenderFragment Dock => @<footer class="dc-dock @(InDoctrine ? "dc-editor" : "")" aria-label="Your orders">
        @if (_s!.Stage == DoctrineStage.Watch && _s.Last is { } v)
        {
            var rec = v.Record;
            var recap = DoctrineGuide.Of(v, _s.ArenaName(rec.ArenaId));
            <section class="dc-result" aria-label="Round result">
                <h2>Round @(rec.Round + 1): @DoctrineWords.OutcomeShort(rec.Result.Outcome) <span class="dc-sub">@_s.ArenaName(rec.ArenaId), @rec.Result.Ticks ticks</span></h2>
                <ul class="dc-recap">
                    @foreach (var line in recap.What) { <li class="dc-recap-what">@line</li> }
                    @if (recap.TryNext is { } tn) { <li class="dc-recap-try">@tn</li> }
                </ul>
            </section>
            <div class="dc-dockbtns">
                <button type="button" class="dc-btn strong dc-next" id="dc-next" @onclick="_s.NextRound">@(v.Last ? "See the end of the game" : "Next round")</button>
            </div>
        }
        else
        {
            @if (InDoctrine && !_tray && _lastAdded != 0 && _slots.Contains(_lastAdded)) { <p class="dc-lastsays">@DoctrineWords.Sentence(_lastAdded)</p> }
            <ol class="dc-slots">
                @for (int i = 0; i < SlotCount; i++)
                {
                    int slot = i;
                    string slotText = DoctrineWords.Label(_slots[slot]);
                    string slotAria = $"Slot {slot + 1}: {slotText}" + (_slots[slot] == 0 || !InDoctrine ? "" : ". Tap to clear.");
                    string slotCls = _slots[slot] == 0 ? "dc-slot empty" : "dc-slot";
                    <li>
                        <button type="button" class="@slotCls" aria-label="@slotAria" disabled="@(!InDoctrine)" @onclick="() => ClearSlot(slot)">
                            <span class="n">@(slot + 1)</span><span class="t">@slotText</span>
                        </button>
                    </li>
                }
            </ol>
            <div class="dc-dockbtns">
                @switch (_s.Stage)
                {
                    case DoctrineStage.Draft:
                        <button type="button" class="dc-btn" id="dc-draftbtn" aria-expanded="@(_sheet == Sheet.Draft ? "true" : "false")" @onclick="ToggleDraft">Draft</button>
                        <button type="button" class="dc-btn strong" id="dc-confirm" @onclick="ConfirmDraft">@(Cost() == 0 ? "Keep the army as it is" : "Confirm the draft")</button>
                        break;
                    case DoctrineStage.Doctrine:
                        <button type="button" class="dc-btn" id="dc-orders" aria-expanded="@(_tray ? "true" : "false")" @onclick="OpenTray">Orders</button>
                        <button type="button" class="dc-btn" id="dc-clear" @onclick="ClearAll">Clear</button>
                        <button type="button" class="dc-btn strong dc-go" id="dc-fight" @onclick="() => Fight(_s.Ghost!)">GO</button>
                        break;
                    case DoctrineStage.Working:
                        <button type="button" class="dc-btn" id="dc-cancel" @onclick="_s.CancelBattle">Cancel</button>
                        break;
                }
            </div>
        }
    </footer>;

    private void ConfirmDraft() => _s!.SubmitDraft(Picks());

    // ------------------------------------------------------------------------------------------------------- over
    private RenderFragment OverView => @<div>
        @if (_s!.Result is { } r)
        {
            int won = r.Rounds.Count(x => x.Result.Outcome == BattleStatus.AttackerWon), lost = r.Rounds.Count(x => x.Result.Outcome == BattleStatus.DefenderWon), drawn = r.Rounds.Count - won - lost;
            <section class="dc-panel dc-end" aria-label="The end of the game">
                <h2>The game is over</h2>
                <p class="dc-says">@r.Rounds.Count @(r.Rounds.Count == 1 ? "round" : "rounds") played: @won won, @lost lost, @drawn drawn. Game seed @r.Seed.</p>
                @if (r.Rounds.Count > 0)
                {
                    <ol class="dc-rounds-list">
                        @foreach (var x in r.Rounds)
                        {
                            <li>Round @(x.Round + 1), @DoctrineWords.OutcomeShort(x.Result.Outcome): @DoctrineWords.Orders(x.PlayerDoctrine)@(x.Overrode ? "" : " (general's suggestion)")</li>
                        }
                    </ol>
                }
                <h3 class="dc-h3">Your army code</h3>
                <p><code class="dc-armycode" id="dc-armycode">@r.PlayerArmyCode</code></p>
                <div class="dc-ghostbtns">
                    <button type="button" class="dc-btn" id="dc-copy" @onclick="() => Copy(r.PlayerArmyCode)">Copy the code</button>
                </div>
                @if (_copied.Length > 0) { <p class="hint" role="status">@_copied</p> }
                <p class="hint">Paste it on the start screen to play on with this army. It holds the army only. Your general is not in it, and a refresh forgets the general.</p>
                <p class="hint">Your general has seen @_s.Sections.General.ExamplesSeen @(_s.Sections.General.ExamplesSeen == 1 ? "example" : "examples") (each doctrine you set and each battle result) since you opened this page.</p>
            </section>
            <div class="dc-endbtns">
                <button type="button" class="dc-btn strong" id="dc-again" @onclick="() => PlayOn(r)">Play on with this army</button>
                <button type="button" class="dc-btn" id="dc-fresh" @onclick="_s.BackToStart">Back to the start</button>
            </div>
        }
    </div>;

    private void PlayOn(GameResult r)
    {
        _s!.BackToStart();
        _loadError = "";
        _news = null;
        if (!_s.NewGame((int)(Environment.TickCount64 & 0x7fffffff), _s.TotalRounds, r.PlayerArmyCode, out var why)) _loadError = why;
    }

    private async Task Copy(string text)
    {
        try { await JS.InvokeVoidAsync("copyText", text); _copied = "Copied. Paste it on the start screen to load this army."; }
        catch (JSException) { _copied = "Your browser would not copy it. Select the code and copy it by hand."; }
        catch (InvalidOperationException) { _copied = "Your browser would not copy it. Select the code and copy it by hand."; }
    }
}
