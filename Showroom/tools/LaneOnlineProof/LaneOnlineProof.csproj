<Project Sdk="Microsoft.NET.Sdk">
  <!-- Proof for the online lane battle (the lobby and human against human): the service is compiled straight from Services/Doctrine/Lane (the match, seats, view) and
       Services/Doctrine/Lane/Online (wire, lobby, session) plus the Plenum relay files it reuses (MqttWsRelay, MqttCodec, PlenumRelay with its in-memory broker, PlenumClock);
       the game is the sibling Doctrine library. Default run (offline, a few minutes): the wire, create and join and the lobby list, commit and reveal (and a tampered reveal), a
       whole match on two in-process clients over the in-memory broker with identical hashes (and the same hashes as an offline replay of the same plays), a hash mismatch that
       stops the match, missed pauses and the grace, the end after three in a row, a dropped connection and a rejoin, a player who leaves, duplicate and out-of-order and replayed
       messages, lobby expiry, every topic under plenum/v1/doctrine-lane/, a rematch with the sides swapped, the mirrored view, and mutants that must each turn a check red.
       The argument "live" (dotnet run -c Release then live after the double hyphen) runs ONE short online match against the public relay under plenum/v1/doctrine-lane/ with a unique
       room code on a sped-up clock and cleans up after itself; it is never part of the default run. The argument "sweep" lists what is retained under plenum/v1/doctrine-lane/
       and clears only the leftovers of that smoke (codes of the form ZT plus eight hex digits).
       Exit code 0 = every check passed and every mutant was caught. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Services\Doctrine\Lane\*.cs" LinkBase="Lane" />
    <Compile Include="..\..\Services\Doctrine\Lane\Online\*.cs" LinkBase="Online" />
    <Compile Include="..\..\Services\Plenum\MqttWsRelay.cs" LinkBase="Plenum" />
    <Compile Include="..\..\Services\Plenum\MqttCodec.cs" LinkBase="Plenum" />
    <Compile Include="..\..\Services\Plenum\PlenumRelay.cs" LinkBase="Plenum" />
    <Compile Include="..\..\Services\Plenum\PlenumClock.cs" LinkBase="Plenum" />
    <ProjectReference Include="..\..\..\Doctrine\Doctrine.csproj" />
  </ItemGroup>
</Project>
