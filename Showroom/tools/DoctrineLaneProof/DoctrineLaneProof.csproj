<Project Sdk="Microsoft.NET.Sdk">
  <!-- Proof and cost table for the Doctrine lane battle (the battler layer, Doctrine\Lane). No UI, no network. Default run (offline, well under a minute): determinism at every
       pause, phase-split equivalence, plays applied only at a pause and with the intended effect, survivors persisting across pauses, win, draw and cap, the hash changing
       when any one body or base hit point differs, the replay (plays + seed) round trip, the counter ring, and mutants that must each turn a check red.
       The argument "cost" prints the milliseconds-per-tick table at 20, 60, 120 and 240 live bodies and the replay sizes (plays + seed against snapshots).
       Exit code 0 = every check passed and every mutant was caught. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The playable match (Showroom\Services\Doctrine\Lane: economy, seats, the bot, the real-time match, the canvas packet) is compiled straight in, so the proof checks the files the page runs.
         The argument "hashes" then a seed plays a whole bot against bot match and prints the short hash at every pause, to compare with the page's hash line in a browser. -->
    <Compile Include="..\..\Services\Doctrine\Lane\*.cs" LinkBase="LaneService" />
    <ProjectReference Include="..\..\..\Doctrine\Doctrine.csproj" />
  </ItemGroup>
</Project>
