<Project Sdk="Microsoft.NET.Sdk">
  <!-- UI proof for the lane battle's development page: renders the REAL page (Showroom.Pages.LaneBattlePage, from the built Showroom.dll) under bUnit with a loose JS stand-in (no browser is
       launched), taps through a pause, the run and the next pause, and checks that the page's hash line is the one a bot against bot batch run gives, the words and the phone CSS rules.
       Build Showroom (Release) first. Usage: dotnet run -c Release (project tools/LaneUiProof). Exit code 0 = every check passed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="bunit" Version="2.11.3" />
    <Reference Include="Showroom"><HintPath>..\..\bin\Release\net10.0\Showroom.dll</HintPath></Reference>
    <ProjectReference Include="..\..\..\Doctrine\Doctrine.csproj" />
    <PackageReference Include="EvaluatedApplications.Blazier" Version="1.0.0" />
  </ItemGroup>
</Project>
