<Project Sdk="Microsoft.NET.Sdk">

  <!-- Proof for the Helix tool. It links the pure files the page itself runs (Services/Helix/*.cs) and embeds the two source files the way
       Showroom.csproj does, so the text the page shows is checked here. It then renders the page's console program, compiles it against
       the published package, runs it, and compares its numbers with an in-process run of the same stages.
       Usage (a correctness check, small by default, not a benchmark): dotnet run -c Release, project tools/HelixProof, argument = demo rows (600). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Services\Helix\*.cs" LinkBase="Linked" />
    <EmbeddedResource Include="..\..\Services\Helix\HelixAnalysis.cs" LogicalName="HelixAnalysis.cs" />
    <EmbeddedResource Include="..\..\Services\Helix\HelixDemoData.cs" LogicalName="HelixDemoData.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EvaluatedApplications.HoloGenome" Version="0.2.0" />
  </ItemGroup>

</Project>
