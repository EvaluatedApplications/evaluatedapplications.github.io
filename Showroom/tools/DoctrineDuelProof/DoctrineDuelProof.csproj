<Project Sdk="Microsoft.NET.Sdk">
  <!-- Proof for the Doctrine duel service (no UI). The service is compiled straight from Services/Doctrine/Duel (the files the page will use) plus the Plenum relay files it
       reuses (MqttWsRelay, MqttCodec, PlenumRelay, PlenumClock); the game is the sibling Doctrine library.
       Default run (offline, under a minute): the wire, then full duels between two in-process clients over the in-memory broker (a real 3-round duel on the Pleroma army and
       the Tracer battle, a chunked result, timeouts, a tampered reveal, duplicates and out-of-order messages, a dropped connection and a resync from retained state, the host
       leaving, a rematch, refusals), and mutants that must each turn a check red. The argument "live" (dotnet run -c Release then live after the double hyphen) runs ONE
       live duel against the public relay in plenum/v1/doctrine/ under a unique room code and cleans up after itself; it is never part of the default run.
       Exit code 0 = every check passed and every mutant was caught. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Services\Doctrine\Duel\*.cs" LinkBase="Duel" />
    <Compile Include="..\..\Services\Plenum\MqttWsRelay.cs" LinkBase="Plenum" />
    <Compile Include="..\..\Services\Plenum\MqttCodec.cs" LinkBase="Plenum" />
    <Compile Include="..\..\Services\Plenum\PlenumRelay.cs" LinkBase="Plenum" />
    <Compile Include="..\..\Services\Plenum\PlenumClock.cs" LinkBase="Plenum" />
    <ProjectReference Include="..\..\..\Doctrine\Doctrine.csproj" />
  </ItemGroup>
</Project>
