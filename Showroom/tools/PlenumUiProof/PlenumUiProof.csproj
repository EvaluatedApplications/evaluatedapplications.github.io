<Project Sdk="Microsoft.NET.Sdk">
  <!-- UI proof for The Plenum: renders the REAL page (Showroom.Pages.Plenum, from the built Showroom.dll) under bUnit, drives it the way a
       visitor taps (no browser is launched), plays the scripted three-play win, and checks the layout rules that can be checked without a
       browser (viewport meta, 44px tap targets, no fixed widths above 360px, media queries, no hover rules, no title tooltips).
       Build Showroom (Release) first. Usage: dotnet run -c Release (project tools/PlenumUiProof). Exit code 0 = every check passed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="bunit" Version="2.11.3" />
    <Reference Include="Showroom"><HintPath>..\..\bin\Release\net10.0\Showroom.dll</HintPath></Reference>
    <PackageReference Include="EvaluatedApplications.Phasor" Version="2.19.1" />
    <PackageReference Include="EvaluatedApplications.Blazier" Version="1.0.0" />
  </ItemGroup>
</Project>
