<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- EXPERIMENT (2026-08-28, testing the user's own hunch that AOT is worth it for this app's numeric
         hot loops): AOT only affects `dotnet publish`, not `dotnet run`/the dev server. AOT requires
         PublishTrimmed=true, so also testing whether the old "EvalApp step factory reflection" trim
         blocker is actually still true: EvalApp was fixed to be trim-safe (a `new()` constraint on
         its step-builder generics) earlier THIS session, so the comment this replaces may be stale. -->
    <!-- TRIM + AOT DISABLED 2026-09-06 to restore a DOWN site, deliberately and temporarily.
         Symptom: /tools/prism loaded every assembly, compiled the WebAssembly module in 156ms, then
         froze on the boot screen forever. Prism.razor's own checkpoint-fetch narration never printed,
         so the app died between Blazor.start() and the first component rendering, i.e. before any
         model code ran. Bundle delivery was ruled out: every assembly present, correct size, all 200
         from the live host, nothing zero-length.
         That leaves a startup-time runtime failure, and trimming/AOT is by far the largest source of
         those, because both fail at RUN time rather than build time and nothing in a green build tells
         you. This app's own csproj comment (above) records that trimming was only ever enabled as an
         EXPERIMENT, on the assumption a since-fixed EvalApp reflection blocker no longer applied.
         EvalApp still emits real IL2026/IL2087/IL2090 trim warnings (JsonSerializer,
         Activator.CreateInstance, Type.GetProperties) that the trimmer cannot see through, and the
         dependency graph changed twice recently (HoloKernel onto the Prism package, then ILGPU
         removed), which is exactly what reshapes a trim graph.
         Cost of turning it off is real but bounded: a bigger download and slower numeric loops. The
         benefit is that a non-trimmed, non-AOT WASM build runs the same code path as `dotnet run`,
         which has never exhibited this. A working slow tool beats a fast broken one.
         RunAOTCompilation REQUIRES PublishTrimmed, so both move together.
         RE-ENABLE only after reproducing the failure in a browser and fixing the real root cause,
         with a trim descriptor or an explicit root, not by flipping this back and hoping. -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- -O2 (the Release default) makes the emcc/wasm-opt link step OOM-fail on this dev machine whenever
         PrismStudio is also running its own live training (which holds about 15 GB resident): confirmed
         reproducible across four failed attempts, always dying at the identical wasm-opt invocation, and
         confirmed fixed by dropping to -O1 (tested successfully at 5 GB free RAM with PrismStudio still
         running). Real, measured tradeoff: dotnet.native.wasm grows about 24.8 MB to about 27.0 MB raw,
         roughly 9% bigger, worth it to never need to interrupt live training for a site rebuild again. -->
    <EmccLinkOptimizationFlag>-O1</EmccLinkOptimizationFlag>
    <!-- REAL WASM MULTITHREADING — REVERTED 2026-08-28 (same day it landed), real device regression.
         Was <WasmEnableThreads>true</WasmEnableThreads> (pthreads over SharedArrayBuffer, gated behind
         window.crossOriginIsolated via wwwroot/coi-serviceworker.js + the index.html boot-gate script).
         First real device report: Continue button on /tools/prism stuck permanently disabled — but
         ONLY on a laptop; a phone loaded the exact same deploy fine. That platform split is the tell:
         the .NET WASM threaded runtime sizes/spins up its pthread worker pool from
         navigator.hardwareConcurrency at boot, and a laptop routinely reports far more logical cores
         than a phone — more workers means more redundant WASM-module fetch/compile/instantiate cycles
         racing in the background right after Blazor.start() resolves and the page paints (this repo's
         own AlgFormer/HoloDb "the fan-out is width-1 at our shapes" finding, ParallelMapping.cs, already
         proved NOTHING in this app's own code dispatches work across threads — the risk was 100% the
         runtime's own boot-time thread-pool machinery, zero app benefit). Emscripten-based multithreaded
         WASM runtimes have a documented deadlock class here too: worker→main-thread calls proxy through
         a synchronous Atomics.wait, which can stall if the main thread's event loop is itself busy
         servicing the worker-spawn/compile queue at that exact moment — a race whose odds scale with
         worker count, i.e. with core count, i.e. exactly a laptop-not-phone split. Genuinely could not
         verify the deadlock live (no browser here, per this repo's own boundary) — but with ZERO current
         consumers of real threading in this app (verified, see HoloKernel/ParallelMapping.cs) this was
         already flagged in Showroom/CLAUDE.md as "the cheapest option of all... pure downside for zero
         benefit right now" BEFORE this incident; the incident is exactly the trigger that was flagged as
         missing. Reverting removes the entire failure class at zero feature cost, and as a side effect
         also removes the ORIGINAL reason the crossOriginIsolated boot-gate/coi-serviceworker existed at
         all (a non-threaded module has no SharedArrayBuffer requirement, so it boots in any browser,
         including the LinkedIn in-app WebView that motivated the gate in the first place) — see
         index.html for the matching simplification. Re-enable only once a real training loop actually
         dispatches across threads (today: none do) AND this exact regression has been reproduced/fixed
         live on a real high-core-count laptop, not just re-flagged as a hunch. -->
    <WasmEnableThreads>false</WasmEnableThreads>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.8" PrivateAssets="all" />
  </ItemGroup>

  <!-- HoloKernel: a sibling project IN THIS SAME REPO (AboutUs\HoloKernel), not MonoRepo — a ProjectReference
       here is the designed consumption path, not a boundary break. It is itself NuGet-only against AlgFormer
       (see its own csproj), so this repo's "never a MonoRepo ProjectReference" rule is unaffected. -->
  <ItemGroup>
    <ProjectReference Include="..\HoloKernel\HoloKernel.csproj" />
  </ItemGroup>

  <!-- The showroom runs our real published libraries client-side (browser-wasm): HoloDb (in-memory SQL),
       AlgFormer (tiny learning model), Tracer (navigation) — straight from NuGet, exactly what a user gets.
       EvalApp comes transitively. Versions are set by `dotnet add package` (latest published). -->
  <ItemGroup>
    <PackageReference Include="EvaluatedApplications.HoloDb">
      <Version>1.4.0</Version>
    </PackageReference>
    <PackageReference Include="EvaluatedApplications.AlgFormer">
      <Version>2.4.0</Version>
    </PackageReference>
    <PackageReference Include="EvaluatedApplications.Tracer">
      <Version>1.1.0</Version>
    </PackageReference>
  </ItemGroup>

</Project>
