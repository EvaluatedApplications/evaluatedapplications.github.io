@using System.Globalization
@using System.Text
@using System.Text.Json
@using HoloKernel
@using Showroom.Services.PrismTab
@inject HttpClient Http
@* The Forecaster tab: the SAME Prism checkpoint, pointed at a real hourly AAPL tape written as words (ForecasterTask).
   The tape is a stored snapshot (wwwroot/data/forecaster-history.json); nothing here fetches a live price. Playing and training are ONE act:
   each beat guesses, reveals the real candle, and trains the visitor's copy on it (PrismTaskLab runs the beats). *@

@if (_loadError is not null)
{
    <p class="err">@_loadError</p>
}
else if (_task is null)
{
    <p class="hint">Loading the price tape…</p>
}
else
{
    <div class="fc-source">
        <span class="fc-src-label">Price tape</span>
        <span class="fc-src-name">AAPL, hourly, @_task.Candles.Count.ToString("N0", CultureInfo.InvariantCulture) candles</span>
        <span class="fc-src-note">@Stamp(_task.Candles[0].T) to @Stamp(_task.Candles[^1].T). <strong>Data as of @Stamp(_task.Candles[^1].T).</strong> A stored snapshot, not a live price.</span>
    </div>

    <section class="tl-panel tl-intro">
        <h3>What the model reads</h3>
        <p class="tl-copy">Each hour's move becomes a word (<code>up</code>, <code>down</code>, <code>flat</code>). Every beat the model sees the recent words and guesses the next one, the real candle lands, and it trains on it. Then it steps on through the tape. Not investment advice.</p>
        <pre class="tl-prompt" aria-label="the text the model reads">@(_beat is null ? _sample.Prompt : _task.Prompt(_beatTarget))</pre>
    </section>

    <section class="tl-panel" aria-labelledby="fc-stage-title">
        <h3 id="fc-stage-title">The tape</h3>
        @if (_beat is not null)
        {
            <div class="fc-stage">
                @((MarkupString)ChartSvg(_beat))
                <div class="fc-predict-strip" @key="_beatId">
                    <span class="fc-predict-dir dir-@(_beat.PredUp ? "up" : "down")">@(_beat.PredUp ? "▲" : "▼")</span>
                    <span class="fc-predict-label">The model guesses <strong>@(_beat.PredUp ? "up" : "down")</strong>
                        (up @((_beat.PUp * 100).ToString("F0", CultureInfo.InvariantCulture))%, down @(((1 - _beat.PUp) * 100).ToString("F0", CultureInfo.InvariantCulture))%)
                        @if (_beat.Revealed) { <span> The hour went <strong>@(_beat.ActualUp ? "up" : "down")</strong>, on @Stamp(_beat.Target.T).</span> } else { <span> Revealing…</span> }</span>
                    @if (!_beat.Revealed) { <div class="fc-countdown"><div class="fc-countdown-bar" style="animation-duration:@(_revealMs)ms"></div></div> }
                </div>
                @if (_beat.Revealed) { <div class="fc-flash fc-flash-@(_beat.Hit ? "win" : "lose")" @key="@("flash" + _beatId)">@(_beat.Hit ? "called it" : "missed it")</div> }
            </div>
        }
        else { <p class="hint">Press Run below.</p> }
    </section>

    <PrismTaskLab @ref="_lab" Model="Model" Job="_task" Tick="TickAsync" OnStopped="OnStopped" OnChanged="OnLabChanged">
        <label>History window (hours)
            <input type="number" step="1" min="@ForecasterTask.MinWindow" max="@ForecasterTask.MaxWindow" value="@_window" @onchange="OnWindow" disabled="@(_lab?.Running == true)" />
        </label>
    </PrismTaskLab>
}
@code {
    [Parameter, EditorRequired] public PrismModel Model { get; set; } = default!;

    ForecasterTask? _task;
    List<Candle>? _raw;
    int _window = ForecasterTask.DefaultWindow;
    TaskItem _sample = default!;
    PrismTaskLab? _lab;
    string? _loadError;
    int _pos;                 // next target index on the tape; the run walks it forward and wraps
    int _beatId, _beatTarget, _revealMs = 500;
    const int ReplayCap = 32;
    readonly List<TaskItem> _replay = new();

    sealed record Beat(Candle[] Window, Candle Target, bool PredUp, double PUp, bool Revealed, bool ActualUp, bool Hit);
    Beat? _beat;

    void OnWindow(ChangeEventArgs e)
    {
        if (_raw is null || !int.TryParse(e.Value?.ToString(), out var w)) return;
        _window = Math.Clamp(w, ForecasterTask.MinWindow, ForecasterTask.MaxWindow);
        _task = new ForecasterTask(_raw, _window);   // the lab starts over on the new task
        _sample = _task.ItemFor(_task.NextTarget(200));
        _beat = null; _pos = 0; _replay.Clear();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var opts = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var raw = await Http.GetFromJsonAsync<List<Candle>>("data/forecaster-history.json", opts) ?? new();
            _raw = raw;
            _task = new ForecasterTask(raw);
            _sample = _task.ItemFor(_task.NextTarget(200));
        }
        catch (Exception ex) { _loadError = "Couldn't load the price tape: " + ex.Message; }
    }

    protected override void OnAfterRender(bool firstRender) { if (firstRender && _task is not null) StateHasChanged(); }

    Task OnLabChanged() { StateHasChanged(); return Task.CompletedTask; }

    // Stop or Reset: back to the start of the tape.
    Task OnStopped() { _beat = null; _pos = 0; _replay.Clear(); StateHasChanged(); return Task.CompletedTask; }

    static string Stamp(long unix) => DateTimeOffset.FromUnixTimeSeconds(unix).UtcDateTime.ToString("d MMM yyyy HH:mm", CultureInfo.InvariantCulture) + " UTC";

    // ---- ONE act, one beat: show the window, the model guesses, a short countdown, the real candle lands, the step trains on it ----
    async Task<bool?> TickAsync(LabTick c)
    {
        var task = _task!;
        int t = task.NextTarget(_pos);
        _beatTarget = t;
        var item = task.ItemFor(t);
        c.Copy.ServeComposed();   // guess fully composed
        var logits = c.Scorer.LabelLogits(c.Copy.Session, item.Prompt);
        var probs = TextTaskScorer.Probabilities(logits, item.Allowed);
        bool predUp = TextTaskScorer.Pick(logits, item.Allowed) == 0;
        var window = Enumerable.Range(t - task.Window, task.Window).Select(i => task.Candles[i]).ToArray();
        _revealMs = Math.Max(100, 800 - c.Speed * 70);
        _beat = new Beat(window, task.Candles[t], predUp, probs[0], false, false, false);
        _beatId++;
        StateHasChanged();

        await Task.Delay(_revealMs, c.Ct).ContinueWith(_ => { });   // the countdown; Pause cuts it short and the beat is replayed on Resume
        if (c.Ct.IsCancellationRequested) return null;

        bool actualUp = item.Good[0], hit = predUp == actualUp;
        _beat = _beat with { Revealed = true, ActualUp = actualUp, Hit = hit };
        _replay.Add(item); if (_replay.Count > ReplayCap) _replay.RemoveAt(0);
        var batch = new List<TaskItem>(c.Examples) { item };
        for (int i = _replay.Count - 2; i >= 0 && batch.Count < c.Examples; i--) batch.Add(_replay[i]);
        c.Copy.TrainBatch(c.Scorer, batch, c.Rng);
        _pos = t + 1;
        StateHasChanged();
        await Task.Delay(Math.Max(60, 400 - c.Speed * 35), c.Ct).ContinueWith(_ => { });   // a moment for the reveal to be seen
        return hit;
    }

    // A small candlestick chart: the hours the model read, then the hour it was asked about (outlined once revealed).
    static string ChartSvg(Beat g)
    {
        const int w = 720, h = 170, axisBand = 22;
        int chartH = h - axisBand;
        var all = g.Revealed ? g.Window.Append(g.Target).ToArray() : g.Window;
        double maxP = all.Max(p => p.H), minP = all.Min(p => p.L);
        if (maxP <= minP) maxP = minP + 1;
        int n = all.Length;
        double slot = (double)w / (g.Window.Length + 1), bodyW = Math.Max(1.5, Math.Min(14, slot * 0.6));
        double Y(double price) => 8 + (chartH - 16) - (price - minP) / (maxP - minP) * (chartH - 16);
        string F(double v) => v.ToString("F1", CultureInfo.InvariantCulture);
        var sb = new StringBuilder();
        sb.Append($"<svg viewBox=\"0 0 {w} {h}\" preserveAspectRatio=\"none\" class=\"fc-chart-svg\">");
        sb.Append($"<line class=\"fc-axis-line\" x1=\"0\" y1=\"{chartH}\" x2=\"{w}\" y2=\"{chartH}\"/>");
        for (int i = 0; i < n; i++)
        {
            var p = all[i];
            double cx = slot * i + slot / 2;
            double top = Math.Min(Y(p.O), Y(p.C)), bh = Math.Max(1.2, Math.Abs(Y(p.C) - Y(p.O)));
            string dirCls = p.C >= p.O ? "up" : "down";
            string last = g.Revealed && i == n - 1 ? " target" : "";
            sb.Append($"<line class=\"fc-wick {dirCls}\" x1=\"{F(cx)}\" y1=\"{F(Y(p.H))}\" x2=\"{F(cx)}\" y2=\"{F(Y(p.L))}\"/>");
            sb.Append($"<rect class=\"fc-body {dirCls}{last}\" x=\"{F(cx - bodyW / 2)}\" y=\"{F(top)}\" width=\"{F(bodyW)}\" height=\"{F(bh)}\"/>");
        }
        foreach (var i in new[] { 0, n - 1 })
        {
            double cx = slot * i + slot / 2;
            string label = System.Net.WebUtility.HtmlEncode(DateTimeOffset.FromUnixTimeSeconds(all[i].T).UtcDateTime.ToString("MM/dd HH:mm", CultureInfo.InvariantCulture));
            sb.Append($"<text class=\"fc-axis-label\" x=\"{F(i == 0 ? cx + 18 : cx - 18)}\" y=\"{h - 5}\" text-anchor=\"middle\">{label}</text>");
        }
        sb.Append("</svg>");
        return sb.ToString();
    }
}