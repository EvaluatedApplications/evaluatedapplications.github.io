@using System.Globalization
@using System.Text
@using System.Text.Json
@using HoloKernel
@using Showroom.Services.PrismTab
@inject HttpClient Http
@* The Forecaster tab: the SAME Prism checkpoint, pointed at a real hourly AAPL tape written as words (ForecasterTask).
   The tape is a stored snapshot (wwwroot/data/forecaster-history.json); nothing here fetches a live price. Test as shipped,
   retrain a private copy (PrismTaskLab), then guess single held-out hours with whichever model is active. *@

@if (_loadError is not null)
{
    <p class="err">@_loadError</p>
}
else if (_task is null)
{
    <p class="hint">Loading the price tape…</p>
}
else
{
    <div class="fc-source">
        <span class="fc-src-label">Price tape</span>
        <span class="fc-src-name">AAPL, hourly, @_task.Candles.Count.ToString("N0", CultureInfo.InvariantCulture) candles</span>
        <span class="fc-src-note">@Stamp(_task.Candles[0].T) to @Stamp(_task.Candles[^1].T). <strong>Data as of @Stamp(_task.Candles[^1].T).</strong> A stored snapshot, not a live price.</span>
    </div>

    <section class="tl-panel tl-intro">
        <h3>What the model reads</h3>
        <p class="tl-copy">Each hour's move becomes a word (<code>up</code>, <code>down</code>, <code>flat</code>). The model sees the recent words and answers with the next one. Scores use the newest 20% of the tape; training uses the older 80%.</p>
        <pre class="tl-prompt" aria-label="a sample of the text the model reads">@_sample.Prompt</pre>
    </section>

    <PrismTaskLab @ref="_lab" Model="Model" Job="_task" Unit="held-out hours" OnChanged="OnLabChanged">
        <label>History window (hours)
            <input type="number" step="1" min="@ForecasterTask.MinWindow" max="@ForecasterTask.MaxWindow" value="@_window" @onchange="OnWindow" disabled="@(_lab?.Busy == true)" />
        </label>
    </PrismTaskLab>

    <section class="tl-panel" aria-labelledby="fc-guess-title">
        <h3 id="fc-guess-title">Guess one hour</h3>
        <p class="tl-copy">A random held-out hour: <strong>@(_lab?.IsPrivate == true ? "your copy" : "the shared model")</strong> calls it from the hours before, then the real candle is shown. Not investment advice.</p>
        <div class="tl-row">
            <button class="go" type="button" @onclick="GuessAsync" disabled="@(_lab is null || _lab.Busy || _guessing)">Guess a random hour</button>
            @if (_guessTotal > 0) { <span class="hint">@_guessHits of @_guessTotal called right in this session</span> }
        </div>
        @if (_guess is not null)
        {
            <div class="fc-stage">
                @((MarkupString)ChartSvg(_guess))
                <div class="fc-predict-strip">
                    <span class="fc-predict-dir dir-@(_guess.PredUp ? "up" : "down")">@(_guess.PredUp ? "▲" : "▼")</span>
                    <span class="fc-predict-label">The model said <strong>@(_guess.PredUp ? "up" : "down")</strong>
                        (up @((_guess.PUp * 100).ToString("F0", CultureInfo.InvariantCulture))%, down @(((1 - _guess.PUp) * 100).ToString("F0", CultureInfo.InvariantCulture))%).
                        The hour went <strong>@(_guess.ActualUp ? "up" : "down")</strong>, on @Stamp(_guess.Target.T).</span>
                </div>
                <div class="fc-flash fc-flash-@(_guess.Hit ? "win" : "lose")">@(_guess.Hit ? "called it" : "missed it")</div>
            </div>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public PrismModel Model { get; set; } = default!;

    ForecasterTask? _task;
    List<Candle>? _raw;
    int _window = ForecasterTask.DefaultWindow;

    void OnWindow(ChangeEventArgs e)
    {
        if (_raw is null || !int.TryParse(e.Value?.ToString(), out var w)) return;
        _window = Math.Clamp(w, ForecasterTask.MinWindow, ForecasterTask.MaxWindow);
        _task = new ForecasterTask(_raw, _window);   // the lab starts over on the new task
        _sample = _task.ItemFor(_task.HeldOut[_task.HeldOut.Count / 2]);
        _guess = null;
    }
    TaskItem _sample = default!;
    PrismTaskLab? _lab;
    string? _loadError;
    bool _guessing;
    int _guessHits, _guessTotal;
    readonly Random _rng = new();

    sealed record Guess(Candle[] Window, Candle Target, bool PredUp, double PUp, bool ActualUp, bool Hit);
    Guess? _guess;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var opts = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var raw = await Http.GetFromJsonAsync<List<Candle>>("data/forecaster-history.json", opts) ?? new();
            _raw = raw;
            _task = new ForecasterTask(raw);
            _sample = _task.ItemFor(_task.HeldOut[_task.HeldOut.Count / 2]);
        }
        catch (Exception ex) { _loadError = "Couldn't load the price tape: " + ex.Message; }
    }

    protected override void OnAfterRender(bool firstRender) { if (firstRender && _task is not null) StateHasChanged(); }

    Task OnLabChanged() { StateHasChanged(); return Task.CompletedTask; }

    static string Stamp(long unix) => DateTimeOffset.FromUnixTimeSeconds(unix).UtcDateTime.ToString("d MMM yyyy HH:mm", CultureInfo.InvariantCulture) + " UTC";

    async Task GuessAsync()
    {
        if (_task is null || _lab is null || _lab.Busy || _guessing) return;
        _guessing = true; StateHasChanged();
        await Task.Delay(1);
        try
        {
            int t = _task.HeldOut[_rng.Next(_task.HeldOut.Count)];
            var item = _task.ItemFor(t);
            var logits = _lab.Scorer.LabelLogits(_lab.Active, item.Prompt);
            var probs = TextTaskScorer.Probabilities(logits, item.Allowed);
            bool predUp = TextTaskScorer.Pick(logits, item.Allowed) == 0;
            bool actualUp = item.Good[0];
            var window = Enumerable.Range(t - _task.Window, _task.Window).Select(i => _task.Candles[i]).ToArray();
            _guess = new Guess(window, _task.Candles[t], predUp, probs[0], actualUp, predUp == actualUp);
            _guessTotal++; if (_guess.Hit) _guessHits++;
        }
        finally { _guessing = false; StateHasChanged(); }
    }

    // A small candlestick chart: the 16 hours the model read, then the hour it was asked about (outlined).
    static string ChartSvg(Guess g)
    {
        const int w = 720, h = 170, axisBand = 22;
        int chartH = h - axisBand;
        var all = g.Window.Append(g.Target).ToArray();
        double maxP = all.Max(p => p.H), minP = all.Min(p => p.L);
        if (maxP <= minP) maxP = minP + 1;
        int n = all.Length;
        double slot = (double)w / n, bodyW = Math.Max(1.5, Math.Min(14, slot * 0.6));
        double Y(double price) => 8 + (chartH - 16) - (price - minP) / (maxP - minP) * (chartH - 16);
        string F(double v) => v.ToString("F1", CultureInfo.InvariantCulture);
        var sb = new StringBuilder();
        sb.Append($"<svg viewBox=\"0 0 {w} {h}\" preserveAspectRatio=\"none\" class=\"fc-chart-svg\">");
        sb.Append($"<line class=\"fc-axis-line\" x1=\"0\" y1=\"{chartH}\" x2=\"{w}\" y2=\"{chartH}\"/>");
        for (int i = 0; i < n; i++)
        {
            var p = all[i];
            double cx = slot * i + slot / 2;
            double top = Math.Min(Y(p.O), Y(p.C)), bh = Math.Max(1.2, Math.Abs(Y(p.C) - Y(p.O)));
            string dirCls = p.C >= p.O ? "up" : "down";
            string last = i == n - 1 ? " target" : "";
            sb.Append($"<line class=\"fc-wick {dirCls}\" x1=\"{F(cx)}\" y1=\"{F(Y(p.H))}\" x2=\"{F(cx)}\" y2=\"{F(Y(p.L))}\"/>");
            sb.Append($"<rect class=\"fc-body {dirCls}{last}\" x=\"{F(cx - bodyW / 2)}\" y=\"{F(top)}\" width=\"{F(bodyW)}\" height=\"{F(bh)}\"/>");
        }
        foreach (var i in new[] { 0, n - 1 })
        {
            double cx = slot * i + slot / 2;
            string label = System.Net.WebUtility.HtmlEncode(DateTimeOffset.FromUnixTimeSeconds(all[i].T).UtcDateTime.ToString("MM/dd HH:mm", CultureInfo.InvariantCulture));
            sb.Append($"<text class=\"fc-axis-label\" x=\"{F(i == 0 ? cx + 18 : cx - 18)}\" y=\"{h - 5}\" text-anchor=\"middle\">{label}</text>");
        }
        sb.Append("</svg>");
        return sb.ToString();
    }
}
