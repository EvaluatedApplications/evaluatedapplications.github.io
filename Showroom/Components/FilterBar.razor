@* The brushing state as chips (press one to drop it), the measure the charts show, and the chart/table switch. *@
@using OrdersDemo
@using Showroom.Services

<div class="filterbar" role="region" aria-label="Filters and view">
    <div class="chips" aria-label="Active filters">
        @if (!S.Filter.Any) { <span class="hint">Everything is shown. Click a bar or a month to filter all the panels.</span> }
        @if (S.Filter.MonthLo >= 0)
        {
            <button type="button" class="chip on" @onclick="S.ClearMonthsAsync" aria-label="Remove the month filter">@MonthText <b aria-hidden="true">x</b></button>
        }
        @foreach (var (dim, set) in Sets)
        {
            @foreach (var v in set.OrderBy(x => x, StringComparer.Ordinal))
            {
                var d = dim; var val = v;
                <button type="button" class="chip on" @onclick="() => S.ToggleAsync(d, val)" aria-label="@($"Remove the {d} filter {val}")">@val <b aria-hidden="true">x</b></button>
            }
        }
        @if (S.Filter.Any) { <button type="button" class="chip" @onclick="S.ClearAsync">Clear all</button> }
    </div>
    <div class="toggles">
        <div class="seg" role="group" aria-label="Measure">
            @foreach (var (key, text) in new[] { ("revenue", "Revenue"), ("orders", "Orders"), ("average", "Average order") })
            {
                var k = key;
                <button type="button" class="@(S.Metric == k ? "on" : "")" aria-pressed="@(S.Metric == k ? "true" : "false")" @onclick="() => Metric(k)">@text</button>
            }
        </div>
        <div class="seg" role="group" aria-label="View">
            <button type="button" class="@(S.AsTable ? "" : "on")" aria-pressed="@(S.AsTable ? "false" : "true")" @onclick="() => View(false)">Charts</button>
            <button type="button" class="@(S.AsTable ? "on" : "")" aria-pressed="@(S.AsTable ? "true" : "false")" @onclick="() => View(true)">Tables</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public DashboardSession S { get; set; } = default!;

    IEnumerable<(string, HashSet<string>)> Sets => new[] { ("region", S.Filter.Regions), ("category", S.Filter.Categories), ("status", S.Filter.Statuses) };

    string MonthText => S.Filter.MonthLo == S.Filter.MonthHi
        ? OrdersGenerator.MonthLabel(S.Filter.MonthLo)
        : OrdersGenerator.MonthLabel(S.Filter.MonthLo) + " to " + OrdersGenerator.MonthLabel(S.Filter.MonthHi);

    Task Metric(string m) { S.Metric = m; return S.Repaint(); }      // the page repaints, so every panel follows
    Task View(bool table) { S.AsTable = table; return S.Repaint(); }
}
