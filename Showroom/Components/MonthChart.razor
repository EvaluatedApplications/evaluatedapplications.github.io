@* The month chart: 36 columns, each a button. Tap one month, tap a second to select the span between them; a year chip selects twelve.
   The same 36 rows are available as a table. Its statement leaves the month filter out, so it always shows every month. *@
@using OrdersDemo
@using Showroom.Services

<section class="panel wide" aria-labelledby="mc-h">
    <h3 id="mc-h">@MetricName by month <PanelRoute R="_route" /></h3>
    <div class="years" role="group" aria-label="Select a whole year">
        @for (int y = 0; y < OrdersGenerator.Months / 12; y++)
        {
            int year = y;
            <button type="button" class="chip @(YearOn(year) ? "on" : "")" aria-pressed="@(YearOn(year) ? "true" : "false")" @onclick="() => S.YearAsync(year)">@(2023 + year)</button>
        }
        <span class="hint">Tap a month, then another, to select the span between them.</span>
    </div>
    @if (S.AsTable)
    {
        <div class="table-scroll tall"><table class="data">
            <caption class="sr-only">Orders and revenue by month</caption>
            <thead><tr><th scope="col">Month</th><th scope="col" class="num">Orders</th><th scope="col" class="num">Revenue</th><th scope="col" class="num">Average</th></tr></thead>
            <tbody>
            @for (int m = 0; m < _rows.Count; m++)
            {
                int month = m; var s = _rows[m];
                <tr class="@(InRange(month) ? "on" : "")">
                    <th scope="row"><button type="button" class="link" aria-pressed="@(InRange(month) ? "true" : "false")" @onclick="() => S.MonthAsync(month)">@OrdersGenerator.MonthLabel(month)</button></th>
                    <td class="num">@DashboardFormat.N(s.Count)</td><td class="num">@DashboardFormat.Money(s.Sum)</td><td class="num">£@DashboardFormat.N(s.Average)</td>
                </tr>
            }
            </tbody></table></div>
    }
    else
    {
        <div class="cols" role="group" aria-label="Months">
        @for (int m = 0; m < _rows.Count; m++)
        {
            int month = m; var s = _rows[m];
            <button type="button" class="col @(InRange(month) ? "on" : _muted ? "muted" : "")" aria-pressed="@(InRange(month) ? "true" : "false")"
                    aria-label="@($"{OrdersGenerator.MonthLabel(month)}: {Text(s)}")" title="@($"{OrdersGenerator.MonthLabel(month)}: {Text(s)}")" @onclick="() => S.MonthAsync(month)">
                <span class="well"><span class="stick" style="height:@Height(s)%"></span></span>
                <span class="tick">@(month % 12 == 0 ? (2023 + month / 12).ToString() : "")</span>
            </button>
        }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public DashboardSession S { get; set; } = default!;

    IReadOnlyList<Slice> _rows = [];
    StmtResult? _route;
    long _max;
    bool _muted;
    string MetricName => S.Metric switch { "orders" => "Orders", "average" => "Average order", _ => "Revenue" };

    protected override void OnParametersSet()
    {
        _rows = S.Slices("month", Enumerable.Range(0, OrdersGenerator.Months).Select(i => i.ToString()));
        _route = S.Result("month");
        _max = _rows.Count == 0 ? 0 : _rows.Max(Val);
        _muted = S.Filter.MonthLo >= 0;
    }

    bool InRange(int m) => S.Filter.MonthLo >= 0 && m >= S.Filter.MonthLo && m <= S.Filter.MonthHi;
    bool YearOn(int y) => S.Filter.MonthLo == y * 12 && S.Filter.MonthHi == y * 12 + 11;
    long Val(Slice s) => S.Metric switch { "orders" => s.Count, "average" => s.Average, _ => s.Sum };
    string Text(Slice s) => S.Metric switch { "orders" => DashboardFormat.N(s.Count) + " orders", "average" => "£" + DashboardFormat.N(s.Average) + " average", _ => DashboardFormat.Money(s.Sum) };
    string Height(Slice s) => _max <= 0 ? "0" : Math.Max(1.5, 100.0 * Val(s) / _max).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
