@using System.Globalization
@using System.Text
@using HoloKernel
@using Showroom.Services.PrismTab
@implements IDisposable
@inject PrismLoader Loader
@* Play-and-train panel shared by the Creature and Forecaster tabs: playing and training are ONE act. The tab supplies the tick (the creature
   moves, or a forecast beat plays) and the tick trains the visitor's copy on what just happened. This component owns the knobs, Run / Pause /
   Stop / Reset, the cooperative loop (the page stays responsive between ticks) and the readout (accuracy of the model's own last calls, with
   its history). The model is the visitor's OWN copy (PrivateCopy, a new session): the shared Prism session is only ever read and is never
   passed to anything that writes. Leaving the tab (Dispose) stops the run and drops the copy. *@

<section class="tl-panel" aria-labelledby="tl-train-@_id">
    <h3 id="tl-train-@_id">Run it</h3>
    <p class="tl-copy">Your copy of the model, trained in your browser as it plays. The shared model is not changed.</p>
    <div class="tl-knobs">
        <label>Weights
            <select value="@(_fresh ? "fresh" : "trained")" @onchange="OnWeights" disabled="@(Running || _copy is not null)">
                <option value="fresh">Fresh</option>
                <option value="trained">Prism's trained weights</option>
            </select>
        </label>
        <label>Learning rate
            <input type="number" step="any" min="0" @bind="_lr" @bind:culture="CultureInfo.InvariantCulture" @bind:after="() => _lrEdited = true" />
        </label>
        <label>Examples per step
            <input type="number" step="1" min="1" @bind="_batch" />
        </label>
        @if (_fresh)
        {
            <label>Seed
                <input type="number" step="1" @bind="_seed" disabled="@(Running || _copy is not null)" />
            </label>
        }
        @if (ShowExploration)
        {
            <label>Exploration
                <input type="number" step="0.05" min="0" max="1" @bind="_explore" @bind:culture="CultureInfo.InvariantCulture" />
            </label>
        }
        <label>Speed
            <input type="range" min="1" max="10" @bind="_speed" @bind:event="oninput" />
        </label>
        @ChildContent
    </div>
    <div class="tl-row">
        <button class="go" type="button" @onclick="RunOrPause">@(Running ? "Pause" : (_copy is null ? "Run" : "Resume"))</button>
        <button class="ghost" type="button" @onclick="StopAsync" disabled="@(_copy is null)">Stop</button>
        <button class="ghost" type="button" @onclick="Reset" disabled="@(Running || _copy is null)">Reset</button>
    </div>
    @if (_error is not null) { <p class="err">@_error</p> }
    @if (_copy is not null)
    {
        <div class="cr-stats tl-stats">
            <div class="stat"><div class="n">@_copy.Steps.ToString("N0", CultureInfo.InvariantCulture)</div><div class="l">steps so far</div></div>
            <div class="stat"><div class="n">@(_recent.Count == 0 ? "…" : Pct(RecentAcc))</div><div class="l">of its last @_recent.Count calls right</div></div>
            <div class="stat"><div class="n">@(_copy.Steps == 0 ? "…" : _copy.LastLoss.ToString("0.00", CultureInfo.InvariantCulture))</div><div class="l">last loss</div></div>
        </div>
        <figure class="cr-curve">
            <figcaption>share of its last @RecentCap calls right, against steps</figcaption>
            @((MarkupString)CurveSvg())
        </figure>
    }
</section>

@code {
    static int _next;
    readonly int _id = Interlocked.Increment(ref _next);

    [Parameter, EditorRequired] public PrismModel Model { get; set; } = default!;
    /// <summary>The task, for its label tokens.</summary>
    [Parameter, EditorRequired] public ITextTask Job { get; set; } = default!;
    /// <summary>One tick of play. It acts, trains <see cref="LabTick.Copy"/> on what happened, paces itself with <see cref="LabTick.Speed"/>, and returns whether the model's own call was right (null if there was no right answer to check).</summary>
    [Parameter, EditorRequired] public Func<LabTick, Task<bool?>> Tick { get; set; } = default!;
    /// <summary>The run was stopped or reset: the tab puts its world back to the start.</summary>
    [Parameter] public EventCallback OnStopped { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public bool ShowExploration { get; set; }
    /// <summary>Extra knobs the tab adds (the Forecaster's history window).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    const int RecentCap = 50, PointEvery = 5;
    ITextTask? _jobSeen;
    TextTaskScorer? _scorer;
    PrivateCopy? _copy;
    readonly Queue<bool> _recent = new();
    readonly List<(int Step, double Acc)> _points = new();
    readonly Random _rng = new(1234);
    CancellationTokenSource? _cts;
    bool _stopRequested;
    string? _error;
    bool _fresh = true, _lrEdited;
    double _lr = PrismTabDefaults.FreshLearningRate, _explore = PrismTabDefaults.Exploration;
    int _batch = PrismTabDefaults.ExamplesPerStep, _seed = PrismTabDefaults.FreshSeed, _speed = 5;

    public bool Running { get; private set; }
    public bool IsPrivate => _copy is not null;
    public bool IsFresh => _copy is { IsFresh: true };
    public TextTaskScorer Scorer { get { _scorer ??= new TextTaskScorer(Model.Vocab, Model.Stats.Context, Job.Labels); return _scorer; } }
    double RecentAcc => _recent.Count == 0 ? 0 : (double)_recent.Count(x => x) / _recent.Count;

    protected override void OnParametersSet()
    {
        // A tab that changes the task (the Forecaster's history window) hands in a new Job: start over on it.
        if (_jobSeen is not null && !ReferenceEquals(_jobSeen, Job) && !Running) { _scorer = null; DropCopy(); }
        _jobSeen = Job;
    }

    void OnWeights(ChangeEventArgs e)
    {
        _fresh = (e.Value?.ToString() ?? "fresh") == "fresh";
        if (!_lrEdited) _lr = _fresh ? PrismTabDefaults.FreshLearningRate : PrismTabDefaults.LearningRate;
    }

    static string Pct(double v) => (v * 100).ToString("F0", CultureInfo.InvariantCulture) + "%";
    async Task Raise() { StateHasChanged(); await OnChanged.InvokeAsync(); }
    void DropCopy() { _copy = null; _recent.Clear(); _points.Clear(); _error = null; }

    async Task RunOrPause()
    {
        if (Running) { _cts?.Cancel(); return; }
        if (!Loader.TryBeginTraining(this)) { _error = "Another job in this tab is still running."; return; }
        _cts = new CancellationTokenSource(); var ct = _cts.Token;
        _stopRequested = false; Running = true; _error = null;
        StateHasChanged();
        try
        {
            await Task.Delay(1);   // let the button state paint before the first heavy tick
            double lr = double.IsFinite(_lr) && _lr > 0 ? _lr : (_fresh ? PrismTabDefaults.FreshLearningRate : PrismTabDefaults.LearningRate);
            if (_copy is null)
            {
                _copy = _fresh ? PrivateCopy.Fresh(Model.Session, _seed, lr) : PrivateCopy.Clone(Model.Session, lr);   // a NEW session; the shared one is only read
                _recent.Clear(); _points.Clear();
                await Raise();
            }
            _copy.LearningRate = lr;
            while (!ct.IsCancellationRequested)
            {
                var hit = await Tick(new LabTick(_copy, Scorer, _rng, Math.Clamp(_batch, 1, 64), Math.Clamp(double.IsFinite(_explore) ? _explore : 0, 0, 1), _speed, ct));
                if (hit is { } h)
                {
                    _recent.Enqueue(h); while (_recent.Count > RecentCap) _recent.Dequeue();
                    if (_copy.Steps % PointEvery == 0) _points.Add((_copy.Steps, RecentAcc));
                }
                StateHasChanged();
                await Task.Delay(1);   // a real browser turn, so input and painting run between ticks
            }
        }
        catch (Exception ex) { _error = "Stopped: " + ex.Message; }
        finally
        {
            Running = false; Loader.EndTraining(this);
            if (_stopRequested) await OnStopped.InvokeAsync();
            await Raise();
        }
    }

    // Stop ends the run and puts the tab's world back to the start; the trained copy stays until Reset.
    async Task StopAsync()
    {
        if (Running) { _stopRequested = true; _cts?.Cancel(); return; }
        await OnStopped.InvokeAsync();
        StateHasChanged();
    }

    async Task Reset()
    {
        if (Running) return;
        DropCopy();
        await OnStopped.InvokeAsync();
        await Raise();
    }

    // ---- the history: share of its last calls right, against steps ----
    string CurveSvg()
    {
        const int w = 640, h = 130, padL = 34, padR = 8, padT = 8, padB = 18;
        double Y(double acc) => padT + (1 - acc) * (h - padT - padB);
        int maxStep = Math.Max(1, Math.Max(_points.Count == 0 ? 1 : _points.Max(p => p.Step), _copy?.Steps ?? 1));
        double X(int step) => padL + (double)step / maxStep * (w - padL - padR);
        var inv = CultureInfo.InvariantCulture;
        string F(double v) => v.ToString("F1", inv);
        var sb = new StringBuilder();
        sb.Append($"<svg viewBox=\"0 0 {w} {h}\" class=\"curve-svg tl-svg\" role=\"img\" aria-label=\"share of recent calls right against steps\">");
        foreach (var g in new[] { 0.0, 0.5, 1.0 })
        {
            sb.Append($"<line class=\"tl-grid\" x1=\"{padL}\" y1=\"{F(Y(g))}\" x2=\"{w - padR}\" y2=\"{F(Y(g))}\"/>");
            sb.Append($"<text class=\"tl-axis\" x=\"{padL - 4}\" y=\"{F(Y(g) + 3)}\" text-anchor=\"end\">{(int)(g * 100)}%</text>");
        }
        if (_points.Count > 1)
        {
            sb.Append("<polyline class=\"curve-line\" points=\"");
            foreach (var (step, acc) in _points) sb.Append(F(X(step))).Append(',').Append(F(Y(acc))).Append(' ');
            sb.Append("\"/>");
        }
        sb.Append($"<text class=\"tl-axis\" x=\"{padL}\" y=\"{h - 4}\">0</text>");
        sb.Append($"<text class=\"tl-axis\" x=\"{w - padR}\" y=\"{h - 4}\" text-anchor=\"end\">{maxStep.ToString("N0", inv)} steps</text>");
        sb.Append("</svg>");
        return sb.ToString();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        Loader.EndTraining(this);
    }
}
