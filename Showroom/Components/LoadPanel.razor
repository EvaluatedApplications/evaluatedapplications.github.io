@* Choose the table size, build it in this tab with a visible progress step, and read back what the build cost here. *@
@using Showroom.Services

<section class="panel build" aria-labelledby="lp-h">
    <h2 id="lp-h">1. Build the database in this tab</h2>
    <p class="hint">A deterministic table of orders is generated here and loaded into HoloDb's memory. Nothing is downloaded but the code, and nothing leaves the tab.
        Bigger tables need more browser memory: if the tab cannot hold one, it will say so. The numbers under the button are measured by this tab, on this device.</p>
    <div class="row">
        <label for="dash-size">Rows</label>
        <select id="dash-size" @bind="S.Size" disabled="@S.Building">
            @foreach (var n in DashboardSession.Sizes)
            {
                <option value="@n">@DashboardFormat.N(n)</option>
            }
        </select>
        <button type="button" class="btn btn-primary" @onclick="S.BuildAsync" disabled="@S.Building">@(S.Load is null ? "Build it" : "Rebuild at this size")</button>
    </div>
    @if (S.Building && S.Step is { } st)
    {
        <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)(st.Fraction * 100))" aria-label="@st.Phase">
            <span style="width:@((int)(st.Fraction * 100))%"></span>
        </div>
        <p class="hint" role="status">@st.Phase: @DashboardFormat.N(st.RowsDone) of @DashboardFormat.N(S.Size) rows</p>
    }
    @if (S.Error is not null) { <p class="err" role="alert">@S.Error</p> }
    @if (S.Load is { } l && !S.Building)
    {
        <dl class="facts">
            <div><dt>Ready in</dt><dd>@DashboardFormat.Ms(l.TotalMs)</dd></div>
            <div><dt>Rows</dt><dd>@DashboardFormat.N(l.Rows)</dd></div>
            <div><dt>Generate</dt><dd>@DashboardFormat.Ms(l.GenerateMs)</dd></div>
            <div><dt>Load columns</dt><dd>@DashboardFormat.Ms(l.BulkLoadMs)</dd></div>
            <div><dt>Build plane</dt><dd>@DashboardFormat.Ms(l.PlaneMs)</dd></div>
            <div><dt>Managed heap</dt><dd>@DashboardFormat.Mb(l.HeapBytes)</dd></div>
            <div><dt>Committed</dt><dd>@DashboardFormat.Mb(l.CommittedBytes)</dd></div>
            <div><dt>Plane</dt><dd>@DashboardFormat.Mb(l.PlaneBytes) (+@DashboardFormat.Mb(l.PlanePendingBytes) pending), @l.JointBits-bit joint</dd></div>
            <div><dt>First dashboard paint</dt><dd>@DashboardFormat.Ms(S.FirstPaintMs)</dd></div>
        </dl>
    }
</section>

@code {
    [Parameter, EditorRequired] public DashboardSession S { get; set; } = default!;
}
