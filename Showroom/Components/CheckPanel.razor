@using System.Diagnostics
@using Showroom.Services
@inject CouncilWebData Data
@inject FoiTray Tray
@implements IDisposable

@* One check of the Council Spending Scanner. Closed until tapped; its file is fetched on the first tap only, parsed in time slices,
   and shown fifteen lines at a time, so the page never builds a long list the visitor did not ask for. *@
<section class="check">
    <button type="button" class="check-head" @onclick="Toggle" aria-expanded="@(_open ? "true" : "false")">
        <span class="arrow" aria-hidden="true">@(_open ? "▾" : "▸")</span>
        <h3>@Def.Title</h3>
        @if (_loaded) { <span class="count">@_rows.Count</span> }
    </button>
    @if (_open)
    {
        <p class="plain">@Def.Plain</p>
        @if (Def.RuleChecks.Length > 0) { <RulesDisclosure Checks="Def.RuleChecks" /> }
        @if (_error is not null) { <p class="err">@_error</p> }
        else if (!_loaded) { <p class="hint">Loading this check (a small file)...</p> }
        else
        {
            <p class="summary">@_summary</p>
            @foreach (var rule in _fileRules) { <p class="caption"><b>The rule as the file states it on every row.</b> @rule</p> }
            @if (!string.IsNullOrEmpty(_note)) { <p class="caption">@_note</p> }
            @if (_rows.Count > 0)
            {
                <ol class="lines">
                    @foreach (var r in _rows.Take(_shown))
                    {
                        <li @key="r">
                            <div class="l1">@r.Line1</div><div class="l2">@r.Line2</div>
                            @if (r.Foi is not null || r.Src is not null)
                            {
                                bool on = r.Key is not null && Tray.Has(r.Key); bool src = r.Source?.Open == true;
                                <div class="acts">
                                    @if (r.Foi is not null)
                                    {
                                        <button type="button" class="tick @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")" @onclick="() => Tick(r)">@(on ? "In your request (tap to remove)" : "Add to request")</button>
                                    }
                                    @if (r.Src is not null)
                                    {
                                        <button type="button" class="srcbtn" aria-expanded="@(src ? "true" : "false")" @onclick="() => ToggleSource(r)">@(src ? "Hide the source rows" : "See the source rows")</button>
                                    }
                                </div>
                                @if (src) { <SourceBlocks State="r.Source!" /> }
                            }
                        </li>
                    }
                </ol>
                @if (_rows.Count > _shown)
                {
                    <button type="button" class="more" @onclick="More">Show @Math.Min(15, _rows.Count - _shown) more (@(_rows.Count - _shown) not shown)</button>
                }
            }
            @if (_side.Count > 0 || _sideSummary is not null)
            {
                <h4 class="side">@Def.SideTitle</h4>
                <p class="summary">@_sideSummary</p>
                <ol class="lines">
                    @foreach (var r in _side.Take(_sideShown))
                    {
                        <li @key="r">
                            <div class="l1">@r.Line1</div><div class="l2">@r.Line2</div>
                            @if (r.Foi is not null)
                            {
                                bool on = r.Key is not null && Tray.Has(r.Key);
                                <div class="acts">
                                    <button type="button" class="tick @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")" @onclick="() => Tick(r)">@(on ? "In your request (tap to remove)" : "Add to request")</button>
                                </div>
                            }
                        </li>
                    }
                </ol>
                @if (_side.Count > _sideShown)
                {
                    <button type="button" class="more" @onclick="() => _sideShown += 15">Show @Math.Min(15, _side.Count - _sideShown) more (@(_side.Count - _sideShown) not shown)</button>
                }
            }
            @if (_full) { <p class="err" role="status">Your request already holds @FoiTray.MaxItems items; remove some first.</p> }
            <p class="caption">@Def.Caption</p>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public CheckDef Def { get; set; } = default!;
    /// <summary>Show only this council's rows; null shows every council.</summary>
    [Parameter] public string? Slug { get; set; }

    bool _open, _loaded;
    int _shown = 15;
    string? _error, _summary, _note;
    List<CheckRow> _rows = new();
    List<CheckRow> _side = new();
    string? _sideSummary;
    int _sideShown = 15;
    List<string> _fileRules = new();

    async Task Toggle()
    {
        _open = !_open;
        if (!_open || _loaded || _error is not null) return;
        var sw = Stopwatch.StartNew();
        try
        {
            var co = new Cooperative(CancellationToken.None);
            var table = await Data.TableAsync(Def.File, true, co);
            var tab = new Tab(table);
            _fileRules = Def.RuleOf?.Invoke(tab) ?? new();
            var mine = Slug is null ? tab.Rows : tab.Rows.Where(r => Def.Matches(tab, r, Slug)).ToList();
            var (rows, summary) = Def.Build(tab, mine);
            // the councils' measured facts are registered when profiles.json is read; the all-councils view of a number-based check needs them to say which councils it cannot cover
            if (Slug is null && Def.Id is "twins" or "withintxn" && CouncilWebData.Councils.Count > 0) await Data.ProfileAsync(CouncilWebData.Councils[0].Slug);
            var cannot = Slug is null ? null : CouncilTerms.CheckCannotRun(Slug, Def.Id);
            _rows = cannot is not null ? new() : rows;   // a check that cannot run for this council lists nothing, and says why instead of "no rows"
            _summary = cannot ?? (mine.Count == 0 ? "This check has no rows for this council." : summary);
            _note = Slug is null ? CouncilTerms.CheckCoverage(Def.Id, CouncilWebData.Councils.Select(c => (c.Slug, c.Short))) : CouncilTerms.CheckNote(Slug, Def.Id);
            // the check's side list (twins: one transaction number in two files), read only when the check can run for this view
            if (Def.SideFile is not null && cannot is null)
            {
                var st = new Tab(await Data.TableAsync(Def.SideFile, true, co));
                var sm = Slug is null ? st.Rows : st.Rows.Where(r => Def.Matches(st, r, Slug)).ToList();
                var (ss, sr) = CouncilChecksWeb.SameNumberRows(st, sm);
                _side = sr; _sideSummary = ss;
            }
            _loaded = true;
            await Data.LogAsync($"check {Def.Id} ({(Slug ?? "all")}) built", sw.ElapsedMilliseconds, $"({mine.Count} source rows)");
        }
        catch (Exception ex) { _error = "Could not load this check: " + ex.Message; }
    }

    void More() => _shown += 15;

    // Plain buttons with their state on the row (a component per row is slower to draw on a phone); see MonthView for the same pattern.
    bool _self, _full;
    protected override void OnInitialized() => Tray.ItemsChanged += OnTray;
    public void Dispose() => Tray.ItemsChanged -= OnTray;
    void OnTray() { if (!_self && _open && _loaded) InvokeAsync(StateHasChanged); }

    void Tick(CheckRow r)
    {
        _full = false; _self = true;
        try
        {
            if (Tray.Has(r.Key!)) Tray.Remove(r.Key!);
            else
            {
                var it = r.Foi!();
                it.Key = r.Key!; it.Section = Def.Title;
                if (!Tray.Add(it)) _full = true;
            }
        }
        finally { _self = false; }
    }

    async Task ToggleSource(CheckRow r)
    {
        var s = r.Source ??= new SourceState();
        s.Open = !s.Open;
        if (s.Open && !s.Loaded && !s.Busy) await s.LoadAsync(Data, r.Src!(), () => InvokeAsync(StateHasChanged));
    }
}
