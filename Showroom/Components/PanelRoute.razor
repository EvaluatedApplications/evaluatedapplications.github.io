@* The small "plane - 0.8 ms" tag on a panel: which path HoloDb reported for this panel's statement, and its measured time here. *@
@using Showroom.Services

@if (R is not null)
{
    <span class="route @DashboardFormat.RouteBadge(R.Route)" title="@Tip">@DashboardFormat.RouteBadge(R.Route) · @DashboardFormat.Ms(R.Ms)</span>
}

@code {
    [Parameter] public StmtResult? R { get; set; }

    string Tip => R is null ? "" : R.Error is not null ? R.Error
        : R.Route + (R.Declined is null ? "" : " (plane declined: " + R.Declined + ")");
}
