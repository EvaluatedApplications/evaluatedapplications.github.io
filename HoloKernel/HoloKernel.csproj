<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>HoloKernel</RootNamespace>
  </PropertyGroup>

  <!-- Consumed by a Blazor WebAssembly host; keep the browser analyzer honest. -->
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- NuGet ONLY, never a MonoRepo ProjectReference — same hard boundary Showroom keeps.
       AlgFormer 2.2.0 is the version Showroom already ships (bumped from 1.5.0, 2026-09-04 —
       see Showroom/CLAUDE.md's "Checkpoint refresh + AlgFormer 2.2.0 bump"); every signature
       this project calls was verified by reflection against THIS exact DLL, not assumed. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.8" />
    <PackageReference Include="EvaluatedApplications.AlgFormer" Version="2.2.0" />
  </ItemGroup>

</Project>
