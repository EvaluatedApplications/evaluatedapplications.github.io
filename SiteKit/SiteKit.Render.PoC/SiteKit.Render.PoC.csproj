<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>SiteKit.Render.PoC</RootNamespace>
  </PropertyGroup>

  <!-- The Phase-1 proof-of-concept: port ONE real page (phasor.html) through the real
       SiteKit.Spec + SiteKit.Render pipeline and diff the output against the hand-authored
       original. Not part of the deployed site; not referenced by deploy.yml. -->
  <ItemGroup>
    <ProjectReference Include="..\SiteKit.Spec\SiteKit.Spec.csproj" />
    <ProjectReference Include="..\SiteKit.Render\SiteKit.Render.csproj" />
  </ItemGroup>

</Project>
