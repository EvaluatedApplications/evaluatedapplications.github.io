<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>SiteKit.Spec</RootNamespace>
  </PropertyGroup>

  <!-- Pure data + a fluent builder. No EvalApp, no HTML, no rendering logic — see
       AboutUs/docs/platform-architecture.md §3.1/§3.2. Zero dependencies on purpose, same
       "design the record first" discipline EvalApp's own docs describe. -->

</Project>
