<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>ContentDbBuilder</RootNamespace>
  </PropertyGroup>

  <!-- Build-time-only desktop console tool: creates the legacy-mode HoloDb content artifact that
       Showroom fetches and opens at runtime (see Showroom/Services/ContentDbHost.cs). NEVER shipped
       to the browser itself — a plain net10.0 console app, not part of the Showroom WASM publish.
       Pinned to the EXACT HoloDb version Showroom.csproj references (1.4.0) so the on-disk snapshot
       format this tool writes cannot skew from the format the WASM runtime reads back. Never bump
       this without bumping Showroom.csproj's HoloDb reference in the same change. -->
  <ItemGroup>
    <PackageReference Include="EvaluatedApplications.HoloDb" Version="1.4.0" />
  </ItemGroup>

</Project>
